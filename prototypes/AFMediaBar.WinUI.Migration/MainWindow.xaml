<Window
    x:Class="AFMediaBar.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid
        x:Name="Root"
        Padding="4"
        Background="Transparent"
        PointerPressed="Root_OnPointerPressed"
        PointerMoved="Root_OnPointerMoved"
        PointerReleased="Root_OnPointerReleased"
        PointerCanceled="Root_OnPointerCanceled"
        PointerCaptureLost="Root_OnPointerCaptureLost">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="PlayerPrimaryTextBrush" Color="#FFF7FA" />
                        <SolidColorBrush x:Key="PlayerSecondaryTextBrush" Color="#FFB9D1E3" />
                        <SolidColorBrush x:Key="PlayerSurfaceBrush" Color="#2AFFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="PlayerPrimaryTextBrush" Color="#FF171A1D" />
                        <SolidColorBrush x:Key="PlayerSecondaryTextBrush" Color="#FF405568" />
                        <SolidColorBrush x:Key="PlayerSurfaceBrush" Color="#24000000" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <Style x:Key="TransportButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="36" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="MinWidth" Value="36" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="{ThemeResource PlayerPrimaryTextBrush}" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="PlayerContextMenu">
                <MenuFlyoutItem
                    x:Name="OpenDetailedSettingsMenuItem"
                    Click="OpenDetailedSettingsMenuItem_OnClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Name="ExitContextMenuItem"
                    Click="ExitContextMenuItem_OnClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE711;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderView" Grid.Row="0" Visibility="Collapsed">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                    Text="AF Media Bar" />
                <TextBlock
                    x:Name="TaglineText"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Text="WinUI 3 application shell" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0">
            <Border
                x:Name="ShellView"
                Padding="2"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="10" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ArtworkColumn" Width="48" />
                            <ColumnDefinition
                                x:Name="MediaInfoColumn"
                                Width="150"
                                MinWidth="150" />
                            <ColumnDefinition x:Name="SourceColumn" Width="120" />
                            <ColumnDefinition x:Name="ControlsColumn" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="ArtworkBorder"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource PlayerSurfaceBrush}"
                            CornerRadius="5">
                            <Grid>
                                <FontIcon
                                    x:Name="ArtworkPlaceholderIcon"
                                    FontSize="18"
                                    Glyph="&#xE8D6;"
                                    Foreground="{ThemeResource PlayerSecondaryTextBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <Image
                                    x:Name="ArtworkImage"
                                    Stretch="UniformToFill"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <StackPanel
                            x:Name="MediaInfoPanel"
                            Grid.Column="1"
                            Spacing="2"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="MediaTitleText"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PlayerPrimaryTextBrush}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="MediaArtistText"
                                FontSize="11"
                                Foreground="{ThemeResource PlayerSecondaryTextBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="2"
                            x:Name="MediaSourceComboBox"
                            Height="32"
                            DisplayMemberPath="DisplayName"
                            SelectedValuePath="Key"
                            SelectionChanged="MediaSourceComboBox_OnSelectionChanged" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                <Button
                                    x:Name="PreviousMediaButton"
                                    Click="PreviousMediaButton_OnClick"
                                    Style="{StaticResource TransportButtonStyle}"
                                    ToolTipService.ToolTip="Previous">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource PlayerPrimaryTextBrush}"
                                        Glyph="&#xE892;" />
                                </Button>
                                <Button
                                    x:Name="PlayPauseMediaButton"
                                    Click="PlayPauseMediaButton_OnClick"
                                    Style="{StaticResource TransportButtonStyle}"
                                    ToolTipService.ToolTip="Play">
                                    <FontIcon
                                        x:Name="PlayPauseIcon"
                                        FontSize="18"
                                        Foreground="{ThemeResource PlayerPrimaryTextBrush}"
                                        Glyph="&#xE768;" />
                                </Button>
                                <Button
                                    x:Name="NextMediaButton"
                                    Click="NextMediaButton_OnClick"
                                    Style="{StaticResource TransportButtonStyle}"
                                    ToolTipService.ToolTip="Next">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource PlayerPrimaryTextBrush}"
                                        Glyph="&#xE893;" />
                                </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        x:Name="MediaStatusText"
                            Foreground="{ThemeResource PlayerSecondaryTextBrush}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed" />
                    <StackPanel
                        Grid.Row="2"
                        x:Name="ComponentIndicatorsHost"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <Border
                            x:Name="MetricsHost"
                            MinWidth="74"
                            Height="24"
                            Padding="4,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="MetricsText"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource PlayerPrimaryTextBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Border
                            x:Name="SpectrumHost"
                            Width="88"
                            Height="24"
                            Padding="2,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource PlayerSurfaceBrush}"
                            Visibility="Collapsed">
                            <StackPanel
                                x:Name="SpectrumBarsHost"
                                Orientation="Horizontal"
                                Spacing="3"
                                VerticalAlignment="Center">
                                <Border x:Name="SpectrumBar0" Width="6" Height="3" CornerRadius="2" Background="{ThemeResource PlayerSecondaryTextBrush}" VerticalAlignment="Center" />
                                <Border x:Name="SpectrumBar1" Width="6" Height="3" CornerRadius="2" Background="{ThemeResource PlayerSecondaryTextBrush}" VerticalAlignment="Center" />
                                <Border x:Name="SpectrumBar2" Width="6" Height="3" CornerRadius="2" Background="{ThemeResource PlayerSecondaryTextBrush}" VerticalAlignment="Center" />
                                <Border x:Name="SpectrumBar3" Width="6" Height="3" CornerRadius="2" Background="{ThemeResource PlayerSecondaryTextBrush}" VerticalAlignment="Center" />
                                <Border x:Name="SpectrumBar4" Width="6" Height="3" CornerRadius="2" Background="{ThemeResource PlayerSecondaryTextBrush}" VerticalAlignment="Center" />
                                <Border x:Name="SpectrumBar5" Width="6" Height="3" CornerRadius="2" Background="{ThemeResource PlayerSecondaryTextBrush}" VerticalAlignment="Center" />
                                <Border x:Name="SpectrumBar6" Width="6" Height="3" CornerRadius="2" Background="{ThemeResource PlayerSecondaryTextBrush}" VerticalAlignment="Center" />
                                <Border x:Name="SpectrumBar7" Width="6" Height="3" CornerRadius="2" Background="{ThemeResource PlayerSecondaryTextBrush}" VerticalAlignment="Center" />
                                <Border x:Name="SpectrumBar8" Width="6" Height="3" CornerRadius="2" Background="{ThemeResource PlayerSecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Grid.Row="3"
                        x:Name="HighContrastStatusText"
                        Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                        Text="High contrast is enabled"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border
                x:Name="SettingsView"
                Padding="0"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0">
                        <Grid Margin="10,14">
                            <StackPanel Spacing="10">
                                <FontIcon
                                    FontSize="22"
                                    Glyph="&#xE8D6;"
                                    Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                                <Button
                                    x:Name="SettingsNavigationButton"
                                    Width="48"
                                    Height="48"
                                    Padding="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="Transparent"
                                    IsEnabled="False">
                                    <FontIcon FontSize="18" Glyph="&#xE713;" />
                                </Button>
                            </StackPanel>
                            <Button
                                x:Name="BackButton"
                                Width="48"
                                Height="48"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="BackButton_OnClick">
                                <FontIcon Glyph="&#xE72B;" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Padding="22,20,22,18" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock
                                x:Name="SettingsTitleText"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                            <TextBlock
                                x:Name="SettingsDescriptionText"
                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Border
                            Grid.Row="1"
                            MinHeight="78"
                            Padding="14,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    FontSize="20"
                                    Glyph="&#xE790;"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="ThemeLabelText"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                                    <TextBlock
                                        x:Name="ThemeDescriptionText"
                                        FontSize="12"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    x:Name="ThemeComboBox"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    SelectionChanged="ThemeComboBox_OnSelectionChanged">
                                    <ComboBoxItem x:Name="ThemeAutomaticItem" />
                                    <ComboBoxItem x:Name="ThemeLightItem" />
                                    <ComboBoxItem x:Name="ThemeDarkItem" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="2"
                            MinHeight="78"
                            Padding="14,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    FontSize="20"
                                    Glyph="&#xE774;"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="LanguageLabelText"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                                    <TextBlock
                                        x:Name="LanguageDescriptionText"
                                        FontSize="12"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    x:Name="LanguageComboBox"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    SelectionChanged="LanguageComboBox_OnSelectionChanged">
                                    <ComboBoxItem x:Name="LanguageFollowSystemItem" />
                                    <ComboBoxItem x:Name="LanguageZhCnItem" />
                                    <ComboBoxItem x:Name="LanguageZhTwItem" />
                                    <ComboBoxItem x:Name="LanguageEnUsItem" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <StackPanel
                            Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                            <Button Click="BackButton_OnClick" Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72B;" />
                                    <TextBlock x:Name="BackButtonText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CloseButton" Command="{x:Bind ViewModel.ExitCommand}" Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE711;" />
                                    <TextBlock x:Name="CloseButtonText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="FooterView" Grid.Row="2" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="FooterText"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.ExitCommand}"
                Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE711;" />
                    <TextBlock x:Name="ExitButtonText" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
