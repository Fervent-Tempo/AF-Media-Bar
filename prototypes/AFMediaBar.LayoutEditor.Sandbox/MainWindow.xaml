<Window x:Class="AFMediaBar.LayoutEditor.Sandbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AF Media Bar Layout Editor Sandbox"
        Width="960"
        Height="640"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="StatusText" FontSize="16" Margin="0,0,0,12" />
    <Border Grid.Row="1" BorderBrush="#667080" BorderThickness="1" CornerRadius="6" Padding="12">
      <ContentControl x:Name="EditorHost" />
    </Border>
  </Grid>
</Window>
