<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:AFMediaBar.Components" x:Class="AFMediaBar.Components.SettingsPreview">
    <StackPanel>
        <Border Background="{DynamicResource AfSettingsPreviewSurfaceBrush}" CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="MinHeight" Value="120"/>
                    <Setter Property="Padding" Value="12,20"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWide, RelativeSource={RelativeSource AncestorType=components:SettingsPageLayout}}" Value="False">
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Padding" Value="8"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="{Binding PreviewViewportHeight, RelativeSource={RelativeSource AncestorType=components:SettingsPageLayout}, FallbackValue=360}">
                <components:SettingsPreviewScene/>
            </Viewbox>
        </Border>
        <TextBlock Text="{Binding ScaleLabel}" Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFull}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWide, RelativeSource={RelativeSource AncestorType=components:SettingsPageLayout}}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <CheckBox Margin="0,14,0,0" Content="{DynamicResource Loc.Settings.Preview.Idle}" IsChecked="{Binding ShowIdle, Mode=TwoWay}" FontSize="13" Visibility="{Binding IsRest, Converter={StaticResource AfBooleanToVisibilityConverter}}"/>
        <TextBlock Margin="0,12,0,0" Text="{DynamicResource Loc.Settings.Preview.Note}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWide, RelativeSource={RelativeSource AncestorType=components:SettingsPageLayout}}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
