<UserControl x:Class="AFMediaBar.Components.TrackNotificationPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:AFMediaBar.Components" x:Name="Root">
    <StackPanel Margin="0,8,0,16">
        <TextBlock Text="{DynamicResource Loc.Notification.Preview.Position}" Style="{DynamicResource AfSettingsSubsectionTitleStyle}"/>
        <Border Height="240" Background="{DynamicResource AfSettingsPreviewSurfaceBrush}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
            <Viewbox Stretch="Uniform">
                <Canvas x:Name="Screen" Background="{DynamicResource SubtleFillColorSecondaryBrush}" ClipToBounds="True">
                    <Border x:Name="PositionCard" Margin="6" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" MaxWidth="388">
                        <components:TrackNotificationContent Snapshot="{Binding Snapshot, ElementName=Root}" Settings="{Binding Settings, ElementName=Root}"/>
                    </Border>
                </Canvas>
            </Viewbox>
        </Border>
        <TextBlock Text="{DynamicResource Loc.Notification.Preview.Appearance}" Style="{DynamicResource AfSettingsSubsectionTitleStyle}"/>
        <Border HorizontalAlignment="Center" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" MaxWidth="388">
            <components:TrackNotificationContent Snapshot="{Binding Snapshot, ElementName=Root}" Settings="{Binding Settings, ElementName=Root}"/>
        </Border>
    </StackPanel>
</UserControl>
