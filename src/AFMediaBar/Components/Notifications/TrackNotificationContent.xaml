<UserControl x:Class="AFMediaBar.Components.TrackNotificationContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ArtworkColumn" Width="44"/>
            <ColumnDefinition Width="9"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="ArtworkBorder" Width="44" Height="44" CornerRadius="7" ClipToBounds="True" Background="#18FFFFFF">
            <Grid>
                <ui:SymbolIcon x:Name="ArtworkPlaceholder" Symbol="MusicNote220" FontSize="24"/>
                <Image x:Name="ArtworkImage" Stretch="Uniform"/>
            </Grid>
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="96" MaxWidth="240">
            <TextBlock Text="{DynamicResource Loc.Panel.Notification.NowPlaying}" FontSize="11" Opacity="0.58"/>
            <TextBlock x:Name="TitleText" Margin="0,2,0,0" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ArtistText" Margin="0,2,0,0" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Grid>
</UserControl>
