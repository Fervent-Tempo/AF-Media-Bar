<ContextMenu x:Class="AFMediaBar.Components.AFContextMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="280"
             Padding="4"
             StaysOpen="False"
             FontFamily="{DynamicResource AppTextFontFamily}"
             FontWeight="{DynamicResource AppTextFontWeight}"
             Background="{DynamicResource AppMenuBackgroundBrush}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
             BorderThickness="1"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <ui:MenuItem x:Name="SessionsMenuItem"
                 Header="{DynamicResource Loc.Common.SwitchMediaSource}"
                 Icon="{ui:SymbolIcon MusicNote216}" />

    <Separator />

    <ui:MenuItem Header="{DynamicResource Loc.Common.ReconnectSmtc}"
                 Icon="{ui:SymbolIcon ArrowSync24}"
                 Command="{Binding ReconnectMediaSessionCommand}" />

    <ui:MenuItem x:Name="ReloadTaskbarHostMenuItem"
                 Header="{DynamicResource Loc.Common.ReloadTaskbarHost}"
                 Icon="{ui:SymbolIcon ArrowSync24}"

                 Click="ReloadTaskbarHostMenuItem_Click" />

    <ui:MenuItem Header="{Binding PlacementTarget.DataContext.ViewModel.UpdateMenuHeader}"
                 Icon="{ui:SymbolIcon ArrowSync24}"
                 IsEnabled="{Binding PlacementTarget.DataContext.ViewModel.IsUpdateMenuEnabled}"
                 Command="{Binding UpdateMenuCommand}" />

    <ui:MenuItem Header="{DynamicResource Loc.Common.Settings}"
                 Icon="{ui:SymbolIcon Settings24}"
                 Command="{Binding OpenSettingsCommand}" />

    <Separator />

    <ui:MenuItem Header="{DynamicResource Loc.Common.Exit}"
                 Icon="{ui:SymbolIcon ArrowExit20}"
                 Command="{Binding ExitApplicationCommand}" />

</ContextMenu>
