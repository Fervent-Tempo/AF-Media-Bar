<StackPanel x:Class="AFMediaBar.Components.AFContextMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <StackPanel.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </StackPanel.Resources>

    <ui:MenuItem x:Name="SessionsMenuItem"
                 Header="{DynamicResource Loc.Common.SwitchMediaSource}"
                 Icon="{ui:SymbolIcon MusicNote216}" />

    <ui:MenuItem x:Name="QuickLaunchMenuItem"
                 Header="{DynamicResource Loc.Common.Group.QuickLaunch}"
                 Icon="{ui:SymbolIcon Rocket24}" />

    <Separator />

    <ui:MenuItem Header="{DynamicResource Loc.Common.ReconnectSmtc}"
                 Icon="{ui:SymbolIcon ArrowSync24}"
                 Command="{Binding ViewModel.ReconnectMediaSessionCommand}" />

    <ui:MenuItem x:Name="ReloadTaskbarHostMenuItem"
                 Header="{DynamicResource Loc.Common.ReloadTaskbarHost}"
                 Icon="{ui:SymbolIcon ArrowSync24}"
                 Click="ReloadTaskbarHostMenuItem_Click" />

    <ui:MenuItem Header="{Binding ViewModel.UpdateMenuHeader}"
                 Icon="{ui:SymbolIcon ArrowSync24}"
                 Visibility="{Binding ViewModel.IsUpdateMenuVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                 Click="UpdateMenuItem_Click" />

    <ui:MenuItem Header="{DynamicResource Loc.Common.Settings}"
                 Icon="{ui:SymbolIcon Settings24}"
                 Command="{Binding OpenSettingsCommand}" />

    <Separator />

    <ui:MenuItem Header="{DynamicResource Loc.Common.Exit}"
                 Icon="{ui:SymbolIcon ArrowExit20}"
                 Command="{Binding ExitApplicationCommand}" />

</StackPanel>
