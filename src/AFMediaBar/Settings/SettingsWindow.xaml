<ui:FluentWindow x:Class="AFMediaBar.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:editorViews="clr-namespace:AFMediaBar.LayoutEditor.Wpf.Views;assembly=AFMediaBar.LayoutEditor.Wpf"
        Title="{DynamicResource Settings.WindowTitle}"
        Icon="/AFMediaBar;component/icon.ico"
        Width="1020"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        Background="{DynamicResource MenuBackgroundBrush}"
        Foreground="{DynamicResource MenuPrimaryTextBrush}"
        FontFamily="{DynamicResource AppTextFontFamily}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Unknown" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="/AFMediaBar;component/Resources/Themes/Settings.Fluent.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{DynamicResource MenuBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="SettingsTitleBar"
                 Grid.Row="0"
                 Panel.ZIndex="2"
                 Title="{DynamicResource Settings.WindowTitle}"
                 HorizontalContentAlignment="Center">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="/AFMediaBar;component/icon.ico" />
      </ui:TitleBar.Icon>
      <ui:TitleBar.CenterContent>
        <Grid Width="360" VerticalAlignment="Center">
          <TextBox x:Name="SearchBox"
                   Height="34"
                   Padding="12,6"
                   ToolTip="{DynamicResource Settings.Search.Placeholder}"
                   TextChanged="SearchBox_OnTextChanged" />
          <TextBlock x:Name="SearchPlaceholder"
                     Margin="12,0"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     Foreground="{DynamicResource MenuSecondaryTextBrush}"
                     Text="{DynamicResource Settings.Search.Placeholder}" />
        </Grid>
      </ui:TitleBar.CenterContent>
    </ui:TitleBar>

    <Grid Grid.Row="1" Margin="4,0,4,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding NavigationPaneWidth}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0"
              Padding="4,0,8,0"
              BorderBrush="{DynamicResource MenuSeparatorBrush}"
              BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ui:Button x:Name="NavigationPaneToggle"
                     Width="44"
                     Height="40"
                     HorizontalAlignment="Left"
                     Appearance="Transparent"
                     ToolTip="{DynamicResource Settings.Categories}"
                     Command="{Binding ToggleNavigationPaneCommand}">
            <ui:SymbolIcon x:Name="NavigationPaneIcon" Symbol="PanelLeftContract20" />
          </ui:Button>
          <ListBox x:Name="NavigationList"
                   Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemContainerStyle="{StaticResource SettingsNavigationItemStyle}"
                   SelectedIndex="0"
                   SelectionChanged="NavigationList_OnSelectionChanged">
            <ListBoxItem Tag="General" ToolTip="{DynamicResource Settings.Nav.General}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Width="32" Symbol="Settings24" />
                <TextBlock Text="{DynamicResource Settings.Nav.General}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Layout" ToolTip="{DynamicResource Settings.Nav.Layout}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Width="32" Symbol="ArrowMove24" />
                <TextBlock Text="{DynamicResource Settings.Nav.Layout}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="LayoutEditor" ToolTip="{DynamicResource Settings.Nav.LayoutEditor}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Width="32" Symbol="GridDots24" />
                <TextBlock Text="{DynamicResource Settings.Nav.LayoutEditor}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Appearance" ToolTip="{DynamicResource Settings.Nav.Appearance}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Width="32" Symbol="Color24" />
                <TextBlock Text="{DynamicResource Settings.Nav.Appearance}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Interaction" ToolTip="{DynamicResource Settings.Nav.Interaction}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Width="32" Symbol="CursorHover24" />
                <TextBlock Text="{DynamicResource Settings.Nav.Interaction}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Performance" ToolTip="{DynamicResource Settings.Nav.Performance}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Width="32" Symbol="Gauge24" />
                <TextBlock Text="{DynamicResource Settings.Nav.Performance}" />
              </StackPanel>
            </ListBoxItem>
          </ListBox>
        </Grid>
      </Border>

      <ScrollViewer x:Name="SettingsPageScrollViewer"
                    Grid.Column="1"
                    Margin="18,12,8,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    SizeChanged="SettingsPageScrollViewer_OnSizeChanged">
        <Grid MaxWidth="1000" Margin="0,0,12,24" HorizontalAlignment="Stretch">
          <StackPanel x:Name="SearchResultsPage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Settings.Search.Results}" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock x:Name="SearchResultsSummaryText"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <ListBox x:Name="SearchResultsList"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource SettingsSearchResultItemStyle}"
                     SelectionChanged="SearchResults_OnSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               Foreground="{DynamicResource MenuPrimaryTextBrush}" />
                    <TextBlock Grid.Column="1"
                               Margin="18,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource MenuSecondaryTextBrush}"
                               Text="{Binding PageTitle}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="SearchEmptyText"
                       Text="{DynamicResource Settings.Search.NoResults}"
                       Visibility="Collapsed"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
          </StackPanel>

          <StackPanel x:Name="GeneralPage">
            <TextBlock Text="{DynamicResource Settings.Nav.General}" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="{DynamicResource Settings.General.Description}"
                       Margin="0,6,0,18"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon ShareScreenStart24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.General.AutoStartTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.General.AutoStartDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <CheckBox x:Name="StartupCheckBox" Style="{StaticResource SettingsCardToggleStyle}" Checked="GeneralCheckBox_OnChanged" Unchecked="GeneralCheckBox_OnChanged" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon EyeOff24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.General.HideWhenNoMediaTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.General.HideWhenNoMediaDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <CheckBox x:Name="HideWhenNoMediaCheckBox" Style="{StaticResource SettingsCardToggleStyle}" Checked="WindowCheckBox_OnChanged" Unchecked="WindowCheckBox_OnChanged" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon Globe24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Language.SectionTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Language.Description}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <WrapPanel MaxWidth="520">
                  <RadioButton x:Name="LanguageFollowSystemRadioButton" Content="{DynamicResource Settings.Language.FollowSystem}" GroupName="LanguageMode" Style="{StaticResource SettingsSegmentStyle}" Checked="LanguageRadio_OnChanged" />
                  <RadioButton x:Name="LanguageZhCnRadioButton" Content="{DynamicResource Settings.Language.ZhCn}" GroupName="LanguageMode" Style="{StaticResource SettingsSegmentStyle}" Checked="LanguageRadio_OnChanged" />
                  <RadioButton x:Name="LanguageZhTwRadioButton" Content="{DynamicResource Settings.Language.ZhTw}" GroupName="LanguageMode" Style="{StaticResource SettingsSegmentStyle}" Checked="LanguageRadio_OnChanged" />
                  <RadioButton x:Name="LanguageEnUsRadioButton" Content="{DynamicResource Settings.Language.EnUs}" GroupName="LanguageMode" Style="{StaticResource SettingsSegmentStyle}" Checked="LanguageRadio_OnChanged" />
              </WrapPanel>
            </ui:CardControl>

            <TextBlock Text="{DynamicResource Settings.General.Update}" Style="{StaticResource SettingsSectionTitleStyle}" />
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon ArrowSync24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.General.AutoCheckUpdateTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.General.AutoCheckUpdateDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <CheckBox x:Name="AutomaticUpdateChecksCheckBox"
                        Style="{StaticResource SettingsCardToggleStyle}"
                        Checked="UpdateCheckSetting_OnChanged"
                        Unchecked="UpdateCheckSetting_OnChanged" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon ArrowDownload24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.General.CheckUpdate}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock x:Name="UpdateStatusText"
                             Text="{DynamicResource Settings.General.CheckUpdateHint}"
                             Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="CheckForUpdatesButton"
                        Content="{DynamicResource Settings.General.CheckUpdate}"
                        Style="{StaticResource SettingsActionButtonStyle}"
                        Click="CheckForUpdates_OnClick" />
                <Button x:Name="SkipUpdateButton"
                        Content="{DynamicResource Settings.General.IgnoreVersion}"
                        Visibility="Collapsed"
                        Style="{StaticResource SettingsActionButtonStyle}"
                        Click="SkipUpdate_OnClick" />
              </StackPanel>
            </ui:CardControl>
            <Border x:Name="UpdateDetailsPanel"
                     Margin="0,14,0,0"
                    Padding="12"
                    Background="{DynamicResource MenuHoverBrush}"
                    BorderBrush="{DynamicResource MenuBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="UpdateTitleText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MenuPrimaryTextBrush}" />
                <TextBlock x:Name="UpdateVersionText"
                           Style="{StaticResource SettingsRowDescriptionStyle}" />
                <TextBlock x:Name="UpdateChangelogText"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MenuPrimaryTextBrush}" />
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="GitHubDownloadButton"
                          Content="{DynamicResource Settings.General.DownloadGithub}"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                  <Button x:Name="QuarkDownloadButton"
                          Content="{DynamicResource Settings.General.DownloadQuark}"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                  <Button x:Name="BaiduDownloadButton"
                          Content="{DynamicResource Settings.General.DownloadBaidu}"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                  <Button x:Name="LanzouDownloadButton"
                          Content="{DynamicResource Settings.General.DownloadLanzou}"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                  <Button x:Name="ReleaseNotesButton"
                          Content="{DynamicResource Settings.General.ViewReleaseNotes}"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource Settings.General.About}" Style="{StaticResource SettingsSectionTitleStyle}" />
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon Info24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="AF Media Bar" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock x:Name="VersionText" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <WrapPanel MaxWidth="520">
                <Button Content="{DynamicResource Settings.General.OpenGitHub}" Tag="https://github.com/Fervent-Tempo/AF-Media-Bar" Style="{StaticResource SettingsActionButtonStyle}" Click="OpenLink_OnClick" />
                <Button Content="{DynamicResource Settings.General.ReportIssue}" Tag="https://github.com/Fervent-Tempo/AF-Media-Bar/issues" Style="{StaticResource SettingsActionButtonStyle}" Click="OpenLink_OnClick" />
                <Button Content="{DynamicResource Settings.General.License}" Tag="https://github.com/Fervent-Tempo/AF-Media-Bar/blob/main/LICENSE" Style="{StaticResource SettingsActionButtonStyle}" Click="OpenLink_OnClick" />
                <Button Content="{DynamicResource Settings.General.OpenLogFile}" Style="{StaticResource SettingsActionButtonStyle}" Click="OpenLogFile_OnClick" />
              </WrapPanel>
            </ui:CardControl>
            <TextBlock Text="{DynamicResource Settings.General.Reset}" Style="{StaticResource SettingsSectionTitleStyle}" />
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon ArrowReset24}">
              <ui:CardControl.Header>
                <TextBlock Text="{DynamicResource Settings.General.ResetAll}" Style="{StaticResource SettingsRowTitleStyle}" />
              </ui:CardControl.Header>
              <Button x:Name="ResetDefaultsButton" Content="{DynamicResource Settings.General.ResetAll}" Style="{StaticResource SettingsActionButtonStyle}" Click="ResetDefaults_OnClick" />
            </ui:CardControl>
          </StackPanel>

          <StackPanel x:Name="LayoutPage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Settings.Nav.Layout}" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="{DynamicResource Settings.Layout.Description}"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon WindowConsole20}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Layout.WindowMode}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Layout.WindowModeHint}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <WrapPanel MaxWidth="360">
                <RadioButton x:Name="TaskbarModeRadioButton" Content="{DynamicResource Settings.Layout.DockToTaskbar}" GroupName="HostMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
                <RadioButton x:Name="FloatingModeRadioButton" Content="{DynamicResource Settings.Layout.Floating}" GroupName="HostMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
              </WrapPanel>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon ArrowAutofitContent24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Layout.Arrangement}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Layout.ArrangementHint}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <WrapPanel MaxWidth="460">
                <RadioButton x:Name="AutomaticLayoutRadioButton" Content="{DynamicResource Settings.Common.Auto}" GroupName="LayoutMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
                <RadioButton x:Name="HorizontalLayoutRadioButton" Content="{DynamicResource Settings.Common.Horizontal}" GroupName="LayoutMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
                <RadioButton x:Name="VerticalLayoutRadioButton" Content="{DynamicResource Settings.Common.Vertical}" GroupName="LayoutMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
              </WrapPanel>
            </ui:CardControl>

            <TextBlock Text="{DynamicResource Settings.Layout.Size}" Style="{StaticResource SettingsSectionTitleStyle}" />
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon ResizeLarge24}">
              <ui:CardControl.Header>
                <TextBlock Text="{DynamicResource Settings.Layout.LengthScale}" Style="{StaticResource SettingsRowTitleStyle}" />
              </ui:CardControl.Header>
              <Grid Width="280">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                <Slider x:Name="LengthScaleSlider" Minimum="70" Maximum="125" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="ScaleSlider_OnValueChanged" />
                <TextBlock x:Name="LengthScaleValueText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" />
              </Grid>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon ResizeSmall24}">
              <ui:CardControl.Header>
                <TextBlock Text="{DynamicResource Settings.Layout.ThicknessScale}" Style="{StaticResource SettingsRowTitleStyle}" />
              </ui:CardControl.Header>
              <Grid Width="280">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                <Slider x:Name="ThicknessScaleSlider" Minimum="70" Maximum="125" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="ScaleSlider_OnValueChanged" />
                <TextBlock x:Name="ThicknessScaleValueText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" />
              </Grid>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon ArrowUp24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Layout.TopOffset}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Layout.TopOffsetDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <Grid Width="280">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                <Slider x:Name="TaskbarTopOffsetSlider" Minimum="-20" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ScaleSlider_OnValueChanged" />
                <TextBlock x:Name="TaskbarTopOffsetValueText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" />
              </Grid>
            </ui:CardControl>

            <TextBlock Text="{DynamicResource Settings.Layout.AvoidTaskbarTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon DesktopArrowRight24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Layout.AvoidTaskbarTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock x:Name="AutomaticPlacementDescription" Text="{DynamicResource Settings.Layout.AvoidTaskbarDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <CheckBox x:Name="AutomaticPlacementCheckBox" Style="{StaticResource SettingsCardToggleStyle}" Checked="PlacementCheckBox_OnChanged" Unchecked="PlacementCheckBox_OnChanged" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon LockClosed24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Layout.LockPositionTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Layout.LockPositionDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <CheckBox x:Name="LockPositionCheckBox" Style="{StaticResource SettingsCardToggleStyle}" Checked="PlacementCheckBox_OnChanged" Unchecked="PlacementCheckBox_OnChanged" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon ArrowReset24}">
              <ui:CardControl.Header>
                <TextBlock Text="{DynamicResource Settings.Layout.ResetPosition}" Style="{StaticResource SettingsRowTitleStyle}" />
              </ui:CardControl.Header>
              <Button Content="{DynamicResource Settings.Layout.ResetPosition}" Style="{StaticResource SettingsActionButtonStyle}" Click="ResetPosition_OnClick" />
            </ui:CardControl>
          </StackPanel>

          <Grid x:Name="LayoutEditorPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Settings.Nav.LayoutEditor}" Style="{StaticResource SettingsPageTitleStyle}" />
                <TextBlock Text="{DynamicResource Settings.Layout.EditorDescription}"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap"
                           Style="{StaticResource SettingsRowDescriptionStyle}" />
              </StackPanel>
              <TextBlock x:Name="LayoutEditorContextText"
                         Grid.Column="1"
                         Margin="16,4,0,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource MenuPrimaryTextBrush}" />
            </Grid>
            <DockPanel Grid.Row="1" Margin="0,0,0,8">
              <WrapPanel DockPanel.Dock="Right">
                <Button x:Name="LayoutUndoButton"
                        Content="{DynamicResource Settings.Layout.EditorUndo}"
                        Style="{StaticResource SettingsActionButtonStyle}"
                        Command="{Binding UndoCommand}" />
                <Button x:Name="LayoutRedoButton"
                        Content="{DynamicResource Settings.Layout.EditorRedo}"
                        Style="{StaticResource SettingsActionButtonStyle}"
                        Command="{Binding RedoCommand}" />
                <Button x:Name="LayoutResetProfileButton"
                        Content="{DynamicResource Settings.Layout.EditorResetProfile}"
                        Style="{StaticResource SettingsActionButtonStyle}"
                        Click="LayoutResetProfileButton_OnClick" />
              </WrapPanel>
              <TextBlock Text="{DynamicResource Settings.Layout.EditorPalette}"
                         VerticalAlignment="Center"
                         Style="{StaticResource SettingsRowDescriptionStyle}" />
            </DockPanel>
            <Grid Grid.Row="2" MinHeight="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="190" />
                <RowDefinition Height="8" />
                <RowDefinition Height="2*" MinHeight="150" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="260" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        MinHeight="0"
                        Padding="8"
                        Background="{DynamicResource MenuHoverBrush}"
                        BorderBrush="{DynamicResource MenuBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        AllowDrop="False">
                  <Border x:Name="LayoutVisualEditorHost"
                          AllowDrop="False" />
                </Border>
                <Grid Grid.Column="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ToggleButton x:Name="LayoutTreeToggleButton"
                                Grid.Column="0"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsChecked="True"
                                Style="{StaticResource SettingsIconToggleButtonStyle}"
                                Content="&#xE76B;"
                                FontFamily="{StaticResource AppIconFontFamily}"
                                ToolTip="{DynamicResource Settings.Layout.EditorToggleTree}"
                                Checked="LayoutTreeToggleButton_OnToggled"
                                Unchecked="LayoutTreeToggleButton_OnToggled" />
                  <Border x:Name="LayoutObjectTreePanel"
                          Grid.Column="1"
                          Width="220"
                          Padding="8"
                          Background="{DynamicResource MenuHoverBrush}"
                          BorderBrush="{DynamicResource MenuBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6"
                          PreviewMouseLeftButtonDown="LayoutEditorOutsidePreview_OnPreviewMouseLeftButtonDown">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="{DynamicResource Settings.Layout.EditorObjects}"
                                 FontWeight="SemiBold"
                                 Margin="2,0,0,6" />
                      <editorViews:LayoutTreeView Grid.Row="1"
                                                  DataContext="{Binding}"
                                                  ItemSelected="LayoutTreeView_OnItemSelected" />
                      <TreeView x:Name="LayoutObjectTree"
                                Grid.Row="1"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource LayoutTreeViewItemStyle}"
                                SelectedItemChanged="LayoutObjectTree_OnSelectedItemChanged">
                        <TreeView.Resources>
                          <Style TargetType="TreeViewItem" BasedOn="{StaticResource LayoutTreeViewItemStyle}" />
                        </TreeView.Resources>
                      </TreeView>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="5*" MinWidth="280" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="4*" MinWidth="240" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Padding="8"
                        Background="{DynamicResource MenuHoverBrush}"
                        BorderBrush="{DynamicResource MenuBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        PreviewMouseLeftButtonDown="LayoutEditorOutsidePreview_OnPreviewMouseLeftButtonDown">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <editorViews:ComponentPaletteView x:Name="LayoutPaletteView"
                                                      DataContext="{Binding}"
                                                      ItemInvoked="LayoutPaletteView_OnItemInvoked"
                                                      ItemDragRequested="LayoutPaletteView_OnItemDragRequested" />
                    <TabControl x:Name="LayoutComponentCategories"
                                Visibility="Collapsed"
                                Style="{StaticResource LayoutCategoryTabControlStyle}" />
                  </Grid>
                </Border>
                <Border Grid.Column="2"
                        Padding="8"
                        Background="{DynamicResource MenuHoverBrush}"
                        BorderBrush="{DynamicResource MenuBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        PreviewMouseLeftButtonDown="LayoutEditorOutsidePreview_OnPreviewMouseLeftButtonDown">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBlock x:Name="LayoutEditorSelectionText"
                                 Text="{DynamicResource Settings.Layout.EditorNoSelection}"
                                 Style="{StaticResource SettingsRowDescriptionStyle}"
                                 Margin="0,0,0,8" />
                      <WrapPanel>
                        <Button x:Name="LayoutRemoveButton"
                                Content="{DynamicResource Settings.Layout.EditorRemove}"
                                Style="{StaticResource SettingsActionButtonStyle}"
                                Click="LayoutRemoveButton_OnClick" />
                      </WrapPanel>
                      <TextBlock x:Name="LayoutEditorMessageText"
                                 Margin="0,6,0,10"
                                 Style="{StaticResource SettingsRowDescriptionStyle}" />
                      <TextBlock Text="{DynamicResource Settings.Layout.EditorProperties}"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,6" />
                      <editorViews:LayoutInspectorView Margin="0,0,0,8" />
                      <Border x:Name="LayoutPropertyHost" />
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Grid>
          </Grid>

          <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Settings.Nav.Appearance}" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="{DynamicResource Settings.Appearance.Description}"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <TextBlock Text="{DynamicResource Settings.Appearance.Fonts}" Style="{StaticResource SettingsSectionTitleStyle}" />
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon TextFont24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Appearance.Fonts}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Appearance.FontsHint}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <Grid Width="300">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Appearance.LatinFont}" Margin="0,0,0,4" Style="{StaticResource SettingsRowDescriptionStyle}" />
                  <ComboBox x:Name="FontLatinComboBox" SelectionChanged="FontComboBox_OnSelectionChanged">
                    <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontSegoeUi}" />
                    <ComboBoxItem Content="Arial" />
                    <ComboBoxItem Content="Calibri" />
                    <ComboBoxItem Content="Verdana" />
                    <ComboBoxItem Content="Consolas" />
                    <ComboBoxItem Content="Times New Roman" />
                    <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontFollowCjk}" />
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{DynamicResource Settings.Appearance.CjkFont}" Margin="0,0,0,4" Style="{StaticResource SettingsRowDescriptionStyle}" />
                  <ComboBox x:Name="FontCjkComboBox" SelectionChanged="FontComboBox_OnSelectionChanged">
                    <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontSystemDefault}" />
                    <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontMsYaHei}" />
                    <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontDengXian}" />
                    <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontSimSun}" />
                    <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontSimHei}" />
                    <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontKaiTi}" />
                    <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontFangSong}" />
                  </ComboBox>
                </StackPanel>
              </Grid>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon TextFontSize24}">
              <ui:CardControl.Header>
                <TextBlock Text="{DynamicResource Settings.Appearance.FontWeight}" Style="{StaticResource SettingsRowTitleStyle}" />
              </ui:CardControl.Header>
              <Grid Width="280">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                <Slider x:Name="FontWeightSlider" Style="{StaticResource SettingsHorizontalSliderStyle}" Minimum="300" Maximum="900" TickFrequency="50" IsSnapToTickEnabled="False" ValueChanged="FontWeightSlider_OnValueChanged" />
                <TextBlock x:Name="FontWeightValueText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" />
              </Grid>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon TextCaseTitle24}">
              <ui:CardControl.Header>
                <TextBlock Text="{DynamicResource Settings.Appearance.FontPreview}" Style="{StaticResource SettingsRowTitleStyle}" />
              </ui:CardControl.Header>
              <TextBlock x:Name="FontPreviewText" Text="{DynamicResource Settings.Appearance.FontPreview}" FontSize="14" Foreground="{DynamicResource MenuPrimaryTextBrush}" />
            </ui:CardControl>

            <TextBlock Text="{DynamicResource Settings.Appearance.PlayerText}" Style="{StaticResource SettingsSectionTitleStyle}" />
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon TextColor24}">
              <ui:CardControl.Header>
                <TextBlock Text="{DynamicResource Settings.Appearance.PlayerText}" Style="{StaticResource SettingsRowTitleStyle}" />
              </ui:CardControl.Header>
              <WrapPanel MaxWidth="430">
                <RadioButton x:Name="AutomaticForegroundRadioButton" Content="{DynamicResource Settings.Common.Auto}" GroupName="ForegroundMode" Style="{StaticResource SettingsSegmentStyle}" Checked="ThemeRadio_OnChanged" />
                <RadioButton x:Name="LightForegroundRadioButton" Content="{DynamicResource Settings.Appearance.LightText}" GroupName="ForegroundMode" Style="{StaticResource SettingsSegmentStyle}" Checked="ThemeRadio_OnChanged" />
                <RadioButton x:Name="DarkForegroundRadioButton" Content="{DynamicResource Settings.Appearance.DarkText}" GroupName="ForegroundMode" Style="{StaticResource SettingsSegmentStyle}" Checked="ThemeRadio_OnChanged" />
              </WrapPanel>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon Eye24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Appearance.ReadabilityTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Appearance.ReadabilityDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <CheckBox x:Name="EnhancedReadabilityCheckBox" Style="{StaticResource SettingsCardToggleStyle}" Checked="ThemeCheckBox_OnChanged" Unchecked="ThemeCheckBox_OnChanged" />
            </ui:CardControl>

            <TextBlock Text="{DynamicResource Settings.Appearance.MenuTheme}" Style="{StaticResource SettingsSectionTitleStyle}" />
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon Color24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Appearance.MenuTheme}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Appearance.MenuThemeHint}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <WrapPanel MaxWidth="380">
                <RadioButton x:Name="AutomaticMenuThemeRadioButton" Content="{DynamicResource Settings.Common.Auto}" GroupName="MenuThemeMode" Style="{StaticResource SettingsSegmentStyle}" Checked="MenuThemeRadio_OnChanged" />
                <RadioButton x:Name="LightMenuThemeRadioButton" Content="{DynamicResource Settings.Common.Light}" GroupName="MenuThemeMode" Style="{StaticResource SettingsSegmentStyle}" Checked="MenuThemeRadio_OnChanged" />
                <RadioButton x:Name="DarkMenuThemeRadioButton" Content="{DynamicResource Settings.Common.Dark}" GroupName="MenuThemeMode" Style="{StaticResource SettingsSegmentStyle}" Checked="MenuThemeRadio_OnChanged" />
              </WrapPanel>
            </ui:CardControl>
          </StackPanel>

          <StackPanel x:Name="InteractionPage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Settings.Nav.Interaction}" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="{DynamicResource Settings.Interaction.Description}"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon WindowMultiple20}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Interaction.TopMostTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Interaction.TopMostDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <CheckBox x:Name="AlwaysOnTopCheckBox" Style="{StaticResource SettingsCardToggleStyle}" Checked="WindowCheckBox_OnChanged" Unchecked="WindowCheckBox_OnChanged" />
            </ui:CardControl>
          </StackPanel>

          <StackPanel x:Name="PerformancePage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Settings.Nav.Performance}" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="{DynamicResource Settings.Performance.Description}"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon Gauge24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Performance.LowPerfTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Performance.LowPerfDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </ui:CardControl.Header>
              <CheckBox x:Name="LowGpuModeCheckBox" Style="{StaticResource SettingsCardToggleStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged" />
            </ui:CardControl>
            <TextBlock Text="{DynamicResource Settings.Performance.Diagnostics}" Style="{StaticResource SettingsSectionTitleStyle}" />
            <ui:CardControl Margin="0,0,0,3" Icon="{ui:SymbolIcon PlugConnected24}">
              <ui:CardControl.Header>
                <TextBlock Text="{DynamicResource Settings.Performance.Reconnect}" Style="{StaticResource SettingsRowTitleStyle}" />
              </ui:CardControl.Header>
              <Button Content="{DynamicResource Settings.Performance.Reconnect}" Style="{StaticResource SettingsActionButtonStyle}" Click="Reconnect_OnClick" />
            </ui:CardControl>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</ui:FluentWindow>
