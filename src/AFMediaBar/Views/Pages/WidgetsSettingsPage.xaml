<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:AFMediaBar.Components" xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="AFMediaBar.Views.Pages.WidgetsSettingsPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="SpectrumParameterRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Setter Property="IsEnabled" Value="{Binding ViewModel.Components.CanConfigureSpectrum}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.Components.CanConfigureSpectrum}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Media.Badge.EnableFirst}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PerformanceParameterRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Setter Property="IsEnabled" Value="{Binding ViewModel.Components.CanConfigurePerformance}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.Components.CanConfigurePerformance}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Media.Badge.EnableFirst}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ForegroundPreviewTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="{DynamicResource AppTextStrongFontWeight}"/>
            <Setter Property="Text" Value="AF Media Bar"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Taskbar.PlayerForegroundMode}" Value="Automatic">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Taskbar.PlayerForegroundMode}" Value="LightText">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Taskbar.PlayerForegroundMode}" Value="DarkText">
                    <Setter Property="Foreground" Value="#FF1A1A1A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ForegroundPreviewOnLightTextStyle" BasedOn="{StaticResource ForegroundPreviewTextStyle}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Taskbar.PlayerForegroundMode}" Value="Automatic">
                    <Setter Property="Foreground" Value="#FF1A1A1A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}"/>
        <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}"/>
    </Page.Resources>
    <components:SettingsPageLayout x:Name="PageLayout">
        <components:SettingsPageLayout.Header>
            <components:SettingsGroupStrip Title="{DynamicResource Loc.Settings.Page.NoteAndLaunch}" Subtitle="{DynamicResource Loc.Settings.Page.WidgetsSettings.Description}" PageIcon="{ui:SymbolIcon MusicNote220}" Target="{Binding ScrollViewer, ElementName=PageLayout}"/>
        </components:SettingsPageLayout.Header>
        <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded">
            <components:SettingsGroup GroupId="Widgets.Note" Header="{DynamicResource Loc.Widgets.Note}" Icon="{ui:SymbolIcon MusicNote220}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Settings.Group.LaunchActions}" Style="{StaticResource AfSettingsSubsectionTitleStyle}"/>
                    <components:SettingsRow Icon="{ui:SymbolIcon MusicNote220}" Title="{DynamicResource Loc.Widgets.Note.Interaction.Title}" Description="{DynamicResource Loc.Widgets.Note.Interaction.Description}">
                        <ComboBox SelectedValue="{Binding ViewModel.Note.InteractionMode, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="{StaticResource AfSettingsSelectMinWidth}">
                            <ComboBoxItem Content="{DynamicResource Loc.Widgets.Note.Interaction.List}" Tag="{x:Static settings:QuickLaunchInteractionMode.ListLaunch}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.Widgets.Note.Interaction.Select}" Tag="{x:Static settings:QuickLaunchInteractionMode.SelectThenLaunch}"/>
                        </ComboBox>
                    </components:SettingsRow>
                    <components:SettingsRow Icon="{ui:SymbolIcon MusicNote220}" Title="{DynamicResource Loc.Widgets.Note.HoverIcon.Title}" Description="{DynamicResource Loc.Widgets.Note.HoverIcon.Description}" Visibility="{Binding ViewModel.Note.IsSelectThenLaunch, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.Note.ShowApplicationIconOnHover, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.Media.QuickLaunch.FromNote.Description}" Icon="{ui:SymbolIcon MusicNote220}" Title="{DynamicResource Loc.Media.QuickLaunch.FromNote.Title}">
                        <ui:Button Click="BrowseQuickLaunch_Click" Content="{DynamicResource Loc.Media.QuickLaunch.Browse}" Icon="{ui:SymbolIcon FolderOpen24}" Style="{StaticResource AfSettingsButtonStyle}"/>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.Media.QuickLaunch.Entries.Description}" Icon="{ui:SymbolIcon AppsListDetail24}" Title="{DynamicResource Loc.Media.QuickLaunch.Entries.Title}">
                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.Note.QuickLaunchEntryCountText}"/>
                    </components:SettingsRow>
                    <AdornerDecorator>
                        <ItemsControl Style="{StaticResource AfSettingsSortableListStyle}" components:SettingsReorderBehavior.MoveCommand="{Binding ViewModel.Note.ReorderQuickLaunchCommand}" ItemsSource="{Binding ViewModel.Note.QuickLaunchEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <components:SettingsRow KeepControlInline="True" Description="{Binding Target}" IsNested="True" Title="{Binding DisplayName}" Icon="{ui:SymbolIcon MusicNote220}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Margin="4,0,0,0" Command="{Binding DataContext.ViewModel.Note.RemoveQuickLaunchCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Delete24}" Style="{StaticResource AfSettingsIconButtonStyle}" ToolTip="{DynamicResource Loc.Media.QuickLaunch.Remove}"/>
                                            <components:SettingsReorderHandle ItemKey="{Binding Id}"/>
                                        </StackPanel>
                                    </components:SettingsRow>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </AdornerDecorator>
                    <Border Margin="0,4,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AfSettingsInfoSurfaceStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.Note.StatusText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ViewModel.Note.StatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource AfSettingsStatusTextStyle}" Text="{Binding ViewModel.Note.StatusText}"/>
                    </Border>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Appearance.IdleNote.Title" Header="{DynamicResource Loc.Appearance.IdleNote.Title}" Description="{DynamicResource Loc.Appearance.IdleNote.Description}" Icon="{ui:SymbolIcon MusicNote220}" Visibility="{Binding HasTaskbarSettings, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                <StackPanel>
                    <components:SettingsRow Title="{DynamicResource Loc.Appearance.IdleNote.Custom}" Description="{DynamicResource Loc.Appearance.IdleNote.Hint}" Icon="{ui:SymbolIcon Color24}">
                        <ui:ToggleSwitch IsChecked="{Binding Taskbar.UseCustomIdleNoteColor, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <Border Style="{StaticResource AfSettingsInfoSurfaceStyle}" Margin="0,4,0,0" Visibility="{Binding Taskbar.UseCustomIdleNoteColor, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Background="#0078D4" Margin="0,0,6,0" ToolTip="#0078D4" Style="{StaticResource AfSettingsColorSwatchStyle}" Command="{Binding Taskbar.SetIdleNoteColorCommand}" CommandParameter="#0078D4"/>
                                <Button Background="#FF8A8A" Margin="0,0,6,0" ToolTip="#FF8A8A" Style="{StaticResource AfSettingsColorSwatchStyle}" Command="{Binding Taskbar.SetIdleNoteColorCommand}" CommandParameter="#FF8A8A"/>
                                <Button Background="#F7C948" Margin="0,0,6,0" ToolTip="#F7C948" Style="{StaticResource AfSettingsColorSwatchStyle}" Command="{Binding Taskbar.SetIdleNoteColorCommand}" CommandParameter="#F7C948"/>
                                <Button Background="#42CBA6" Margin="0,0,6,0" ToolTip="#42CBA6" Style="{StaticResource AfSettingsColorSwatchStyle}" Command="{Binding Taskbar.SetIdleNoteColorCommand}" CommandParameter="#42CBA6"/>
                                <Button Background="#9C7CFF" Margin="0,0,6,0" ToolTip="#9C7CFF" Style="{StaticResource AfSettingsColorSwatchStyle}" Command="{Binding Taskbar.SetIdleNoteColorCommand}" CommandParameter="#9C7CFF"/>
                                <Button Background="#FFFFFF" ToolTip="#FFFFFF" Style="{StaticResource AfSettingsColorSwatchStyle}" Command="{Binding Taskbar.SetIdleNoteColorCommand}" CommandParameter="#FFFFFF"/>
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource AfSettingsActionsStyle}">
                                <TextBlock Text="{DynamicResource Loc.Appearance.Accent.HexLabel}" VerticalAlignment="Center"/>
                                <TextBox Width="110" Margin="8,0,0,0" MaxLength="9" Text="{Binding Taskbar.IdleNoteColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <ui:Button Margin="{StaticResource AfSettingsActionGap}" Content="{DynamicResource Loc.Appearance.IdleNote.FollowAccent}" Command="{Binding Taskbar.ResetIdleNoteColorCommand}" Style="{StaticResource AfSettingsButtonStyle}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <WrapPanel Style="{StaticResource AfSettingsRelatedLinksStyle}">
                        <components:SettingsNavigationButton Content="{DynamicResource Loc.Settings.Related.RestContent}" Destination="Components" GroupId="Common.RestLayer"/>
                    </WrapPanel>
                </StackPanel>
            </components:SettingsGroup>
            <ui:Button Content="{DynamicResource Loc.Common.ResetPageDefaults}" Style="{StaticResource AfSettingsButtonStyle}" Click="ResetButton_Click" HorizontalAlignment="Left" Margin="0,0,0,20"/>
        </StackPanel>
    </components:SettingsPageLayout>
</Page>
