<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Class="AFMediaBar.Views.Pages.AppearancePage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="ForegroundPreviewTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="{DynamicResource AppTextStrongFontWeight}" />
            <Setter Property="Text" Value="AF Media Bar" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Taskbar.PlayerForegroundMode}" Value="Automatic">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Taskbar.PlayerForegroundMode}" Value="LightText">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Taskbar.PlayerForegroundMode}" Value="DarkText">
                    <Setter Property="Foreground" Value="#FF1A1A1A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ForegroundPreviewOnLightTextStyle" BasedOn="{StaticResource ForegroundPreviewTextStyle}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Taskbar.PlayerForegroundMode}" Value="Automatic">
                    <Setter Property="Foreground" Value="#FF1A1A1A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <components:SettingsGroupStrip
            Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            Grid.Row="0"
            PageIcon="{ui:SymbolIcon PaintBrush24}"
            Subtitle="{DynamicResource Loc.Appearance.Unified.Header.Subtitle}"
            Target="{Binding ElementName=PageScroll}"
            Title="{DynamicResource Loc.Common.Page.Appearance}" />
        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PageRoot" MaxWidth="{StaticResource AfSettingsContentMaxWidth}" Loaded="OnPageLoaded" Unloaded="OnPageUnloaded">
                <components:SettingsGroup
                    GroupId="Common.Group.ThemeAndBackdrop"
                    Header="{DynamicResource Loc.Common.Group.ThemeAndBackdrop}"
                    Icon="{ui:SymbolIcon Color24}"
                    Description="{DynamicResource Loc.Appearance.Scope.Global}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.Theme.Description}"
                            Icon="{ui:SymbolIcon Color24}"
                            Title="{DynamicResource Loc.Appearance.Row.Theme.Title}">
                            <ComboBox
                                MinWidth="180"
                                SelectedValue="{Binding ViewModel.ApplicationThemeMode, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Theme.Automatic}"
                                    Tag="{x:Static settings:ApplicationThemeMode.Automatic}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Theme.Light}"
                                    Tag="{x:Static settings:ApplicationThemeMode.Light}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Theme.Dark}"
                                    Tag="{x:Static settings:ApplicationThemeMode.Dark}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.Backdrop.Description}"
                            Icon="{ui:SymbolIcon WindowConsole20}"
                            Title="{DynamicResource Loc.Appearance.Row.Backdrop.Title}">
                            <ComboBox MinWidth="180" SelectedValue="{Binding ViewModel.BackdropMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Backdrop.Solid}"
                                    Tag="{x:Static settings:ApplicationBackdropMode.FluentSolid}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Backdrop.Mica}"
                                    Tag="{x:Static settings:ApplicationBackdropMode.Mica}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Backdrop.MicaAlt}"
                                    Tag="{x:Static settings:ApplicationBackdropMode.MicaAlt}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Backdrop.Acrylic}"
                                    Tag="{x:Static settings:ApplicationBackdropMode.Acrylic}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <Border Style="{StaticResource AfSettingsInfoSurfaceStyle}" Margin="0,2,0,4">
                            <TextBlock
                                Style="{StaticResource AfSettingsHintTextStyle}"
                                Text="{DynamicResource Loc.Appearance.BackdropTint.Hint}" />
                        </Border>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.Accent.Description}"
                            Icon="{ui:SymbolIcon ColorBackground20}"
                            Title="{DynamicResource Loc.Appearance.Row.Accent.Title}">
                            <ComboBox MinWidth="180" SelectedValue="{Binding ViewModel.AccentColorMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Accent.FollowSystem}"
                                    Tag="{x:Static settings:AccentColorMode.System}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Accent.Custom}"
                                    Tag="{x:Static settings:AccentColorMode.Custom}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <Border
                            Margin="0,4,0,0"
                            Padding="14,12"
                            Background="{DynamicResource AfSettingsInfoSurfaceBrush}"
                            BorderBrush="{DynamicResource AfSettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding ViewModel.IsCustomAccent, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                    Text="{DynamicResource Loc.Appearance.Accent.PaletteLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#0078D4"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#0078D4"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#0078D4"
                                        ToolTip="#0078D4" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#0099BC"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#0099BC"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#0099BC"
                                        ToolTip="#0099BC" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#107C10"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#107C10"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#107C10"
                                        ToolTip="#107C10" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#876400"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#876400"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#876400"
                                        ToolTip="#876400" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#C42B1C"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#C42B1C"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#C42B1C"
                                        ToolTip="#C42B1C" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#E3008C"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#E3008C"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#E3008C"
                                        ToolTip="#E3008C" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#881798"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#881798"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#881798"
                                        ToolTip="#881798" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#7C3AED"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#7C3AED"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#7C3AED"
                                        ToolTip="#7C3AED" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#4A545E"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#4A545E"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#4A545E"
                                        ToolTip="#4A545E" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        Background="#767676"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#767676"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#767676"
                                        ToolTip="#767676" />
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                        Text="{DynamicResource Loc.Appearance.Accent.HexLabel}" />
                                    <TextBox
                                        Width="110"
                                        Margin="8,0,0,0"
                                        Text="{Binding ViewModel.AccentColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AfSettingsInfoSurfaceStyle}" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource AfSettingsHintTextStyle}" Text="{DynamicResource Loc.Appearance.Accent.Hint}" />
                        </Border>
                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            IsExpanded="False"
                            Icon="{ui:SymbolIcon CircleHalfFill24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock
                                        Style="{StaticResource AfSettingsRowTitleStyle}"
                                        Text="{DynamicResource Loc.Settings.Advanced.Backdrop.Title}" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                        Text="{DynamicResource Loc.Settings.Advanced.Backdrop.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Appearance.Row.BackdropTint.Description}"
                                    Icon="{ui:SymbolIcon CircleHalfFill24}"
                                    Title="{DynamicResource Loc.Appearance.Row.BackdropTint.Title}">
                                    <components:SettingsNumericEditor
                                        Value="{Binding ViewModel.BackdropTintOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="{Binding Source={x:Static settings:AppearanceSettings.MinimumBackdropTintOpacityPercent}}"
                                        Maximum="{Binding Source={x:Static settings:AppearanceSettings.MaximumBackdropTintOpacityPercent}}"
                                        Step="{Binding Source={x:Static settings:AppearanceSettings.BackdropTintOpacityStep}}"
                                        Unit="{DynamicResource Loc.Settings.Numeric.Percent}" />
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>
                        <Border Style="{StaticResource AfSettingsInfoSurfaceStyle}" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource AfSettingsHintTextStyle}" Text="{Binding ViewModel.MotionDetailText}" />
                        </Border>
                    </StackPanel>
                </components:SettingsGroup>
                <components:SettingsGroup
                    GroupId="Common.Group.Fonts"
                    Header="{DynamicResource Loc.Common.Group.Fonts}"
                    Icon="{ui:SymbolIcon TextFont24}"
                    Description="{DynamicResource Loc.Appearance.Scope.Fonts}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.LatinFont.Description}"
                            Icon="{ui:SymbolIcon TextFont24}"
                            Title="{DynamicResource Loc.Appearance.Row.LatinFont.Title}">
                            <ComboBox
                                MinWidth="200"
                                MaxDropDownHeight="360"
                                ItemsSource="{Binding ViewModel.LatinFontChoices}"
                                SelectedValue="{Binding ViewModel.LatinFontFamily, Mode=TwoWay}"
                                SelectedValuePath="Name">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,2,7,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{DynamicResource Loc.Appearance.Font.PreviewLabel}" />
                                                <TextBlock
                                                    FontFamily="{Binding PreviewFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding PreviewText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.CjkFont.Description}"
                            Icon="{ui:SymbolIcon LocalLanguage24}"
                            Title="{DynamicResource Loc.Appearance.Row.CjkFont.Title}">
                            <ComboBox
                                MinWidth="200"
                                MaxDropDownHeight="360"
                                ItemsSource="{Binding ViewModel.CjkFontChoices}"
                                SelectedValue="{Binding ViewModel.CjkFontFamily, Mode=TwoWay}"
                                SelectedValuePath="Name">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,2,7,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{DynamicResource Loc.Appearance.Font.PreviewLabel}" />
                                                <TextBlock
                                                    FontFamily="{Binding PreviewFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding PreviewText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.FontWeight.Description}"
                            Icon="{ui:SymbolIcon TextBold24}"
                            Title="{DynamicResource Loc.Appearance.Row.FontWeight.Title}">
                            <components:SettingsNumericEditor
                                Value="{Binding ViewModel.FontWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="{Binding Source={x:Static settings:AppearanceSettings.MinimumFontWeight}}"
                                Maximum="{Binding Source={x:Static settings:AppearanceSettings.MaximumFontWeight}}"
                                Step="{Binding Source={x:Static settings:AppearanceSettings.FontWeightStep}}" />
                        </components:SettingsRow>
                        <Border
                            Margin="0,4,0,0"
                            Padding="16,13"
                            Background="{DynamicResource AfSettingsInfoSurfaceBrush}"
                            BorderBrush="{DynamicResource AfSettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                    Text="{DynamicResource Loc.Appearance.Specimen.Label}" />
                                <TextBlock
                                    FontFamily="{DynamicResource AppTextFontFamily}"
                                    FontSize="20"
                                    FontWeight="{DynamicResource AppTextFontWeight}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource Loc.Appearance.Specimen.Line1}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="{DynamicResource AppTextFontFamily}"
                                    FontSize="16"
                                    FontWeight="{DynamicResource AppTextFontWeight}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource Loc.Appearance.Specimen.Line2}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="{DynamicResource AppTextFontFamily}"
                                    FontSize="13"
                                    FontWeight="{DynamicResource AppTextFontWeight}"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{DynamicResource Loc.Appearance.Specimen.Line3}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </components:SettingsGroup>
                <components:SettingsGroup
                    GroupId="Common.Group.MediaBarText"
                    Header="{DynamicResource Loc.Common.Group.MediaBarText}"
                    Icon="{ui:SymbolIcon TextColor24}"
                    Visibility="{Binding HasTaskbarSettings, Converter={StaticResource AfBooleanToVisibilityConverter}}"
                    Description="{DynamicResource Loc.Appearance.Scope.Taskbar}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.MediaFontSize.Description}"
                            Icon="{ui:SymbolIcon TextFont24}"
                            Title="{DynamicResource Loc.Appearance.Row.MediaFontSize.Title}">
                            <components:SettingsNumericEditor
                                Value="{Binding Taskbar.MediaFontSizePercent, Mode=TwoWay}"
                                Minimum="{Binding Source={x:Static settings:TaskbarExperienceSettings.MinimumMediaFontSizePercent}}"
                                Maximum="{Binding Source={x:Static settings:TaskbarExperienceSettings.MaximumMediaFontSizePercent}}"
                                Step="{Binding Source={x:Static settings:TaskbarExperienceSettings.MediaFontSizeStepPercent}}"
                                Unit="{DynamicResource Loc.Settings.Numeric.Percent}" />
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.TextColor.Description}"
                            Icon="{ui:SymbolIcon TextColor24}"
                            Title="{DynamicResource Loc.Appearance.Row.TextColor.Title}">
                            <ComboBox MinWidth="200" SelectedValue="{Binding Taskbar.PlayerForegroundMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.TextColor.Automatic}"
                                    Tag="{x:Static settings:PlayerForegroundMode.Automatic}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.TextColor.LightText}"
                                    Tag="{x:Static settings:PlayerForegroundMode.LightText}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.TextColor.DarkText}"
                                    Tag="{x:Static settings:PlayerForegroundMode.DarkText}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="14,10" Background="#FF202020" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ForegroundPreviewTextStyle}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="#B3FFFFFF"
                                        Text="{DynamicResource Loc.Appearance.Preview.DarkWallpaper}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="14,10" Background="#FFF2F2F2" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ForegroundPreviewOnLightTextStyle}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="#B3000000"
                                        Text="{DynamicResource Loc.Appearance.Preview.LightWallpaper}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource AfSettingsInfoSurfaceStyle}" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource AfSettingsHintTextStyle}" Text="{DynamicResource Loc.Appearance.Preview.Hint}" />
                        </Border>
                    </StackPanel>
                </components:SettingsGroup>
                <components:SettingsGroup
                    GroupId="Appearance.Group.TaskbarBackground"
                    Header="{DynamicResource Loc.Appearance.Group.TaskbarBackground}"
                    Icon="{ui:SymbolIcon Blur24}"
                    Visibility="{Binding HasTaskbarSettings, Converter={StaticResource AfBooleanToVisibilityConverter}}"
                    Description="{DynamicResource Loc.Appearance.Scope.Taskbar}">
                    <StackPanel>
                        <components:SettingsRow
                            Title="{DynamicResource Loc.Appearance.Row.TaskbarBackground.Title}"
                            Description="{DynamicResource Loc.Appearance.Row.TaskbarBackground.Description}"
                            Icon="{ui:SymbolIcon Blur24}">
                            <ui:ToggleSwitch IsChecked="{Binding Taskbar.UseFrostedTaskbarBackground, Mode=TwoWay}" />
                        </components:SettingsRow>
                        <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon Options24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock
                                        Style="{StaticResource AfSettingsRowTitleStyle}"
                                        Text="{DynamicResource Loc.Appearance.TaskbarBackground.Details.Title}" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                        Text="{DynamicResource Loc.Appearance.TaskbarBackground.Details.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.Appearance.Background.Prerequisite}" Margin="0,0,0,8">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource AfSettingsHintTextStyle}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Taskbar.UseFrostedTaskbarBackground}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Appearance.Row.TaskbarFrostedStyle.Description}"
                                    Icon="{ui:SymbolIcon Color24}"
                                    IsEnabled="{Binding Taskbar.UseFrostedTaskbarBackground}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Appearance.Row.TaskbarFrostedStyle.Title}">
                                    <ComboBox
                                        MinWidth="180"
                                        SelectedValue="{Binding Taskbar.TaskbarFrostedStyle, Mode=TwoWay}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem
                                            Content="{DynamicResource Loc.Appearance.TaskbarFrostedStyle.Neutral}"
                                            Tag="{x:Static settings:TaskbarFrostedStyle.Neutral}" />
                                        <ComboBoxItem
                                            Content="{DynamicResource Loc.Appearance.TaskbarFrostedStyle.Cool}"
                                            Tag="{x:Static settings:TaskbarFrostedStyle.Cool}" />
                                        <ComboBoxItem
                                            Content="{DynamicResource Loc.Appearance.TaskbarFrostedStyle.Warm}"
                                            Tag="{x:Static settings:TaskbarFrostedStyle.Warm}" />
                                        <ComboBoxItem
                                            Content="{DynamicResource Loc.Appearance.TaskbarFrostedStyle.Artwork}"
                                            Tag="{x:Static settings:TaskbarFrostedStyle.Artwork}" />
                                    </ComboBox>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Appearance.Row.TaskbarBackgroundOpacity.Description}"
                                    Icon="{ui:SymbolIcon CircleHalfFill24}"
                                    IsEnabled="{Binding Taskbar.UseFrostedTaskbarBackground}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Appearance.Row.TaskbarBackgroundOpacity.Title}">
                                    <components:SettingsNumericEditor
                                        Unit="%"
                                        Value="{Binding Taskbar.TaskbarBackgroundOpacityPercent, Mode=TwoWay}"
                                        Minimum="{Binding Source={x:Static settings:AppearanceSettings.MinimumTaskbarBackgroundOpacityPercent}}"
                                        Maximum="{Binding Source={x:Static settings:AppearanceSettings.MaximumTaskbarBackgroundOpacityPercent}}"
                                        Step="{Binding Source={x:Static settings:AppearanceSettings.TaskbarBackgroundOpacityStep}}" />
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>
                <ui:Button
                    Margin="0,16,0,40"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="{DynamicResource Loc.Common.ResetPageDefaults}"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
