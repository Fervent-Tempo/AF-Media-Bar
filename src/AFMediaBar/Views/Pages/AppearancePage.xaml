<Page x:Class="AFMediaBar.Views.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:AFMediaBar.Classes.Converters"
      xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1100"
      Title="AppearancePage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <converters:GenericEnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    <StackPanel MaxWidth="1000"
                Margin="16"
                VerticalAlignment="Center"
                TextElement.FontFamily="{DynamicResource AppTextFontFamily}"
                TextElement.FontWeight="{DynamicResource AppTextFontWeight}">
        <TextBlock Text="外观"
                   FontSize="32"
                   FontWeight="{DynamicResource AppTextStrongFontWeight}" />
        <ui:TextBlock Text="调整字体、文字颜色和应用主题"
                      Appearance="Secondary"
                      Margin="0,8,0,28" />

        <TextBlock Text="字体"
                   FontSize="18"
                   FontWeight="{DynamicResource AppTextStrongFontWeight}"
                   Margin="0,0,0,12" />
        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon TextFont24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="界面字体"
                                  FontWeight="{DynamicResource AppTextStrongFontWeight}" />
                    <ui:TextBlock Text="分别选择西文和中文字体"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <Grid Width="320">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox SelectedValuePath="Tag"
                          SelectedValue="{Binding ViewModel.LatinFont, Mode=TwoWay}">
                    <ComboBoxItem Content="Segoe UI" Tag="{x:Static settings:LatinFontPreset.SegoeUi}" />
                    <ComboBoxItem Content="Arial" Tag="{x:Static settings:LatinFontPreset.Arial}" />
                    <ComboBoxItem Content="Calibri" Tag="{x:Static settings:LatinFontPreset.Calibri}" />
                    <ComboBoxItem Content="Verdana" Tag="{x:Static settings:LatinFontPreset.Verdana}" />
                    <ComboBoxItem Content="Consolas" Tag="{x:Static settings:LatinFontPreset.Consolas}" />
                    <ComboBoxItem Content="Times New Roman" Tag="{x:Static settings:LatinFontPreset.TimesNewRoman}" />
                </ComboBox>
                <ComboBox Grid.Column="2"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding ViewModel.CjkFont, Mode=TwoWay}">
                    <ComboBoxItem Content="跟随系统" Tag="{x:Static settings:CjkFontPreset.SystemDefault}" />
                    <ComboBoxItem Content="微软雅黑" Tag="{x:Static settings:CjkFontPreset.MicrosoftYaHei}" />
                    <ComboBoxItem Content="等线" Tag="{x:Static settings:CjkFontPreset.DengXian}" />
                    <ComboBoxItem Content="宋体" Tag="{x:Static settings:CjkFontPreset.SimSun}" />
                    <ComboBoxItem Content="黑体" Tag="{x:Static settings:CjkFontPreset.SimHei}" />
                    <ComboBoxItem Content="楷体" Tag="{x:Static settings:CjkFontPreset.KaiTi}" />
                    <ComboBoxItem Content="仿宋" Tag="{x:Static settings:CjkFontPreset.FangSong}" />
                </ComboBox>
            </Grid>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon TextFontSize24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="字重"
                                  FontWeight="{DynamicResource AppTextStrongFontWeight}" />
                    <ui:TextBlock Text="调整界面文字的粗细"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <Grid Width="280">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>
                <Slider Minimum="300"
                        Maximum="900"
                        TickFrequency="50"
                        IsSnapToTickEnabled="True"
                        Value="{Binding ViewModel.FontWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ViewModel.FontWeight}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="14" />
            </Grid>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,24"
                        Icon="{ui:SymbolIcon TextCaseTitle24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="字体预览"
                                  FontWeight="{DynamicResource AppTextStrongFontWeight}" />
                    <ui:TextBlock Text="预览当前选择的字体效果"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <TextBlock Text="The quick brown fox 敏捷的棕色狐狸"
                       FontSize="16"
                       FontFamily="{DynamicResource AppTextFontFamily}"
                       FontWeight="{DynamicResource AppTextFontWeight}" />
        </ui:CardControl>

        <TextBlock Text="播放器文字"
                   FontSize="18"
                   FontWeight="{DynamicResource AppTextStrongFontWeight}"
                   Margin="0,0,0,12" />
        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon TextColor24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="文字颜色"
                                  FontWeight="{DynamicResource AppTextStrongFontWeight}" />
                    <ui:TextBlock Text="选择媒体栏文字的颜色模式"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="自动"
                             GroupName="ForegroundMode"
                             IsChecked="{Binding ViewModel.PlayerForegroundMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Automatic}"
                             Command="{Binding ViewModel.SetPlayerForegroundModeCommand}"
                             CommandParameter="{x:Static settings:PlayerForegroundMode.Automatic}"
                             Margin="0,0,12,0" />
                <RadioButton Content="浅色文字"
                             GroupName="ForegroundMode"
                             IsChecked="{Binding ViewModel.PlayerForegroundMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LightText}"
                             Command="{Binding ViewModel.SetPlayerForegroundModeCommand}"
                             CommandParameter="{x:Static settings:PlayerForegroundMode.LightText}"
                             Margin="0,0,12,0" />
                <RadioButton Content="深色文字"
                             GroupName="ForegroundMode"
                             IsChecked="{Binding ViewModel.PlayerForegroundMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DarkText}"
                             Command="{Binding ViewModel.SetPlayerForegroundModeCommand}"
                             CommandParameter="{x:Static settings:PlayerForegroundMode.DarkText}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,24"
                        Icon="{ui:SymbolIcon Eye24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="增强可读性"
                                  FontWeight="{DynamicResource AppTextStrongFontWeight}" />
                    <ui:TextBlock Text="为文字增加背景以提升对比度"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding ViewModel.EnhancedReadability, Mode=TwoWay}" />
        </ui:CardControl>

        <TextBlock Text="应用主题"
                   FontSize="18"
                   FontWeight="{DynamicResource AppTextStrongFontWeight}"
                   Margin="0,0,0,12" />
        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon Color24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="应用主题"
                                  FontWeight="{DynamicResource AppTextStrongFontWeight}" />
                    <ui:TextBlock Text="选择整个程序界面的明暗外观"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="自动"
                             GroupName="ApplicationThemeMode"
                             IsChecked="{Binding ViewModel.ApplicationThemeMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Automatic}"
                             Command="{Binding ViewModel.SetApplicationThemeModeCommand}"
                             CommandParameter="{x:Static settings:ApplicationThemeMode.Automatic}"
                             Margin="0,0,12,0" />
                <RadioButton Content="浅色"
                             GroupName="ApplicationThemeMode"
                             IsChecked="{Binding ViewModel.ApplicationThemeMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light}"
                             Command="{Binding ViewModel.SetApplicationThemeModeCommand}"
                             CommandParameter="{x:Static settings:ApplicationThemeMode.Light}"
                             Margin="0,0,12,0" />
                <RadioButton Content="深色"
                             GroupName="ApplicationThemeMode"
                             IsChecked="{Binding ViewModel.ApplicationThemeMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark}"
                             Command="{Binding ViewModel.SetApplicationThemeModeCommand}"
                             CommandParameter="{x:Static settings:ApplicationThemeMode.Dark}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon WindowConsole20}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="背景材质"
                                  FontWeight="{DynamicResource AppTextStrongFontWeight}" />
                    <ui:TextBlock Text="统一设置窗口、托盘弹窗和右键菜单的背景效果"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Fluent 纯色"
                             GroupName="BackdropMode"
                             IsChecked="{Binding ViewModel.BackdropMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=FluentSolid}"
                             Command="{Binding ViewModel.SetBackdropModeCommand}"
                             CommandParameter="{x:Static settings:ApplicationBackdropMode.FluentSolid}"
                             Margin="0,0,12,0" />
                <RadioButton Content="Mica 云母"
                             GroupName="BackdropMode"
                             IsChecked="{Binding ViewModel.BackdropMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Mica}"
                             Command="{Binding ViewModel.SetBackdropModeCommand}"
                             CommandParameter="{x:Static settings:ApplicationBackdropMode.Mica}"
                             Margin="0,0,12,0" />
                <RadioButton Content="Acrylic 亚克力"
                             GroupName="BackdropMode"
                             IsChecked="{Binding ViewModel.BackdropMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Acrylic}"
                             Command="{Binding ViewModel.SetBackdropModeCommand}"
                             CommandParameter="{x:Static settings:ApplicationBackdropMode.Acrylic}" />
            </StackPanel>
        </ui:CardControl>
    </StackPanel>
</Page>
