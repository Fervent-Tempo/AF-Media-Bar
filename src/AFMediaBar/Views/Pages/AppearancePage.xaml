<Page
    x:Class="AFMediaBar.Views.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <!--
        外观页 / Appearance page

        四个分组：字体、主题与材质、播放器文字、灵动岛表面（未实现）。全部是一行一个选项。

        上一版把字体、字重和字样预览合并成一张纵向大卡，又给主题/材质/文字颜色用了分段药丸；
        现在字体的三项各占一行，枚举项统一用下拉框，预览与对照图作为该分组的插图放在行下方。
        Four groups: font, theme and material, player text, and the unimplemented island surface. Every one of
        them is one option per row.

        The previous version merged font, weight, and specimen into one tall stacked card and used segmented
        pills for theme, material, and text colour. Now the three font settings each own a row, enumerations use
        selects, and the specimen and contrast preview sit below the rows as that group's illustration.
    -->

    <Page.Resources>
        <!--
            对照预览：两块模拟背景，用来展示当前文字颜色选项在深色与浅色壁纸上的结果。
            这里的黑白色是刻意的硬编码——它模拟的是任意壁纸，而不是主题表面，因此不应该跟随主题。
            Contrast preview: two simulated backdrops showing what the chosen text colour produces on a dark and
            a light wallpaper. White and black are deliberately hardcoded because they simulate an arbitrary
            wallpaper rather than a themed surface, and must not follow the theme.
        -->
        <Style x:Key="ForegroundPreviewTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="{DynamicResource AppTextStrongFontWeight}" />
            <Setter Property="Text" Value="AF Media Bar" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.PlayerForegroundMode}" Value="Automatic">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.PlayerForegroundMode}" Value="LightText">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.PlayerForegroundMode}" Value="DarkText">
                    <Setter Property="Foreground" Value="#FF1A1A1A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="ForegroundPreviewOnLightTextStyle"
            BasedOn="{StaticResource ForegroundPreviewTextStyle}"
            TargetType="{x:Type TextBlock}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.PlayerForegroundMode}" Value="Automatic">
                    <Setter Property="Foreground" Value="#FF1A1A1A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:SettingsGroupStrip
            Grid.Row="0"
            Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            PageIcon="{ui:SymbolIcon PaintBrush24}"
            Subtitle="{DynamicResource Loc.Appearance.Header.Subtitle}"
            Target="{Binding ElementName=PageScroll}"
            Title="{DynamicResource Loc.Common.Page.Appearance}" />

        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageRoot"
                MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
                Loaded="OnPageLoaded">

                <components:SettingsGroup Header="{DynamicResource Loc.Common.Group.Fonts}" Icon="{ui:SymbolIcon TextFont24}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.LatinFont.Description}"
                            Icon="{ui:SymbolIcon TextFont24}"
                            Title="{DynamicResource Loc.Appearance.Row.LatinFont.Title}">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.LatinFont, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.LatinFont.FollowSystem}" Tag="{x:Static settings:LatinFontPreset.SystemDefault}" />
                                <ComboBoxItem Content="Segoe UI" Tag="{x:Static settings:LatinFontPreset.SegoeUi}" />
                                <ComboBoxItem Content="Arial" Tag="{x:Static settings:LatinFontPreset.Arial}" />
                                <ComboBoxItem Content="Calibri" Tag="{x:Static settings:LatinFontPreset.Calibri}" />
                                <ComboBoxItem Content="Verdana" Tag="{x:Static settings:LatinFontPreset.Verdana}" />
                                <ComboBoxItem Content="Consolas" Tag="{x:Static settings:LatinFontPreset.Consolas}" />
                                <ComboBoxItem Content="Times New Roman" Tag="{x:Static settings:LatinFontPreset.TimesNewRoman}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.CjkFont.Description}"
                            Icon="{ui:SymbolIcon LocalLanguage24}"
                            Title="{DynamicResource Loc.Appearance.Row.CjkFont.Title}">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.CjkFont, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.CjkFont.FollowSystem}" Tag="{x:Static settings:CjkFontPreset.SystemDefault}" />
                                <ComboBoxItem Content="微软雅黑" Tag="{x:Static settings:CjkFontPreset.MicrosoftYaHei}" />
                                <ComboBoxItem Content="等线" Tag="{x:Static settings:CjkFontPreset.DengXian}" />
                                <ComboBoxItem Content="宋体" Tag="{x:Static settings:CjkFontPreset.SimSun}" />
                                <ComboBoxItem Content="黑体" Tag="{x:Static settings:CjkFontPreset.SimHei}" />
                                <ComboBoxItem Content="楷体" Tag="{x:Static settings:CjkFontPreset.KaiTi}" />
                                <ComboBoxItem Content="仿宋" Tag="{x:Static settings:CjkFontPreset.FangSong}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!--
                            上下限用 Binding 而不是 x:Static：x:Static 返回装箱的 int，
                            RangeBase.Maximum 需要 double，标记扩展不做这个转换，而绑定会。
                            The bounds use Binding rather than x:Static because x:Static yields a boxed int,
                            RangeBase.Maximum wants a double, and the markup extension performs no conversion
                            while the binding engine does.
                        -->
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.FontWeight.Description}"
                            Icon="{ui:SymbolIcon TextBold24}"
                            Title="{DynamicResource Loc.Appearance.Row.FontWeight.Title}">
                            <StackPanel Orientation="Horizontal">
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    Maximum="{Binding Source={x:Static settings:AppearanceSettings.MaximumFontWeight}}"
                                    Minimum="{Binding Source={x:Static settings:AppearanceSettings.MinimumFontWeight}}"
                                    Style="{StaticResource AfSettingsRowSliderStyle}"
                                    TickFrequency="{Binding Source={x:Static settings:AppearanceSettings.FontWeightStep}}"
                                    Value="{Binding ViewModel.FontWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.FontWeight}" />
                            </StackPanel>
                        </components:SettingsRow>

                        <Border
                            Margin="0,4,0,0"
                            Padding="16,13"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                    Text="{DynamicResource Loc.Appearance.Specimen.Label}" />
                                <TextBlock
                                    FontFamily="{DynamicResource AppTextFontFamily}"
                                    FontSize="20"
                                    FontWeight="{DynamicResource AppTextFontWeight}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="AF Media Bar · 你是我的一切" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="{DynamicResource AppTextFontFamily}"
                                    FontSize="16"
                                    FontWeight="{DynamicResource AppTextFontWeight}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="You are my everything · 君は私のすべて" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="{DynamicResource AppTextFontFamily}"
                                    FontSize="13"
                                    FontWeight="{DynamicResource AppTextFontWeight}"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="당신은 나의 전부 · You are my everything · 你是我的一切" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup Header="{DynamicResource Loc.Common.Group.ThemeAndBackdrop}" Icon="{ui:SymbolIcon Color24}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.Theme.Description}"
                            Icon="{ui:SymbolIcon Color24}"
                            Title="{DynamicResource Loc.Appearance.Row.Theme.Title}">
                            <ComboBox
                                MinWidth="180"
                                SelectedValue="{Binding ViewModel.ApplicationThemeMode, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Theme.Automatic}" Tag="{x:Static settings:ApplicationThemeMode.Automatic}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Theme.Light}" Tag="{x:Static settings:ApplicationThemeMode.Light}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Theme.Dark}" Tag="{x:Static settings:ApplicationThemeMode.Dark}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.Backdrop.Description}"
                            Icon="{ui:SymbolIcon WindowConsole20}"
                            Title="{DynamicResource Loc.Appearance.Row.Backdrop.Title}">
                            <ComboBox
                                MinWidth="180"
                                SelectedValue="{Binding ViewModel.BackdropMode, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Backdrop.Solid}" Tag="{x:Static settings:ApplicationBackdropMode.FluentSolid}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Backdrop.Mica}" Tag="{x:Static settings:ApplicationBackdropMode.Mica}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Backdrop.MicaAlt}" Tag="{x:Static settings:ApplicationBackdropMode.MicaAlt}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Backdrop.Acrylic}" Tag="{x:Static settings:ApplicationBackdropMode.Acrylic}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!--
                            材质浓度：只作用于"应用自己绘制材质"的两处（Windows 10 的窗口，以及永不激活的曲目通知）。
                            Windows 11 的云母/亚克力/Mica Alt 由 DWM 绘制，浓度对它无效，因此行说明里写清了适用面。
                            Material concentration: it only affects the two places where the application paints the material itself
                            (Windows 10 windows and the never-activating track notification). Mica, Acrylic, and Mica Alt on Windows 11
                            are painted by DWM and ignore it, which the row's description states.
                        -->
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.BackdropTint.Description}"
                            Icon="{ui:SymbolIcon CircleHalfFill24}"
                            Title="{DynamicResource Loc.Appearance.Row.BackdropTint.Title}">
                            <StackPanel Orientation="Horizontal">
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    Maximum="{Binding Source={x:Static settings:AppearanceSettings.MaximumBackdropTintOpacityPercent}}"
                                    Minimum="{Binding Source={x:Static settings:AppearanceSettings.MinimumBackdropTintOpacityPercent}}"
                                    Style="{StaticResource AfSettingsRowSliderStyle}"
                                    TickFrequency="{Binding Source={x:Static settings:AppearanceSettings.BackdropTintOpacityStep}}"
                                    Value="{Binding ViewModel.BackdropTintOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.BackdropTintOpacityPercent, StringFormat={}{0:0}%}" />
                            </StackPanel>
                        </components:SettingsRow>
                        <TextBlock
                            Margin="0,2,0,4"
                            Style="{StaticResource AfSettingsHintTextStyle}"
                            Text="{DynamicResource Loc.Appearance.BackdropTint.Hint}" />

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.Accent.Description}"
                            Icon="{ui:SymbolIcon ColorBackground20}"
                            Title="{DynamicResource Loc.Appearance.Row.Accent.Title}">
                            <ComboBox
                                MinWidth="180"
                                SelectedValue="{Binding ViewModel.AccentColorMode, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Accent.FollowSystem}" Tag="{x:Static settings:AccentColorMode.System}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Accent.Custom}" Tag="{x:Static settings:AccentColorMode.Custom}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!--
                            自选色板。这里的颜色是刻意的硬编码：色块展示的就是"用户正在挑选的那个颜色"，它按定义不是主题语义画刷，
                            与上面模拟任意壁纸的对照预览属于同一类例外。
                            Custom swatch strip. These colours are deliberately hardcoded: a swatch shows the very colour the user is
                            picking, which by definition is not a theme semantic brush, making it the same class of exception as the
                            wallpaper contrast preview above.
                        -->
                        <Border
                            Margin="0,4,0,0"
                            Padding="14,12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding ViewModel.IsCustomAccent, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                    Text="{DynamicResource Loc.Appearance.Accent.PaletteLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#0078D4"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#0078D4"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#0078D4"
                                        ToolTip="#0078D4" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#0099BC"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#0099BC"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#0099BC"
                                        ToolTip="#0099BC" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#107C10"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#107C10"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#107C10"
                                        ToolTip="#107C10" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#876400"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#876400"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#876400"
                                        ToolTip="#876400" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#C42B1C"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#C42B1C"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#C42B1C"
                                        ToolTip="#C42B1C" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#E3008C"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#E3008C"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#E3008C"
                                        ToolTip="#E3008C" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#881798"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#881798"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#881798"
                                        ToolTip="#881798" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#7C3AED"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#7C3AED"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#7C3AED"
                                        ToolTip="#7C3AED" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#4A545E"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#4A545E"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#4A545E"
                                        ToolTip="#4A545E" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        Background="#767676"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#767676"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#767676"
                                        ToolTip="#767676" />
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                        Text="{DynamicResource Loc.Appearance.Accent.HexLabel}" />
                                    <TextBox
                                        Width="110"
                                        Margin="8,0,0,0"
                                        Text="{Binding ViewModel.AccentColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource AfSettingsHintTextStyle}"
                            Text="{DynamicResource Loc.Appearance.Accent.Hint}" />

                        <components:SettingsRow
                            Badge="{Binding ViewModel.MotionModeText}"
                            BadgeTone="Accent"
                            Description="{Binding ViewModel.MotionDetailText}"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            Title="{DynamicResource Loc.Appearance.Row.Motion.Title}" />
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup Header="{DynamicResource Loc.Common.Group.MediaBarText}" Icon="{ui:SymbolIcon TextColor24}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.TextColor.Description}"
                            Icon="{ui:SymbolIcon TextColor24}"
                            Title="{DynamicResource Loc.Appearance.Row.TextColor.Title}">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.PlayerForegroundMode, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.TextColor.Automatic}" Tag="{x:Static settings:PlayerForegroundMode.Automatic}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.TextColor.LightText}" Tag="{x:Static settings:PlayerForegroundMode.LightText}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.TextColor.DarkText}" Tag="{x:Static settings:PlayerForegroundMode.DarkText}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!--
                            媒体文字大小原本在「显示模式 → 静置层」，但它是"媒体栏上的文字长什么样"，
                            与同组的颜色、字号、粗细属于同一件事，因此并入本页；取值范围不变。
                            The media text size used to live under Display Modes → Rest, but it describes how the media bar's text
                            looks, which is the same subject as this group's colour, typeface, and weight, so it moved here. Its range
                            is unchanged.
                        -->
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.MediaFontSize.Description}"
                            Icon="{ui:SymbolIcon TextFont24}"
                            Title="{DynamicResource Loc.Appearance.Row.MediaFontSize.Title}">
                            <StackPanel Orientation="Horizontal">
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    Maximum="125"
                                    Minimum="80"
                                    Style="{StaticResource AfSettingsRowSliderStyle}"
                                    TickFrequency="5"
                                    Value="{Binding ViewModel.MediaFontSizePercent, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.MediaFontSizePercent, StringFormat={}{0:0}%}" />
                            </StackPanel>
                        </components:SettingsRow>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Padding="14,10"
                                Background="#FF202020"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ForegroundPreviewTextStyle}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="#B3FFFFFF"
                                        Text="{DynamicResource Loc.Appearance.Preview.DarkWallpaper}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="2"
                                Padding="14,10"
                                Background="#FFF2F2F2"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ForegroundPreviewOnLightTextStyle}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="#B3000000"
                                        Text="{DynamicResource Loc.Appearance.Preview.LightWallpaper}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource AfSettingsHintTextStyle}"
                            Text="{DynamicResource Loc.Appearance.Preview.Hint}" />
                    </StackPanel>
                </components:SettingsGroup>

                <ui:Button
                    Margin="0,16,0,40"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="{DynamicResource Loc.Common.ResetPageDefaults}"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
