<Page x:Class="AFMediaBar.Views.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1100"
      Title="AppearancePage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <StackPanel MaxWidth="1000"
                Margin="16"
                VerticalAlignment="Center">
        <TextBlock Text="外观"
                   FontSize="32"
                   FontWeight="SemiBold" />
        <ui:TextBlock Text="调整字体、文字颜色和菜单主题"
                      Appearance="Secondary"
                      Margin="0,8,0,28" />

        <TextBlock Text="字体"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon TextFont24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="界面字体"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="分别选择西文和中文字体"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <Grid Width="320">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox SelectedIndex="0">
                    <ComboBoxItem Content="Segoe UI" />
                    <ComboBoxItem Content="Arial" />
                    <ComboBoxItem Content="Calibri" />
                    <ComboBoxItem Content="Verdana" />
                    <ComboBoxItem Content="Consolas" />
                    <ComboBoxItem Content="Times New Roman" />
                </ComboBox>
                <ComboBox Grid.Column="2"
                          SelectedIndex="0">
                    <ComboBoxItem Content="跟随系统" />
                    <ComboBoxItem Content="微软雅黑" />
                    <ComboBoxItem Content="等线" />
                    <ComboBoxItem Content="宋体" />
                    <ComboBoxItem Content="黑体" />
                    <ComboBoxItem Content="楷体" />
                    <ComboBoxItem Content="仿宋" />
                </ComboBox>
            </Grid>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon TextFontSize24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="字重"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="调整界面文字的粗细"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <Grid Width="280">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>
                <Slider Minimum="300"
                        Maximum="900"
                        TickFrequency="50"
                        Value="400" />
                <TextBlock Grid.Column="1"
                           Text="400"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="14" />
            </Grid>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,24"
                        Icon="{ui:SymbolIcon TextCaseTitle24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="字体预览"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="预览当前选择的字体效果"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <TextBlock Text="The quick brown fox 敏捷的棕色狐狸"
                       FontSize="16" />
        </ui:CardControl>

        <TextBlock Text="播放器文字"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon TextColor24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="文字颜色"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="选择媒体栏文字的颜色模式"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="自动"
                             GroupName="ForegroundMode"
                             IsChecked="True"
                             Margin="0,0,12,0" />
                <RadioButton Content="浅色文字"
                             GroupName="ForegroundMode"
                             Margin="0,0,12,0" />
                <RadioButton Content="深色文字"
                             GroupName="ForegroundMode" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,24"
                        Icon="{ui:SymbolIcon Eye24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="增强可读性"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="为文字增加背景以提升对比度"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch />
        </ui:CardControl>

        <TextBlock Text="菜单主题"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <ui:CardControl Icon="{ui:SymbolIcon Color24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="菜单主题"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="选择媒体栏菜单的明暗外观"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="自动"
                             GroupName="MenuThemeMode"
                             IsChecked="True"
                             Margin="0,0,12,0" />
                <RadioButton Content="浅色"
                             GroupName="MenuThemeMode"
                             Margin="0,0,12,0" />
                <RadioButton Content="深色"
                             GroupName="MenuThemeMode" />
            </StackPanel>
        </ui:CardControl>
    </StackPanel>
</Page>