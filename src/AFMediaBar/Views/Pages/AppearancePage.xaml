<Page
    x:Class="AFMediaBar.Views.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <!-- Taskbar appearance for the editor environment. -->

    <Page.Resources>
        <!--
            对照预览：两块模拟背景，用来展示当前文字颜色选项在深色与浅色壁纸上的结果。
            这里的黑白色是刻意的硬编码——它模拟的是任意壁纸，而不是主题表面，因此不应该跟随主题。
            Contrast preview: two simulated backdrops showing what the chosen text colour produces on a dark and
            a light wallpaper. White and black are deliberately hardcoded because they simulate an arbitrary
            wallpaper rather than a themed surface, and must not follow the theme.
        -->
        <Style x:Key="ForegroundPreviewTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="{DynamicResource AppTextStrongFontWeight}" />
            <Setter Property="Text" Value="AF Media Bar" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.PlayerForegroundMode}" Value="Automatic">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.PlayerForegroundMode}" Value="LightText">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.PlayerForegroundMode}" Value="DarkText">
                    <Setter Property="Foreground" Value="#FF1A1A1A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="ForegroundPreviewOnLightTextStyle"
            BasedOn="{StaticResource ForegroundPreviewTextStyle}"
            TargetType="{x:Type TextBlock}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.PlayerForegroundMode}" Value="Automatic">
                    <Setter Property="Foreground" Value="#FF1A1A1A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Fixed width becomes available when following content length is turned off. -->
        <Style
            x:Key="FixedLengthRowStyle"
            BasedOn="{StaticResource {x:Type components:SettingsRow}}"
            TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Setter Property="IsEnabled" Value="{Binding ViewModel.UsesFixedTaskbarLength}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.FollowMediaTextLength}" Value="True">
                    <Setter Property="Badge" Value="{DynamicResource Loc.DisplayModes.Width.Row.Fixed.Badge}" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:SettingsGroupStrip Margin="{StaticResource AfSettingsHeaderMargin}" MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            Grid.Row="0"
            PageIcon="{ui:SymbolIcon PaintBrush24}"
            Subtitle="{DynamicResource Loc.TaskbarAppearance.Header.Subtitle}"
            Target="{Binding ElementName=PageScroll}"
            Title="{DynamicResource Loc.Common.Page.TaskbarAppearance}" />

        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageRoot"
                MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
                Loaded="OnPageLoaded"
>






                <components:SettingsGroup GroupId="Common.Group.MediaBarText" Header="{DynamicResource Loc.Common.Group.MediaBarText}" Icon="{ui:SymbolIcon TextColor24}">
                    <StackPanel>
<components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.MediaFontSize.Description}"
                            Icon="{ui:SymbolIcon TextFont24}"
                            Title="{DynamicResource Loc.Appearance.Row.MediaFontSize.Title}">
                            <components:SettingsNumericEditor
                                    Value="{Binding ViewModel.MediaFontSizePercent, Mode=TwoWay}"
                                    Minimum="{Binding Source={x:Static settings:TaskbarExperienceSettings.MinimumMediaFontSizePercent}}"
                                    Maximum="{Binding Source={x:Static settings:TaskbarExperienceSettings.MaximumMediaFontSizePercent}}"
                                    Step="{Binding Source={x:Static settings:TaskbarExperienceSettings.MediaFontSizeStepPercent}}"
                                    Unit="{DynamicResource Loc.Settings.Numeric.Percent}" />
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.TextColor.Description}"
                            Icon="{ui:SymbolIcon TextColor24}"
                            Title="{DynamicResource Loc.Appearance.Row.TextColor.Title}">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.PlayerForegroundMode, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.TextColor.Automatic}" Tag="{x:Static settings:PlayerForegroundMode.Automatic}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.TextColor.LightText}" Tag="{x:Static settings:PlayerForegroundMode.LightText}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.TextColor.DarkText}" Tag="{x:Static settings:PlayerForegroundMode.DarkText}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!--
                            媒体文字大小原本在「显示模式 → 静置层」，但它是"媒体栏上的文字长什么样"，
                            与同组的颜色、字号、粗细属于同一件事，因此并入本页；取值范围不变。
                            The media text size used to live under Display Modes → Rest, but it describes how the media bar's text
                            looks, which is the same subject as this group's colour, typeface, and weight, so it moved here. Its range
                            is unchanged.
                        -->


                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Padding="14,10"
                                Background="#FF202020"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ForegroundPreviewTextStyle}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="#B3FFFFFF"
                                        Text="{DynamicResource Loc.Appearance.Preview.DarkWallpaper}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="2"
                                Padding="14,10"
                                Background="#FFF2F2F2"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ForegroundPreviewOnLightTextStyle}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="#B3000000"
                                        Text="{DynamicResource Loc.Appearance.Preview.LightWallpaper}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource AfSettingsInfoSurfaceStyle}" Margin="0,8,0,0"><TextBlock
                            Style="{StaticResource AfSettingsHintTextStyle}"
                            Text="{DynamicResource Loc.Appearance.Preview.Hint}" /></Border>

                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup GroupId="Common.Group.MediaBarWidth"
                    Description="{DynamicResource Loc.DisplayModes.Width.Group.Description}"
                    Header="{DynamicResource Loc.Common.Group.MediaBarWidth}"
                    Icon="{ui:SymbolIcon ResizeLarge24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="TaskbarLength" />

                        <components:SettingsRow
                            Description="{DynamicResource Loc.DisplayModes.Width.Row.Follow.Description}"
                            Icon="{ui:SymbolIcon ArrowAutofitWidth24}"
                            Title="{DynamicResource Loc.DisplayModes.Width.Row.Follow.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.FollowMediaTextLength, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.DisplayModes.Width.Row.Fixed.Description}"
                            Icon="{ui:SymbolIcon SlideSize24}"
                            Style="{StaticResource FixedLengthRowStyle}"
                            Title="{DynamicResource Loc.DisplayModes.Width.Row.Fixed.Title}">
                            <components:SettingsNumericEditor
                                    Value="{Binding ViewModel.FixedTaskbarLengthDip, Mode=TwoWay}"
                                    Minimum="{Binding ViewModel.FixedTaskbarLengthMinimum}"
                                    Maximum="{Binding ViewModel.FixedTaskbarLengthMaximum}"
                                    Step="1"
                                    IsSnapToTickEnabled="False"
                                    Unit="{DynamicResource Loc.Settings.Numeric.Dip}" />
                        </components:SettingsRow>


                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" IsExpanded="False" Icon="{ui:SymbolIcon PaddingLeft24}">
                            <ui:CardExpander.Header><StackPanel>
                                <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Settings.Advanced.Spacing.Title}" />
                                <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Settings.Advanced.Spacing.Description}" />
                            </StackPanel></ui:CardExpander.Header>
                            <StackPanel>
<components:SettingsRow
                            Description="{DynamicResource Loc.DisplayModes.Width.Row.Spacing.Description}"
                            Icon="{ui:SymbolIcon PaddingLeft24}"
                            Title="{DynamicResource Loc.DisplayModes.Width.Row.Spacing.Title}">
                            <components:SettingsNumericEditor
                                    Value="{Binding ViewModel.ComponentSpacingDip, Mode=TwoWay}"
                                    Minimum="{Binding Source={x:Static settings:TaskbarExperienceSettings.MinimumComponentSpacingDip}}"
                                    Maximum="{Binding Source={x:Static settings:TaskbarExperienceSettings.MaximumComponentSpacingDip}}"
                                    Step="1"
                                    Unit="{DynamicResource Loc.Settings.Numeric.Dip}" />
                        </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup GroupId="Appearance.Group.RestLayout" Visibility="{Binding ViewModel.IsHorizontalLayout, Converter={StaticResource AfBooleanToVisibilityConverter}}" Header="{DynamicResource Loc.Appearance.Group.RestLayout}" Icon="{ui:SymbolIcon LayoutColumnTwo24}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.DisplayModes.Rest.Row.Layout.Description}"
                            Icon="{ui:SymbolIcon LayoutColumnTwo24}"
                            Title="{DynamicResource Loc.DisplayModes.Rest.Row.Layout.Title}">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.ContentLayout, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.DisplayModes.Rest.ContentLayout.CompactInline}" Tag="{x:Static settings:TaskbarContentLayout.CompactInline}" />
                                <ComboBoxItem Content="{DynamicResource Loc.DisplayModes.Rest.ContentLayout.AdaptiveStack}" Tag="{x:Static settings:TaskbarContentLayout.AdaptiveStack}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.DisplayModes.Rest.Row.Alignment.Description}"
                            Icon="{ui:SymbolIcon TextAlignLeft24}"
                            Title="{DynamicResource Loc.DisplayModes.Rest.Row.Alignment.Title}">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.MediaTextAlignment, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Common.AlignLeft}" Tag="{x:Static settings:TaskbarMediaTextAlignment.Left}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Common.AlignCenter}" Tag="{x:Static settings:TaskbarMediaTextAlignment.Center}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Common.AlignRight}" Tag="{x:Static settings:TaskbarMediaTextAlignment.Right}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon ArrowSort24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.DisplayModes.Rest.Order.Expander.Title}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.DisplayModes.Rest.Order.Expander.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>

                            <StackPanel>
                                <components:SettingsCallout
                                    Margin="0,0,0,4"
                                    Symbol="Info24"
                                    Text="{DynamicResource Loc.DisplayModes.Rest.Order.Notice}" />

                                <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding ViewModel.RestOrderEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <components:SettingsRow
                                                Description="{Binding Description}"
                                                IsNested="True"
                                                Title="{Binding DisplayName}">
                                                <StackPanel Orientation="Horizontal">
                                                    <!--
                                                        固定在最前面的两行没有按钮：它们在提示条里说明了不参与排序，而一个点不动的按钮比没有按钮更难懂。
                                                        The two pinned rows carry no buttons: the callout says they take no part in ordering, and a button that does
                                                        nothing is harder to understand than no button at all.
                                                    -->
                                                    <ui:Button
                                                        Margin="8,0,0,0"
                                                        Command="{Binding DataContext.ViewModel.MoveRestComponentUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Icon="{ui:SymbolIcon ArrowUp24}"
                                                        Style="{StaticResource AfSettingsIconButtonStyle}"
                                                        ToolTip="{DynamicResource Loc.Lyrics.Sources.MoveUp}"
                                                        Visibility="{Binding CanMove, Converter={StaticResource AfBooleanToVisibilityConverter}}" />
                                                    <ui:Button
                                                        Margin="4,0,0,0"
                                                        Command="{Binding DataContext.ViewModel.MoveRestComponentDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Icon="{ui:SymbolIcon ArrowDown24}"
                                                        Style="{StaticResource AfSettingsIconButtonStyle}"
                                                        ToolTip="{DynamicResource Loc.Lyrics.Sources.MoveDown}"
                                                        Visibility="{Binding CanMove, Converter={StaticResource AfBooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </components:SettingsRow>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <components:SettingsRow
                                    Description="{DynamicResource Loc.DisplayModes.Rest.Order.Reset.Description}"
                                    Icon="{ui:SymbolIcon ArrowReset24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.DisplayModes.Rest.Order.Reset.Title}">
                                    <ui:Button
                                        Command="{Binding ViewModel.ResetRestComponentOrderCommand}"
                                        Content="{DynamicResource Loc.Lyrics.Sources.Reset.Action}"
                                        Icon="{ui:SymbolIcon ArrowReset24}"
                                        Style="{StaticResource AfSettingsButtonStyle}" />
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup GroupId="Appearance.Group.InteractionButtons" Header="{DynamicResource Loc.Appearance.Group.InteractionButtons}" Icon="{ui:SymbolIcon CursorClick24}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.InteractionButtonSize.Description}"
                            Icon="{ui:SymbolIcon TextAlignJustify24}"
                            Title="{DynamicResource Loc.Appearance.Row.InteractionButtonSize.Title}">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.InteractionButtonSize, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.DisplayModes.Rest.Density.Minimal}" Tag="{x:Static settings:TaskbarInformationDensity.Minimal}" />
                                <ComboBoxItem Content="{DynamicResource Loc.DisplayModes.Rest.Density.Balanced}" Tag="{x:Static settings:TaskbarInformationDensity.Balanced}" />
                                <ComboBoxItem Content="{DynamicResource Loc.DisplayModes.Rest.Density.Information}" Tag="{x:Static settings:TaskbarInformationDensity.Information}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.DisplayModes.Hover.Row.Spacing.Description}"
                            Icon="{ui:SymbolIcon PaddingLeft24}"
                            Title="{DynamicResource Loc.DisplayModes.Hover.Row.Spacing.Title}">
                            <components:SettingsNumericEditor
                                    Value="{Binding ViewModel.HoverButtonSpacingDip, Mode=TwoWay}"
                                    Minimum="0"
                                    Maximum="{Binding Source={x:Static settings:TaskbarExperienceSettings.MaximumHoverButtonSpacingDip}}"
                                    Step="1"
                                    Unit="{DynamicResource Loc.Settings.Numeric.Dip}" />
                        </components:SettingsRow>
                    </StackPanel>
                </components:SettingsGroup>

                <ui:Button
                    Margin="0,16,0,40"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="{DynamicResource Loc.Common.ResetPageDefaults}"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
