<Page
    x:Class="AFMediaBar.Views.Pages.ApplicationAppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <!-- Application-wide theme, materials and interface typography. -->



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:SettingsGroupStrip Margin="{StaticResource AfSettingsHeaderMargin}" MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            Grid.Row="0"
            PageIcon="{ui:SymbolIcon PaintBrush24}"
            Subtitle="{DynamicResource Loc.ApplicationAppearance.Header.Subtitle}"
            Target="{Binding ElementName=PageScroll}"
            Title="{DynamicResource Loc.Common.Page.ApplicationAppearance}" />

        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageRoot"
                MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
                Loaded="OnPageLoaded"
                Unloaded="OnPageUnloaded">




                <components:SettingsGroup Header="{DynamicResource Loc.Common.Group.ThemeAndBackdrop}" Icon="{ui:SymbolIcon Color24}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.Theme.Description}"
                            Icon="{ui:SymbolIcon Color24}"
                            Title="{DynamicResource Loc.Appearance.Row.Theme.Title}">
                            <ComboBox
                                MinWidth="180"
                                SelectedValue="{Binding ViewModel.ApplicationThemeMode, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Theme.Automatic}" Tag="{x:Static settings:ApplicationThemeMode.Automatic}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Theme.Light}" Tag="{x:Static settings:ApplicationThemeMode.Light}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Theme.Dark}" Tag="{x:Static settings:ApplicationThemeMode.Dark}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.Backdrop.Description}"
                            Icon="{ui:SymbolIcon WindowConsole20}"
                            Title="{DynamicResource Loc.Appearance.Row.Backdrop.Title}">
                            <ComboBox
                                MinWidth="180"
                                SelectedValue="{Binding ViewModel.BackdropMode, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Backdrop.Solid}" Tag="{x:Static settings:ApplicationBackdropMode.FluentSolid}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Backdrop.Mica}" Tag="{x:Static settings:ApplicationBackdropMode.Mica}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Backdrop.MicaAlt}" Tag="{x:Static settings:ApplicationBackdropMode.MicaAlt}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Backdrop.Acrylic}" Tag="{x:Static settings:ApplicationBackdropMode.Acrylic}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!--
                            材质浓度：只作用于"应用自己绘制材质"的两处（Windows 10 的窗口，以及永不激活的曲目通知）。
                            Windows 11 的云母/亚克力/Mica Alt 由 DWM 绘制，浓度对它无效，因此行说明里写清了适用面。
                            Material concentration: it only affects the two places where the application paints the material itself
                            (Windows 10 windows and the never-activating track notification). Mica, Acrylic, and Mica Alt on Windows 11
                            are painted by DWM and ignore it, which the row's description states.
                        -->

                        <Border Style="{StaticResource AfSettingsInfoSurfaceStyle}" Margin="0,2,0,4"><TextBlock
                            Style="{StaticResource AfSettingsHintTextStyle}"
                            Text="{DynamicResource Loc.Appearance.BackdropTint.Hint}" /></Border>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.Accent.Description}"
                            Icon="{ui:SymbolIcon ColorBackground20}"
                            Title="{DynamicResource Loc.Appearance.Row.Accent.Title}">
                            <ComboBox
                                MinWidth="180"
                                SelectedValue="{Binding ViewModel.AccentColorMode, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Accent.FollowSystem}" Tag="{x:Static settings:AccentColorMode.System}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Appearance.Accent.Custom}" Tag="{x:Static settings:AccentColorMode.Custom}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!--
                            自选色板。这里的颜色是刻意的硬编码：色块展示的就是"用户正在挑选的那个颜色"，它按定义不是主题语义画刷，
                            与上面模拟任意壁纸的对照预览属于同一类例外。
                            Custom swatch strip. These colours are deliberately hardcoded: a swatch shows the very colour the user is
                            picking, which by definition is not a theme semantic brush, making it the same class of exception as the
                            wallpaper contrast preview above.
                        -->
                        <Border
                            Margin="0,4,0,0"
                            Padding="14,12"
                            Background="{DynamicResource AfSettingsInfoSurfaceBrush}"
                            BorderBrush="{DynamicResource AfSettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding ViewModel.IsCustomAccent, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                    Text="{DynamicResource Loc.Appearance.Accent.PaletteLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#0078D4"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#0078D4"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#0078D4"
                                        ToolTip="#0078D4" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#0099BC"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#0099BC"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#0099BC"
                                        ToolTip="#0099BC" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#107C10"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#107C10"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#107C10"
                                        ToolTip="#107C10" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#876400"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#876400"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#876400"
                                        ToolTip="#876400" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#C42B1C"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#C42B1C"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#C42B1C"
                                        ToolTip="#C42B1C" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#E3008C"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#E3008C"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#E3008C"
                                        ToolTip="#E3008C" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#881798"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#881798"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#881798"
                                        ToolTip="#881798" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#7C3AED"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#7C3AED"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#7C3AED"
                                        ToolTip="#7C3AED" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#4A545E"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#4A545E"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#4A545E"
                                        ToolTip="#4A545E" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        Background="#767676"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#767676"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#767676"
                                        ToolTip="#767676" />
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                        Text="{DynamicResource Loc.Appearance.Accent.HexLabel}" />
                                    <TextBox
                                        Width="110"
                                        Margin="8,0,0,0"
                                        Text="{Binding ViewModel.AccentColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource AfSettingsInfoSurfaceStyle}" Margin="0,8,0,0"><TextBlock
                            Style="{StaticResource AfSettingsHintTextStyle}"
                            Text="{DynamicResource Loc.Appearance.Accent.Hint}" /></Border>

                        <components:SettingsRow
                            Badge="{Binding ViewModel.MotionModeText}"
                            BadgeTone="Accent"
                            Description="{Binding ViewModel.MotionDetailText}"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            Title="{DynamicResource Loc.Appearance.Row.Motion.Title}" />
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" IsExpanded="False" Icon="{ui:SymbolIcon CircleHalfFill24}">
                            <ui:CardExpander.Header><StackPanel>
                                <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Settings.Advanced.Backdrop.Title}" />
                                <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Settings.Advanced.Backdrop.Description}" />
                            </StackPanel></ui:CardExpander.Header>
                            <StackPanel>
<components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.BackdropTint.Description}"
                            Icon="{ui:SymbolIcon CircleHalfFill24}"
                            Title="{DynamicResource Loc.Appearance.Row.BackdropTint.Title}">
                            <components:SettingsNumericEditor
                                    Value="{Binding ViewModel.BackdropTintOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="{Binding Source={x:Static settings:AppearanceSettings.MinimumBackdropTintOpacityPercent}}"
                                    Maximum="{Binding Source={x:Static settings:AppearanceSettings.MaximumBackdropTintOpacityPercent}}"
                                    Step="{Binding Source={x:Static settings:AppearanceSettings.BackdropTintOpacityStep}}"
                                    Unit="{DynamicResource Loc.Settings.Numeric.Percent}" />
                        </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>
<components:SettingsGroup Header="{DynamicResource Loc.Common.Group.Fonts}" Icon="{ui:SymbolIcon TextFont24}"><StackPanel>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.LatinFont.Description}"
                            Icon="{ui:SymbolIcon TextFont24}"
                            Title="{DynamicResource Loc.Appearance.Row.LatinFont.Title}">
                            <ComboBox
                                MinWidth="200"
                                MaxDropDownHeight="360"
                                ItemsSource="{Binding ViewModel.LatinFontChoices}"
                                SelectedValue="{Binding ViewModel.LatinFontFamily, Mode=TwoWay}"
                                SelectedValuePath="Name">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,2,7,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{DynamicResource Loc.Appearance.Font.PreviewLabel}" />
                                                <TextBlock
                                                    FontFamily="{Binding PreviewFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding PreviewText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.CjkFont.Description}"
                            Icon="{ui:SymbolIcon LocalLanguage24}"
                            Title="{DynamicResource Loc.Appearance.Row.CjkFont.Title}">
                            <ComboBox
                                MinWidth="200"
                                MaxDropDownHeight="360"
                                ItemsSource="{Binding ViewModel.CjkFontChoices}"
                                SelectedValue="{Binding ViewModel.CjkFontFamily, Mode=TwoWay}"
                                SelectedValuePath="Name">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,2,7,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{DynamicResource Loc.Appearance.Font.PreviewLabel}" />
                                                <TextBlock
                                                    FontFamily="{Binding PreviewFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding PreviewText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </components:SettingsRow>

                        <!--
                            上下限用 Binding 而不是 x:Static：x:Static 返回装箱的 int，
                            RangeBase.Maximum 需要 double，标记扩展不做这个转换，而绑定会。
                            The bounds use Binding rather than x:Static because x:Static yields a boxed int,
                            RangeBase.Maximum wants a double, and the markup extension performs no conversion
                            while the binding engine does.
                        -->
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Appearance.Row.FontWeight.Description}"
                            Icon="{ui:SymbolIcon TextBold24}"
                            Title="{DynamicResource Loc.Appearance.Row.FontWeight.Title}">
                            <components:SettingsNumericEditor
                                    Value="{Binding ViewModel.FontWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="{Binding Source={x:Static settings:AppearanceSettings.MinimumFontWeight}}"
                                    Maximum="{Binding Source={x:Static settings:AppearanceSettings.MaximumFontWeight}}"
                                    Step="{Binding Source={x:Static settings:AppearanceSettings.FontWeightStep}}" />
                        </components:SettingsRow>

                        <Border
                            Margin="0,4,0,0"
                            Padding="16,13"
                            Background="{DynamicResource AfSettingsInfoSurfaceBrush}"
                            BorderBrush="{DynamicResource AfSettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                    Text="{DynamicResource Loc.Appearance.Specimen.Label}" />
                                <TextBlock
                                    FontFamily="{DynamicResource AppTextFontFamily}"
                                    FontSize="20"
                                    FontWeight="{DynamicResource AppTextFontWeight}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource Loc.Appearance.Specimen.Line1}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="{DynamicResource AppTextFontFamily}"
                                    FontSize="16"
                                    FontWeight="{DynamicResource AppTextFontWeight}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource Loc.Appearance.Specimen.Line2}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="{DynamicResource AppTextFontFamily}"
                                    FontSize="13"
                                    FontWeight="{DynamicResource AppTextFontWeight}"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{DynamicResource Loc.Appearance.Specimen.Line3}" />
                            </StackPanel>
                        </Border>

                            </StackPanel></components:SettingsGroup>

                <ui:Button
                    Margin="0,16,0,40"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="{DynamicResource Loc.Common.ResetPageDefaults}"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
