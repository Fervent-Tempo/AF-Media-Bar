<Page x:Class="AFMediaBar.Views.Pages.ApplicationAppearancePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:components="clr-namespace:AFMediaBar.Components"
 xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
 <Page.Resources>
  <Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}" />
  <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}" />
 </Page.Resources>
 <components:SettingsPageLayout x:Name="PageLayout">
  <components:SettingsPageLayout.Header><components:SettingsGroupStrip
   Title="{DynamicResource Loc.Common.Page.ApplicationAppearance}" Subtitle="{DynamicResource Loc.Settings.Personalization.Subtitle}"
   PageIcon="{ui:SymbolIcon Color24}" Target="{Binding ScrollViewer, ElementName=PageLayout}" >
                <components:SettingsGroupStrip.HeaderActions>
                    <ui:Button Click="ResetButton_Click" Content="{DynamicResource Loc.Common.ResetPageDefaults}" Style="{StaticResource AfSettingsButtonStyle}" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top"/>
                </components:SettingsGroupStrip.HeaderActions>
            </components:SettingsGroupStrip></components:SettingsPageLayout.Header>
  <components:SettingsPageLayout.Preview><StackPanel>
   <Border Padding="18" Margin="0,0,0,16" CornerRadius="8" Background="{DynamicResource AfSettingsInputBrush}"
    BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="1">
    <StackPanel><TextBlock Text="{DynamicResource Loc.Settings.Personalization.Sample}" FontSize="20" TextWrapping="Wrap" />
     <TextBlock Margin="0,10,0,0" Text="{DynamicResource Loc.Settings.Personalization.SampleDescription}" FontSize="13" LineHeight="20" TextWrapping="Wrap" />
     <Border Margin="0,16,0,0" Padding="14,8" HorizontalAlignment="Left" Background="{DynamicResource AfAccentBrush}" CornerRadius="5">
      <TextBlock Text="{DynamicResource Loc.Settings.Personalization.Accent}" Foreground="{DynamicResource AfOnAccentBrush}" FontSize="14" />
     </Border></StackPanel>
   </Border><components:SettingsPreview DataContext="{Binding Preview}" />
  </StackPanel></components:SettingsPageLayout.Preview>
  <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded" Unloaded="OnPageUnloaded">
<components:SettingsGroup GroupId="Common.Group.ThemeAndBackdrop" Header="{DynamicResource Loc.Common.Group.ThemeAndBackdrop}"><StackPanel><components:SettingsRow
                            Icon="{ui:SymbolIcon Color24}"
                            Title="{DynamicResource Loc.Appearance.Row.Theme.Title}">
                            <ComboBox
                                MinWidth="{StaticResource AfSettingsSelectMinWidth}"
                                SelectedValue="{Binding ViewModel.ApplicationThemeMode, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Theme.Automatic}"
                                    Tag="{x:Static settings:ApplicationThemeMode.Automatic}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Theme.Light}"
                                    Tag="{x:Static settings:ApplicationThemeMode.Light}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Theme.Dark}"
                                    Tag="{x:Static settings:ApplicationThemeMode.Dark}" />
                            </ComboBox>
                        </components:SettingsRow><components:SettingsRow
                            Icon="{ui:SymbolIcon WindowConsole20}"
                            Description="{DynamicResource Loc.Appearance.Row.Backdrop.Description}"
                            Title="{DynamicResource Loc.Appearance.Row.Backdrop.Title}">
                            <ComboBox MinWidth="{StaticResource AfSettingsSelectMinWidth}" SelectedValue="{Binding ViewModel.BackdropMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Backdrop.Solid}"
                                    Tag="{x:Static settings:ApplicationBackdropMode.FluentSolid}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Backdrop.Mica}"
                                    Tag="{x:Static settings:ApplicationBackdropMode.Mica}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Backdrop.MicaAlt}"
                                    Tag="{x:Static settings:ApplicationBackdropMode.MicaAlt}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Backdrop.Acrylic}"
                                    Tag="{x:Static settings:ApplicationBackdropMode.Acrylic}" />
                            </ComboBox>
                        </components:SettingsRow><ui:CardExpander
                            Padding="16,12" Margin="0,0,0,4"
                            Background="{DynamicResource AfSettingsCardBrush}"
                            BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="1"
                            IsExpanded="False">
                            <ui:CardExpander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="WindowConsole20" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsRowTitleStyle}"
                                        Text="{DynamicResource Loc.Settings.Advanced.Backdrop.Title}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,4">
                                <TextBlock Style="{StaticResource AfSettingsHintTextStyle}" Margin="0,0,0,10"
                                    Text="{DynamicResource Loc.Appearance.BackdropTint.Hint}" />
                                <components:SettingsRow IsNested="True" Icon="{ui:SymbolIcon Color24}"
                                    Title="{DynamicResource Loc.Appearance.Row.BackdropTint.Title}">
                                    <components:SettingsNumericEditor
                                        Value="{Binding ViewModel.BackdropTintOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="{Binding Source={x:Static settings:AppearanceSettings.MinimumBackdropTintOpacityPercent}}"
                                        Maximum="{Binding Source={x:Static settings:AppearanceSettings.MaximumBackdropTintOpacityPercent}}"
                                        Step="{Binding Source={x:Static settings:AppearanceSettings.BackdropTintOpacityStep}}"
                                        Unit="{DynamicResource Loc.Settings.Numeric.Percent}" />
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander></StackPanel></components:SettingsGroup><components:SettingsGroup GroupId="Settings.Personalization.Accent" Header="{DynamicResource Loc.Settings.Personalization.Accent}"><StackPanel><components:SettingsRow
                            Icon="{ui:SymbolIcon Color24}"
                            Title="{DynamicResource Loc.Appearance.Row.Accent.Title}">
                            <ComboBox MinWidth="{StaticResource AfSettingsSelectMinWidth}" SelectedValue="{Binding ViewModel.AccentColorMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Accent.FollowSystem}"
                                    Tag="{x:Static settings:AccentColorMode.System}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Appearance.Accent.Custom}"
                                    Tag="{x:Static settings:AccentColorMode.Custom}" />
                            </ComboBox>
                        </components:SettingsRow><Border
                            Margin="0,4,0,0"
                            Padding="14,12"
                            Background="{DynamicResource AfSettingsInfoSurfaceBrush}"
                            BorderBrush="{DynamicResource AfSettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding ViewModel.IsCustomAccent, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                    Text="{DynamicResource Loc.Appearance.Accent.PaletteLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#0078D4"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#0078D4"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#0078D4"
                                        ToolTip="#0078D4" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#0099BC"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#0099BC"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#0099BC"
                                        ToolTip="#0099BC" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#107C10"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#107C10"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#107C10"
                                        ToolTip="#107C10" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#876400"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#876400"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#876400"
                                        ToolTip="#876400" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#C42B1C"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#C42B1C"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#C42B1C"
                                        ToolTip="#C42B1C" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#E3008C"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#E3008C"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#E3008C"
                                        ToolTip="#E3008C" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#881798"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#881798"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#881798"
                                        ToolTip="#881798" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#7C3AED"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#7C3AED"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#7C3AED"
                                        ToolTip="#7C3AED" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Background="#4A545E"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#4A545E"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#4A545E"
                                        ToolTip="#4A545E" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        Background="#767676"
                                        Command="{Binding ViewModel.SetAccentColorCommand}"
                                        CommandParameter="#767676"
                                        Style="{StaticResource AfSettingsColorSwatchStyle}"
                                        Tag="#767676"
                                        ToolTip="#767676" />
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                        Text="{DynamicResource Loc.Appearance.Accent.HexLabel}" />
                                    <TextBox
                                        Width="110"
                                        Margin="8,0,0,0"
                                        Text="{Binding ViewModel.AccentColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </Border><Border Style="{StaticResource AfSettingsInfoSurfaceStyle}" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource AfSettingsHintTextStyle}" Text="{DynamicResource Loc.Appearance.Accent.Hint}" />
                        </Border></StackPanel></components:SettingsGroup>                <components:SettingsGroup
                    GroupId="Common.Group.Fonts"
                    Header="{DynamicResource Loc.Common.Group.Fonts}"
                    Description="{DynamicResource Loc.Appearance.Scope.Fonts}">
                    <StackPanel>
                        <components:SettingsRow
                            Icon="{ui:SymbolIcon TextFont24}"
                            Description="{DynamicResource Loc.Appearance.Row.LatinFont.Description}"
                            Title="{DynamicResource Loc.Appearance.Row.LatinFont.Title}">
                            <ComboBox
                                MinWidth="{StaticResource AfSettingsSelectMinWidth}"
                                MaxDropDownHeight="360"
                                ItemsSource="{Binding ViewModel.LatinFontChoices}"
                                SelectedValue="{Binding ViewModel.LatinFontFamily, Mode=TwoWay}"
                                SelectedValuePath="Name">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,2,7,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{DynamicResource Loc.Appearance.Font.PreviewLabel}" />
                                                <TextBlock
                                                    FontFamily="{Binding PreviewFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding PreviewText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Icon="{ui:SymbolIcon TextFont24}"
                            Description="{DynamicResource Loc.Appearance.Row.CjkFont.Description}"
                            Title="{DynamicResource Loc.Appearance.Row.CjkFont.Title}">
                            <ComboBox
                                MinWidth="{StaticResource AfSettingsSelectMinWidth}"
                                MaxDropDownHeight="360"
                                ItemsSource="{Binding ViewModel.CjkFontChoices}"
                                SelectedValue="{Binding ViewModel.CjkFontFamily, Mode=TwoWay}"
                                SelectedValuePath="Name">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,2,7,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{DynamicResource Loc.Appearance.Font.PreviewLabel}" />
                                                <TextBlock
                                                    FontFamily="{Binding PreviewFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding PreviewText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Icon="{ui:SymbolIcon TextFont24}"
                            Description="{DynamicResource Loc.Appearance.Row.FontWeight.Description}"
                            Title="{DynamicResource Loc.Appearance.Row.FontWeight.Title}">
                            <components:SettingsNumericEditor
                                Value="{Binding ViewModel.FontWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="{Binding Source={x:Static settings:AppearanceSettings.MinimumFontWeight}}"
                                Maximum="{Binding Source={x:Static settings:AppearanceSettings.MaximumFontWeight}}"
                                Step="{Binding Source={x:Static settings:AppearanceSettings.FontWeightStep}}" />
                        </components:SettingsRow>
                        <Border
                            Margin="0,4,0,0"
                            Padding="16,13"
                            Background="{DynamicResource AfSettingsInfoSurfaceBrush}"
                            BorderBrush="{DynamicResource AfSettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                    Text="{DynamicResource Loc.Appearance.Specimen.Label}" />
                                <TextBlock
                                    FontFamily="{DynamicResource AppTextFontFamily}"
                                    FontSize="20"
                                    FontWeight="{DynamicResource AppTextFontWeight}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource Loc.Appearance.Specimen.Line1}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="{DynamicResource AppTextFontFamily}"
                                    FontSize="16"
                                    FontWeight="{DynamicResource AppTextFontWeight}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource Loc.Appearance.Specimen.Line2}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="{DynamicResource AppTextFontFamily}"
                                    FontSize="13"
                                    FontWeight="{DynamicResource AppTextFontWeight}"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{DynamicResource Loc.Appearance.Specimen.Line3}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </components:SettingsGroup>
  </StackPanel>
 </components:SettingsPageLayout>
</Page>
