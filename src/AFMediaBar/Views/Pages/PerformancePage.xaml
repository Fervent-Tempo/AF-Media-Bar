<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:AFMediaBar.Components" xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="AFMediaBar.Views.Pages.PerformancePage" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="SpectrumParameterRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Setter Property="IsEnabled" Value="{Binding ViewModel.Components.CanConfigureSpectrum}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.Components.CanConfigureSpectrum}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Media.Badge.EnableFirst}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PerformanceParameterRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Setter Property="IsEnabled" Value="{Binding ViewModel.Components.CanConfigurePerformance}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.Components.CanConfigurePerformance}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Media.Badge.EnableFirst}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}"/>
        <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}"/>
    </Page.Resources>
    <components:SettingsPageLayout x:Name="PageLayout">
        <components:SettingsPageLayout.Header>
            <components:SettingsGroupStrip Title="{DynamicResource Loc.Settings.Page.Performance}" Subtitle="{DynamicResource Loc.Settings.Page.Performance.Description}" PageIcon="{ui:SymbolIcon Gauge24}" Target="{Binding ScrollViewer, ElementName=PageLayout}"/>
        </components:SettingsPageLayout.Header>
        <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded">
            <components:SettingsGroup GroupId="Widgets.Performance" Header="{DynamicResource Loc.Widgets.Performance}" Description="{DynamicResource Loc.Media.Performance.Metrics.Description}" Icon="{ui:SymbolIcon DataUsage24}">
                <StackPanel>
                    <components:SettingsNavigationButton Destination="RestState" GroupId="Common.RestLayer" Content="{DynamicResource Loc.Settings.RestState.VisibilityLink}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource Loc.Settings.Group.DisplayAndOrder}" Style="{StaticResource AfSettingsSubsectionTitleStyle}"/>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon Gauge24}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Media.Performance.Metrics.Title}"/>
                                <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Media.Performance.Metrics.Description}"/>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <components:SettingsRow Description="{DynamicResource Loc.Media.Metric.SystemMemory.Description}" Icon="{ui:SymbolIcon Storage24}" IsNested="True" Style="{StaticResource PerformanceParameterRowStyle}" Title="{DynamicResource Loc.Media.Metric.SystemMemory.Title}">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.Components.ShowSystemMemory, Mode=TwoWay}" IsEnabled="{Binding ViewModel.Components.CanUncheckSystemMemory}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon DeveloperBoard24}" IsNested="True" Style="{StaticResource PerformanceParameterRowStyle}" Title="CPU">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.Components.ShowSystemCpu, Mode=TwoWay}" IsEnabled="{Binding ViewModel.Components.CanUncheckSystemCpu}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon VideoClip24}" IsNested="True" Style="{StaticResource PerformanceParameterRowStyle}" Title="GPU">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.Components.ShowSystemGpu, Mode=TwoWay}" IsEnabled="{Binding ViewModel.Components.CanUncheckSystemGpu}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon Apps24}" IsNested="True" Style="{StaticResource PerformanceParameterRowStyle}" Title="{DynamicResource Loc.Media.Metric.ProcessMemory.Title}">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.Components.ShowProcessMemory, Mode=TwoWay}" IsEnabled="{Binding ViewModel.Components.CanUncheckProcessMemory}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Description="{DynamicResource Loc.Media.Performance.RefreshInterval.Description}" Icon="{ui:SymbolIcon Timer24}" IsNested="True" Style="{StaticResource PerformanceParameterRowStyle}" Title="{DynamicResource Loc.Media.Performance.RefreshInterval.Title}">
                                <components:SettingsNumericEditor Value="{Binding ViewModel.Components.PerformanceRefreshIntervalSeconds, Mode=TwoWay}" Minimum="{Binding ViewModel.Components.MinimumPerformanceRefreshIntervalSeconds}" Maximum="{Binding ViewModel.Components.MaximumPerformanceRefreshIntervalSeconds}" Step="{Binding ViewModel.Components.PerformanceRefreshIntervalStepSeconds}" Unit="{DynamicResource Loc.Settings.Numeric.Seconds}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Description="{DynamicResource Loc.Media.Metric.SystemNetwork.Description}" IsNested="True" Style="{StaticResource PerformanceParameterRowStyle}" Title="{DynamicResource Loc.Media.Metric.SystemNetwork.Title}" Icon="{ui:SymbolIcon DataUsage24}">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.Components.ShowSystemNetwork, Mode=TwoWay}" IsEnabled="{Binding ViewModel.Components.CanUncheckSystemNetwork}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Description="{DynamicResource Loc.Media.Performance.DisplayMode.Description}" IsNested="True" Style="{StaticResource PerformanceParameterRowStyle}" Title="{DynamicResource Loc.Media.Performance.DisplayMode.Title}" Icon="{ui:SymbolIcon DataUsage24}">
                                <ComboBox SelectedValue="{Binding ViewModel.Components.PerformanceMode, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="{StaticResource AfSettingsSelectShortWidth}">
                                    <ComboBoxItem Content="{DynamicResource Loc.Media.Performance.DisplayMode.Cycle}" Tag="{x:Static settings:PerformanceDisplayMode.Cycle}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Media.Performance.DisplayMode.Parallel}" Tag="{x:Static settings:PerformanceDisplayMode.Parallel}"/>
                                </ComboBox>
                            </components:SettingsRow>
                            <components:SettingsCallout Margin="0,4,0,4" Text="{DynamicResource Loc.Media.Performance.Order.Description}"/>
                            <AdornerDecorator>
                                <ItemsControl Style="{StaticResource AfSettingsSortableListStyle}" components:SettingsReorderBehavior.MoveCommand="{Binding ViewModel.Components.ReorderMetricCommand}" ItemsSource="{Binding ViewModel.Components.MetricOrderEntries}" IsEnabled="{Binding ViewModel.Components.CanConfigurePerformance}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <components:SettingsRow Style="{StaticResource AfSettingsListItemStyle}" KeepControlInline="True" IsNested="True" Title="{Binding DisplayName}" Icon="{ui:SymbolIcon DataUsage24}">
                                                <components:SettingsReorderHandle ItemKey="{Binding Metric}"/>
                                            </components:SettingsRow>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </AdornerDecorator>
                            <components:SettingsRow Description="{DynamicResource Loc.Media.Performance.OpenTaskManager.Description}" Icon="{ui:SymbolIcon CursorClick24}" IsNested="True" Style="{StaticResource PerformanceParameterRowStyle}" Title="{DynamicResource Loc.Media.Performance.OpenTaskManager.Title}">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.Components.OpenTaskManagerOnMetricsClick, Mode=TwoWay}"/>
                            </components:SettingsRow>
                        </StackPanel>
                    </ui:CardExpander>
                    <WrapPanel Style="{StaticResource AfSettingsRelatedLinksStyle}">
                        <components:SettingsNavigationButton Content="{DynamicResource Loc.Settings.Related.WidgetLayout}" Destination="Components" GroupId="Common.Group.ComponentOrder" HorizontalAlignment="Left"/>
                    </WrapPanel>
                </StackPanel>
            </components:SettingsGroup>
            <ui:Button Content="{DynamicResource Loc.Common.ResetPageDefaults}" Style="{StaticResource AfSettingsButtonStyle}" Click="ResetButton_Click" HorizontalAlignment="Left" Margin="0,0,0,20"/>
        </StackPanel>
    </components:SettingsPageLayout>
</Page>
