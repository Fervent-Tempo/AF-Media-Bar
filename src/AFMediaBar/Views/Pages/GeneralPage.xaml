<Page x:Class="AFMediaBar.Views.Pages.GeneralPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
<StackPanel MaxWidth="1000" Margin="16,16,24,32">
  <TextBlock Text="常规" FontSize="32" FontWeight="{DynamicResource AppTextStrongFontWeight}"/><ui:TextBlock Text="应用生命周期、语言、更新和设置文件" Appearance="Secondary" Margin="0,8,0,24"/>
  <TextBlock Text="应用" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ShareScreenStart24}"><ui:CardControl.Header><StackPanel><TextBlock Text="开机自动启动" FontWeight="SemiBold"/><TextBlock Text="登录 Windows 后自动运行 AF Media Bar（功能预留）" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ui:ToggleSwitch IsEnabled="False"/></ui:CardControl>
  <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Globe24}"><ui:CardControl.Header><StackPanel><TextBlock Text="界面语言" FontWeight="SemiBold"/><TextBlock Text="当前版本使用简体中文" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ComboBox MinWidth="180" SelectedIndex="0" IsEnabled="False"><ComboBoxItem Content="简体中文"/></ComboBox></ui:CardControl>
  <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon ArrowSync24}"><ui:CardControl.Header><StackPanel><TextBlock Text="检查更新" FontWeight="SemiBold"/><TextBlock Text="自动更新服务尚未接入" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ui:Button Content="检查更新" IsEnabled="False"/></ui:CardControl>
  <TextBlock Text="设置文件" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <ui:CardControl Icon="{ui:SymbolIcon FolderOpen24}"><ui:CardControl.Header><StackPanel><TextBlock Text="本地设置" FontWeight="SemiBold"/><TextBlock Text="打开 settings.json 所在文件夹，或恢复本页默认设置" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><StackPanel Orientation="Horizontal"><ui:Button Content="打开设置文件夹" Icon="{ui:SymbolIcon FolderOpen24}" Click="OpenSettingsFolder_Click" Margin="0,0,10,0"/><ui:Button Content="恢复本页默认" Icon="{ui:SymbolIcon ArrowReset24}" Click="ResetButton_Click"/></StackPanel></ui:CardControl>
 </StackPanel>
</Page>
