<Page x:Class="AFMediaBar.Views.Pages.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1100"
      Title="GeneralPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">


    <StackPanel MaxWidth="1000"
                Margin="16"
                VerticalAlignment="Center">
        <TextBlock Text="常规"
                   FontSize="32"
                   FontWeight="SemiBold" />
        <ui:TextBlock Text="管理启动、语言、更新和基础信息"
                      Appearance="Secondary"
                      Margin="0,8,0,28" />

        <TextBlock Text="快速入口"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <Grid ColumnDefinitions="*, *, *"
              Margin="0,0,0,32">
            <ui:CardAction Grid.Column="0"
                           Margin="0,0,8,0"
                           Padding="16"
                           IsChevronVisible="True">
                <ui:CardAction.Icon>
                    <ui:SymbolIcon Symbol="Open24"
                                   FontSize="28" />
                </ui:CardAction.Icon>
                <StackPanel>
                    <ui:TextBlock Text="GitHub"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="查看源码和发布页"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardAction>

            <ui:CardAction Grid.Column="1"
                           Margin="8,0,8,0"
                           Padding="16"
                           IsChevronVisible="True">
                <ui:CardAction.Icon>
                    <ui:SymbolIcon Symbol="Bug24"
                                   FontSize="28" />
                </ui:CardAction.Icon>
                <StackPanel>
                    <ui:TextBlock Text="问题反馈"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="提交 Bug 或功能建议"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardAction>

            <ui:CardAction Grid.Column="2"
                           Margin="8,0,0,0"
                           Padding="16"
                           IsChevronVisible="True">
                <ui:CardAction.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24"
                                   FontSize="28" />
                </ui:CardAction.Icon>
                <StackPanel>
                    <ui:TextBlock Text="日志文件"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="打开本地运行日志"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardAction>
        </Grid>

        <TextBlock Text="基础设置"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon ShareScreenStart24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="开机自动启动"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="登录 Windows 后自动运行 AF Media Bar"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon EyeOff24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="无媒体时隐藏"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="没有正在播放的内容时隐藏媒体栏"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,24"
                        Icon="{ui:SymbolIcon Globe24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="界面语言"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="选择应用显示语言"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox MinWidth="180"
                      SelectedIndex="0">
                <ComboBoxItem Content="跟随系统" />
                <ComboBoxItem Content="简体中文" />
                <ComboBoxItem Content="繁體中文" />
                <ComboBoxItem Content="English" />
            </ComboBox>
        </ui:CardControl>

        <TextBlock Text="更新"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon ArrowSync24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="自动检查更新"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="启动时在后台检查新版本"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,24"
                        Icon="{ui:SymbolIcon ArrowDownload24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="检查更新"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="手动获取最新版本信息"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="检查更新"
                       Icon="{ui:SymbolIcon ArrowSync24}" />
        </ui:CardControl>

        <TextBlock Text="关于"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <ui:CardControl Margin="0,0,0,24"
                        Icon="{ui:SymbolIcon Info24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="AF Media Bar"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="版本 1.0.0"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Anchor Content="GitHub"
                       Icon="{ui:SymbolIcon Open24}"
                       NavigateUri="https://github.com/Fervent-Tempo/AF-Media-Bar" />
        </ui:CardControl>

        <TextBlock Text="重置"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <ui:CardControl Icon="{ui:SymbolIcon ArrowReset24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="恢复默认设置"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="将所有设置恢复到初始状态"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="重置"
                       Icon="{ui:SymbolIcon ArrowReset24}" />
        </ui:CardControl>
    </StackPanel>
</Page>