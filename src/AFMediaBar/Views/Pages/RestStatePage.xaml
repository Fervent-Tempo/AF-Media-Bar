<Page x:Class="AFMediaBar.Views.Pages.RestStatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}" />
        <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}" />
        <Style x:Key="SmallArtworkRowStyle" TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}">
            <Setter Property="IsEnabled" Value="{Binding ViewModel.Layers.RestArtworkVisible}" />
            <Style.Triggers><DataTrigger Binding="{Binding ViewModel.Layers.RestArtworkVisible}" Value="False">
                <Setter Property="Badge" Value="{DynamicResource Loc.DisplayModes.Rest.Row.SmallArtwork.Badge}" />
                <Setter Property="BadgeTone" Value="Attention" />
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ComponentIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="Image24" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Component}" Value="{x:Static settings:TaskbarRestComponent.MediaText}"><Setter Property="Symbol" Value="TextFont24" /></DataTrigger>
                <DataTrigger Binding="{Binding Component}" Value="{x:Static settings:TaskbarRestComponent.Spectrum}"><Setter Property="Symbol" Value="DataBarVertical24" /></DataTrigger>
                <DataTrigger Binding="{Binding Component}" Value="{x:Static settings:TaskbarRestComponent.Performance}"><Setter Property="Symbol" Value="Gauge24" /></DataTrigger>
                <DataTrigger Binding="{Binding Component}" Value="{x:Static settings:TaskbarRestComponent.OutputDevice}"><Setter Property="Symbol" Value="Speaker224" /></DataTrigger>
                <DataTrigger Binding="{Binding Component}" Value="{x:Static settings:TaskbarRestComponent.InputDevice}"><Setter Property="Symbol" Value="Mic24" /></DataTrigger>
                <DataTrigger Binding="{Binding Component}" Value="{x:Static settings:TaskbarRestComponent.Volume}"><Setter Property="Symbol" Value="Speaker124" /></DataTrigger>
                <DataTrigger Binding="{Binding Component}" Value="{x:Static settings:TaskbarRestComponent.BluetoothBattery}"><Setter Property="Symbol" Value="Bluetooth24" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IdleComponentIconStyle" TargetType="ui:SymbolIcon" BasedOn="{StaticResource ComponentIconStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Component}" Value="{x:Static settings:TaskbarRestComponent.Artwork}"><Setter Property="Symbol" Value="MusicNote220" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <components:SettingsPageLayout x:Name="PageLayout">
        <components:SettingsPageLayout.Header>
            <components:SettingsGroupStrip Title="{DynamicResource Loc.Common.Page.RestState}"
                Subtitle="{DynamicResource Loc.Settings.RestState.Subtitle}" PageIcon="{ui:SymbolIcon Layer24}"
                Target="{Binding ScrollViewer, ElementName=PageLayout}" />
        </components:SettingsPageLayout.Header>
        <components:SettingsPageLayout.Preview><components:SettingsPreview DataContext="{Binding ViewModel.Preview}" /></components:SettingsPageLayout.Preview>
        <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded" Unloaded="OnPageUnloaded">
            <components:SettingsGroup GroupId="Common.RestLayer" Header="{DynamicResource Loc.Settings.RestState.Visible}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Settings.RestState.ArtworkAndProgress}" Style="{StaticResource AfSettingsSubsectionTitleStyle}" Margin="16,8,16,8" />
                    <components:SettingsRow Icon="{ui:SymbolIcon Image24}" Title="{DynamicResource Loc.DisplayModes.Rest.Row.Artwork.Title}" Description="{DynamicResource Loc.Settings.RestState.ArtworkHint}">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.RestArtworkVisible, Mode=TwoWay}" />
                    </components:SettingsRow>
                    <ui:CardExpander IsExpanded="False" Margin="0,0,0,4" Padding="16,12"
                        Background="{DynamicResource AfSettingsCardBrush}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="1">
                        <ui:CardExpander.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Image24" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc.Settings.RestState.ArtworkDetails}" Style="{StaticResource AfSettingsRowTitleStyle}" />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel Margin="0,8,0,4">
                            <components:SettingsRow Icon="{ui:SymbolIcon Image24}" IsNested="True" Title="{DynamicResource Loc.DisplayModes.Rest.Row.SmallArtwork.Title}" Description="{DynamicResource Loc.DisplayModes.Rest.Row.SmallArtwork.Description}" Style="{StaticResource SmallArtworkRowStyle}">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.SmallArtwork, Mode=TwoWay}" />
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon DataBarVertical24}" IsNested="True" Title="{DynamicResource Loc.DisplayModes.Rest.Row.ArtworkProgress.Title}">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.ArtworkProgressVisible, Mode=TwoWay}" />
                            </components:SettingsRow>
                        </StackPanel>
                    </ui:CardExpander>
                    <components:SettingsRow Icon="{ui:SymbolIcon DataBarVertical24}" Title="{DynamicResource Loc.DisplayModes.Rest.Row.Progress.Title}" Description="{DynamicResource Loc.Settings.RestState.ProgressHint}">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.RestProgressVisible, Mode=TwoWay}" />
                    </components:SettingsRow>
                    <TextBlock Text="{DynamicResource Loc.Settings.RestState.DevicesAndVolume}" Style="{StaticResource AfSettingsSubsectionTitleStyle}" />
                    <TextBlock Text="{DynamicResource Loc.Settings.RestState.SpaceHint}" Style="{StaticResource AfSettingsHintTextStyle}" Margin="16,0,16,10" />
                    <components:SettingsRow Icon="{ui:SymbolIcon Speaker224}" Title="{DynamicResource Loc.Common.OutputDevice}"><StackPanel Orientation="Horizontal"><components:SettingsNavigationButton Style="{StaticResource AfSettingsRelatedLinkStyle}" Destination="DeviceManagement" GroupId="Common.OutputDevice" Content="{DynamicResource Loc.Settings.Component.Configure}" Margin="0,0,12,0" /><ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.RestOutputDeviceVisible, Mode=TwoWay}" /></StackPanel></components:SettingsRow>
                    <components:SettingsRow Icon="{ui:SymbolIcon Mic24}" Title="{DynamicResource Loc.Common.InputDevice}"><StackPanel Orientation="Horizontal"><components:SettingsNavigationButton Style="{StaticResource AfSettingsRelatedLinkStyle}" Destination="DeviceManagement" GroupId="Common.InputDevice" Content="{DynamicResource Loc.Settings.Component.Configure}" Margin="0,0,12,0" /><ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.RestInputDeviceVisible, Mode=TwoWay}" /></StackPanel></components:SettingsRow>
                    <components:SettingsRow Icon="{ui:SymbolIcon Speaker124}" Title="{DynamicResource Loc.Settings.RestState.Volume}"><StackPanel Orientation="Horizontal"><components:SettingsNavigationButton Style="{StaticResource AfSettingsRelatedLinkStyle}" Destination="Interaction" GroupId="Audio.Settings.Advanced" Content="{DynamicResource Loc.Settings.Component.Configure}" Margin="0,0,12,0" /><ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.RestVolumeVisible, Mode=TwoWay}" /></StackPanel></components:SettingsRow>
                    <TextBlock Text="{DynamicResource Loc.Settings.RestState.Extensions}" Style="{StaticResource AfSettingsSubsectionTitleStyle}" />
                    <components:SettingsRow Icon="{ui:SymbolIcon DataBarVertical24}" Title="{DynamicResource Loc.DisplayModes.Rest.Component.Spectrum}"><StackPanel Orientation="Horizontal"><components:SettingsNavigationButton Style="{StaticResource AfSettingsRelatedLinkStyle}" Destination="Widgets" GroupId="Widgets.Spectrum" Content="{DynamicResource Loc.Settings.Component.Configure}" Margin="0,0,12,0" /><ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.SpectrumVisible, Mode=TwoWay}" /></StackPanel></components:SettingsRow>
                    <components:SettingsRow Icon="{ui:SymbolIcon Gauge24}" Title="{DynamicResource Loc.DisplayModes.Rest.Component.Performance}"><StackPanel Orientation="Horizontal"><components:SettingsNavigationButton Style="{StaticResource AfSettingsRelatedLinkStyle}" Destination="Widgets" GroupId="Widgets.Performance" Content="{DynamicResource Loc.Settings.Component.Configure}" Margin="0,0,12,0" /><ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.PerformanceVisible, Mode=TwoWay}" /></StackPanel></components:SettingsRow>
                    <components:SettingsRow Icon="{ui:SymbolIcon Bluetooth24}" Title="{DynamicResource Loc.Battery.Title}" Description="{DynamicResource Loc.Settings.RestState.BatteryHint}"><StackPanel Orientation="Horizontal"><components:SettingsNavigationButton Style="{StaticResource AfSettingsRelatedLinkStyle}" Destination="{Binding ViewModel.BatteryDestination}" GroupId="Battery.Title" Content="{DynamicResource Loc.Settings.Component.Configure}" Margin="0,0,12,0" /><ui:ToggleSwitch IsChecked="{Binding ViewModel.Battery.Enabled, Mode=TwoWay}" IsEnabled="{Binding ViewModel.BatteryAvailable}" /></StackPanel></components:SettingsRow>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Common.Group.ComponentOrder" Header="{DynamicResource Loc.Common.Group.ComponentOrder}">
                <StackPanel>
                    <TextBlock Margin="10,8,10,12" Text="{DynamicResource Loc.Settings.RestState.OrderHint}" TextWrapping="Wrap" Style="{StaticResource AfSettingsHintTextStyle}" />
                    <AdornerDecorator><ItemsControl ItemsSource="{Binding ViewModel.Layout.RestOrderEntries}" Style="{StaticResource AfSettingsSortableListStyle}"
                        components:SettingsReorderBehavior.MoveCommand="{Binding ViewModel.Layout.ReorderRestComponentCommand}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <components:SettingsRow Title="{Binding DisplayName}" KeepControlInline="True" IsNested="True">
                                <components:SettingsRow.Icon><ui:SymbolIcon Style="{StaticResource ComponentIconStyle}" /></components:SettingsRow.Icon>
                                <components:SettingsRow.Style><Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding CanMove}" Value="False"><Setter Property="Badge" Value="{DynamicResource Loc.Settings.RestState.Fixed}" /></DataTrigger>
                                </Style.Triggers></Style></components:SettingsRow.Style>
                                <components:SettingsReorderHandle ItemKey="{Binding Component}" Visibility="{Binding CanMove, Converter={StaticResource AfBooleanToVisibilityConverter}}" />
                            </components:SettingsRow>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl></AdornerDecorator>
                    <ui:Button Command="{Binding ViewModel.Layout.ResetRestComponentOrderCommand}" Content="{DynamicResource Loc.DisplayModes.Rest.Order.Reset.Title}" Style="{StaticResource AfSettingsButtonStyle}" HorizontalAlignment="Right" Margin="0,8,0,4" />
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Settings.RestState.Idle" Header="{DynamicResource Loc.Settings.RestState.Idle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Settings.RestState.IdleDescription}" TextWrapping="Wrap" Margin="10,8,10,12" Style="{StaticResource AfSettingsHintTextStyle}" />
                    <ItemsControl ItemsSource="{Binding ViewModel.Layers.IdleComponentEntries}"><ItemsControl.ItemTemplate><DataTemplate>
                        <components:SettingsRow Title="{Binding DisplayName}">
                            <components:SettingsRow.Icon><ui:SymbolIcon Style="{StaticResource IdleComponentIconStyle}" /></components:SettingsRow.Icon>
                            <ui:ToggleSwitch IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                        </components:SettingsRow>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </components:SettingsGroup>
            <ui:Button Content="{DynamicResource Loc.Common.ResetPageDefaults}" Click="ResetButton_Click" Style="{StaticResource AfSettingsButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,20" />
        </StackPanel>
    </components:SettingsPageLayout>
</Page>
