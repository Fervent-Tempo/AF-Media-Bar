<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:components="clr-namespace:AFMediaBar.Components" x:Class="AFMediaBar.Views.Pages.RestStatePage" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}"/>
        <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}"/>
    </Page.Resources>
    <components:SettingsPageLayout x:Name="PageLayout">
        <components:SettingsPageLayout.Header>
            <components:SettingsGroupStrip Title="{DynamicResource Loc.Common.Page.RestState}" Subtitle="{DynamicResource Loc.Settings.RestState.Description}" PageIcon="{ui:SymbolIcon Layer24}" Target="{Binding ScrollViewer, ElementName=PageLayout}">
                <components:SettingsGroupStrip.HeaderActions>
                    <ui:Button Content="{DynamicResource Loc.Common.ResetPageDefaults}" Style="{StaticResource AfSettingsButtonStyle}" Click="ResetButton_Click" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top"/>
                </components:SettingsGroupStrip.HeaderActions>
            </components:SettingsGroupStrip>
        </components:SettingsPageLayout.Header>
        <components:SettingsPageLayout.Preview>
            <components:SettingsPreview DataContext="{Binding ViewModel.Preview}"/>
        </components:SettingsPageLayout.Preview>
        <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded">
            <components:SettingsGroup GroupId="Common.RestLayer" Header="{DynamicResource Loc.ComponentLayout.Resident}">
                <StackPanel>
                    <AdornerDecorator>
                        <ItemsControl ItemsSource="{Binding ViewModel.Layers.ResidentLayoutEntries}" Style="{StaticResource AfSettingsSortableListStyle}" ItemTemplate="{StaticResource AfSettingsComponentRowTemplate}" components:SettingsReorderBehavior.MoveCommand="{Binding ViewModel.Layers.ReorderLayoutCommand}"/>
                    </AdornerDecorator>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Settings.RestState.Details" Header="{DynamicResource Loc.Settings.RestState.Details}">
                <StackPanel>
                    <components:SettingsRow Title="{DynamicResource Loc.DisplayModes.Rest.Row.SmallArtwork.Title}" Description="{DynamicResource Loc.DisplayModes.Rest.Row.SmallArtwork.Description}" Icon="{ui:SymbolIcon Image24}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.SmallArtwork, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <components:SettingsRow Title="{DynamicResource Loc.DisplayModes.Rest.Row.ArtworkProgress.Title}" Description="{DynamicResource Loc.DisplayModes.Rest.Row.ArtworkProgress.Description}" Icon="{ui:SymbolIcon DataBarVertical24}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.ArtworkProgressVisible, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <components:SettingsRow Title="{DynamicResource Loc.DisplayModes.Rest.Row.Progress.Title}" Description="{DynamicResource Loc.DisplayModes.Rest.Row.Progress.Description}" Icon="{ui:SymbolIcon Play24}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.RestProgressVisible, Mode=TwoWay}"/>
                    </components:SettingsRow>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Settings.RestState.Idle" Header="{DynamicResource Loc.ComponentLayout.Idle}">
                <StackPanel>
                    <components:SettingsCallout Text="{DynamicResource Loc.Settings.RestState.IdleDescription}"/>
                    <AdornerDecorator>
                        <ItemsControl ItemsSource="{Binding ViewModel.Layers.IdleLayoutEntries}" Style="{StaticResource AfSettingsSortableListStyle}" ItemTemplate="{StaticResource AfSettingsComponentRowTemplate}" components:SettingsReorderBehavior.MoveCommand="{Binding ViewModel.Layers.ReorderLayoutCommand}"/>
                    </AdornerDecorator>
                </StackPanel>
            </components:SettingsGroup>
        </StackPanel>
    </components:SettingsPageLayout>
</Page>
