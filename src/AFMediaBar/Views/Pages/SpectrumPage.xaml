<?xml version="1.0" ?><Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:AFMediaBar.Components" xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="AFMediaBar.Views.Pages.SpectrumPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="SpectrumParameterRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Setter Property="IsEnabled" Value="{Binding ViewModel.Components.CanConfigureSpectrum}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.Components.CanConfigureSpectrum}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Media.Badge.EnableFirst}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PerformanceParameterRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Setter Property="IsEnabled" Value="{Binding ViewModel.Components.CanConfigurePerformance}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.Components.CanConfigurePerformance}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Media.Badge.EnableFirst}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}"/>
        <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}"/>
    </Page.Resources>
    <components:SettingsPageLayout x:Name="PageLayout">
        <components:SettingsPageLayout.Header>
            <components:SettingsGroupStrip Title="{DynamicResource Loc.Settings.Page.Spectrum}" Subtitle="{DynamicResource Loc.Settings.Page.Spectrum.Description}" PageIcon="{ui:SymbolIcon DataBarVertical24}" Target="{Binding ScrollViewer, ElementName=PageLayout}"><components:SettingsGroupStrip.HeaderActions><ui:Button Content="{DynamicResource Loc.Common.ResetPageDefaults}" Style="{StaticResource AfSettingsButtonStyle}" Click="ResetButton_Click" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top"/></components:SettingsGroupStrip.HeaderActions></components:SettingsGroupStrip>
        </components:SettingsPageLayout.Header>
        <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded">
            <components:SettingsGroup GroupId="Widgets.Spectrum" Header="{DynamicResource Loc.Widgets.Spectrum}" Description="{DynamicResource Loc.Widgets.Spectrum.Description}" Icon="{ui:SymbolIcon DataHistogram24}">
                <StackPanel>
                    <components:SettingsNavigationButton Destination="RestState" GroupId="Common.RestLayer" Content="{DynamicResource Loc.Settings.RestState.VisibilityLink}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource Loc.Settings.Group.Capture}" Style="{StaticResource AfSettingsSubsectionTitleStyle}"/>
                    <components:SettingsRow Description="{DynamicResource Loc.Media.Spectrum.CaptureSource.Description}" Icon="{ui:SymbolIcon Speaker224}" Style="{StaticResource SpectrumParameterRowStyle}" Title="{DynamicResource Loc.Media.Spectrum.CaptureSource.Title}">
                        <ComboBox MinWidth="{StaticResource AfSettingsSelectShortWidth}" SelectedValue="{Binding ViewModel.Components.SpectrumCaptureSource, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.CaptureSource.CurrentDevice}" Tag="{x:Static settings:SpectrumCaptureSource.CurrentDevice}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.CaptureSource.AllApplications}" IsEnabled="{Binding ViewModel.Components.IsProcessLoopbackSupported}" Tag="{x:Static settings:SpectrumCaptureSource.AllApplications}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.CaptureSource.CurrentMediaApplication}" IsEnabled="{Binding ViewModel.Components.IsProcessLoopbackSupported}" Tag="{x:Static settings:SpectrumCaptureSource.CurrentMediaApplication}"/>
                        </ComboBox>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.Media.Spectrum.CaptureDevice.Description}" Icon="{ui:SymbolIcon Speaker224}" Style="{StaticResource SpectrumParameterRowStyle}" Title="{DynamicResource Loc.Media.Spectrum.CaptureDevice.Title}" Visibility="{Binding ViewModel.Components.IsDeviceCapture, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                        <ComboBox ItemsSource="{Binding ViewModel.Components.SpectrumCaptureDevices}" SelectedItem="{Binding ViewModel.Components.SelectedSpectrumCaptureDevice, Mode=TwoWay}" DisplayMemberPath="DisplayName" MinWidth="{StaticResource AfSettingsSelectMinWidth}" MaxWidth="{StaticResource AfSettingsSelectLongMaxWidth}"/>
                    </components:SettingsRow>
                    <TextBlock Text="{Binding ViewModel.Components.SpectrumCaptureDeviceStatus}" Style="{StaticResource AfSettingsStatusTextStyle}" TextWrapping="Wrap" Visibility="{Binding ViewModel.Components.IsDeviceCapture, Converter={StaticResource AfBooleanToVisibilityConverter}}"/>
                    <TextBlock Margin="0,0,0,8" Style="{StaticResource AfSettingsHintTextStyle}" Text="{DynamicResource Loc.Media.Spectrum.CaptureSource.Requirements}"/>
                    <TextBlock Margin="0,0,0,8" Style="{StaticResource AfSettingsHintTextStyle}" Text="{DynamicResource Loc.Media.Spectrum.CaptureSource.Compatibility}"/>
                    <components:SettingsRow Description="{DynamicResource Loc.Media.Spectrum.Style.Description}" Icon="{ui:SymbolIcon PaintBrush24}" Style="{StaticResource SpectrumParameterRowStyle}" Title="{DynamicResource Loc.Media.Spectrum.Style.Title}">
                        <ComboBox MinWidth="{StaticResource AfSettingsSelectShortWidth}" SelectedValue="{Binding ViewModel.Components.SpectrumStyle, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.Style.Bars}" Tag="{x:Static settings:SpectrumStyle.Bars}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.Style.Waveform}" Tag="{x:Static settings:SpectrumStyle.Waveform}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.Style.PixelBars}" Tag="{x:Static settings:SpectrumStyle.PixelBars}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.Style.MirroredBars}" Tag="{x:Static settings:SpectrumStyle.MirroredBars}"/>
                        </ComboBox>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.Media.Spectrum.BandCount.Description}" Icon="{ui:SymbolIcon DataBarVertical24}" Style="{StaticResource SpectrumParameterRowStyle}" Title="{DynamicResource Loc.Media.Spectrum.BandCount.Title}">
                        <components:SettingsNumericEditor Value="{Binding ViewModel.Components.SpectrumBandCount, Mode=TwoWay}" Minimum="{Binding ViewModel.Components.MinimumSpectrumBandCount}" Maximum="{Binding ViewModel.Components.MaximumSpectrumBandCount}" Step="1"/>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.Media.Spectrum.ContentHeight.Description}" Icon="{ui:SymbolIcon ArrowSort24}" Style="{StaticResource SpectrumParameterRowStyle}" Title="{DynamicResource Loc.Media.Spectrum.ContentHeight.Title}">
                        <components:SettingsNumericEditor Value="{Binding ViewModel.Components.SpectrumContentHeightDip, Mode=TwoWay}" Minimum="{Binding ViewModel.Components.MinimumSpectrumContentHeightDip}" Maximum="{Binding ViewModel.Components.MaximumSpectrumContentHeightDip}" Step="{Binding ViewModel.Components.SpectrumContentHeightStepDip}" Unit="{DynamicResource Loc.Settings.Numeric.Dip}"/>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.Media.Spectrum.RefreshRate.Description}" Icon="{ui:SymbolIcon Timer24}" Style="{StaticResource SpectrumParameterRowStyle}" Title="{DynamicResource Loc.Media.Spectrum.RefreshRate.Title}">
                        <components:SettingsNumericEditor Value="{Binding ViewModel.Components.SpectrumRefreshRateHz, Mode=TwoWay}" Minimum="{Binding Source={x:Static settings:SpectrumComponentSettings.MinimumRefreshRateHz}}" Maximum="{Binding Source={x:Static settings:SpectrumComponentSettings.MaximumRefreshRateHz}}" Step="1" Unit="{DynamicResource Loc.Settings.Numeric.Hertz}"/>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.Media.Spectrum.Sensitivity.Description}" Icon="{ui:SymbolIcon TopSpeed24}" Style="{StaticResource SpectrumParameterRowStyle}" Title="{DynamicResource Loc.Media.Spectrum.Sensitivity.Title}">
                        <components:SettingsNumericEditor Value="{Binding ViewModel.Components.SpectrumSensitivityPercent, Mode=TwoWay}" Minimum="{Binding ViewModel.Components.MinimumSpectrumSensitivityPercent}" Maximum="{Binding ViewModel.Components.MaximumSpectrumSensitivityPercent}" Step="{Binding ViewModel.Components.SpectrumSensitivityStepPercent}" Unit="{DynamicResource Loc.Settings.Numeric.Percent}"/>
                    </components:SettingsRow>
                </StackPanel>
            </components:SettingsGroup>

        </StackPanel>
    </components:SettingsPageLayout>
</Page>
