<?xml version="1.0" ?><Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:memory="clr-namespace:AFMediaBar.Classes.Settings" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:AFMediaBar.Components" xmlns:localization="clr-namespace:AFMediaBar.Classes.Services.Localization" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="AFMediaBar.Views.Pages.DiagnosticsPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}"/>
        <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}"/>
    </Page.Resources>
    <components:SettingsPageLayout x:Name="PageLayout">
        <components:SettingsPageLayout.Header>
            <components:SettingsGroupStrip Title="{DynamicResource Loc.Settings.Page.Diagnostics}" Subtitle="{DynamicResource Loc.Settings.Page.Diagnostics.Description}" PageIcon="{ui:SymbolIcon Bug24}" Target="{Binding ScrollViewer, ElementName=PageLayout}"/>
        </components:SettingsPageLayout.Header>
        <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded">
            <components:SettingsGroup GroupId="Common.Group.Diagnostics" Header="{DynamicResource Loc.Common.Group.Diagnostics}" Icon="{ui:SymbolIcon Bug24}">
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsSubsectionTitleStyle}" Text="{DynamicResource Loc.Settings.Group.Developer}"/>
                    <components:SettingsRow IsNested="False" Title="{DynamicResource Loc.Developer.Mode.Title}" Description="{DynamicResource Loc.Developer.Mode.Description}" Icon="{ui:SymbolIcon Bug24}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.DeveloperModeEnabled, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <components:SettingsRow IsNested="False" Title="{DynamicResource Loc.Developer.Tools.Title}" Description="{DynamicResource Loc.Developer.Tools.Description}" Visibility="{Binding ViewModel.DeveloperModeEnabled, Converter={StaticResource AfBooleanToVisibilityConverter}}" Icon="{ui:SymbolIcon Bug24}">
                        <ui:Button Content="{DynamicResource Loc.Developer.Open}" Command="{Binding ViewModel.OpenDeveloperToolsCommand}" Style="{StaticResource AfSettingsButtonStyle}"/>
                    </components:SettingsRow>
                    <TextBlock Style="{StaticResource AfSettingsSubsectionTitleStyle}" Text="{DynamicResource Loc.Settings.Group.Logs}"/>
                    <components:SettingsRow IsNested="False" Description="{DynamicResource Loc.About.Row.LogFolder.Description}" Icon="{ui:SymbolIcon FolderOpen24}" Title="{DynamicResource Loc.About.Row.LogFolder.Title}">
                        <ui:Button Click="OpenLogFolder_Click" Content="{DynamicResource Loc.Common.OpenFolder}" Icon="{ui:SymbolIcon FolderOpen24}" Style="{StaticResource AfSettingsButtonStyle}"/>
                    </components:SettingsRow>
                </StackPanel>
            </components:SettingsGroup>
        </StackPanel>
    </components:SettingsPageLayout>
</Page>
