<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Class="AFMediaBar.Views.Pages.InteractionPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <components:SettingsGroupStrip
            Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            Grid.Row="0"
            PageIcon="{ui:SymbolIcon HandDraw24}"
            Subtitle="{DynamicResource Loc.Interaction.Header.Subtitle}"
            Target="{Binding ElementName=PageScroll}"
            Title="{DynamicResource Loc.Common.Page.Interaction}" />
        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PageRoot" MaxWidth="{StaticResource AfSettingsContentMaxWidth}" Loaded="OnPageLoaded">
                <components:SettingsGroup
                    GroupId="Common.Group.InAppRestLayer"
                    Description="{DynamicResource Loc.Interaction.InApp.Group.Description}"
                    Header="{DynamicResource Loc.Common.Group.InAppRestLayer}"
                    Icon="{ui:SymbolIcon CursorClick24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="InputGestures" />
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.ArtworkClick.Description}"
                            Icon="{ui:SymbolIcon Play24}"
                            Title="{DynamicResource Loc.Interaction.Row.ArtworkClick.Title}">
                            <ComboBox MinWidth="200" SelectedValue="{Binding ViewModel.ArtworkClickAction, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.PlayPause}"
                                    Tag="{x:Static settings:PlayerClickAction.TogglePlayPause}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.ActivateSourceApplication}"
                                    Tag="{x:Static settings:PlayerClickAction.ActivateSource}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.OpenFullPanel}"
                                    Tag="{x:Static settings:PlayerClickAction.OpenFullPanel}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Disabled}"
                                    Tag="{x:Static settings:PlayerClickAction.Disabled}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow Icon="{ui:SymbolIcon TextQuote24}" Title="{DynamicResource Loc.Interaction.Row.TextClick.Title}">
                            <ComboBox MinWidth="200" SelectedValue="{Binding ViewModel.TextClickAction, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.ActivateSourceApplication}"
                                    Tag="{x:Static settings:PlayerClickAction.ActivateSource}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.PlayPause}"
                                    Tag="{x:Static settings:PlayerClickAction.TogglePlayPause}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.OpenFullPanel}"
                                    Tag="{x:Static settings:PlayerClickAction.OpenFullPanel}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Disabled}"
                                    Tag="{x:Static settings:PlayerClickAction.Disabled}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.ArtworkHover.Description}"
                            Icon="{ui:SymbolIcon ZoomIn24}"
                            Title="{DynamicResource Loc.Interaction.Row.ArtworkHover.Title}">
                            <ComboBox MinWidth="200" SelectedValue="{Binding ViewModel.ArtworkHoverMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Row.ArtworkHover.Mode.Off}"
                                    Tag="{x:Static settings:ArtworkHoverMode.Off}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Row.ArtworkHover.Mode.Zoom}"
                                    Tag="{x:Static settings:ArtworkHoverMode.Zoom}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Row.ArtworkHover.Mode.Preview}"
                                    Tag="{x:Static settings:ArtworkHoverMode.Preview}" />
                            </ComboBox>
                        </components:SettingsRow>
                    </StackPanel>
                </components:SettingsGroup>
                <components:SettingsGroup
                    GroupId="Interaction.Group.Wheel"
                    Header="{DynamicResource Loc.Interaction.Group.Wheel}"
                    Icon="{ui:SymbolIcon Cursor24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="WheelGestures" />
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.PrimaryWheel.Description}"
                            Icon="{ui:SymbolIcon Cursor24}"
                            Title="{DynamicResource Loc.Interaction.Wheel.Primary.Title}">
                            <ComboBox MinWidth="200" SelectedValue="{Binding ViewModel.PrimaryWheelAction, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.PreviousNextTrack}"
                                    Tag="{x:Static settings:WheelAction.PreviousNext}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.SwitchOutputDevice}"
                                    Tag="{x:Static settings:WheelAction.OutputDevice}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.SwitchInputDevice}"
                                    Tag="{x:Static settings:WheelAction.InputDevice}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.AdjustCurrentMediaVolume}"
                                    Tag="{x:Static settings:WheelAction.CurrentApplicationVolume}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.SwitchPlayer}"
                                    Tag="{x:Static settings:WheelAction.SwitchMediaSource}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Disabled}"
                                    Tag="{x:Static settings:WheelAction.Disabled}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.ChordWheel.Description}"
                            Icon="{ui:SymbolIcon Keyboard24}"
                            Title="{DynamicResource Loc.Interaction.Wheel.Chord.Title}">
                            <ComboBox MinWidth="200" SelectedValue="{Binding ViewModel.ChordWheelAction, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.SwitchPlayer}"
                                    Tag="{x:Static settings:WheelAction.SwitchMediaSource}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.AdjustCurrentMediaVolume}"
                                    Tag="{x:Static settings:WheelAction.CurrentApplicationVolume}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.SwitchOutputDevice}"
                                    Tag="{x:Static settings:WheelAction.OutputDevice}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.SwitchInputDevice}"
                                    Tag="{x:Static settings:WheelAction.InputDevice}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.PreviousNextTrack}"
                                    Tag="{x:Static settings:WheelAction.PreviousNext}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Disabled}"
                                    Tag="{x:Static settings:WheelAction.Disabled}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.Modifier.Description}"
                            Icon="{ui:SymbolIcon Keyboard24}"
                            Title="{DynamicResource Loc.Interaction.Row.Modifier.Title}">
                            <ComboBox MinWidth="150" SelectedValue="{Binding ViewModel.Modifier, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.Modifier.Shift}"
                                    Tag="{x:Static settings:InteractionModifier.Shift}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.Modifier.LeftMouseButton}"
                                    Tag="{x:Static settings:InteractionModifier.LeftMouseButton}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.Modifier.RightMouseButton}"
                                    Tag="{x:Static settings:InteractionModifier.RightMouseButton}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.WheelTooltip.Description}"
                            Icon="{ui:SymbolIcon Info24}"
                            Title="{DynamicResource Loc.Interaction.Row.WheelTooltip.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.ShowWheelTooltips, Mode=TwoWay}" />
                        </components:SettingsRow>
                        <components:SettingsCallout
                            Margin="0,4,0,0"
                            IsAccent="False"
                            Symbol="Info24"
                            Text="{DynamicResource Loc.Interaction.SharedModifier.Callout}" />
                    </StackPanel>
                </components:SettingsGroup>
                <components:SettingsGroup GroupId="Common.TrayIcon" Header="{DynamicResource Loc.Common.TrayIcon}" Icon="{ui:SymbolIcon Apps24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="TrayOverflow" />
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.TrayClick.Description}"
                            Icon="{ui:SymbolIcon CursorClick24}"
                            Title="{DynamicResource Loc.Interaction.Row.TrayClick.Title}">
                            <ComboBox MinWidth="200" SelectedValue="{Binding ViewModel.TrayClickAction, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.TrayAction.OpenAudioControl}"
                                    Tag="{x:Static settings:TrayClickAction.OpenAudioControl}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.TrayAction.OpenOutputDeviceMenu}"
                                    Tag="{x:Static settings:TrayClickAction.OpenOutputDeviceMenu}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.InputDevice}"
                                    Tag="{x:Static settings:TrayClickAction.OpenInputDeviceMenu}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.TrayAction.OpenCurrentAppVolumeMenu}"
                                    Tag="{x:Static settings:TrayClickAction.OpenCurrentAppVolumeMenu}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.TrayAction.OpenSettings}"
                                    Tag="{x:Static settings:TrayClickAction.OpenSettings}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.TrayAction.OpenContextMenu}"
                                    Tag="{x:Static settings:TrayClickAction.OpenContextMenu}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Disabled}"
                                    Tag="{x:Static settings:TrayClickAction.None}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.TrayPrimaryWheel.Description}"
                            Icon="{ui:SymbolIcon Cursor24}"
                            Title="{DynamicResource Loc.Interaction.Wheel.Primary.Title}">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.TrayPrimaryWheelAction, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.SwitchOutputDevice}"
                                    Tag="{x:Static settings:TrayWheelBehavior.SwitchOutputDevice}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.SwitchInputDevice}"
                                    Tag="{x:Static settings:TrayWheelBehavior.SwitchInputDevice}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.AdjustCurrentMediaVolume}"
                                    Tag="{x:Static settings:TrayWheelBehavior.AdjustVolume}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Disabled}"
                                    Tag="{x:Static settings:TrayWheelBehavior.Disabled}" />
                            </ComboBox>
                        </components:SettingsRow>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup GroupId="Audio.Settings.Title" Header="{DynamicResource Loc.Audio.Settings.Title}"
                    Description="{DynamicResource Loc.Audio.Settings.Description}" Icon="{ui:SymbolIcon Speaker224}">
                    <StackPanel>
                        <Expander Header="{DynamicResource Loc.Common.OutputDevice}" Margin="0,4">
                            <ItemsControl ItemsSource="{Binding ViewModel.AudioDevices.OutputDevices}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Margin="4,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" ToolTip="{Binding EndpointId}"/>
                                            <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Content="{DynamicResource Loc.Audio.Settings.Allow}" IsChecked="{Binding IsAllowed, Mode=TwoWay}" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <Expander Header="{DynamicResource Loc.Common.InputDevice}" Margin="0,4">
                            <ItemsControl ItemsSource="{Binding ViewModel.AudioDevices.InputDevices}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Margin="4,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" ToolTip="{Binding EndpointId}"/>
                                            <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Content="{DynamicResource Loc.Audio.Settings.Allow}" IsChecked="{Binding IsAllowed, Mode=TwoWay}" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <TextBlock Text="{Binding ViewModel.AudioDevices.StatusText}" TextWrapping="Wrap" FontSize="12"/>
                        <Expander Header="{DynamicResource Loc.Audio.Settings.Advanced}" Margin="0,8">
                            <StackPanel>
                            <components:SettingsRow Title="{DynamicResource Loc.Audio.Settings.OutputCommunications}">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.AudioDevices.SwitchOutputCommunications, Mode=TwoWay}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Audio.Settings.OutputClick}">
                                <ComboBox MinWidth="180" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.OutputDeviceClickTarget, Mode=TwoWay}">
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.System}" Tag="{x:Static settings:AudioDeviceSwitchTarget.SystemDefault}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.Foreground}" Tag="{x:Static settings:AudioDeviceSwitchTarget.ForegroundApplication}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Interaction.Disabled}" Tag="{x:Static settings:AudioDeviceSwitchTarget.Disabled}"/>
                                </ComboBox>
                            </components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Audio.Settings.OutputWheel}">
                                <ComboBox MinWidth="180" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.OutputDeviceWheelTarget, Mode=TwoWay}">
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.System}" Tag="{x:Static settings:AudioDeviceSwitchTarget.SystemDefault}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.Foreground}" Tag="{x:Static settings:AudioDeviceSwitchTarget.ForegroundApplication}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Interaction.Disabled}" Tag="{x:Static settings:AudioDeviceSwitchTarget.Disabled}"/>
                                </ComboBox>
                            </components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Audio.Settings.InputCommunications}">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.AudioDevices.SwitchInputCommunications, Mode=TwoWay}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Audio.Settings.InputClick}">
                                <ComboBox MinWidth="180" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.InputDeviceClickTarget, Mode=TwoWay}">
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.System}" Tag="{x:Static settings:AudioDeviceSwitchTarget.SystemDefault}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.Foreground}" Tag="{x:Static settings:AudioDeviceSwitchTarget.ForegroundApplication}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Interaction.Disabled}" Tag="{x:Static settings:AudioDeviceSwitchTarget.Disabled}"/>
                                </ComboBox>
                            </components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Audio.Settings.InputWheel}">
                                <ComboBox MinWidth="180" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.InputDeviceWheelTarget, Mode=TwoWay}">
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.System}" Tag="{x:Static settings:AudioDeviceSwitchTarget.SystemDefault}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.Foreground}" Tag="{x:Static settings:AudioDeviceSwitchTarget.ForegroundApplication}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Interaction.Disabled}" Tag="{x:Static settings:AudioDeviceSwitchTarget.Disabled}"/>
                                </ComboBox>
                            </components:SettingsRow>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </components:SettingsGroup>
                <ui:Button
                    Margin="0,16,0,40"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="{DynamicResource Loc.Common.ResetPageDefaults}"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
