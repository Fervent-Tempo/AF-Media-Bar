<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:AFMediaBar.Classes.Models"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Class="AFMediaBar.Views.Pages.InteractionPage"
    x:Name="InteractionView"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="ExperimentalAudioOptionStyle" BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="ComboBoxItem">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.IsNewAudioControlEnabled, ElementName=InteractionView}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="AudioDevicePermissionTemplate">
            <Border Padding="16,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AfSettingsBorderBrush}">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontSize="14" />
                            <TextBlock Text="{Binding StateText}" Style="{StaticResource AfSettingsHintTextStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="{DynamicResource Loc.Audio.Settings.Allow}" AutomationProperties.Name="{Binding DisplayName}" IsChecked="{Binding IsAllowed, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Text="{Binding BatteryText}" Visibility="{Binding HasBattery, Converter={StaticResource AfBooleanToVisibilityConverter}}" TextWrapping="Wrap" Style="{StaticResource AfSettingsHintTextStyle}" Margin="0,4,0,0" />
                    <StackPanel Visibility="{Binding IsHotkeysEnabled, Converter={StaticResource AfBooleanToVisibilityConverter}}" Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource Loc.Device.Hotkey.Direct}" Style="{StaticResource AfSettingsHintTextStyle}" />
                        <TextBox Text="{Binding Hotkey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MaxLength="80" AutomationProperties.Name="{DynamicResource Loc.Device.Hotkey.Direct}" />
                        <TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" Style="{StaticResource AfSettingsHintTextStyle}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsPersonalizationEnabled, Converter={StaticResource AfBooleanToVisibilityConverter}}" Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource Loc.Device.Alias}" Style="{StaticResource AfSettingsHintTextStyle}" />
                        <TextBox Text="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{DynamicResource Loc.Device.Alias}" MaxLength="120" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox Content="{DynamicResource Loc.Device.Favorite}" IsChecked="{Binding IsFavorite, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ui:Button Content="{DynamicResource Loc.Device.MoveUp}" Command="{Binding MoveUpCommand}" Style="{StaticResource AfSettingsButtonStyle}" />
                            <ui:Button Content="{DynamicResource Loc.Device.MoveDown}" Command="{Binding MoveDownCommand}" Style="{StaticResource AfSettingsButtonStyle}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsOffline, Converter={StaticResource AfBooleanToVisibilityConverter}}" Margin="0,8,0,0">
                            <TextBlock Text="{DynamicResource Loc.Device.RebindHint}" TextWrapping="Wrap" Style="{StaticResource AfSettingsHintTextStyle}" />
                            <ComboBox ItemsSource="{Binding Replacements}" SelectedItem="{Binding Replacement}" DisplayMemberPath="DisplayName" AutomationProperties.Name="{DynamicResource Loc.Device.Rebind}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:Button Content="{DynamicResource Loc.Device.Rebind}" Command="{Binding RebindCommand}" Style="{StaticResource AfSettingsButtonStyle}" />
                                <ui:Button Content="{DynamicResource Loc.Device.Forget}" Command="{Binding ForgetCommand}" Style="{StaticResource AfSettingsButtonStyle}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <components:SettingsGroupStrip
            Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            Grid.Row="0"
            PageIcon="{ui:SymbolIcon HandDraw24}"
            Subtitle="{DynamicResource Loc.Interaction.Header.Subtitle}"
            Target="{Binding ElementName=PageScroll}"
            Title="{DynamicResource Loc.Common.Page.Interaction}" />
        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PageRoot" MaxWidth="{StaticResource AfSettingsContentMaxWidth}" Loaded="OnPageLoaded">
                <components:SettingsGroup
                    GroupId="Common.Group.InAppRestLayer"
                    Description="{DynamicResource Loc.Interaction.InApp.Group.Description}"
                    Header="{DynamicResource Loc.Common.Group.InAppRestLayer}"
                    Icon="{ui:SymbolIcon CursorClick24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="InputGestures" />
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.ArtworkClick.Description}"
                            Icon="{ui:SymbolIcon Play24}"
                            Title="{DynamicResource Loc.Interaction.Row.ArtworkClick.Title}">
                            <ComboBox MinWidth="200" SelectedValue="{Binding ViewModel.ArtworkClickAction, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.PlayPause}"
                                    Tag="{x:Static settings:PlayerClickAction.TogglePlayPause}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.ActivateSourceApplication}"
                                    Tag="{x:Static settings:PlayerClickAction.ActivateSource}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.OpenFullPanel}"
                                    Tag="{x:Static settings:PlayerClickAction.OpenFullPanel}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Disabled}"
                                    Tag="{x:Static settings:PlayerClickAction.Disabled}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow Icon="{ui:SymbolIcon TextQuote24}" Title="{DynamicResource Loc.Interaction.Row.TextClick.Title}">
                            <ComboBox MinWidth="200" SelectedValue="{Binding ViewModel.TextClickAction, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.ActivateSourceApplication}"
                                    Tag="{x:Static settings:PlayerClickAction.ActivateSource}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.PlayPause}"
                                    Tag="{x:Static settings:PlayerClickAction.TogglePlayPause}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.OpenFullPanel}"
                                    Tag="{x:Static settings:PlayerClickAction.OpenFullPanel}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Disabled}"
                                    Tag="{x:Static settings:PlayerClickAction.Disabled}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.ArtworkHover.Description}"
                            Icon="{ui:SymbolIcon ZoomIn24}"
                            Title="{DynamicResource Loc.Interaction.Row.ArtworkHover.Title}">
                            <ComboBox MinWidth="200" SelectedValue="{Binding ViewModel.ArtworkHoverMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Row.ArtworkHover.Mode.Off}"
                                    Tag="{x:Static settings:ArtworkHoverMode.Off}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Row.ArtworkHover.Mode.Zoom}"
                                    Tag="{x:Static settings:ArtworkHoverMode.Zoom}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Row.ArtworkHover.Mode.Preview}"
                                    Tag="{x:Static settings:ArtworkHoverMode.Preview}" />
                            </ComboBox>
                        </components:SettingsRow>
                    </StackPanel>
                </components:SettingsGroup>
                <components:SettingsGroup
                    GroupId="Interaction.Group.Wheel"
                    Header="{DynamicResource Loc.Interaction.Group.Wheel}"
                    Icon="{ui:SymbolIcon Cursor24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="WheelGestures" />
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.PrimaryWheel.Description}"
                            Icon="{ui:SymbolIcon Cursor24}"
                            Title="{DynamicResource Loc.Interaction.Wheel.Primary.Title}">
                            <ComboBox MinWidth="200" SelectedValue="{Binding ViewModel.PrimaryWheelAction, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.PreviousNextTrack}"
                                    Tag="{x:Static settings:WheelAction.PreviousNext}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.SwitchOutputDevice}"
                                    Tag="{x:Static settings:WheelAction.OutputDevice}" />
                                <ComboBoxItem Style="{StaticResource ExperimentalAudioOptionStyle}"
                                    Content="{DynamicResource Loc.Common.SwitchInputDevice}"
                                    Tag="{x:Static settings:WheelAction.InputDevice}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.AdjustCurrentMediaVolume}"
                                    Tag="{x:Static settings:WheelAction.CurrentApplicationVolume}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.SwitchPlayer}"
                                    Tag="{x:Static settings:WheelAction.SwitchMediaSource}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Disabled}"
                                    Tag="{x:Static settings:WheelAction.Disabled}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.ChordWheel.Description}"
                            Icon="{ui:SymbolIcon Keyboard24}"
                            Title="{DynamicResource Loc.Interaction.Wheel.Chord.Title}">
                            <ComboBox MinWidth="200" SelectedValue="{Binding ViewModel.ChordWheelAction, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.SwitchPlayer}"
                                    Tag="{x:Static settings:WheelAction.SwitchMediaSource}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.AdjustCurrentMediaVolume}"
                                    Tag="{x:Static settings:WheelAction.CurrentApplicationVolume}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.SwitchOutputDevice}"
                                    Tag="{x:Static settings:WheelAction.OutputDevice}" />
                                <ComboBoxItem Style="{StaticResource ExperimentalAudioOptionStyle}"
                                    Content="{DynamicResource Loc.Common.SwitchInputDevice}"
                                    Tag="{x:Static settings:WheelAction.InputDevice}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.PreviousNextTrack}"
                                    Tag="{x:Static settings:WheelAction.PreviousNext}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Disabled}"
                                    Tag="{x:Static settings:WheelAction.Disabled}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.Modifier.Description}"
                            Icon="{ui:SymbolIcon Keyboard24}"
                            Title="{DynamicResource Loc.Interaction.Row.Modifier.Title}">
                            <ComboBox MinWidth="150" SelectedValue="{Binding ViewModel.Modifier, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.Modifier.Shift}"
                                    Tag="{x:Static settings:InteractionModifier.Shift}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.Modifier.LeftMouseButton}"
                                    Tag="{x:Static settings:InteractionModifier.LeftMouseButton}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.Modifier.RightMouseButton}"
                                    Tag="{x:Static settings:InteractionModifier.RightMouseButton}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.WheelTooltip.Description}"
                            Icon="{ui:SymbolIcon Info24}"
                            Title="{DynamicResource Loc.Interaction.Row.WheelTooltip.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.ShowWheelTooltips, Mode=TwoWay}" />
                        </components:SettingsRow>
                        <components:SettingsCallout
                            Margin="0,4,0,0"
                            IsAccent="False"
                            Symbol="Info24"
                            Text="{DynamicResource Loc.Interaction.SharedModifier.Callout}" />
                    </StackPanel>
                </components:SettingsGroup>
                <components:SettingsGroup GroupId="Common.TrayIcon" Header="{DynamicResource Loc.Common.TrayIcon}" Icon="{ui:SymbolIcon Apps24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="TrayOverflow" />
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.TrayClick.Description}"
                            Icon="{ui:SymbolIcon CursorClick24}"
                            Title="{DynamicResource Loc.Interaction.Row.TrayClick.Title}">
                            <ComboBox MinWidth="200" SelectedValue="{Binding ViewModel.TrayClickAction, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.TrayAction.OpenAudioControl}"
                                    Tag="{x:Static settings:TrayClickAction.OpenAudioControl}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.TrayAction.OpenOutputDeviceMenu}"
                                    Tag="{x:Static settings:TrayClickAction.OpenOutputDeviceMenu}" />
                                <ComboBoxItem Style="{StaticResource ExperimentalAudioOptionStyle}"
                                    Content="{DynamicResource Loc.Common.InputDevice}"
                                    Tag="{x:Static settings:TrayClickAction.OpenInputDeviceMenu}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.TrayAction.OpenCurrentAppVolumeMenu}"
                                    Tag="{x:Static settings:TrayClickAction.OpenCurrentAppVolumeMenu}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.TrayAction.OpenSettings}"
                                    Tag="{x:Static settings:TrayClickAction.OpenSettings}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.TrayAction.OpenContextMenu}"
                                    Tag="{x:Static settings:TrayClickAction.OpenContextMenu}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Disabled}"
                                    Tag="{x:Static settings:TrayClickAction.None}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Interaction.Row.TrayPrimaryWheel.Description}"
                            Icon="{ui:SymbolIcon Cursor24}"
                            Title="{DynamicResource Loc.Interaction.Wheel.Primary.Title}">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.TrayPrimaryWheelAction, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.SwitchOutputDevice}"
                                    Tag="{x:Static settings:TrayWheelBehavior.SwitchOutputDevice}" />
                                <ComboBoxItem Style="{StaticResource ExperimentalAudioOptionStyle}"
                                    Content="{DynamicResource Loc.Common.SwitchInputDevice}"
                                    Tag="{x:Static settings:TrayWheelBehavior.SwitchInputDevice}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Common.AdjustCurrentMediaVolume}"
                                    Tag="{x:Static settings:TrayWheelBehavior.AdjustVolume}" />
                                <ComboBoxItem
                                    Content="{DynamicResource Loc.Interaction.Disabled}"
                                    Tag="{x:Static settings:TrayWheelBehavior.Disabled}" />
                            </ComboBox>
                        </components:SettingsRow>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup GroupId="Audio.Settings.Title" Header="{DynamicResource Loc.Audio.Settings.Title}"
                    Visibility="{Binding ViewModel.IsNewAudioControlEnabled, Converter={StaticResource AfBooleanToVisibilityConverter}}"
                    Description="{DynamicResource Loc.Audio.Settings.Description}" Icon="{ui:SymbolIcon Speaker224}">
                    <StackPanel>
                        <components:SettingsCallout IsAccent="False" Symbol="Info24" Margin="0,0,0,12" Text="{DynamicResource Loc.Audio.Settings.AvailabilityHint}" />
                        <StackPanel Visibility="{Binding ViewModel.AudioDevices.IsBatteryEnabled, Converter={StaticResource AfBooleanToVisibilityConverter}}" Margin="0,0,0,12">
                            <components:SettingsCallout Text="{DynamicResource Loc.Battery.Hint}" Symbol="Info24" IsAccent="False" />
                            <components:SettingsRow Title="{DynamicResource Loc.Battery.Notify}"><ui:ToggleSwitch IsChecked="{Binding ViewModel.AudioDevices.LowBatteryNotifications, Mode=TwoWay}" /></components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Battery.Threshold}" Visibility="{Binding ViewModel.AudioDevices.LowBatteryNotifications, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal"><Slider Minimum="5" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding ViewModel.AudioDevices.LowBatteryThreshold, Mode=TwoWay}" Width="160" Style="{StaticResource AfAccentSliderStyle}" />
                                    <TextBlock Text="{Binding ViewModel.AudioDevices.LowBatteryThreshold, StringFormat={}{0}%}" VerticalAlignment="Center" Margin="8,0,0,0" /></StackPanel>
                            </components:SettingsRow>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ViewModel.AudioDevices.IsHotkeysEnabled, Converter={StaticResource AfBooleanToVisibilityConverter}}" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource Loc.Device.Hotkey.Hint}" TextWrapping="Wrap" Style="{StaticResource AfSettingsHintTextStyle}" />
                            <components:SettingsRow Title="{DynamicResource Loc.Device.Hotkey.CycleOutput}"><TextBox Text="{Binding ViewModel.AudioDevices.OutputCycleHotkey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MinWidth="180" MaxLength="80" AutomationProperties.Name="{DynamicResource Loc.Device.Hotkey.CycleOutput}" /></components:SettingsRow>
                            <TextBlock Text="{Binding ViewModel.AudioDevices.OutputCycleStatus}" Style="{StaticResource AfSettingsHintTextStyle}" />
                            <components:SettingsRow Title="{DynamicResource Loc.Device.Hotkey.CycleInput}"><TextBox Text="{Binding ViewModel.AudioDevices.InputCycleHotkey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MinWidth="180" MaxLength="80" AutomationProperties.Name="{DynamicResource Loc.Device.Hotkey.CycleInput}" /></components:SettingsRow>
                            <TextBlock Text="{Binding ViewModel.AudioDevices.InputCycleStatus}" Style="{StaticResource AfSettingsHintTextStyle}" />
                        </StackPanel>
                        <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon Speaker224}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Common.OutputDevice}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Audio.Settings.OutputList}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding ViewModel.AudioDevices.OutputDevices}"
                                              ItemTemplate="{StaticResource AudioDevicePermissionTemplate}" />
                                <Expander Margin="12,8,12,12" HorizontalContentAlignment="Stretch">
                                    <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.AudioDevices.OtherOutputDevices.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers></Style></Expander.Style>
                                    <Expander.Header><TextBlock><Run Text="{DynamicResource Loc.Audio.Settings.OtherDevices}" /><Run Text=" " /><Run Text="{Binding ViewModel.AudioDevices.OtherOutputDevices.Count, Mode=OneWay, StringFormat={}{0}}" /></TextBlock></Expander.Header>
                                    <ItemsControl ItemsSource="{Binding ViewModel.AudioDevices.OtherOutputDevices}" ItemTemplate="{StaticResource AudioDevicePermissionTemplate}" />
                                </Expander>
                            </StackPanel>
                        </ui:CardExpander>
                        <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon Mic24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Common.InputDevice}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Audio.Settings.InputList}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding ViewModel.AudioDevices.InputDevices}"
                                              ItemTemplate="{StaticResource AudioDevicePermissionTemplate}" />
                                <Expander Margin="12,8,12,12" HorizontalContentAlignment="Stretch">
                                    <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.AudioDevices.OtherInputDevices.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers></Style></Expander.Style>
                                    <Expander.Header><TextBlock><Run Text="{DynamicResource Loc.Audio.Settings.OtherDevices}" /><Run Text=" " /><Run Text="{Binding ViewModel.AudioDevices.OtherInputDevices.Count, Mode=OneWay, StringFormat={}{0}}" /></TextBlock></Expander.Header>
                                    <ItemsControl ItemsSource="{Binding ViewModel.AudioDevices.OtherInputDevices}" ItemTemplate="{StaticResource AudioDevicePermissionTemplate}" />
                                </Expander>
                            </StackPanel>
                        </ui:CardExpander>
                        <TextBlock Text="{Binding ViewModel.AudioDevices.StatusText}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.AudioDevices.StatusText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon Options24}" Margin="0,12,0,4">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Audio.Settings.Advanced}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Audio.Settings.AdvancedDescription}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="16,0,16,12">
                                <TextBlock Text="{DynamicResource Loc.Common.OutputDevice}" Style="{StaticResource AfSettingsCardTitleStyle}" Margin="0,12,0,8" />
                            <components:SettingsRow Title="{DynamicResource Loc.Audio.Settings.OutputCommunications}">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.AudioDevices.SwitchOutputCommunications, Mode=TwoWay}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Audio.Settings.OutputClick}">
                                <ComboBox MinWidth="{StaticResource AfSettingsSelectMinWidth}" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.OutputDeviceClickTarget, Mode=TwoWay}">
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.System}" Tag="{x:Static settings:AudioDeviceSwitchTarget.SystemDefault}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.Foreground}" Tag="{x:Static settings:AudioDeviceSwitchTarget.ForegroundApplication}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Interaction.Disabled}" Tag="{x:Static settings:AudioDeviceSwitchTarget.Disabled}"/>
                                </ComboBox>
                            </components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Audio.Settings.OutputWheel}">
                                <ComboBox MinWidth="{StaticResource AfSettingsSelectMinWidth}" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.OutputDeviceWheelTarget, Mode=TwoWay}">
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.System}" Tag="{x:Static settings:AudioDeviceSwitchTarget.SystemDefault}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.Foreground}" Tag="{x:Static settings:AudioDeviceSwitchTarget.ForegroundApplication}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Interaction.Disabled}" Tag="{x:Static settings:AudioDeviceSwitchTarget.Disabled}"/>
                                </ComboBox>
                            </components:SettingsRow>
                            <TextBlock Text="{DynamicResource Loc.Common.InputDevice}" Style="{StaticResource AfSettingsCardTitleStyle}" Margin="0,16,0,8" />
                            <components:SettingsRow Title="{DynamicResource Loc.Audio.Settings.InputCommunications}">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.AudioDevices.SwitchInputCommunications, Mode=TwoWay}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Audio.Settings.InputClick}">
                                <ComboBox MinWidth="{StaticResource AfSettingsSelectMinWidth}" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.InputDeviceClickTarget, Mode=TwoWay}">
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.System}" Tag="{x:Static settings:AudioDeviceSwitchTarget.SystemDefault}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.Foreground}" Tag="{x:Static settings:AudioDeviceSwitchTarget.ForegroundApplication}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Interaction.Disabled}" Tag="{x:Static settings:AudioDeviceSwitchTarget.Disabled}"/>
                                </ComboBox>
                            </components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Audio.Settings.InputWheel}">
                                <ComboBox MinWidth="{StaticResource AfSettingsSelectMinWidth}" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.InputDeviceWheelTarget, Mode=TwoWay}">
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.System}" Tag="{x:Static settings:AudioDeviceSwitchTarget.SystemDefault}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Audio.Target.Foreground}" Tag="{x:Static settings:AudioDeviceSwitchTarget.ForegroundApplication}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Interaction.Disabled}" Tag="{x:Static settings:AudioDeviceSwitchTarget.Disabled}"/>
                                </ComboBox>
                            </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>
                <ui:Button
                    Margin="0,16,0,40"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="{DynamicResource Loc.Common.ResetPageDefaults}"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
