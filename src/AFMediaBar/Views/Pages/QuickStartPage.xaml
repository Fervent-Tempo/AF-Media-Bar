<!-- 教程和兼容性使用本地纯文本，页面不执行安装或播放器探测。 -->
<Page x:Class="AFMediaBar.Views.Pages.QuickStartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:components="clr-namespace:AFMediaBar.Components"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="{DynamicResource AppTextFontFamily}"
    TextElement.FontWeight="{DynamicResource AppTextFontWeight}" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <components:SettingsGroupStrip Margin="{StaticResource AfSettingsHeaderMargin}" MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            PageIcon="{ui:SymbolIcon BookOpen24}" Target="{Binding ElementName=PageScroll}" Title="{DynamicResource Loc.Common.Page.QuickStart}"
            Subtitle="{DynamicResource Loc.QuickStart.Subtitle}" />
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" Margin="{StaticResource AfSettingsScrollMargin}"
            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="{StaticResource AfSettingsContentMaxWidth}">
                <components:SettingsGroup GroupId="QuickStart.Latest" Header="{DynamicResource Loc.QuickStart.Latest}" Icon="{ui:SymbolIcon Sparkle24}">
                    <StackPanel>
                        <TextBlock Text="{Binding ViewModel.LatestVersion}" Foreground="{DynamicResource AfAccentBrush}" FontSize="22" />
                        <TextBlock Text="{Binding ViewModel.LatestTitle}" FontSize="16" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding ViewModel.Highlights}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6" />
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <components:SettingsNavigationButton Destination="ReleaseHighlights" Content="{DynamicResource Loc.QuickStart.AllReleases}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </components:SettingsGroup>
                <components:SettingsGroup GroupId="QuickStart.Basics" Header="{DynamicResource Loc.QuickStart.Basics}" Icon="{ui:SymbolIcon BookOpen24}">
                    <StackPanel>
                    <Expander Header="{DynamicResource Loc.QuickStart.Tutorial.Playback.Title}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                        <StackPanel Margin="12,8,12,12">
                            <TextBlock Text="{DynamicResource Loc.QuickStart.Tutorial.Playback.Body}" TextWrapping="Wrap" FontSize="14" />
                            <components:SettingsNavigationButton Destination="MediaAndNotifications" GroupId="Common.MediaSource"
                                Content="{DynamicResource Loc.QuickStart.OpenSettings}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>
                    </Expander>
                    <Expander Header="{DynamicResource Loc.QuickStart.Tutorial.Placement.Title}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                        <StackPanel Margin="12,8,12,12">
                            <TextBlock Text="{DynamicResource Loc.QuickStart.Tutorial.Placement.Body}" TextWrapping="Wrap" FontSize="14" />
                            <components:SettingsNavigationButton Destination="ScreenAndPlacement" GroupId="Common.Group.ScreenAndPlacement"
                                Content="{DynamicResource Loc.QuickStart.OpenSettings}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>
                    </Expander>
                    <Expander Header="{DynamicResource Loc.QuickStart.Tutorial.Appearance.Title}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                        <StackPanel Margin="12,8,12,12">
                            <TextBlock Text="{DynamicResource Loc.QuickStart.Tutorial.Appearance.Body}" TextWrapping="Wrap" FontSize="14" />
                            <components:SettingsNavigationButton Destination="Components" GroupId="Common.RestLayer"
                                Content="{DynamicResource Loc.QuickStart.OpenSettings}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>
                    </Expander>
                    <Expander Header="{DynamicResource Loc.QuickStart.Tutorial.Lyrics.Title}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                        <StackPanel Margin="12,8,12,12">
                            <TextBlock Text="{DynamicResource Loc.QuickStart.Tutorial.Lyrics.Body}" TextWrapping="Wrap" FontSize="14" />
                            <components:SettingsNavigationButton Destination="Lyrics" GroupId="Common.Group.LyricsSources"
                                Content="{DynamicResource Loc.QuickStart.OpenSettings}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>
                    </Expander>
                    </StackPanel>
                </components:SettingsGroup>
                <components:SettingsGroup GroupId="QuickStart.Players" Header="{DynamicResource Loc.QuickStart.Players}" Icon="{ui:SymbolIcon MusicNote224}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.QuickStart.Reference}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <ui:TextBox PlaceholderText="{DynamicResource Loc.QuickStart.Search}" Background="{DynamicResource AfSettingsInputBrush}" Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                            AutomationProperties.Name="{DynamicResource Loc.QuickStart.Search}" ToolTip="{DynamicResource Loc.QuickStart.Search}" />
                        <TextBlock Text="{DynamicResource Loc.Plugins.Empty}" Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource AfBooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding ViewModel.Players}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Expander HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                                    <Expander.Header>
                                        <StackPanel>
                                            <WrapPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="{DynamicResource AppTextStrongFontWeight}" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding Profile.Version}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Recommendation}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="12,8,12,12">
                                        <TextBlock Text="{Binding Capabilities}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding AfNote}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding Note}" FontSize="14" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <components:SettingsNavigationButton Destination="PluginCenter" GroupId="Plugins.Catalog"
                                                Content="{DynamicResource Loc.QuickStart.ViewPlugin}" Margin="0,0,8,8"
                                                Visibility="{Binding HasPlugin, Converter={StaticResource AfBooleanToVisibilityConverter}}" />
                                            <ui:Button Content="{DynamicResource Loc.QuickStart.Source}" Command="{Binding OpenSourceCommand}"
                                                Style="{StaticResource AfSettingsButtonStyle}" Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </components:SettingsGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
