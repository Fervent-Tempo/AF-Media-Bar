<Page x:Class="AFMediaBar.Views.Pages.QuickStartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}" Unloaded="OnPageUnloaded">
    <Page.Resources>
        <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}"/>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="TableCell" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Margin" Value="10,12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>
    <components:SettingsPageLayout x:Name="PageLayout">
        <components:SettingsPageLayout.Header>
            <components:SettingsGroupStrip Title="{DynamicResource Loc.Settings.Section.Start}"
                Subtitle="{DynamicResource Loc.Start.Description}" PageIcon="{ui:SymbolIcon Sparkle24}"
                Target="{Binding ScrollViewer, ElementName=PageLayout}"/>
        </components:SettingsPageLayout.Header>
        <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded">
            <components:SettingsGroup GroupId="Start.Overview" Header="{DynamicResource Loc.Start.Overview}" Icon="{ui:SymbolIcon Layer24}">
                <StackPanel Margin="16">
                    <TextBlock FontSize="26" FontWeight="{DynamicResource AppTextStrongFontWeight}" Text="AF Media Bar"/>
                    <TextBlock Margin="0,8,0,20" Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Intro.Description}"/>
                    <WrapPanel Margin="-6,0">
                        <Border Width="276" Margin="6,0,6,12" Padding="18" CornerRadius="10"
                            Background="{DynamicResource AfSettingsCardBrush}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Layer24" FontSize="32" HorizontalAlignment="Left" Margin="0,0,0,18" Foreground="{DynamicResource AfAccentBrush}"/>
                                <TextBlock FontSize="16" FontWeight="{DynamicResource AppTextStrongFontWeight}" Text="{DynamicResource Loc.Start.Rest}"/>
                                <TextBlock Margin="0,8,0,16" MinHeight="80" Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Rest.Description}"/>
                                <components:SettingsNavigationButton HorizontalAlignment="Left" Destination="RestState" GroupId="Common.RestLayer" Content="{DynamicResource Loc.Settings.Component.Configure}"/>
                            </StackPanel>
                        </Border>
                        <Border Width="276" Margin="6,0,6,12" Padding="18" CornerRadius="10"
                            Background="{DynamicResource AfSettingsCardBrush}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Play24" FontSize="32" HorizontalAlignment="Left" Margin="0,0,0,18" Foreground="{DynamicResource AfAccentBrush}"/>
                                <TextBlock FontSize="16" FontWeight="{DynamicResource AppTextStrongFontWeight}" Text="{DynamicResource Loc.Start.Hover}"/>
                                <TextBlock Margin="0,8,0,16" MinHeight="80" Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Hover.Description}"/>
                                <components:SettingsNavigationButton HorizontalAlignment="Left" Destination="Components" GroupId="Common.HoverLayer" Content="{DynamicResource Loc.Settings.Component.Configure}"/>
                            </StackPanel>
                        </Border>
                        <Border Width="276" Margin="6,0,6,12" Padding="18" CornerRadius="10"
                            Background="{DynamicResource AfSettingsCardBrush}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="WindowConsole20" FontSize="32" HorizontalAlignment="Left" Margin="0,0,0,18" Foreground="{DynamicResource AfAccentBrush}"/>
                                <TextBlock FontSize="16" FontWeight="{DynamicResource AppTextStrongFontWeight}" Text="{DynamicResource Loc.Start.Full}"/>
                                <TextBlock Margin="0,8,0,16" MinHeight="80" Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Full.Description}"/>
                                <components:SettingsNavigationButton HorizontalAlignment="Left" Destination="FullPanel" GroupId="Common.FullLayer" Content="{DynamicResource Loc.Settings.Component.Configure}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Start.Tutorials" Header="{DynamicResource Loc.Start.Tutorials}" Icon="{ui:SymbolIcon BookOpen24}">
                <StackPanel>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon Desktop24}"><ui:CardExpander.Header><StackPanel><TextBlock FontSize="15" TextWrapping="Wrap" Text="{DynamicResource Loc.Start.Tutorial.Mode}"/><TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" Text="{DynamicResource Loc.Start.Tutorial.Mode.Short}"/></StackPanel></ui:CardExpander.Header>
                        <StackPanel Margin="12">
                            <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Tutorial.Mode.Body}"/>
                            <components:SettingsNavigationButton HorizontalAlignment="Left" Margin="0,16,0,0" Destination="ScreenAndPlacement" GroupId="Common.Group.ChooseDisplayMode" Content="{DynamicResource Loc.Settings.Component.Configure}"/>
                        </StackPanel>
                    </ui:CardExpander>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon Play24}"><ui:CardExpander.Header><StackPanel><TextBlock FontSize="15" TextWrapping="Wrap" Text="{DynamicResource Loc.Start.Tutorial.Playback}"/><TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" Text="{DynamicResource Loc.Start.Tutorial.Playback.Short}"/></StackPanel></ui:CardExpander.Header>
                        <StackPanel Margin="12">
                            <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Tutorial.Playback.Body}"/>
                            <components:SettingsNavigationButton HorizontalAlignment="Left" Margin="0,16,0,0" Destination="MediaAndNotifications" GroupId="Common.MediaSource" Content="{DynamicResource Loc.Settings.Component.Configure}"/>
                        </StackPanel>
                    </ui:CardExpander>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon TextQuote24}"><ui:CardExpander.Header><StackPanel><TextBlock FontSize="15" TextWrapping="Wrap" Text="{DynamicResource Loc.Start.Tutorial.Lyrics}"/><TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" Text="{DynamicResource Loc.Start.Tutorial.Lyrics.Short}"/></StackPanel></ui:CardExpander.Header>
                        <StackPanel Margin="12">
                            <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Tutorial.Lyrics.Body}"/>
                            <components:SettingsNavigationButton HorizontalAlignment="Left" Margin="0,16,0,0" Destination="Lyrics" GroupId="Common.Group.LyricsSources" Content="{DynamicResource Loc.Settings.Component.Configure}"/>
                        </StackPanel>
                    </ui:CardExpander>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon Headphones24}"><ui:CardExpander.Header><StackPanel><TextBlock FontSize="15" TextWrapping="Wrap" Text="{DynamicResource Loc.Start.Tutorial.Devices}"/><TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" Text="{DynamicResource Loc.Start.Tutorial.Devices.Short}"/></StackPanel></ui:CardExpander.Header>
                        <StackPanel Margin="12">
                            <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Tutorial.Devices.Body}"/>
                            <components:SettingsNavigationButton HorizontalAlignment="Left" Margin="0,16,0,0" Destination="DeviceManagement" GroupId="Common.OutputDevice" Content="{DynamicResource Loc.Settings.Component.Configure}"/>
                        </StackPanel>
                    </ui:CardExpander>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon HandDraw24}"><ui:CardExpander.Header><StackPanel><TextBlock FontSize="15" TextWrapping="Wrap" Text="{DynamicResource Loc.Start.Tutorial.Daily}"/><TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" Text="{DynamicResource Loc.Start.Tutorial.Daily.Short}"/></StackPanel></ui:CardExpander.Header>
                        <StackPanel Margin="12">
                            <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Tutorial.Daily.Body}"/>
                            <components:SettingsNavigationButton HorizontalAlignment="Left" Margin="0,16,0,0" Destination="Interaction" GroupId="Interaction.Group.Wheel" Content="{DynamicResource Loc.Settings.Component.Configure}"/>
                        </StackPanel>
                    </ui:CardExpander>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Start.Releases" Header="{DynamicResource Loc.Start.Releases}" Icon="{ui:SymbolIcon Sparkle24}">
                <StackPanel Margin="16">
                    <TextBlock FontSize="20" FontWeight="{DynamicResource AppTextStrongFontWeight}" Text="{DynamicResource Loc.Start.Release16}"/>
                    <TextBlock Margin="0,12,0,12" Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Release16.Body}"/>
                    <ui:Anchor HorizontalAlignment="Left" Content="{DynamicResource Loc.Start.ReleaseNotes}" NavigateUri="https://github.com/Fervent-Tempo/AF-Media-Bar/releases/tag/v1.6.0"/>
                    <Border Margin="0,24,0,20" Padding="16" Background="{DynamicResource AfSettingsCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="{DynamicResource AppTextStrongFontWeight}" Text="{DynamicResource Loc.Start.Development}"/>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Development.Body}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock FontSize="15" FontWeight="{DynamicResource AppTextStrongFontWeight}" Text="{DynamicResource Loc.Start.History}"/>
                    <TextBlock Margin="0,8,0,12" Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.History.Description}"/>
                    <ItemsControl ItemsSource="{Binding ViewModel.History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}"><ui:CardExpander.Header><StackPanel><TextBlock FontSize="15" TextWrapping="Wrap" Text="{Binding VersionLabel}"/><TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" Text="{Binding DisplayTitle}"/></StackPanel></ui:CardExpander.Header>
                                    <StackPanel Margin="12">
                                        <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding OriginalNotice}" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding Highlights}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Style="{StaticResource BodyText}" Margin="0,4" Text="{Binding}"/></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ui:CardExpander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <components:SettingsNavigationButton Margin="0,16,0,0" HorizontalAlignment="Left" Destination="ReleaseHighlights" Content="{DynamicResource Loc.Common.Page.ReleaseHighlights}"/>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Start.Players" Header="{DynamicResource Loc.Start.Players}" Icon="{ui:SymbolIcon MusicNote220}">
                <StackPanel Margin="16">
                    <TextBlock Margin="0,0,0,12" Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Players.Note}"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid MinWidth="860">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.ColumnSpan="6" Background="{DynamicResource AfSettingsCardBrush}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.Player}" FontWeight="{DynamicResource AppTextStrongFontWeight}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.Metadata}" FontWeight="{DynamicResource AppTextStrongFontWeight}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.Control}" FontWeight="{DynamicResource AppTextStrongFontWeight}"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.Timeline}" FontWeight="{DynamicResource AppTextStrongFontWeight}"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.Lyrics}" FontWeight="{DynamicResource AppTextStrongFontWeight}"/>
                            <TextBlock Grid.Row="0" Grid.Column="5" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.Plugins}" FontWeight="{DynamicResource AppTextStrongFontWeight}"/>
                            <Border Grid.Row="1" Grid.ColumnSpan="6" Background="{DynamicResource AfSettingsCardBrush}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.NetEase}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.MemoryAndSmtc}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource TableCell}" Text="SMTC"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.MemoryTimeline}"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.NetEaseLyrics}"/>
                            <TextBlock Grid.Row="1" Grid.Column="5" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.BuiltIn}"/>
                            <Border Grid.Row="2" Grid.ColumnSpan="6" Background="{DynamicResource AfSettingsCardBrush}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.KuGou}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TableCell}" Text="SMTC"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource TableCell}" Text="SMTC"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.MemoryTimeline}"/>
                            <TextBlock Grid.Row="2" Grid.Column="4" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.OnlineLyrics}"/>
                            <TextBlock Grid.Row="2" Grid.Column="5" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.BuiltIn}"/>
                            <Border Grid.Row="3" Grid.ColumnSpan="6" Background="{DynamicResource AfSettingsCardBrush}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.OtherSmtc}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource TableCell}" Text="SMTC"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.SessionDependent}"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.SessionDependent}"/>
                            <TextBlock Grid.Row="3" Grid.Column="4" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.OnlineLyrics}"/>
                            <TextBlock Grid.Row="3" Grid.Column="5" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.NoPlugin}"/>
                            <Border Grid.Row="4" Grid.ColumnSpan="6" Background="{DynamicResource AfSettingsCardBrush}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.NoSmtc}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.NotDetected}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource TableCell}" Text="—"/>
                            <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource TableCell}" Text="—"/>
                            <TextBlock Grid.Row="4" Grid.Column="4" Style="{StaticResource TableCell}" Text="—"/>
                            <TextBlock Grid.Row="4" Grid.Column="5" Style="{StaticResource TableCell}" Text="{DynamicResource Loc.Start.UnverifiedPlugin}"/>
                        </Grid>
                    </ScrollViewer>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Start.Shortcuts" Header="{DynamicResource Loc.Start.Shortcuts}" Icon="{ui:SymbolIcon ArrowRight24}">
                <WrapPanel Margin="12">
                    <components:SettingsNavigationButton Margin="4" Destination="ScreenAndPlacement" GroupId="Common.Group.ChooseDisplayMode" Content="{DynamicResource Loc.Common.Page.ScreenAndPlacement}"/>
                    <components:SettingsNavigationButton Margin="4" Destination="ApplicationAppearance" GroupId="Settings.Personalization.Accent" Content="{DynamicResource Loc.Common.Page.ApplicationAppearance}"/>
                    <components:SettingsNavigationButton Margin="4" Destination="RestState" GroupId="Common.RestLayer" Content="{DynamicResource Loc.Common.Page.RestState}"/>
                    <components:SettingsNavigationButton Margin="4" Destination="Lyrics" GroupId="Common.Group.MediaBarText" Content="{DynamicResource Loc.Settings.Page.TextAndLyrics}"/>
                    <components:SettingsNavigationButton Margin="4" Destination="DeviceManagement" GroupId="Common.OutputDevice" Content="{DynamicResource Loc.Settings.Page.AudioDevices}"/>
                    <components:SettingsNavigationButton Margin="4" Destination="Configuration" GroupId="Common.Group.SettingsFile" Content="{DynamicResource Loc.Settings.Page.Configuration}"/>
                </WrapPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Start.Help" Header="{DynamicResource Loc.Start.Help}" Icon="{ui:SymbolIcon QuestionCircle24}">
                <StackPanel>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon QuestionCircle24}"><ui:CardExpander.Header><StackPanel><TextBlock FontSize="15" TextWrapping="Wrap" Text="{DynamicResource Loc.Start.Faq.Source}"/></StackPanel></ui:CardExpander.Header>
                        <TextBlock Margin="16" Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Faq.Source.Body}"/>
                    </ui:CardExpander>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon QuestionCircle24}"><ui:CardExpander.Header><StackPanel><TextBlock FontSize="15" TextWrapping="Wrap" Text="{DynamicResource Loc.Start.Faq.Lyrics}"/></StackPanel></ui:CardExpander.Header>
                        <TextBlock Margin="16" Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Faq.Lyrics.Body}"/>
                    </ui:CardExpander>
                    <Border Padding="16">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="{DynamicResource AppTextStrongFontWeight}" Text="{DynamicResource Loc.Start.Runtime}"/>
                            <TextBlock Margin="0,8,0,16" Style="{StaticResource BodyText}" Text="{DynamicResource Loc.Start.Runtime.Body}"/>
                            <WrapPanel>
                                <ui:Anchor Margin="0,0,20,8" Content="{DynamicResource Loc.Start.ProjectHelp}" NavigateUri="https://github.com/Fervent-Tempo/AF-Media-Bar#readme"/>
                                <ui:Anchor Margin="0,0,20,8" Content="{DynamicResource Loc.Start.Report}" NavigateUri="https://github.com/Fervent-Tempo/AF-Media-Bar/issues"/>
                                <ui:Anchor Margin="0,0,20,8" Content="{DynamicResource Loc.Start.WebView}" NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </components:SettingsGroup>
        </StackPanel>
    </components:SettingsPageLayout>
</Page>
