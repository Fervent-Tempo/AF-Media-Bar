<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:AFMediaBar.Components" xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="AFMediaBar.Views.Pages.FullPanelPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="FixedLengthRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Setter Property="IsEnabled" Value="{Binding ViewModel.Layout.CanEditFixedTaskbarLength}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.Layout.FollowMediaTextLength}" Value="True">
                    <Setter Property="Badge" Value="{DynamicResource Loc.DisplayModes.Width.Row.Fixed.Badge}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FixedWidthRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.Lyrics.CanConfigureFixedWidth}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Lyrics.Row.FixedWidth.Badge}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmallArtworkRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Setter Property="IsEnabled" Value="{Binding ViewModel.Layers.RestArtworkVisible}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.Layers.RestArtworkVisible}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.DisplayModes.Rest.Row.SmallArtwork.Badge}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HoverDependencyHintStyle" BasedOn="{StaticResource AfSettingsHintTextStyle}" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.Layers.HoverLayerEnabled}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}"/>
        <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}"/>
    </Page.Resources>
    <components:SettingsPageLayout x:Name="PageLayout">
        <components:SettingsPageLayout.Header>
            <components:SettingsGroupStrip Title="{DynamicResource Loc.Settings.Page.FullPanel}" Subtitle="{DynamicResource Loc.Settings.Page.FullPanel.Description}" PageIcon="{ui:SymbolIcon WindowConsole20}" Target="{Binding ScrollViewer, ElementName=PageLayout}">
                <components:SettingsGroupStrip.HeaderActions>
                    <ui:Button Content="{DynamicResource Loc.Common.ResetPageDefaults}" Style="{StaticResource AfSettingsButtonStyle}" Click="ResetButton_Click" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top"/>
                </components:SettingsGroupStrip.HeaderActions>
            </components:SettingsGroupStrip>
        </components:SettingsPageLayout.Header>
        <components:SettingsPageLayout.Preview>
            <components:SettingsPreview xmlns:components="clr-namespace:AFMediaBar.Components" DataContext="{Binding Preview}"/>
        </components:SettingsPageLayout.Preview>
        <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded">
            <components:SettingsGroup GroupId="Common.FullLayer" Description="{DynamicResource Loc.DisplayModes.Full.Group.Description}" Header="{DynamicResource Loc.Common.FullLayer}" Icon="{ui:SymbolIcon ProjectionScreen24}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Settings.Group.Entry}" Style="{StaticResource AfSettingsSubsectionTitleStyle}"/>
                    <components:SettingsRow Description="{DynamicResource Loc.DisplayModes.Rest.Row.Entry.Description}" Icon="{ui:SymbolIcon ChevronUp24}" Title="{DynamicResource Loc.DisplayModes.Rest.Row.Entry.Title}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.FullPanelEntryVisible, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <components:SettingsRow Title="{DynamicResource Loc.DisplayModes.Full.Entry.Trigger}" Icon="{ui:SymbolIcon CursorClick24}">
                        <ComboBox SelectedIndex="{Binding ViewModel.Layers.FullPanelEntryTriggerIndex, Mode=TwoWay}" MinWidth="{StaticResource AfSettingsSelectMinWidth}">
                            <ComboBoxItem Content="{DynamicResource Loc.DisplayModes.Full.Entry.Click}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.DisplayModes.Full.Entry.Hover}"/>
                        </ComboBox>
                    </components:SettingsRow>
                    <components:SettingsRow Title="{DynamicResource Loc.DisplayModes.Full.Entry.HoverDelay.Title}" Description="{DynamicResource Loc.DisplayModes.Full.Entry.HoverDelay.Description}" Icon="{ui:SymbolIcon Timer24}" Visibility="{Binding ViewModel.Layers.UsesFullPanelEntryHover, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                        <components:SettingsNumericEditor Value="{Binding ViewModel.Layers.FullPanelEntryHoverDelaySeconds, Mode=TwoWay}" Minimum="{Binding Source={x:Static settings:TaskbarExperienceSettings.MinimumFullPanelEntryHoverDelaySeconds}}" Maximum="{Binding Source={x:Static settings:TaskbarExperienceSettings.MaximumFullPanelEntryHoverDelaySeconds}}" Step="{Binding Source={x:Static settings:TaskbarExperienceSettings.FullPanelEntryHoverDelayStepSeconds}}" Unit="{DynamicResource Loc.Settings.Numeric.Seconds}"/>
                    </components:SettingsRow>
                    <TextBlock Text="{DynamicResource Loc.Settings.Group.PanelSections}" Style="{StaticResource AfSettingsSubsectionTitleStyle}"/>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon Info24}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.DisplayModes.Full.Expander.Title}"/>
                                <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.DisplayModes.Full.Expander.Description}"/>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <components:SettingsRow Description="{DynamicResource Loc.DisplayModes.Full.Row.Preset.Description}" Icon="{ui:SymbolIcon ArrowSync24}" IsNested="True" Title="{DynamicResource Loc.DisplayModes.Full.Row.Preset.Title}">
                                <WrapPanel Style="{StaticResource AfSettingsActionsStyle}">
                                    <ui:Button Margin="{StaticResource AfSettingsActionGap}" Command="{Binding ViewModel.Layers.ApplyCompactFullPanelPresetCommand}" Content="{DynamicResource Loc.DisplayModes.Full.Preset.Compact}" Style="{StaticResource AfSettingsButtonStyle}"/>
                                    <ui:Button Margin="{StaticResource AfSettingsActionGap}" Command="{Binding ViewModel.Layers.ApplyFullFullPanelPresetCommand}" Content="{DynamicResource Loc.DisplayModes.Full.Preset.Full}" Style="{StaticResource AfSettingsButtonStyle}"/>
                                </WrapPanel>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon Info24}" IsNested="True" Title="{DynamicResource Loc.DisplayModes.Full.Row.MediaInfo.Title}" KeepControlInline="True">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.FullPanelMediaInfoVisible, Mode=TwoWay}" IsEnabled="{Binding ViewModel.Layers.CanToggleFullPanelMediaInfo}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon Play24}" IsNested="True" Title="{DynamicResource Loc.DisplayModes.Full.Row.MediaControls.Title}" KeepControlInline="True">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.FullPanelMediaControlsVisible, Mode=TwoWay}" IsEnabled="{Binding ViewModel.Layers.CanToggleFullPanelMediaControls}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon Speaker124}" IsNested="True" Title="{DynamicResource Loc.Common.AudioControl}" KeepControlInline="True">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.FullPanelAudioControlsVisible, Mode=TwoWay}" IsEnabled="{Binding ViewModel.Layers.CanToggleFullPanelAudioControls}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon Gauge24}" IsNested="True" Title="{DynamicResource Loc.DisplayModes.Full.Row.Performance.Title}" KeepControlInline="True">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.FullPanelPerformanceVisible, Mode=TwoWay}" IsEnabled="{Binding ViewModel.Layers.CanToggleFullPanelPerformance}"/>
                            </components:SettingsRow>
                        </StackPanel>
                    </ui:CardExpander>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Integration.Panel.Scale" Header="{DynamicResource Loc.Integration.Panel.Scale}">
                <StackPanel>
                    <components:SettingsRow Title="{DynamicResource Loc.Integration.Panel.Scale}" Description="{DynamicResource Loc.Integration.Panel.Scale.Description}" Icon="{ui:SymbolIcon ArrowMaximize24}">
                        <StackPanel>
                            <components:SettingsNumericEditor Value="{Binding ViewModel.Layers.FullPanelScalePercent, Mode=TwoWay}" Minimum="{Binding ViewModel.Layers.MinimumFullPanelScalePercent}" Maximum="{Binding ViewModel.Layers.MaximumFullPanelScalePercent}" Step="5" Unit="%"/>
                            <ui:Button Content="{DynamicResource Loc.Integration.Panel.ResetSize}" Command="{Binding ViewModel.Layers.ResetFullPanelScaleCommand}" Style="{StaticResource AfSettingsButtonStyle}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </components:SettingsRow>
                </StackPanel>
            </components:SettingsGroup>
        </StackPanel>
    </components:SettingsPageLayout>
</Page>
