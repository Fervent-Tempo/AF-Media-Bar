<Page x:Class="AFMediaBar.Views.Pages.LyricsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
<StackPanel MaxWidth="1000" Margin="16,16,24,32">
  <TextBlock Text="歌词" FontSize="32" FontWeight="{DynamicResource AppTextStrongFontWeight}"/><ui:TextBlock Text="歌词是媒体内容，而不是显示模式组件" Appearance="Secondary" Margin="0,8,0,24"/>
  <Border Padding="14" CornerRadius="8" Background="#0D4CC2FF" BorderBrush="#304CC2FF" BorderThickness="1" Margin="0,0,0,20"><TextBlock Text="歌词仅显示在静置层。当前歌词可用并启用时，会自动隐藏标题和歌手/来源；悬停层与完整层始终显示媒体信息。" TextWrapping="Wrap"/></Border>
  <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon TextQuote24}"><ui:CardControl.Header><StackPanel><TextBlock Text="显示实时歌词" FontWeight="SemiBold"/><TextBlock Text="没有歌词时自动回退为标题与歌手，歌手为空时显示来源" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ui:ToggleSwitch IsChecked="{Binding ViewModel.LyricsEnabled, Mode=TwoWay}"/></ui:CardControl>
  <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon TextAlignJustify24}"><ui:CardControl.Header><StackPanel><TextBlock Text="双行歌词" FontWeight="SemiBold"/><TextBlock Text="静置层空间允许时显示下一句或当前句翻译" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ui:ToggleSwitch IsChecked="{Binding ViewModel.TwoLineLyricsEnabled, Mode=TwoWay}" IsEnabled="{Binding ViewModel.CanConfigureTwoLine}"/></ui:CardControl>
  <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon TextBulletListSquare24}"><ui:CardControl.Header><StackPanel><TextBlock Text="第二行内容" FontWeight="SemiBold"/><TextBlock Text="翻译不存在时不会显示空白占位" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ComboBox MinWidth="200" IsEnabled="{Binding ViewModel.CanConfigureSecondary}" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.SecondaryLineMode, Mode=TwoWay}"><ComboBoxItem Content="下一句歌词" Tag="{x:Static settings:LyricsSecondaryLineMode.NextLine}"/><ComboBoxItem Content="当前句翻译" Tag="{x:Static settings:LyricsSecondaryLineMode.Translation}"/></ComboBox></ui:CardControl>
  <ui:CardControl Icon="{ui:SymbolIcon TextAlignLeft24}"><ui:CardControl.Header><StackPanel><TextBlock Text="文字对齐" FontWeight="SemiBold"/><TextBlock Text="应用于任务栏静置歌词和媒体文字" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ComboBox MinWidth="200" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.TextAlignment, Mode=TwoWay}"><ComboBoxItem Content="左对齐" Tag="{x:Static settings:LyricsTextAlignment.Left}"/><ComboBoxItem Content="居中" Tag="{x:Static settings:LyricsTextAlignment.Center}"/><ComboBoxItem Content="右对齐" Tag="{x:Static settings:LyricsTextAlignment.Right}"/></ComboBox></ui:CardControl>
  <ui:Button Content="恢复本页默认设置" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,18,0,0" HorizontalAlignment="Left" Click="ResetButton_Click"/>
 </StackPanel>
</Page>
