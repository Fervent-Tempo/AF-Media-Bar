<?xml version="1.0" ?><Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:AFMediaBar.Components" xmlns:lyrics="clr-namespace:AFMediaBar.Classes.Services.Lyrics" xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="AFMediaBar.Views.Pages.LyricsPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="SourceOrderListStyle" TargetType="ItemsControl" BasedOn="{StaticResource AfSettingsSortableListStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.IsManualSourceRule}" Value="False">
                    <Setter Property="Template" Value="{StaticResource AfSettingsListTemplate}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="AfBareTextBoxTemplate" TargetType="{x:Type TextBox}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
        </ControlTemplate>
        <Style x:Key="TwoLineRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.CanConfigureTwoLine}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Lyrics.Row.TwoLine.Badge}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UnsungOpacityRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.CanConfigureUnsungOpacity}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Lyrics.Row.UnsungOpacity.Badge}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LineGapRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.CanConfigureLineGap}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Lyrics.Row.LineGap.Badge}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LongLineScrollRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.CanConfigureLongLineScroll}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Lyrics.Row.LongLineScroll.Badge}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ForegroundPreviewTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="{DynamicResource AppTextStrongFontWeight}"/>
            <Setter Property="Text" Value="AF Media Bar"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Taskbar.PlayerForegroundMode}" Value="Automatic">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Taskbar.PlayerForegroundMode}" Value="LightText">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Taskbar.PlayerForegroundMode}" Value="DarkText">
                    <Setter Property="Foreground" Value="#FF1A1A1A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ForegroundPreviewOnLightTextStyle" BasedOn="{StaticResource ForegroundPreviewTextStyle}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Taskbar.PlayerForegroundMode}" Value="Automatic">
                    <Setter Property="Foreground" Value="#FF1A1A1A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FixedLengthRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Setter Property="IsEnabled" Value="{Binding LayoutEditor.Layout.CanEditFixedTaskbarLength}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LayoutEditor.Layout.FollowMediaTextLength}" Value="True">
                    <Setter Property="Badge" Value="{DynamicResource Loc.DisplayModes.Width.Row.Fixed.Badge}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FixedWidthRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LayoutEditor.Lyrics.CanConfigureFixedWidth}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Lyrics.Row.FixedWidth.Badge}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmallArtworkRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value=""/>
            <Setter Property="IsEnabled" Value="{Binding LayoutEditor.Layers.RestArtworkVisible}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LayoutEditor.Layers.RestArtworkVisible}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.DisplayModes.Rest.Row.SmallArtwork.Badge}"/>
                    <Setter Property="BadgeTone" Value="Attention"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HoverDependencyHintStyle" BasedOn="{StaticResource AfSettingsHintTextStyle}" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LayoutEditor.Layers.HoverLayerEnabled}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}"/>
        <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}"/>
    </Page.Resources>
    <components:SettingsPageLayout x:Name="PageLayout">
        <components:SettingsPageLayout.Header>
            <components:SettingsGroupStrip Title="{DynamicResource Loc.Settings.Page.TextAndLyrics}" Subtitle="{DynamicResource Loc.Settings.Page.Lyrics.Description}" PageIcon="{ui:SymbolIcon TextQuote24}" Target="{Binding ScrollViewer, ElementName=PageLayout}"><components:SettingsGroupStrip.HeaderActions><ui:Button Click="ResetButton_Click" Content="{DynamicResource Loc.Common.ResetPageDefaults}" Style="{StaticResource AfSettingsButtonStyle}" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top"/></components:SettingsGroupStrip.HeaderActions></components:SettingsGroupStrip>
        </components:SettingsPageLayout.Header>
        <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded">
            <components:SettingsGroup GroupId="Common.Group.MediaBarText" Header="{DynamicResource Loc.Common.Group.MediaBarText}" Icon="{ui:SymbolIcon TextColor24}" Visibility="{Binding HasTaskbarSettings, Converter={StaticResource AfBooleanToVisibilityConverter}}" Description="{DynamicResource Loc.Appearance.Scope.Taskbar}">
                <StackPanel>
                    <components:SettingsRow Description="{DynamicResource Loc.Appearance.Row.MediaFontSize.Description}" Icon="{ui:SymbolIcon TextFont24}" Title="{DynamicResource Loc.Appearance.Row.MediaFontSize.Title}">
                        <components:SettingsNumericEditor Value="{Binding Taskbar.MediaFontSizePercent, Mode=TwoWay}" Minimum="{Binding Source={x:Static settings:TaskbarExperienceSettings.MinimumMediaFontSizePercent}}" Maximum="{Binding Source={x:Static settings:TaskbarExperienceSettings.MaximumMediaFontSizePercent}}" Step="{Binding Source={x:Static settings:TaskbarExperienceSettings.MediaFontSizeStepPercent}}" Unit="{DynamicResource Loc.Settings.Numeric.Percent}"/>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.Appearance.Row.TextColor.Description}" Icon="{ui:SymbolIcon TextColor24}" Title="{DynamicResource Loc.Appearance.Row.TextColor.Title}">
                        <ComboBox MinWidth="{StaticResource AfSettingsSelectMinWidth}" SelectedValue="{Binding Taskbar.PlayerForegroundMode, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{DynamicResource Loc.Appearance.TextColor.Automatic}" Tag="{x:Static settings:PlayerForegroundMode.Automatic}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.Appearance.TextColor.LightText}" Tag="{x:Static settings:PlayerForegroundMode.LightText}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.Appearance.TextColor.DarkText}" Tag="{x:Static settings:PlayerForegroundMode.DarkText}"/>
                        </ComboBox>
                    </components:SettingsRow>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="14,10" Background="#FF202020" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ForegroundPreviewTextStyle}"/>
                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#B3FFFFFF" Text="{DynamicResource Loc.Appearance.Preview.DarkWallpaper}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="14,10" Background="#FFF2F2F2" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ForegroundPreviewOnLightTextStyle}"/>
                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#B3000000" Text="{DynamicResource Loc.Appearance.Preview.LightWallpaper}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource AfSettingsInfoSurfaceStyle}" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource AfSettingsHintTextStyle}" Text="{DynamicResource Loc.Appearance.Preview.Hint}"/>
                    </Border>
                    <WrapPanel Style="{StaticResource AfSettingsRelatedLinksStyle}">
                        <components:SettingsNavigationButton Content="{DynamicResource Loc.Settings.Related.TextLayout}" Destination="Components" GroupId="Appearance.Group.RestLayout"/>
                        <components:SettingsNavigationButton Content="{DynamicResource Loc.Settings.Related.LyricsPresentation}" Destination="Lyrics" GroupId="Lyrics.Group.Presentation"/>
                    </WrapPanel>
                    <components:SettingsRow Description="{DynamicResource Loc.DisplayModes.Rest.Row.Layout.Description}" Icon="{ui:SymbolIcon Grid24}" Title="{DynamicResource Loc.DisplayModes.Rest.Row.Layout.Title}" Visibility="{Binding LayoutEditor.Layout.CanConfigureBarLayout, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                        <ComboBox MinWidth="{StaticResource AfSettingsSelectMinWidth}" SelectedValue="{Binding LayoutEditor.Layout.ContentLayout, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{DynamicResource Loc.DisplayModes.Rest.ContentLayout.CompactInline}" Tag="{x:Static settings:TaskbarContentLayout.CompactInline}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.DisplayModes.Rest.ContentLayout.AdaptiveStack}" Tag="{x:Static settings:TaskbarContentLayout.AdaptiveStack}"/>
                        </ComboBox>
                    </components:SettingsRow>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" IsExpanded="False" Icon="{ui:SymbolIcon Options24}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.ContentLayout.Text.Details.Title}"/>
                                <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.ContentLayout.Text.Details.Description}"/>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <components:SettingsRow IsNested="True" Description="{DynamicResource Loc.DisplayModes.Rest.Row.Alignment.Description}" Icon="{ui:SymbolIcon TextAlignLeft24}" Title="{DynamicResource Loc.DisplayModes.Rest.Row.Alignment.Title}" Visibility="{Binding LayoutEditor.Layout.CanConfigureBarLayout, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                                <ComboBox MinWidth="{StaticResource AfSettingsSelectMinWidth}" SelectedValue="{Binding LayoutEditor.Layout.MediaTextAlignment, Mode=TwoWay}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="{Binding LayoutEditor.Layers.AxisStartText}" Tag="{x:Static settings:TaskbarMediaTextAlignment.Left}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Common.AlignCenter}" Tag="{x:Static settings:TaskbarMediaTextAlignment.Center}"/>
                                    <ComboBoxItem Content="{Binding LayoutEditor.Layers.AxisEndText}" Tag="{x:Static settings:TaskbarMediaTextAlignment.Right}"/>
                                </ComboBox>
                            </components:SettingsRow>
                            <components:SettingsRow IsNested="True" Description="{DynamicResource Loc.Lyrics.Row.Alignment.Description}" Icon="{ui:SymbolIcon TextAlignLeft24}" Title="{DynamicResource Loc.Lyrics.Row.Alignment.Title}">
                                <ComboBox MinWidth="{StaticResource AfSettingsSelectShortWidth}" SelectedValue="{Binding LayoutEditor.Lyrics.TextAlignment, Mode=TwoWay}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="{Binding LayoutEditor.Layers.AxisStartText}" Tag="{x:Static settings:LyricsTextAlignment.Left}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Common.AlignCenter}" Tag="{x:Static settings:LyricsTextAlignment.Center}"/>
                                    <ComboBoxItem Content="{Binding LayoutEditor.Layers.AxisEndText}" Tag="{x:Static settings:LyricsTextAlignment.Right}"/>
                                </ComboBox>
                            </components:SettingsRow>
                        </StackPanel>
                    </ui:CardExpander>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Common.Group.LyricsDisplay" Header="{DynamicResource Loc.Common.Group.LyricsDisplay}" Icon="{ui:SymbolIcon TextQuote24}">
                <StackPanel>
                    <components:SettingsCallout Margin="0,0,0,12" IsAccent="True" Symbol="TextQuote24" Text="{DynamicResource Loc.Lyrics.Callout.Display}"/>
                    <components:SettingsRow Description="{DynamicResource Loc.Lyrics.Row.ShowLyrics.Description}" Icon="{ui:SymbolIcon TextQuote24}" Title="{DynamicResource Loc.Lyrics.Row.ShowLyrics.Title}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.LyricsEnabled, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.Lyrics.Row.TwoLine.Description}" Icon="{ui:SymbolIcon TextAlignJustify24}" Style="{StaticResource TwoLineRowStyle}" Title="{DynamicResource Loc.Lyrics.Row.TwoLine.Title}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.TwoLineLyricsEnabled, Mode=TwoWay}" IsEnabled="{Binding ViewModel.CanConfigureTwoLine}"/>
                    </components:SettingsRow>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon TextBulletListSquare24}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Lyrics.Row.SecondLine.Title}"/>
                                <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Lyrics.Row.SecondLine.Description}"/>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <components:SettingsDiagram Margin="0,0,0,12" Kind="LyricsTwoLine"/>
                            <components:SettingsRow Description="{DynamicResource Loc.Lyrics.Row.SecondLine.Note}" Icon="{ui:SymbolIcon TextBulletListSquare24}" IsNested="True" Title="{DynamicResource Loc.Lyrics.Row.SecondLine.Title}">
                                <TextBlock MaxWidth="260" Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{Binding ViewModel.SecondaryLineOrderText}" TextWrapping="Wrap"/>
                            </components:SettingsRow>
                            <AdornerDecorator>
                                <ItemsControl Style="{StaticResource AfSettingsSortableListStyle}" components:SettingsReorderBehavior.MoveCommand="{Binding ViewModel.ReorderSecondaryLineCommand}" ItemsSource="{Binding ViewModel.SecondaryLineEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <components:SettingsRow Style="{StaticResource AfSettingsListItemStyle}" KeepControlInline="True" Description="{DynamicResource Loc.Lyrics.Row.SecondLine.OrderRow.Description}" IsNested="True" Title="{Binding DisplayName}" Icon="{ui:SymbolIcon TextQuote24}">
                                                <components:SettingsReorderHandle ItemKey="{Binding Mode}"/>
                                            </components:SettingsRow>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </AdornerDecorator>
                            <components:SettingsRow Description="{DynamicResource Loc.Lyrics.SecondLine.Reset.Description}" Icon="{ui:SymbolIcon ArrowReset24}" IsNested="True" Title="{DynamicResource Loc.Lyrics.SecondLine.Reset.Title}">
                                <ui:Button Command="{Binding ViewModel.ResetSecondaryLineOrderCommand}" Content="{DynamicResource Loc.Lyrics.SecondLine.Reset.Title}" Icon="{ui:SymbolIcon ArrowReset24}" Style="{StaticResource AfSettingsButtonStyle}"/>
                            </components:SettingsRow>
                        </StackPanel>
                    </ui:CardExpander>
                    <WrapPanel Style="{StaticResource AfSettingsRelatedLinksStyle}">
                        <components:SettingsNavigationButton ToolTip="{DynamicResource Loc.ContentLayout.Text.Shortcut.Description}" Destination="Components" GroupId="Appearance.Group.RestLayout" Content="{DynamicResource Loc.ContentLayout.Text.Shortcut.Action}"/>
                    </WrapPanel>
                    <components:SettingsRow Description="{DynamicResource Loc.Lyrics.Row.SyllableHighlight.Description}" Icon="{ui:SymbolIcon TextColor24}" Title="{DynamicResource Loc.Lyrics.Row.SyllableHighlight.Title}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.SyllableHighlightEnabled, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" IsExpanded="False" Icon="{ui:SymbolIcon TextParagraph24}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Settings.Advanced.Lyrics.Title}"/>
                                <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Settings.Advanced.Lyrics.Description}"/>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <components:SettingsRow IsNested="True" Description="{DynamicResource Loc.Lyrics.Row.UnsungOpacity.Description}" Icon="{ui:SymbolIcon CircleHalfFill24}" Style="{StaticResource UnsungOpacityRowStyle}" Title="{DynamicResource Loc.Lyrics.Row.UnsungOpacity.Title}">
                                <components:SettingsNumericEditor Value="{Binding ViewModel.UnsungOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="{Binding Source={x:Static settings:LyricsUnsungOpacity.MinimumPercent}}" Maximum="{Binding Source={x:Static settings:LyricsUnsungOpacity.MaximumPercent}}" Step="{Binding Source={x:Static settings:LyricsUnsungOpacity.StepPercent}}" IsEnabled="{Binding ViewModel.CanConfigureUnsungOpacity}" Unit="{DynamicResource Loc.Settings.Numeric.Percent}"/>
                            </components:SettingsRow>
                            <components:SettingsRow IsNested="True" Description="{DynamicResource Loc.Lyrics.Row.LineGap.Description}" Icon="{ui:SymbolIcon TextAlignJustify24}" Style="{StaticResource LineGapRowStyle}" Title="{DynamicResource Loc.Lyrics.Row.LineGap.Title}">
                                <components:SettingsNumericEditor Value="{Binding ViewModel.LineGapPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="{Binding Source={x:Static settings:LyricsLineGap.MinimumPercent}}" Maximum="{Binding Source={x:Static settings:LyricsLineGap.MaximumPercent}}" Step="{Binding Source={x:Static settings:LyricsLineGap.StepPercent}}" IsEnabled="{Binding ViewModel.CanConfigureLineGap}" Unit="{DynamicResource Loc.Settings.Numeric.Percent}"/>
                            </components:SettingsRow>
                            <components:SettingsRow IsNested="True" Description="{DynamicResource Loc.Lyrics.Row.CharacterSpacing.Description}" Icon="{ui:SymbolIcon TextFont24}" Title="{DynamicResource Loc.Lyrics.Row.CharacterSpacing.Title}">
                                <components:SettingsNumericEditor Value="{Binding ViewModel.CharacterSpacingPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="{Binding Source={x:Static settings:LyricsCharacterSpacing.MinimumPercent}}" Maximum="{Binding Source={x:Static settings:LyricsCharacterSpacing.MaximumPercent}}" Step="{Binding Source={x:Static settings:LyricsCharacterSpacing.StepPercent}}" Unit="{DynamicResource Loc.Settings.Numeric.Percent}"/>
                            </components:SettingsRow>
                            <components:SettingsRow IsNested="True" Description="{DynamicResource Loc.Lyrics.Row.LongLineScroll.Description}" Icon="{ui:SymbolIcon ArrowAutofitWidth24}" Style="{StaticResource LongLineScrollRowStyle}" Title="{DynamicResource Loc.Lyrics.Row.LongLineScroll.Title}" KeepControlInline="True">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.LongLineScrollEnabled, Mode=TwoWay}" IsEnabled="{Binding ViewModel.CanConfigureLongLineScroll}"/>
                            </components:SettingsRow>
                        </StackPanel>
                    </ui:CardExpander>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" IsExpanded="False" Icon="{ui:SymbolIcon Options24}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.ContentLayout.LyricsLength.Title}"/>
                                <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.ContentLayout.LyricsLength.Description}"/>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <components:SettingsRow IsNested="True" Description="{DynamicResource Loc.Lyrics.Row.FixedWidth.Description}" Icon="{ui:SymbolIcon ResizeLarge24}" Style="{StaticResource FixedWidthRowStyle}" Title="{DynamicResource Loc.Lyrics.Row.FixedWidth.Title}" KeepControlInline="True">
                                <ui:ToggleSwitch IsChecked="{Binding LayoutEditor.Lyrics.FixedWidthEnabled, Mode=TwoWay}"/>
                            </components:SettingsRow>
                            <components:SettingsRow IsNested="True" Description="{DynamicResource Loc.Lyrics.Row.FixedWidth.Length.Description}" Icon="{ui:SymbolIcon ArrowAutofitWidth24}" Title="{DynamicResource Loc.Lyrics.Row.FixedWidth.Length.Title}" Visibility="{Binding LayoutEditor.Lyrics.FixedWidthEnabled, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                                <components:SettingsNumericEditor Value="{Binding LayoutEditor.Lyrics.FixedWidthDip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="{Binding Source={x:Static settings:LyricsFixedWidth.MinimumDip}}" Maximum="{Binding Source={x:Static settings:LyricsFixedWidth.MaximumDip}}" Step="{Binding Source={x:Static settings:LyricsFixedWidth.StepDip}}" IsEnabled="{Binding LayoutEditor.Lyrics.CanConfigureFixedWidthDip}" Unit="{DynamicResource Loc.Settings.Numeric.Dip}"/>
                            </components:SettingsRow>
                        </StackPanel>
                    </ui:CardExpander>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Lyrics.Group.Presentation" Header="{DynamicResource Loc.Settings.Group.TextProcessing}" Icon="{ui:SymbolIcon TextColor24}">
                <StackPanel>
                    <components:SettingsRow Description="{DynamicResource Loc.Lyrics.Row.InfoLines.Description}" Icon="{ui:SymbolIcon TextGrammarWand24}" Title="{DynamicResource Loc.Lyrics.Row.InfoLines.Title}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.InfoLineFilterEnabled, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.Lyrics.Row.FuriganaFilter.Description}" Icon="{ui:SymbolIcon TextGrammarWand24}" Title="{DynamicResource Loc.Lyrics.Row.FuriganaFilter.Title}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.FuriganaFilterEnabled, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.Lyrics.Row.BracketSymbols.Description}" Icon="{ui:SymbolIcon TextQuote24}" Title="{DynamicResource Loc.Lyrics.Row.BracketSymbols.Title}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.BracketSymbolsHidden, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" IsExpanded="False" Icon="{ui:SymbolIcon Translate24}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Lyrics.Row.ChineseConversion.Title}"/>
                                <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Lyrics.Row.ChineseConversion.Description}"/>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <components:SettingsRow IsNested="True" Description="{DynamicResource Loc.Lyrics.Row.ChineseConversion.Direction.Description}" Icon="{ui:SymbolIcon ArrowSwap24}" Title="{DynamicResource Loc.Lyrics.Row.ChineseConversion.Direction.Title}">
                                <ComboBox MinWidth="{StaticResource AfSettingsSelectShortWidth}" SelectedValue="{Binding ViewModel.ChineseConversion, Mode=TwoWay}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Row.ChineseConversion.Option.Off}" Tag="{x:Static settings:LyricsChineseConversionMode.None}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Row.ChineseConversion.Option.ToTraditional}" Tag="{x:Static settings:LyricsChineseConversionMode.SimplifiedToTraditional}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Row.ChineseConversion.Option.ToSimplified}" Tag="{x:Static settings:LyricsChineseConversionMode.TraditionalToSimplified}"/>
                                </ComboBox>
                            </components:SettingsRow>
                        </StackPanel>
                    </ui:CardExpander>
                    <WrapPanel Style="{StaticResource AfSettingsRelatedLinksStyle}">
                        <components:SettingsNavigationButton Content="{DynamicResource Loc.Settings.Related.TextLayout}" Destination="Components" GroupId="Appearance.Group.RestLayout"/>
                        <components:SettingsNavigationButton Content="{DynamicResource Loc.Settings.Related.TextAppearance}" Destination="Appearance" GroupId="Common.Group.MediaBarText"/>
                        <components:SettingsNavigationButton Content="{DynamicResource Loc.Settings.Related.MediaBarLength}" Destination="Components" GroupId="Common.Group.MediaBarWidth"/>
                    </WrapPanel>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Common.Group.LyricsSources" Header="{DynamicResource Loc.Common.Group.LyricsSources}" Icon="{ui:SymbolIcon CloudArrowDown24}">
                <StackPanel>
                    <components:SettingsRow Description="{DynamicResource Loc.Lyrics.Row.BrowserVideo.Description}" Icon="{ui:SymbolIcon Video24}" Title="{DynamicResource Loc.Lyrics.Row.BrowserVideo.Title}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.AllowBrowserAndVideoLyrics, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.Lyrics.Row.Local.Description}" Hint="{DynamicResource Loc.Lyrics.Row.Local.Formats.Hint}" Icon="{ui:SymbolIcon Folder24}" Title="{DynamicResource Loc.Lyrics.Row.Local.Title}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.LocalLyricsEnabled, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <StackPanel Visibility="{Binding ViewModel.LocalLyricsEnabled, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.Local.Fallback.Description}"
                            Icon="{ui:SymbolIcon ArrowSwap24}"
                            Style="{StaticResource AfSettingsListItemStyle}"
                            Title="{DynamicResource Loc.Lyrics.Row.Local.Fallback.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.LocalLyricsFallbackOnly, Mode=TwoWay}"/>
                        </components:SettingsRow>
                        <ItemsControl ItemsSource="{Binding ViewModel.LocalLyricsFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <components:SettingsRow
                                        Style="{StaticResource AfSettingsListItemStyle}"
                                        Description="{Binding}"
                                        Icon="{ui:SymbolIcon Folder24}"
                                        Title="{DynamicResource Loc.Lyrics.Row.Local.Folder}">
                                        <ui:Button
                                            Click="RemoveLocalLyricsFolder_Click"
                                            Content="{DynamicResource Loc.Lyrics.Row.Local.Remove}"
                                            Icon="{ui:SymbolIcon Delete24}"
                                            Style="{StaticResource AfSettingsButtonStyle}"
                                            Tag="{Binding}" />
                                    </components:SettingsRow>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button
                            Margin="0,4,0,0"
                            Click="AddLocalLyricsFolder_Click"
                            Content="{DynamicResource Loc.Lyrics.Row.Local.Add}"
                            Icon="{ui:SymbolIcon FolderAdd24}"
                            Style="{StaticResource AfSettingsButtonStyle}" />
                    </StackPanel>
                    <components:SettingsRow Description="{DynamicResource Loc.Lyrics.Row.ArtistSeparators.Description}" Icon="{ui:SymbolIcon TextFont24}" Title="{DynamicResource Loc.Lyrics.Row.ArtistSeparators.Title}">
                        <ui:Button Click="ManageArtistSeparators_Click" Icon="{ui:SymbolIcon Edit24}" Content="{DynamicResource Loc.Lyrics.Row.ArtistSeparators.Manage}" Style="{StaticResource AfSettingsButtonStyle}"/>
                    </components:SettingsRow>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon CloudArrowDown24}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Lyrics.Sources.Expander.Title}"/>
                                <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Lyrics.Sources.Expander.Description}"/>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <components:SettingsRow Title="{DynamicResource Loc.Lyrics.Sources.Rule.Title}" Description="{Binding ViewModel.SourceRuleDescription}" IsNested="True" Icon="{ui:SymbolIcon CloudArrowDown24}">
                                <ComboBox SelectedValue="{Binding ViewModel.SourceRule, Mode=TwoWay}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Sources.Rule.Default}" Tag="{x:Static settings:LyricsSourceRule.Default}"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Sources.Rule.Manual}" Tag="{x:Static settings:LyricsSourceRule.Manual}"/>
                                </ComboBox>
                            </components:SettingsRow>
                            <StackPanel Visibility="{Binding ViewModel.IsManualSourceRule, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                                <components:SettingsRow Title="{DynamicResource Loc.Lyrics.Sources.Attempt.Title}" Description="{DynamicResource Loc.Lyrics.Sources.Attempt.Description}" IsNested="True" Icon="{ui:SymbolIcon CloudArrowDown24}">
                                    <ComboBox SelectedValue="{Binding ViewModel.SourceAttemptMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Sources.Attempt.Sequential}" Tag="{x:Static settings:LyricsSourceAttemptMode.Sequential}"/>
                                        <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Sources.Attempt.Parallel}" Tag="{x:Static settings:LyricsSourceAttemptMode.Parallel}"/>
                                    </ComboBox>
                                </components:SettingsRow>
                                <components:SettingsRow Title="{DynamicResource Loc.Lyrics.Sources.Result.Title}" Description="{Binding ViewModel.SourceResultDescription}" IsNested="True" Icon="{ui:SymbolIcon CloudArrowDown24}">
                                    <ComboBox SelectedValue="{Binding ViewModel.SourceResultMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Sources.Result.FirstAvailable}" Tag="{x:Static settings:LyricsSourceResultMode.FirstAvailable}"/>
                                        <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Sources.Result.Ordered}" Tag="{x:Static settings:LyricsSourceResultMode.Ordered}"/>
                                    </ComboBox>
                                </components:SettingsRow>
                                <components:SettingsRow Title="{DynamicResource Loc.Lyrics.Sources.Order.Title}" Description="{DynamicResource Loc.Lyrics.Sources.Order.Description}" IsNested="True" Icon="{ui:SymbolIcon CloudArrowDown24}">
                                    <ui:Button Command="{Binding ViewModel.ResetSourceOrderCommand}" Content="{DynamicResource Loc.Lyrics.Sources.Order.Reset}" Icon="{ui:SymbolIcon ArrowReset24}" Style="{StaticResource AfSettingsButtonStyle}"/>
                                </components:SettingsRow>
                            </StackPanel>
                            <components:SettingsRow Description="{DynamicResource Loc.Lyrics.Sources.Reset.Description}" Icon="{ui:SymbolIcon ArrowReset24}" IsNested="True" Title="{DynamicResource Loc.Lyrics.Sources.Reset.Title}">
                                <ui:Button Command="{Binding ViewModel.EnableAllSourcesCommand}" Content="{DynamicResource Loc.Lyrics.Sources.Reset.Action}" Icon="{ui:SymbolIcon ArrowReset24}" Style="{StaticResource AfSettingsButtonStyle}"/>
                            </components:SettingsRow>
                            <AdornerDecorator>
                                <ItemsControl Style="{StaticResource SourceOrderListStyle}" components:SettingsReorderBehavior.MoveCommand="{Binding ViewModel.ReorderSourceCommand}" ItemsSource="{Binding ViewModel.SourceEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <components:SettingsRow Style="{StaticResource AfSettingsListItemStyle}" KeepControlInline="True" Description="{DynamicResource Loc.Lyrics.Sources.Row.Description}" IsNested="True" Title="{Binding DisplayName}" Icon="{ui:SymbolIcon CloudArrowDown24}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.ViewModel.IsManualSourceRule, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                                                        <components:SettingsReorderHandle ItemKey="{Binding SourceId}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </components:SettingsRow>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </AdornerDecorator>
                            <components:SettingsCallout Text="{DynamicResource Loc.Lyrics.Sources.AllDisabled.Callout}">
                                <components:SettingsCallout.Style>
                                    <Style TargetType="{x:Type components:SettingsCallout}">
                                        <Setter Property="Margin" Value="0,8,0,0"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.IsEverySourceDisabled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </components:SettingsCallout.Style>
                            </components:SettingsCallout>
                        </StackPanel>
                    </ui:CardExpander>
                </StackPanel>
            </components:SettingsGroup>

        </StackPanel>
    </components:SettingsPageLayout>
</Page>
