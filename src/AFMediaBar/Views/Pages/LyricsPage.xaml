<Page
    x:Class="AFMediaBar.Views.Pages.LyricsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:lyrics="clr-namespace:AFMediaBar.Classes.Services.Lyrics"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <!--
        歌词页 / Lyrics page

        两个分组：显示（开关、双行、第二行内容）与对齐（歌词对齐）。全部是一行一个选项。

        这里的依赖关系由展开器表达：第二行内容只属于双行歌词，因此它住在双行歌词的展开体里，
        双行歌词关闭时整块收起，不会留下一排点不动的下拉框。
        对齐卡片的说明与源码一致：歌词对齐只作用于歌词本身，标题与歌手的对齐是显示模式页的另一项设置。

        Two groups: display (switch, two lines, second line) and alignment, every one of them a single row.

        The dependency is expressed by an expander: the second line only exists for two-line lyrics, so it lives
        inside that expander's body and disappears with it, instead of leaving a row of dead selects behind. The
        alignment row's description matches the source: lyric alignment affects only the lyrics, while title and
        artist alignment is a separate setting on the display-modes page.
    -->
    <Page.Resources>
        <!--
            极简文本框模板：只有内容宿主，无边框无圆角无聚焦弧线——绕开 WPF-UI 的隐式 TextBox 样式，
            让绑定行的备注默认看起来就是纯文本，点击直接进入编辑。
            A bare text-box template: the content host only, no border, radius, or focus underline — it bypasses WPF-UI's
            implicit TextBox style so the binding row's remark reads as plain text until clicked.
        -->
        <ControlTemplate x:Key="AfBareTextBoxTemplate" TargetType="{x:Type TextBox}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>

        <!--
            歌词关闭时双行开关不可用，用徽章说明原因；父项开关就在上方两行处。
            The two-line switch is unavailable while lyrics are off; a badge states why, and the parent switch is
            two rows above.
        -->
        <Style
            x:Key="TwoLineRowStyle"
            BasedOn="{StaticResource {x:Type components:SettingsRow}}"
            TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.CanConfigureTwoLine}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Lyrics.Row.TwoLine.Badge}" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            未唱部分不透明度只在启用逐字擦亮时才有作用对象：关闭时用徽章说明原因，而不是把滑杆静默变灰。
            The unsung opacity only has a target while syllable highlighting is on: a badge states why when it is off, instead of
            leaving a silently greyed slider behind.
        -->
        <Style
            x:Key="UnsungOpacityRowStyle"
            BasedOn="{StaticResource {x:Type components:SettingsRow}}"
            TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.CanConfigureUnsungOpacity}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Lyrics.Row.UnsungOpacity.Badge}" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            行距只在双行歌词开启时可用：单行时没有"两行之间"可调，用徽章说明原因而不是留一根无效滑杆。
            The line gap applies only while two-line lyrics are on: with a single line there is no "between" to adjust, so a badge
            states why instead of leaving an inert slider behind.
        -->
        <Style
            x:Key="LineGapRowStyle"
            BasedOn="{StaticResource {x:Type components:SettingsRow}}"
            TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.CanConfigureLineGap}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Lyrics.Row.LineGap.Badge}" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            固定歌词框长度只在歌词开启时有意义：关闭歌词时用徽章说明原因。
            The fixed lyric-box length only matters while lyrics are on: a badge states why when they are off.
        -->
        <Style
            x:Key="FixedWidthRowStyle"
            BasedOn="{StaticResource {x:Type components:SettingsRow}}"
            TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.CanConfigureFixedWidth}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Lyrics.Row.FixedWidth.Badge}" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:SettingsGroupStrip
            Grid.Row="0"
            Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            PageIcon="{ui:SymbolIcon TextQuote24}"
            Subtitle="{DynamicResource Loc.Lyrics.Header.Subtitle}"
            Target="{Binding ElementName=PageScroll}"
            Title="{DynamicResource Loc.Common.Page.Lyrics}" />

        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageRoot"
                MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
                Loaded="OnPageLoaded">

                <components:SettingsGroup Header="{DynamicResource Loc.Common.Group.LyricsDisplay}" Icon="{ui:SymbolIcon TextQuote24}">
                    <StackPanel>
                        <components:SettingsCallout
                            Margin="0,0,0,12"
                            IsAccent="True"
                            Symbol="TextQuote24"
                            Text="{DynamicResource Loc.Lyrics.Callout.Display}" />

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.ShowLyrics.Description}"
                            Icon="{ui:SymbolIcon TextQuote24}"
                            Title="{DynamicResource Loc.Lyrics.Row.ShowLyrics.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.LyricsEnabled, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.SyllableHighlight.Description}"
                            Icon="{ui:SymbolIcon TextColor24}"
                            Title="{DynamicResource Loc.Lyrics.Row.SyllableHighlight.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.SyllableHighlightEnabled, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.UnsungOpacity.Description}"
                            Icon="{ui:SymbolIcon CircleHalfFill24}"
                            Style="{StaticResource UnsungOpacityRowStyle}"
                            Title="{DynamicResource Loc.Lyrics.Row.UnsungOpacity.Title}">
                            <!--
                                上下限用 Binding 而不是 x:Static：x:Static 返回装箱的 int，RangeBase.Maximum 需要 double，
                                标记扩展不做这个转换，而绑定会（与外观页的字重滑杆同一处理）。
                                The bounds use Binding rather than x:Static because x:Static yields a boxed int, RangeBase.Maximum
                                wants a double, and the markup extension performs no conversion while the binding engine does —
                                the same handling as the font-weight slider on the appearance page.
                            -->
                            <StackPanel Orientation="Horizontal">
                                <Slider
                                    IsEnabled="{Binding ViewModel.CanConfigureUnsungOpacity}"
                                    IsSnapToTickEnabled="True"
                                    Maximum="{Binding Source={x:Static settings:LyricsUnsungOpacity.MaximumPercent}}"
                                    Minimum="{Binding Source={x:Static settings:LyricsUnsungOpacity.MinimumPercent}}"
                                    Style="{StaticResource AfSettingsRowSliderStyle}"
                                    TickFrequency="{Binding Source={x:Static settings:LyricsUnsungOpacity.StepPercent}}"
                                    Value="{Binding ViewModel.UnsungOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Style="{StaticResource AfSettingsRowValueStyle}"
                                    Text="{Binding ViewModel.UnsungOpacityText}" />
                            </StackPanel>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.InfoLines.Description}"
                            Icon="{ui:SymbolIcon TextGrammarWand24}"
                            Title="{DynamicResource Loc.Lyrics.Row.InfoLines.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.InfoLineFilterEnabled, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.TwoLine.Description}"
                            Icon="{ui:SymbolIcon TextAlignJustify24}"
                            Style="{StaticResource TwoLineRowStyle}"
                            Title="{DynamicResource Loc.Lyrics.Row.TwoLine.Title}">
                            <ui:ToggleSwitch
                                IsChecked="{Binding ViewModel.TwoLineLyricsEnabled, Mode=TwoWay}"
                                IsEnabled="{Binding ViewModel.CanConfigureTwoLine}" />
                        </components:SettingsRow>

                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon TextBulletListSquare24}"
                            IsExpanded="{Binding ViewModel.TwoLineLyricsEnabled, Mode=OneWay}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Lyrics.Row.SecondLine.Title}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Lyrics.Row.SecondLine.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsDiagram Margin="0,0,0,12" Kind="LyricsTwoLine" />

                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Lyrics.Row.SecondLine.Note}"
                                    Icon="{ui:SymbolIcon TextBulletListSquare24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Lyrics.Row.SecondLine.Title}">
                                    <TextBlock
                                        MaxWidth="260"
                                        Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                        Text="{Binding ViewModel.SecondaryLineOrderText}"
                                        TextWrapping="Wrap" />
                                </components:SettingsRow>

                                <!--
                                    顺序即优先级，与来源列表同一套写法：一行一种来源，自带上下移按钮。
                                    The order is the priority, written exactly like the source list: one source per row with its own move buttons.
                                -->
                                <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding ViewModel.SecondaryLineEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <components:SettingsRow
                                                Description="{DynamicResource Loc.Lyrics.Row.SecondLine.OrderRow.Description}"
                                                IsNested="True"
                                                Title="{Binding DisplayName}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:Button
                                                        Command="{Binding DataContext.ViewModel.MoveSecondaryLineUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Icon="{ui:SymbolIcon ArrowUp24}"
                                                        Style="{StaticResource AfSettingsIconButtonStyle}"
                                                        ToolTip="{DynamicResource Loc.Lyrics.Sources.MoveUp}" />
                                                    <ui:Button
                                                        Margin="4,0,0,0"
                                                        Command="{Binding DataContext.ViewModel.MoveSecondaryLineDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Icon="{ui:SymbolIcon ArrowDown24}"
                                                        Style="{StaticResource AfSettingsIconButtonStyle}"
                                                        ToolTip="{DynamicResource Loc.Lyrics.Sources.MoveDown}" />
                                                </StackPanel>
                                            </components:SettingsRow>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Lyrics.SecondLine.Reset.Description}"
                                    Icon="{ui:SymbolIcon ArrowReset24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Lyrics.SecondLine.Reset.Title}">
                                    <ui:Button
                                        Command="{Binding ViewModel.ResetSecondaryLineOrderCommand}"
                                        Content="{DynamicResource Loc.Lyrics.Sources.Reset.Action}"
                                        Icon="{ui:SymbolIcon ArrowReset24}"
                                        Style="{StaticResource AfSettingsButtonStyle}" />
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.LineGap.Description}"
                            Icon="{ui:SymbolIcon TextAlignJustify24}"
                            Style="{StaticResource LineGapRowStyle}"
                            Title="{DynamicResource Loc.Lyrics.Row.LineGap.Title}">
                            <!-- 上下限用 Binding 而不是 x:Static：与未唱部分不透明度同一处理（x:Static 不做装箱 int 到 double 的转换）。 -->
                            <StackPanel Orientation="Horizontal">
                                <Slider
                                    IsEnabled="{Binding ViewModel.CanConfigureLineGap}"
                                    IsSnapToTickEnabled="True"
                                    Maximum="{Binding Source={x:Static settings:LyricsLineGap.MaximumPercent}}"
                                    Minimum="{Binding Source={x:Static settings:LyricsLineGap.MinimumPercent}}"
                                    Style="{StaticResource AfSettingsRowSliderStyle}"
                                    TickFrequency="{Binding Source={x:Static settings:LyricsLineGap.StepPercent}}"
                                    Value="{Binding ViewModel.LineGapPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Style="{StaticResource AfSettingsRowValueStyle}"
                                    Text="{Binding ViewModel.LineGapText}" />
                            </StackPanel>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.CharacterSpacing.Description}"
                            Icon="{ui:SymbolIcon TextFont24}"
                            Title="{DynamicResource Loc.Lyrics.Row.CharacterSpacing.Title}">
                            <StackPanel Orientation="Horizontal">
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    Maximum="{Binding Source={x:Static settings:LyricsCharacterSpacing.MaximumPercent}}"
                                    Minimum="{Binding Source={x:Static settings:LyricsCharacterSpacing.MinimumPercent}}"
                                    Style="{StaticResource AfSettingsRowSliderStyle}"
                                    TickFrequency="{Binding Source={x:Static settings:LyricsCharacterSpacing.StepPercent}}"
                                    Value="{Binding ViewModel.CharacterSpacingPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Style="{StaticResource AfSettingsRowValueStyle}"
                                    Text="{Binding ViewModel.CharacterSpacingText}" />
                            </StackPanel>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.FixedWidth.Description}"
                            Icon="{ui:SymbolIcon ResizeLarge24}"
                            Style="{StaticResource FixedWidthRowStyle}"
                            Title="{DynamicResource Loc.Lyrics.Row.FixedWidth.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.FixedWidthEnabled, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.FixedWidth.Length.Description}"
                            Icon="{ui:SymbolIcon ArrowAutofitWidth24}"
                            Title="{DynamicResource Loc.Lyrics.Row.FixedWidth.Length.Title}">
                            <StackPanel Orientation="Horizontal">
                                <Slider
                                    IsEnabled="{Binding ViewModel.CanConfigureFixedWidthDip}"
                                    IsSnapToTickEnabled="True"
                                    Maximum="{Binding Source={x:Static settings:LyricsFixedWidth.MaximumDip}}"
                                    Minimum="{Binding Source={x:Static settings:LyricsFixedWidth.MinimumDip}}"
                                    Style="{StaticResource AfSettingsRowSliderStyle}"
                                    TickFrequency="{Binding Source={x:Static settings:LyricsFixedWidth.StepDip}}"
                                    Value="{Binding ViewModel.FixedWidthDip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Style="{StaticResource AfSettingsRowValueStyle}"
                                    Text="{Binding ViewModel.FixedWidthText}" />
                            </StackPanel>
                        </components:SettingsRow>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup Header="{DynamicResource Loc.Common.Group.LyricsAlignment}" Icon="{ui:SymbolIcon TextAlignLeft24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="LyricsAlignment" />

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.Alignment.Description}"
                            Icon="{ui:SymbolIcon TextAlignLeft24}"
                            Title="{DynamicResource Loc.Lyrics.Row.Alignment.Title}">
                            <ComboBox
                                MinWidth="160"
                                SelectedValue="{Binding ViewModel.TextAlignment, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Common.AlignLeft}" Tag="{x:Static settings:LyricsTextAlignment.Left}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Common.AlignCenter}" Tag="{x:Static settings:LyricsTextAlignment.Center}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Common.AlignRight}" Tag="{x:Static settings:LyricsTextAlignment.Right}" />
                            </ComboBox>
                        </components:SettingsRow>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup Header="{DynamicResource Loc.Common.Group.LyricsSources}" Icon="{ui:SymbolIcon CloudArrowDown24}">
                    <StackPanel>
                        <components:SettingsCallout
                            Margin="0,0,0,12"
                            IsAccent="True"
                            Symbol="CloudArrowDown24"
                            Text="{DynamicResource Loc.Lyrics.Sources.Callout}" />

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.MatchStrictness.Description}"
                            Icon="{ui:SymbolIcon Filter24}"
                            Title="{DynamicResource Loc.Lyrics.Row.MatchStrictness.Title}">
                            <ComboBox
                                MinWidth="160"
                                SelectedValue="{Binding ViewModel.MatchStrictness, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Strictness.Balanced}" Tag="{x:Static settings:LyricsMatchStrictness.Balanced}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Strictness.Strict}" Tag="{x:Static settings:LyricsMatchStrictness.Strict}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Strictness.Exact}" Tag="{x:Static settings:LyricsMatchStrictness.Exact}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!--
                            查询策略：按序（传统串行链）或并发（默认接口 + 优先级批次并发）。
                            按序时并发专属的设置项全部隐藏，来源列表也随之改名为「优先级顺序」。
                            The query strategy: sequential (the classic serial chain) or concurrent (the default interface plus
                            concurrent priority batches). Sequential mode hides every concurrency-specific option and renames the
                            source list to "priority order".
                        -->
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.QueryStrategy.Description}"
                            Icon="{ui:SymbolIcon ArrowSwap24}"
                            Title="{DynamicResource Loc.Lyrics.Row.QueryStrategy.Title}">
                            <ComboBox
                                MinWidth="160"
                                SelectedValue="{Binding ViewModel.QueryStrategy, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Lyrics.QueryStrategy.Sequential}" Tag="{x:Static settings:LyricsQueryStrategy.Sequential}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Lyrics.QueryStrategy.Concurrent}" Tag="{x:Static settings:LyricsQueryStrategy.Concurrent}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!--
                            并发取词三件套：采纳策略（下拉）、批次大小（滑杆）、默认接口倒计时（滑杆）。按序查询时整组隐藏。
                            上下限全部绑定 LyricsConcurrencyDefaults，不在 XAML 里另写字面量（与未唱不透明度同一处理）。
                            The concurrency trio: adoption mode (select), batch size (slider), and the default-interface deadline
                            (slider). The bounds all bind to LyricsConcurrencyDefaults and no literal is repeated in XAML — the
                            same handling as the unsung-opacity slider.
                        -->
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.AdoptionMode.Description}"
                            Icon="{ui:SymbolIcon ArrowSwap24}"
                            Title="{DynamicResource Loc.Lyrics.Row.AdoptionMode.Title}" Visibility="{Binding ViewModel.IsConcurrentQuery, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.AdoptionMode, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Adoption.FirstArrival}" Tag="{x:Static settings:LyricsAdoptionMode.FirstArrival}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Adoption.PreferDefaultSource}" Tag="{x:Static settings:LyricsAdoptionMode.PreferDefaultSource}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Adoption.PreferDefaultSourceWithDeadline}" Tag="{x:Static settings:LyricsAdoptionMode.PreferDefaultSourceWithDeadline}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.BatchSize.Description}"
                            Icon="{ui:SymbolIcon Options24}"
                            Title="{DynamicResource Loc.Lyrics.Row.BatchSize.Title}" Visibility="{Binding ViewModel.IsConcurrentQuery, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    Maximum="{Binding Source={x:Static settings:LyricsConcurrencyDefaults.BatchSizeMaximum}}"
                                    Minimum="{Binding Source={x:Static settings:LyricsConcurrencyDefaults.BatchSizeMinimum}}"
                                    Style="{StaticResource AfSettingsRowSliderStyle}"
                                    TickFrequency="1"
                                    Value="{Binding ViewModel.ConcurrencyBatchSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Style="{StaticResource AfSettingsRowValueStyle}"
                                    Text="{Binding ViewModel.ConcurrencyBatchSizeText}" />
                            </StackPanel>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.Deadline.Description}"
                            Icon="{ui:SymbolIcon Timer24}"
                            Title="{DynamicResource Loc.Lyrics.Row.Deadline.Title}" Visibility="{Binding ViewModel.CanConfigureDeadline, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    Maximum="{Binding Source={x:Static settings:LyricsConcurrencyDefaults.AdoptionDeadlineMillisecondsMaximum}}"
                                    Minimum="{Binding Source={x:Static settings:LyricsConcurrencyDefaults.AdoptionDeadlineMillisecondsMinimum}}"
                                    Style="{StaticResource AfSettingsRowSliderStyle}"
                                    TickFrequency="500"
                                    Value="{Binding ViewModel.AdoptionDeadlineMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Style="{StaticResource AfSettingsRowValueStyle}"
                                    Text="{Binding ViewModel.AdoptionDeadlineText}" />
                            </StackPanel>
                        </components:SettingsRow>

                        <!--
                            列表用展开器承载，一行一个来源；顺序即优先级，因此每行自带上下移按钮，
                            与「媒体与通知」页的来源列表、快速启动列表保持同一套写法。
                            The list lives inside an expander with one source per row; the order is the priority, so every row carries
                            its own move buttons, matching the source and quick-launch lists on the media page.
                        -->
                        <!--
                            默认取词接口绑定：一行一个播放器，备注名可编辑（灰字是 AppID 原文，截断防挤占下拉框），
                            下拉选择默认来源，空选项 = 不绑定；AppID 不可改，想改 = 删除后重新添加。
                            内置绑定只是配置文件未生成时的预填，写回后所有行一律按用户条目对待。
                            The default-interface bindings: one player per row with an editable remark (the grey text is the raw
                            AppID, truncated so it cannot crowd the select), a select for the default source where the empty
                            option means "not bound"; an AppID is immutable — changing it means delete and re-add. A built-in
                            binding is only the prefill for a settings file that does not exist yet; after any write-back every
                            row is a plain user entry.
                        -->
                        <ui:CardExpander
                            Visibility="{Binding ViewModel.IsConcurrentQuery, Converter={StaticResource AfBooleanToVisibilityConverter}}"
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon Link24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Lyrics.DefaultBindings.Expander.Title}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Lyrics.DefaultBindings.Expander.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Lyrics.DefaultBindings.Expander.Description}"
                                    Icon="{ui:SymbolIcon Search24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Lyrics.DefaultBindings.Scan}">
                                    <ui:Button
                                        Command="{Binding ViewModel.ScanPlayingPlayersCommand}"
                                        Content="{DynamicResource Loc.Lyrics.DefaultBindings.Scan}"
                                        Icon="{ui:SymbolIcon Search24}"
                                        Style="{StaticResource AfSettingsButtonStyle}" />
                                </components:SettingsRow>

                                <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding ViewModel.BindingEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--
                                                绑定行自绘（IsNested 同款视觉：透明面 + 发丝线 + 缩进）：
                                                左侧备注是无边框 TextBox——默认看起来是纯文本，点击即进入编辑；
                                                右侧紧跟灰色小字的 AppID 原文，截断防挤占，悬停看全文；
                                                AppID 不可编辑——想改 = 删除后重新添加。
                                                The binding row is self-drawn (the nested-row look: transparent surface, hairline, indent):
                                                the remark on the left is a borderless TextBox that reads as plain text until clicked,
                                                followed by the grey raw AppID, truncated with a tooltip; an AppID is immutable —
                                                changing it means delete and re-add.
                                            -->
                                            <Border
                                                Padding="52,12,16,12"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBox
                                                            MinWidth="48"
                                                            MaxWidth="170"
                                                            Padding="0"
                                                            VerticalAlignment="Center"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            FontSize="14"
                                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                            Template="{StaticResource AfBareTextBoxTemplate}"
                                                            Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            ToolTip="{DynamicResource Loc.Lyrics.DefaultBindings.Remark.Placeholder}" />
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            MaxWidth="120"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Opacity="0.7"
                                                            Text="{Binding AppId}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip="{Binding AppId}" />
                                                    </StackPanel>
                                                    <StackPanel
                                                        Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                        <ComboBox
                                                            MinWidth="160"
                                                            SelectedValue="{Binding SelectedSourceId, Mode=TwoWay}"
                                                            SelectedValuePath="Tag">
                                                            <ComboBoxItem Content="{DynamicResource Loc.Lyrics.DefaultBindings.None}" Tag="" />
                                                            <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Source.Netease}" Tag="{x:Static lyrics:LyricsSourceCatalog.NetEase}" />
                                                            <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Source.NeteaseSearch}" Tag="{x:Static lyrics:LyricsSourceCatalog.NetEaseSearch}" />
                                                            <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Source.LRCLIB}" Tag="{x:Static lyrics:LyricsSourceCatalog.Lrclib}" />
                                                            <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Source.QQMusic}" Tag="{x:Static lyrics:LyricsSourceCatalog.QQMusic}" />
                                                            <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Source.Kugou}" Tag="{x:Static lyrics:LyricsSourceCatalog.Kugou}" />
                                                            <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Source.SodaMusic}" Tag="{x:Static lyrics:LyricsSourceCatalog.SodaMusic}" />
                                                        </ComboBox>
                                                        <ui:Button
                                                            Margin="8,0,0,0"
                                                            Command="{Binding DataContext.ViewModel.RemoveBindingCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}"
                                                            Icon="{ui:SymbolIcon Delete24}"
                                                            Style="{StaticResource AfSettingsIconButtonStyle}"
                                                            ToolTip="{DynamicResource Loc.Lyrics.DefaultBindings.Remove}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon Add24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Lyrics.DefaultBindings.Add}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBox
                                            MinWidth="240"
                                            MaxWidth="320"
                                            PlaceholderText="{DynamicResource Loc.Lyrics.DefaultBindings.Add.Placeholder}"
                                            Text="{Binding ViewModel.NewPlayerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:Button
                                            Margin="8,0,0,0"
                                            Command="{Binding ViewModel.AddPlayerCommand}"
                                            Content="{DynamicResource Loc.Lyrics.DefaultBindings.Add}"
                                            Icon="{ui:SymbolIcon Add24}"
                                            Style="{StaticResource AfSettingsButtonStyle}" />
                                    </StackPanel>
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon CloudArrowDown24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <!-- 标题随查询策略动态变化：按序时是「优先级顺序」，并发时是「备用来源优先级顺序」。
                                         The title follows the query strategy: "priority order" in sequential mode, "fallback source priority
                                         order" in concurrent mode. -->
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{Binding ViewModel.SourceExpanderTitle}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Lyrics.Sources.Expander.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Lyrics.Sources.Reset.Description}"
                                    Icon="{ui:SymbolIcon ArrowReset24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Lyrics.Sources.Reset.Title}">
                                    <ui:Button
                                        Command="{Binding ViewModel.ResetSourceOrderCommand}"
                                        Content="{DynamicResource Loc.Lyrics.Sources.Reset.Action}"
                                        Icon="{ui:SymbolIcon ArrowReset24}"
                                        Style="{StaticResource AfSettingsButtonStyle}" />
                                </components:SettingsRow>

                                <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding ViewModel.SourceEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <components:SettingsRow
                                                Description="{DynamicResource Loc.Lyrics.Sources.Row.Description}"
                                                IsNested="True"
                                                Title="{Binding DisplayName}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                                    <ui:Button
                                                        Margin="8,0,0,0"
                                                        Command="{Binding DataContext.ViewModel.MoveSourceUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Icon="{ui:SymbolIcon ArrowUp24}"
                                                        Style="{StaticResource AfSettingsIconButtonStyle}"
                                                        ToolTip="{DynamicResource Loc.Lyrics.Sources.MoveUp}" />
                                                    <ui:Button
                                                        Margin="4,0,0,0"
                                                        Command="{Binding DataContext.ViewModel.MoveSourceDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Icon="{ui:SymbolIcon ArrowDown24}"
                                                        Style="{StaticResource AfSettingsIconButtonStyle}"
                                                        ToolTip="{DynamicResource Loc.Lyrics.Sources.MoveDown}" />
                                                </StackPanel>
                                            </components:SettingsRow>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 全部来源关闭时说明后果：这时不会有任何歌词请求，媒体栏只显示标题与歌手。 -->
                                <!-- With every source off the callout states the consequence: no lyric request is made at all and the bar shows title and artist only. -->
                                <components:SettingsCallout Text="{DynamicResource Loc.Lyrics.Sources.AllDisabled.Callout}">
                                    <components:SettingsCallout.Style>
                                        <Style TargetType="{x:Type components:SettingsCallout}">
                                            <Setter Property="Margin" Value="0,8,0,0" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ViewModel.IsEverySourceDisabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </components:SettingsCallout.Style>
                                </components:SettingsCallout>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>

                <ui:Button
                    Margin="0,16,0,40"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="{DynamicResource Loc.Common.ResetPageDefaults}"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
