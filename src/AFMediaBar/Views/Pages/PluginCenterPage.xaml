<!-- 插件卡片突出名称、必要条件和下载操作，安装详情默认收起。 -->
<Page x:Class="AFMediaBar.Views.Pages.PluginCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="{DynamicResource AppTextFontFamily}"
    TextElement.FontWeight="{DynamicResource AppTextFontWeight}" ScrollViewer.CanContentScroll="False"
    Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <components:SettingsGroupStrip Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}" PageIcon="{ui:SymbolIcon ArrowDownload24}"
            Target="{Binding ElementName=PageScroll}" Title="{DynamicResource Loc.Common.Page.PluginCenter}"
            Subtitle="{DynamicResource Loc.Plugins.Subtitle}" />
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="{StaticResource AfSettingsContentMaxWidth}">
                <components:SettingsGroup GroupId="Plugins.Catalog" Header="{DynamicResource Loc.Plugins.Catalog}" Icon="{ui:SymbolIcon ArrowDownload24}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.Plugins.ManualNotice}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <ui:TextBox PlaceholderText="{DynamicResource Loc.Plugins.Search}" Background="{DynamicResource AfSettingsInputBrush}" Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{DynamicResource Loc.Plugins.Search}" ToolTip="{DynamicResource Loc.Plugins.Search}" Margin="0,0,0,12" />
                        <TextBlock Text="{DynamicResource Loc.Plugins.Empty}" Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource AfBooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding ViewModel.Plugins}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="{DynamicResource AfSettingsInfoSurfaceBrush}" BorderBrush="{DynamicResource AfSettingsBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid SizeChanged="OnCardSizeChanged">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Descriptor.Name}" FontSize="20" FontWeight="{DynamicResource AppTextStrongFontWeight}" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding Target}" FontSize="14" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding Descriptor.Version}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Summary}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" MaxWidth="240">
                                                <WrapPanel HorizontalAlignment="Right">
                                                    <ComboBox ItemsSource="{Binding Descriptor.Assets}" SelectedItem="{Binding SelectedAsset}" DisplayMemberPath="Architecture"
                                                        MinWidth="100" Margin="0,0,8,8" IsEnabled="{Binding CanSelectAsset}"
                                                        AutomationProperties.Name="{DynamicResource Loc.Plugins.Architecture}" ToolTip="{DynamicResource Loc.Plugins.ChooseArchitecture}" />
                                                    <ui:Button Content="{Binding DownloadLabel}" Command="{Binding DownloadCommand}"
                                                        Style="{StaticResource AfSettingsButtonStyle}" Margin="0,0,0,8" />
                                                </WrapPanel>
                                                <WrapPanel HorizontalAlignment="Right">
                                                    <ui:Button Content="{DynamicResource Loc.Plugins.Cancel}" Command="{Binding CancelCommand}"
                                                        Style="{StaticResource AfSettingsButtonStyle}" Margin="0,0,0,8"
                                                        Visibility="{Binding CanCancel, Converter={StaticResource AfBooleanToVisibilityConverter}}" />
                                                    <ui:Button Content="{DynamicResource Loc.Plugins.Reveal}" Command="{Binding RevealCommand}"
                                                        Style="{StaticResource AfSettingsButtonStyle}" Margin="0,0,0,8"
                                                        Visibility="{Binding CanReveal, Converter={StaticResource AfBooleanToVisibilityConverter}}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource Loc.Plugins.Experimental}" Foreground="{DynamicResource AfAccentBrush}" FontSize="14" Margin="0,10,0,0"
                                            Visibility="{Binding Descriptor.IsExperimental, Converter={StaticResource AfBooleanToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding Compatibility}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="3" Margin="0,12,0,6"
                                            Visibility="{Binding HasProgress, Converter={StaticResource AfBooleanToVisibilityConverter}}" />
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasStatus, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource AfSettingsResultTextStyle}" />
                                            <TextBlock Text="{Binding SourceText}" FontSize="14" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Expander Header="{DynamicResource Loc.Plugins.Guide}" Margin="0,12,0,0" HorizontalContentAlignment="Stretch">
                                            <StackPanel Margin="12,8,12,12">
                                                <TextBlock Text="{Binding Attribution}" FontSize="14" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Requirements}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,12" />
                                                <ui:Button Content="{DynamicResource Loc.Plugins.Project}" Command="{Binding OpenProjectCommand}"
                                                    Style="{StaticResource AfSettingsButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,16" />
                                                <TextBlock Text="{DynamicResource Loc.Plugins.Install}" Style="{StaticResource AfSettingsRowTitleStyle}" />
                                                <TextBlock Text="{Binding Install}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                <TextBlock Text="{DynamicResource Loc.Plugins.Upgrade}" Style="{StaticResource AfSettingsRowTitleStyle}" Margin="0,16,0,0" />
                                                <TextBlock Text="{Binding Upgrade}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                <TextBlock Text="{DynamicResource Loc.Plugins.Restore}" Style="{StaticResource AfSettingsRowTitleStyle}" Margin="0,16,0,0" />
                                                <TextBlock Text="{Binding Restore}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander Header="{DynamicResource Loc.Plugins.DownloadDetails}" HorizontalContentAlignment="Stretch">
                            <TextBlock Text="{DynamicResource Loc.Plugins.DownloadDetails.Body}" FontSize="14" TextWrapping="Wrap" Margin="12" />
                        </Expander>
                    </StackPanel>
                </components:SettingsGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
