<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:memory="clr-namespace:AFMediaBar.Classes.Settings" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:AFMediaBar.Components" xmlns:localization="clr-namespace:AFMediaBar.Classes.Services.Localization" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="AFMediaBar.Views.Pages.ApplicationPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}"/>
        <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}"/>
    </Page.Resources>
    <components:SettingsPageLayout x:Name="PageLayout">
        <components:SettingsPageLayout.Header>
            <components:SettingsGroupStrip Title="{DynamicResource Loc.Settings.Page.GeneralAndUpdates}" Subtitle="{DynamicResource Loc.Settings.Page.Application.Description}" PageIcon="{ui:SymbolIcon Settings24}" Target="{Binding ScrollViewer, ElementName=PageLayout}"/>
        </components:SettingsPageLayout.Header>
        <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded">
            <components:SettingsGroup GroupId="Common.Group.Application" Header="{DynamicResource Loc.Common.Group.Application}" Icon="{ui:SymbolIcon Info24}">
                <StackPanel>
                    <components:SettingsRow Description="{DynamicResource Loc.About.Language.Description}" Icon="{ui:SymbolIcon Globe24}" Title="{DynamicResource Loc.About.Language.Title}">
                        <ComboBox MinWidth="{StaticResource AfSettingsSelectShortWidth}" SelectedValue="{Binding ViewModel.InterfaceLanguage, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{DynamicResource Loc.About.Language.FollowSystem}" Tag="{x:Static localization:InterfaceLanguage.System}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.About.Language.SimplifiedChinese}" Tag="{x:Static localization:InterfaceLanguage.SimplifiedChinese}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.About.Language.TraditionalChinese}" Tag="{x:Static localization:InterfaceLanguage.TraditionalChinese}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.About.Language.English}" Tag="{x:Static localization:InterfaceLanguage.English}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.About.Language.Vietnamese}" Tag="{x:Static localization:InterfaceLanguage.Vietnamese}"/>
                        </ComboBox>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.About.Row.Startup.Description}" Icon="{ui:SymbolIcon ShareScreenStart24}" Title="{DynamicResource Loc.About.Row.Startup.Title}">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.LaunchAtStartup, Mode=TwoWay}"/>
                    </components:SettingsRow>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Application.Group.Updates" Header="{DynamicResource Loc.Application.Group.Updates}" Icon="{ui:SymbolIcon ArrowSync24}">
                <StackPanel>
                    <components:SettingsRow Description="{DynamicResource Loc.About.Row.Version.Description}" Icon="{ui:SymbolIcon Info24}" Title="{DynamicResource Loc.About.Row.Version.Title}">
                        <WrapPanel Style="{StaticResource AfSettingsActionsStyle}">
                            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.CurrentVersion, StringFormat=v{0}}"/>
                            <ui:Button Margin="{StaticResource AfSettingsActionGap}" Command="{Binding ViewModel.CheckForUpdatesCommand}" Content="{DynamicResource Loc.About.Row.Version.Check}" Icon="{ui:SymbolIcon ArrowSync24}" IsEnabled="{Binding ViewModel.CanCheck}" Style="{StaticResource AfSettingsButtonStyle}"/>
                        </WrapPanel>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.About.Row.AutoCheck.Description}" Icon="{ui:SymbolIcon ArrowSync24}" Title="{DynamicResource Loc.About.Row.AutoCheck.Title}">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.AutoCheckEnabled, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <components:SettingsCallout Margin="0,0,0,8" IsAccent="False" Symbol="Warning24" Text="{Binding ViewModel.StatusText}" Visibility="{Binding ViewModel.ShowStatusNotice, Converter={StaticResource AfBooleanToVisibilityConverter}}"/>
                    <components:SettingsRow Badge="{DynamicResource Loc.About.Row.Portable.Badge}" Description="{DynamicResource Loc.About.Row.Portable.Description}" Icon="{ui:SymbolIcon Warning24}" Title="{DynamicResource Loc.About.Row.Portable.Title}" Visibility="{Binding ViewModel.IsPortable, Converter={StaticResource AfBooleanToVisibilityConverter}}"/>
                    <StackPanel Visibility="{Binding ViewModel.HasUpdate, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                        <components:SettingsRow Description="{Binding ViewModel.HighlightDate}" Icon="{ui:SymbolIcon Sparkle24}" Title="{Binding ViewModel.HighlightTitle}">
                            <WrapPanel Style="{StaticResource AfSettingsActionsStyle}">
                                <ui:Button Margin="{StaticResource AfSettingsActionGap}" Command="{Binding ViewModel.DownloadUpdateCommand}" Content="{DynamicResource Loc.About.Row.Download.Download}" Icon="{ui:SymbolIcon ArrowDownload24}" IsEnabled="{Binding ViewModel.CanDownload}" Style="{StaticResource AfSettingsButtonStyle}"/>
                                <ui:Button Margin="{StaticResource AfSettingsActionGap}" Command="{Binding ViewModel.CancelDownloadCommand}" Content="{DynamicResource Loc.Common.Cancel}" IsEnabled="{Binding ViewModel.CanCancel}" Style="{StaticResource AfSettingsButtonStyle}"/>
                            </WrapPanel>
                        </components:SettingsRow>
                        <components:SettingsCallout Margin="0,0,0,8" IsAccent="True" Symbol="Info24" Text="{Binding ViewModel.StatusText}"/>
                        <components:SettingsRow Description="{Binding ViewModel.ChannelText}" Icon="{ui:SymbolIcon ArrowSync24}" Title="{DynamicResource Loc.About.Row.Progress.Title}" Visibility="{Binding ViewModel.IsProgressVisible, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar Width="150" Height="4" VerticalAlignment="Center" Maximum="100" Style="{StaticResource AfAccentProgressBarStyle}" Value="{Binding ViewModel.ProgressPercent}"/>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.ProgressPercent, StringFormat={}{0:0}%}"/>
                            </StackPanel>
                        </components:SettingsRow>
                        <components:SettingsRow Description="{DynamicResource Loc.About.Row.Install.Description}" Icon="{ui:SymbolIcon ArrowClockwise24}" Title="{DynamicResource Loc.About.Row.Install.Title}">
                            <ui:Button Command="{Binding ViewModel.InstallAndRestartCommand}" Content="{DynamicResource Loc.About.Row.Install.Now}" Icon="{ui:SymbolIcon ArrowClockwise24}" IsEnabled="{Binding ViewModel.CanInstallNow}" Style="{StaticResource AfSettingsButtonStyle}"/>
                        </components:SettingsRow>
                        <components:SettingsRow Description="{DynamicResource Loc.About.Row.Skip.Description}" Icon="{ui:SymbolIcon Dismiss24}" Title="{DynamicResource Loc.Common.SkipVersion}">
                            <WrapPanel Style="{StaticResource AfSettingsActionsStyle}">
                                <ui:Button Margin="{StaticResource AfSettingsActionGap}" Command="{Binding ViewModel.SkipVersionCommand}" Content="{DynamicResource Loc.Common.SkipVersion}" IsEnabled="{Binding ViewModel.CanSkip}" Style="{StaticResource AfSettingsButtonStyle}"/>
                                <ui:Button Margin="{StaticResource AfSettingsActionGap}" Command="{Binding ViewModel.ClearSkippedVersionCommand}" Content="{DynamicResource Loc.About.Row.Skip.Clear}" IsEnabled="{Binding ViewModel.HasSkippedVersion}" Style="{StaticResource AfSettingsButtonStyle}"/>
                            </WrapPanel>
                        </components:SettingsRow>
                        <components:SettingsRow Description="{DynamicResource Loc.About.Row.DownloadPage.Description}" Icon="{ui:SymbolIcon Globe24}" Title="{DynamicResource Loc.About.Row.DownloadPage.Title}">
                            <WrapPanel Style="{StaticResource AfSettingsActionsStyle}">
                                <ui:Button Margin="{StaticResource AfSettingsActionGap}" Command="{Binding ViewModel.OpenDownloadPageCommand}" Content="GitHub" Icon="{ui:SymbolIcon Globe24}" Style="{StaticResource AfSettingsButtonStyle}"/>
                                <ui:Button Margin="{StaticResource AfSettingsActionGap}" Command="{Binding ViewModel.OpenAcceleratedDownloadPageCommand}" Content="{DynamicResource Loc.About.Row.DownloadPage.Mirror}" Icon="{ui:SymbolIcon ArrowDownload24}" Style="{StaticResource AfSettingsButtonStyle}"/>
                            </WrapPanel>
                        </components:SettingsRow>
                    </StackPanel>
                    <Border Margin="0,4,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AfSettingsInfoSurfaceStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.StartupStatusText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ViewModel.StartupStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource AfSettingsStatusTextStyle}" Text="{Binding ViewModel.StartupStatusText}"/>
                    </Border>
                    <WrapPanel Style="{StaticResource AfSettingsRelatedLinksStyle}">
                        <components:SettingsNavigationButton ToolTip="{DynamicResource Loc.ReleaseHighlights.Application.Description}" Content="{DynamicResource Loc.ReleaseHighlights.Application.Open}" Destination="ReleaseHighlights">
                            <components:SettingsNavigationButton.Style>
                                <Style TargetType="components:SettingsNavigationButton" BasedOn="{StaticResource AfSettingsNavigationButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.HasUpdate}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AfAccentTintBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AfAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AfAccentBrush}"/>
                                            <Setter Property="FontWeight" Value="{DynamicResource AppTextMediumFontWeight}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </components:SettingsNavigationButton.Style>
                        </components:SettingsNavigationButton>
                    </WrapPanel>
                </StackPanel>
            </components:SettingsGroup>
        </StackPanel>
    </components:SettingsPageLayout>
</Page>
