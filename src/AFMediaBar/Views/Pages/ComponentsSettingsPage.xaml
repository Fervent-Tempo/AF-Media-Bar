<Page
    x:Class="AFMediaBar.Views.Pages.ComponentsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <!-- 静置层组件的开关和参数归本页；设置状态由共享的 ExtraFeaturesViewModel 持有。 -->
    <Page.Resources>
        <!--
            依赖未满足时才出现的徽章：组件关闭时它的参数行只读。
            父项开关就在行内，因此徽章只需要一句话。
            A badge that appears only while its dependency is unmet: a component's parameter rows are read-only
            while the component is off. The parent switch is on the same card, so one short phrase is enough.
        -->
        <Style
            x:Key="SpectrumParameterRowStyle"
            BasedOn="{StaticResource {x:Type components:SettingsRow}}"
            TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Setter Property="IsEnabled" Value="{Binding ViewModel.SpectrumVisible}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.SpectrumVisible}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Media.Badge.EnableFirst}" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="PerformanceParameterRowStyle"
            BasedOn="{StaticResource {x:Type components:SettingsRow}}"
            TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Setter Property="IsEnabled" Value="{Binding ViewModel.PerformanceVisible}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.PerformanceVisible}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Media.Badge.EnableFirst}" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:SettingsGroupStrip
            Grid.Row="0"
            PageIcon="{ui:SymbolIcon DataHistogram24}"
            Subtitle="{DynamicResource Loc.Components.Header.Subtitle}"
            Target="{Binding ElementName=PageScroll}"
            Title="{DynamicResource Loc.Common.Page.Components}" />

        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageRoot"
                MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
                Loaded="OnPageLoaded">
                <Grid Style="{StaticResource AfSettingsPageIntroStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ContentControl Content="{ui:SymbolIcon DataHistogram24}" Style="{StaticResource AfSettingsPageIconStyle}" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{DynamicResource Loc.Common.Page.Components}" Style="{StaticResource AfSettingsPageTitleStyle}" />
                        <TextBlock Text="{DynamicResource Loc.Components.Header.Subtitle}" Style="{StaticResource AfSettingsPageSubtitleStyle}" />
                    </StackPanel>
                </Grid>
                <components:SettingsGroup
                    Description="{DynamicResource Loc.Media.RestComponents.Description}"
                    Header="{DynamicResource Loc.Common.Group.RestLayerComponents}"
                    Icon="{ui:SymbolIcon DataHistogram24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="Spectrum" />

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Media.Spectrum.Visible.Description}"
                            Icon="{ui:SymbolIcon DataHistogram24}"
                            Title="{DynamicResource Loc.Media.Spectrum.Visible.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.SpectrumVisible, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon DataBarVertical24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Media.Spectrum.Parameters.Title}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Media.Spectrum.Parameters.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Spectrum.Style.Description}"
                                    Icon="{ui:SymbolIcon PaintBrush24}"
                                    IsNested="True"
                                    Style="{StaticResource SpectrumParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Spectrum.Style.Title}">
                                    <ComboBox
                                        MinWidth="160"
                                        SelectedValue="{Binding ViewModel.SpectrumStyle, Mode=TwoWay}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.Style.Bars}" Tag="{x:Static settings:SpectrumStyle.Bars}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.Style.Waveform}" Tag="{x:Static settings:SpectrumStyle.Waveform}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.Style.PixelBars}" Tag="{x:Static settings:SpectrumStyle.PixelBars}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.Style.MirroredBars}" Tag="{x:Static settings:SpectrumStyle.MirroredBars}" />
                                    </ComboBox>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Spectrum.BandCount.Description}"
                                    Icon="{ui:SymbolIcon DataBarVertical24}"
                                    IsNested="True"
                                    Style="{StaticResource SpectrumParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Spectrum.BandCount.Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="{Binding ViewModel.MaximumSpectrumBandCount}"
                                            Minimum="{Binding ViewModel.MinimumSpectrumBandCount}"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="1"
                                            Value="{Binding ViewModel.SpectrumBandCount, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.SpectrumBandCountText}" />
                                    </StackPanel>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Spectrum.ContentHeight.Description}"
                                    Icon="{ui:SymbolIcon ArrowSort24}"
                                    IsNested="True"
                                    Style="{StaticResource SpectrumParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Spectrum.ContentHeight.Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="{Binding ViewModel.MaximumSpectrumContentHeightDip}"
                                            Minimum="{Binding ViewModel.MinimumSpectrumContentHeightDip}"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="{Binding ViewModel.SpectrumContentHeightStepDip}"
                                            Value="{Binding ViewModel.SpectrumContentHeightDip, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.SpectrumContentHeightText}" />
                                    </StackPanel>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Spectrum.RefreshRate.Description}"
                                    Icon="{ui:SymbolIcon Timer24}"
                                    IsNested="True"
                                    Style="{StaticResource SpectrumParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Spectrum.RefreshRate.Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="30"
                                            Minimum="5"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="1"
                                            Value="{Binding ViewModel.SpectrumRefreshRateHz, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.SpectrumRefreshRateHz, StringFormat={}{0} Hz}" />
                                    </StackPanel>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Spectrum.Sensitivity.Description}"
                                    Icon="{ui:SymbolIcon TopSpeed24}"
                                    IsNested="True"
                                    Style="{StaticResource SpectrumParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Spectrum.Sensitivity.Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="{Binding ViewModel.MaximumSpectrumSensitivityPercent}"
                                            Minimum="{Binding ViewModel.MinimumSpectrumSensitivityPercent}"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="{Binding ViewModel.SpectrumSensitivityStepPercent}"
                                            Value="{Binding ViewModel.SpectrumSensitivityPercent, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.SpectrumSensitivityPercent, StringFormat={}{0}%}" />
                                    </StackPanel>
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Media.Performance.Visible.Description}"
                            Icon="{ui:SymbolIcon Gauge24}"
                            Title="{DynamicResource Loc.Media.Performance.Visible.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.PerformanceVisible, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon Gauge24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Media.Performance.Metrics.Title}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Media.Performance.Metrics.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Metric.SystemMemory.Description}"
                                    Icon="{ui:SymbolIcon Storage24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Metric.SystemMemory.Title}">
                                    <ui:ToggleSwitch
                                        IsChecked="{Binding ViewModel.ShowSystemMemory, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanUncheckSystemMemory}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon DeveloperBoard24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="CPU">
                                    <ui:ToggleSwitch
                                        IsChecked="{Binding ViewModel.ShowSystemCpu, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanUncheckSystemCpu}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon VideoClip24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="GPU">
                                    <ui:ToggleSwitch
                                        IsChecked="{Binding ViewModel.ShowSystemGpu, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanUncheckSystemGpu}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon Apps24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Metric.ProcessMemory.Title}">
                                    <ui:ToggleSwitch
                                        IsChecked="{Binding ViewModel.ShowProcessMemory, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanUncheckProcessMemory}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Performance.RefreshInterval.Description}"
                                    Icon="{ui:SymbolIcon Timer24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Performance.RefreshInterval.Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="{Binding ViewModel.MaximumPerformanceRefreshIntervalSeconds}"
                                            Minimum="{Binding ViewModel.MinimumPerformanceRefreshIntervalSeconds}"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="{Binding ViewModel.PerformanceRefreshIntervalStepSeconds}"
                                            Value="{Binding ViewModel.PerformanceRefreshIntervalSeconds, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.PerformanceRefreshIntervalText}" />
                                    </StackPanel>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Performance.OpenTaskManager.Description}"
                                    Icon="{ui:SymbolIcon CursorClick24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Performance.OpenTaskManager.Title}">
                                    <ui:ToggleSwitch IsChecked="{Binding ViewModel.OpenTaskManagerOnMetricsClick, Mode=TwoWay}" />
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>

                <ui:Button
                    Margin="0,16,0,40"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="{DynamicResource Loc.Common.ResetPageDefaults}"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
