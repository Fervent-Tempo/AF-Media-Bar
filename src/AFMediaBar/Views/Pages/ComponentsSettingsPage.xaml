<Page xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:components="clr-namespace:AFMediaBar.Components" x:Class="AFMediaBar.Views.Pages.ComponentsSettingsPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}"/>
        <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}"/>
    </Page.Resources>
    <components:SettingsPageLayout x:Name="PageLayout">
        <components:SettingsPageLayout.Header>
            <components:SettingsGroupStrip Title="{DynamicResource Loc.Settings.Page.QuickControls}" Subtitle="{DynamicResource Loc.Settings.Page.QuickControls.Description}" PageIcon="{ui:SymbolIcon HandDraw24}" Target="{Binding ScrollViewer, ElementName=PageLayout}">
                <components:SettingsGroupStrip.HeaderActions>
                    <ui:Button Content="{DynamicResource Loc.Common.ResetPageDefaults}" Style="{StaticResource AfSettingsButtonStyle}" Click="ResetButton_Click" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top"/>
                </components:SettingsGroupStrip.HeaderActions>
            </components:SettingsGroupStrip>
        </components:SettingsPageLayout.Header>
        <components:SettingsPageLayout.Preview>
            <components:SettingsPreview DataContext="{Binding Preview}"/>
        </components:SettingsPageLayout.Preview>
        <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded">
            <components:SettingsGroup GroupId="Common.HoverLayer" Header="{DynamicResource Loc.ComponentLayout.Hover}">
                <StackPanel>
                    <components:SettingsRow Title="{DynamicResource Loc.DisplayModes.Hover.Row.Enable.Title}" Description="{DynamicResource Loc.DisplayModes.Hover.Row.Enable.Description}" Icon="{ui:SymbolIcon HandDraw24}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.Layers.HoverLayerEnabled, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <AdornerDecorator>
                        <ItemsControl ItemsSource="{Binding ViewModel.Layers.HoverLayoutEntries}" Style="{StaticResource AfSettingsSortableListStyle}" ItemTemplate="{StaticResource AfSettingsComponentRowTemplate}" components:SettingsReorderBehavior.MoveCommand="{Binding ViewModel.Layers.ReorderLayoutCommand}"/>
                    </AdornerDecorator>
                    <components:SettingsRow Title="{DynamicResource Loc.DisplayModes.Hover.Row.Alignment.Title}" Description="{DynamicResource Loc.DisplayModes.Hover.Row.Alignment.Description}" Icon="{ui:SymbolIcon ArrowMove24}" OptionId="hover:alignment">
                        <ComboBox MinWidth="{StaticResource AfSettingsSelectMinWidth}" SelectedIndex="{Binding ViewModel.Layers.TaskbarHoverAlignmentIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource Loc.DisplayModes.Hover.Alignment.Automatic}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.Common.AlignLeft}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.Common.AlignCenter}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.Common.AlignRight}"/>
                        </ComboBox>
                    </components:SettingsRow>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Appearance.Group.InteractionButtons" Header="{DynamicResource Loc.Appearance.Group.InteractionButtons}" Icon="{ui:SymbolIcon CursorClick24}">
                <StackPanel>
                    <components:SettingsRow Description="{DynamicResource Loc.Appearance.Row.InteractionButtonSize.Description}" Icon="{ui:SymbolIcon TextAlignJustify24}" Title="{DynamicResource Loc.Appearance.Row.InteractionButtonSize.Title}">
                        <ComboBox MinWidth="{StaticResource AfSettingsSelectMinWidth}" SelectedValue="{Binding ViewModel.Layout.InteractionButtonSize, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{DynamicResource Loc.DisplayModes.Rest.Density.Minimal}" Tag="{x:Static settings:TaskbarInformationDensity.Minimal}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.DisplayModes.Rest.Density.Balanced}" Tag="{x:Static settings:TaskbarInformationDensity.Balanced}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.DisplayModes.Rest.Density.Information}" Tag="{x:Static settings:TaskbarInformationDensity.Information}"/>
                        </ComboBox>
                    </components:SettingsRow>
                    <components:SettingsRow Description="{DynamicResource Loc.DisplayModes.Hover.Row.Spacing.Description}" Icon="{ui:SymbolIcon PaddingLeft24}" Title="{DynamicResource Loc.DisplayModes.Hover.Row.Spacing.Title}">
                        <components:SettingsNumericEditor Value="{Binding ViewModel.Layout.HoverButtonSpacingDip, Mode=TwoWay}" Minimum="0" Maximum="{Binding Source={x:Static settings:TaskbarExperienceSettings.MaximumHoverButtonSpacingDip}}" Step="1" Unit="{DynamicResource Loc.Settings.Numeric.Dip}"/>
                    </components:SettingsRow>
                    <WrapPanel Style="{StaticResource AfSettingsRelatedLinksStyle}">
                        <components:SettingsNavigationButton Content="{DynamicResource Loc.Settings.Related.RestInteraction}" Destination="Interaction" GroupId="Common.Group.InAppRestLayer"/>
                    </WrapPanel>
                </StackPanel>
            </components:SettingsGroup>
        </StackPanel>
    </components:SettingsPageLayout>
</Page>
