<?xml version="1.0" ?><Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:memory="clr-namespace:AFMediaBar.Classes.Settings" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:AFMediaBar.Components" xmlns:localization="clr-namespace:AFMediaBar.Classes.Services.Localization" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="AFMediaBar.Views.Pages.MemoryToolsPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}"/>
        <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}"/>
    </Page.Resources>
    <components:SettingsPageLayout x:Name="PageLayout">
        <components:SettingsPageLayout.Header>
            <components:SettingsGroupStrip Title="{DynamicResource Loc.Settings.Page.MemoryTools}" Subtitle="{DynamicResource Loc.Settings.Page.MemoryTools.Description}" PageIcon="{ui:SymbolIcon ArrowMinimize24}" Target="{Binding ScrollViewer, ElementName=PageLayout}"/>
        </components:SettingsPageLayout.Header>
        <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded">
            <StackPanel Margin="0,0,0,20">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.MemoryTools.IsEnabled}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{DynamicResource Loc.Settings.Experiment.Required}" Style="{StaticResource AfSettingsHintTextStyle}"/>
                <components:SettingsNavigationButton Destination="Experimental" GroupId="Memory.Title" Content="{DynamicResource Loc.Settings.Component.Configure}"/>
            </StackPanel>
            <components:SettingsGroup GroupId="Memory.Local" Header="{DynamicResource Loc.Memory.OptimizeAf}" Visibility="{Binding ViewModel.MemoryTools.IsLegacyTrimVisible, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                <components:SettingsRow IsNested="True" Description="{DynamicResource Loc.About.Row.TrimMemory.Description}" Icon="{ui:SymbolIcon ArrowMinimize24}" Title="{DynamicResource Loc.Memory.OptimizeAf}" Visibility="{Binding ViewModel.MemoryTools.IsLegacyTrimVisible, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                    <ui:Button Command="{Binding ViewModel.MemoryTools.DeepCommand}" IsEnabled="{Binding ViewModel.MemoryTools.CanRun}" Content="{DynamicResource Loc.Memory.OptimizeAf}" Icon="{ui:SymbolIcon ArrowMinimize24}" Style="{StaticResource AfSettingsButtonStyle}"/>
                </components:SettingsRow>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Memory.Title" Header="{DynamicResource Loc.Memory.Title}" Description="{DynamicResource Loc.Memory.ToolsDescription}" Icon="{ui:SymbolIcon ArrowMinimize24}" Visibility="{Binding ViewModel.MemoryTools.IsEnabled, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                <StackPanel>
                    <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" Title="{DynamicResource Loc.Memory.OptimizeAf}" Description="{DynamicResource Loc.Memory.Deep.Description}">
                        <ui:Button Content="{DynamicResource Loc.Memory.OptimizeAf}" Command="{Binding ViewModel.MemoryTools.DeepCommand}" IsEnabled="{Binding ViewModel.MemoryTools.CanRun}" Style="{StaticResource AfSettingsButtonStyle}"/>
                    </components:SettingsRow>
                    <ui:Button Content="{DynamicResource Loc.Memory.Result.ViewLatest}" Command="{Binding ViewModel.MemoryTools.ShowLastResultCommand}" Style="{StaticResource AfSettingsButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,4" Visibility="{Binding ViewModel.MemoryTools.HasManualResult, Converter={StaticResource AfBooleanToVisibilityConverter}}"/>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon ArrowMinimize24}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="{DynamicResource Loc.Memory.Metrics.Title}" Style="{StaticResource AfSettingsRowTitleStyle}"/>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.WorkingSet}">
                                <TextBlock Text="{Binding ViewModel.MemoryTools.WorkingSetText}" Style="{StaticResource AfSettingsRowValueStyle}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.PrivateCommit}">
                                <TextBlock Text="{Binding ViewModel.MemoryTools.PrivateCommitText}" Style="{StaticResource AfSettingsRowValueStyle}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.ManagedHeap}">
                                <TextBlock Text="{Binding ViewModel.MemoryTools.ManagedHeapText}" Style="{StaticResource AfSettingsRowValueStyle}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.Handles}">
                                <TextBlock Text="{Binding ViewModel.MemoryTools.HandlesText}" Style="{StaticResource AfSettingsRowValueStyle}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.Threads}">
                                <TextBlock Text="{Binding ViewModel.MemoryTools.ThreadsText}" Style="{StaticResource AfSettingsRowValueStyle}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.Available}">
                                <TextBlock Text="{Binding ViewModel.MemoryTools.AvailableMemoryText}" Style="{StaticResource AfSettingsRowValueStyle}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.SampleTime}">
                                <TextBlock Text="{Binding ViewModel.MemoryTools.SampleTimeText}" Style="{StaticResource AfSettingsRowValueStyle}"/>
                            </components:SettingsRow>
                            <TextBlock Text="{DynamicResource Loc.Memory.Explanation}" TextWrapping="Wrap" Style="{StaticResource AfSettingsHintTextStyle}" Margin="0,8,0,4"/>
                        </StackPanel>
                    </ui:CardExpander>
                    <ui:CardExpander IsExpanded="True" Visibility="{Binding ViewModel.MemoryTools.HasResult, Converter={StaticResource AfBooleanToVisibilityConverter}}" Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon ArrowMinimize24}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="{DynamicResource Loc.Memory.LastResult}" Style="{StaticResource AfSettingsRowTitleStyle}"/>
                        </ui:CardExpander.Header>
                        <TextBlock Text="{Binding ViewModel.MemoryTools.ResultText}" TextWrapping="Wrap" Style="{StaticResource AfSettingsResultTextStyle}"/>
                    </ui:CardExpander>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon ArrowMinimize24}" Visibility="{Binding ViewModel.MemoryTools.IsSystemCleanupEnabled, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.Memory.System.Title}" Style="{StaticResource AfSettingsRowTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Loc.Memory.System.Scope}" TextWrapping="Wrap" Style="{StaticResource AfSettingsRowDescriptionStyle}"/>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.System.Clean}" Description="{DynamicResource Loc.Memory.System.Description}">
                                <ui:Button Content="{DynamicResource Loc.Memory.System.Run}" Command="{Binding ViewModel.MemoryTools.CleanSystemCommand}" IsEnabled="{Binding ViewModel.MemoryTools.CanRun}" Style="{StaticResource AfSettingsButtonStyle}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.System.Deep}" Description="{DynamicResource Loc.Memory.System.DeepDescription}">
                                <ui:Button Content="{DynamicResource Loc.Memory.System.Deep}" Command="{Binding ViewModel.MemoryTools.CleanSystemDeepCommand}" IsEnabled="{Binding ViewModel.MemoryTools.CanRun}" Style="{StaticResource AfSettingsButtonStyle}"/>
                            </components:SettingsRow>
                            <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.Authorization.Title}" Description="{Binding ViewModel.MemoryTools.AuthorizationText}">
                                <WrapPanel Style="{StaticResource AfSettingsActionsStyle}">
                                    <ui:Button Margin="{StaticResource AfSettingsActionGap}" Content="{DynamicResource Loc.Memory.Authorization.Remember}" Command="{Binding ViewModel.MemoryTools.AuthorizeCommand}" IsEnabled="{Binding ViewModel.MemoryTools.CanRun}" Style="{StaticResource AfSettingsButtonStyle}"/>
                                    <ui:Button Margin="{StaticResource AfSettingsActionGap}" Content="{DynamicResource Loc.Memory.Authorization.Revoke}" Command="{Binding ViewModel.MemoryTools.RevokeAuthorizationCommand}" IsEnabled="{Binding ViewModel.MemoryTools.CanRun}" Style="{StaticResource AfSettingsButtonStyle}"/>
                                </WrapPanel>
                            </components:SettingsRow>
                            <ui:CardExpander Style="{StaticResource AfSettingsNestedExpanderStyle}" Icon="{ui:SymbolIcon ArrowMinimize24}">
                                <ui:CardExpander.Header>
                                    <TextBlock Text="{DynamicResource Loc.Memory.Auto.Title}" Style="{StaticResource AfSettingsRowTitleStyle}"/>
                                </ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.Memory.Auto.Description}" TextWrapping="Wrap" Style="{StaticResource AfSettingsHintTextStyle}" Margin="0,8"/>
                                    <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.Auto.Timer}" KeepControlInline="True">
                                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.MemoryTools.TimerEnabled, Mode=TwoWay}"/>
                                    </components:SettingsRow>
                                    <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.Auto.Interval}">
                                        <WrapPanel>
                                            <ui:NumberBox Minimum="{Binding ViewModel.MemoryTools.MinimumAutomaticInterval}" Maximum="{Binding ViewModel.MemoryTools.MaximumAutomaticInterval}" Value="{Binding ViewModel.MemoryTools.IntervalMinutes, Mode=TwoWay}" Width="150"/>
                                            <TextBlock Text="{DynamicResource Loc.Settings.Numeric.Minutes}" Style="{StaticResource AfSettingsRowValueStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </components:SettingsRow>
                                    <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.Auto.Threshold}" KeepControlInline="True">
                                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.MemoryTools.ThresholdEnabled, Mode=TwoWay}"/>
                                    </components:SettingsRow>
                                    <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.Auto.Percent}">
                                        <components:SettingsNumericEditor Minimum="{Binding ViewModel.MemoryTools.MinimumAutomaticThreshold}" Maximum="{Binding ViewModel.MemoryTools.MaximumAutomaticThreshold}" Value="{Binding ViewModel.MemoryTools.ThresholdPercent, Mode=TwoWay}" Step="1" Unit="{DynamicResource Loc.Settings.Numeric.Percent}"/>
                                    </components:SettingsRow>
                                    <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{DynamicResource Loc.Memory.Auto.Level}">
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.MemoryTools.AutomaticLevel, Mode=TwoWay}" MinWidth="{StaticResource AfSettingsSelectMinWidth}">
                                            <ComboBoxItem Content="{DynamicResource Loc.Memory.System.Standard}" Tag="{x:Static memory:SystemMemoryOptimizationLevel.Standard}"/>
                                            <ComboBoxItem Content="{DynamicResource Loc.Memory.System.Deep}" Tag="{x:Static memory:SystemMemoryOptimizationLevel.Deep}"/>
                                        </ComboBox>
                                    </components:SettingsRow>
                                    <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" IsNested="True" Title="{Binding ViewModel.MemoryTools.AutomaticStatusText}">
                                        <ui:Button Content="{DynamicResource Loc.Memory.Auto.Resume}" Command="{Binding ViewModel.MemoryTools.ResumeAutomaticCommand}" Style="{StaticResource AfSettingsButtonStyle}"/>
                                    </components:SettingsRow>
                                </StackPanel>
                            </ui:CardExpander>
                            <TextBlock Text="{Binding ViewModel.MemoryTools.SystemResultText}" TextWrapping="Wrap" Style="{StaticResource AfSettingsResultTextStyle}" Visibility="{Binding ViewModel.MemoryTools.HasSystemResult, Converter={StaticResource AfBooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </ui:CardExpander>
                    <WrapPanel Style="{StaticResource AfSettingsRelatedLinksStyle}">
                        <components:SettingsNavigationButton Content="{DynamicResource Loc.Settings.Related.WidgetLayout}" Destination="Components" GroupId="Common.Group.ComponentOrder"/>
                        <components:SettingsNavigationButton Content="{DynamicResource Loc.Settings.Related.Experiments}" Destination="Experimental" GroupId="Memory.Title"/>
                    </WrapPanel>
                </StackPanel>
            </components:SettingsGroup>
        </StackPanel>
    </components:SettingsPageLayout>
</Page>
