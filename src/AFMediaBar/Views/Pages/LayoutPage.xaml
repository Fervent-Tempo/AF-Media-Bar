<Page x:Class="AFMediaBar.Views.Pages.LayoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1100"
      Title="LayoutPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <StackPanel MaxWidth="1000"
                Margin="16"
                VerticalAlignment="Center">
        <TextBlock Text="布局"
                   FontSize="32"
                   FontWeight="SemiBold" />
        <ui:TextBlock Text="调整窗口模式、排列方式和尺寸"
                      Appearance="Secondary"
                      Margin="0,8,0,28" />

        <TextBlock Text="窗口"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon WindowConsole20}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="窗口模式"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="选择媒体栏的承载方式"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="停靠任务栏"
                             GroupName="HostMode"
                             IsChecked="True"
                             Margin="0,0,12,0" />
                <RadioButton Content="悬浮窗口"
                             GroupName="HostMode" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,24"
                        Icon="{ui:SymbolIcon ArrowAutofitContent24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="排列方式"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="设置媒体内容的排列方向"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="自动"
                             GroupName="LayoutMode"
                             IsChecked="True"
                             Margin="0,0,12,0" />
                <RadioButton Content="横向"
                             GroupName="LayoutMode"
                             Margin="0,0,12,0" />
                <RadioButton Content="纵向"
                             GroupName="LayoutMode" />
            </StackPanel>
        </ui:CardControl>

        <TextBlock Text="尺寸"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon ResizeLarge24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="长度缩放"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="调整媒体栏长度"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <Grid Width="280">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>
                <Slider Minimum="70"
                        Maximum="125"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Value="100" />
                <TextBlock Grid.Column="1"
                           Text="100%"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="14" />
            </Grid>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon ResizeSmall24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="粗细缩放"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="调整媒体栏厚度"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <Grid Width="280">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>
                <Slider Minimum="70"
                        Maximum="125"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Value="100" />
                <TextBlock Grid.Column="1"
                           Text="100%"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="14" />
            </Grid>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,24"
                        Icon="{ui:SymbolIcon ArrowUp24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="顶部偏移"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="微调媒体栏相对位置"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <Grid Width="280">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>
                <Slider Minimum="-20"
                        Maximum="20"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="0" />
                <TextBlock Grid.Column="1"
                           Text="0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="14" />
            </Grid>
        </ui:CardControl>

        <TextBlock Text="位置"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon DesktopArrowRight24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="避开任务栏"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="自动调整位置以避免遮挡任务栏"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon LockClosed24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="锁定位置"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="固定媒体栏当前位置"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon ArrowReset24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="重置位置"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="恢复默认位置"
                                  Appearance="Secondary"
                                  FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="重置"
                       Icon="{ui:SymbolIcon ArrowReset24}" />
        </ui:CardControl>
    </StackPanel>
</Page>