<!-- Native WPF release reading surface; release bodies are plain text, never executable HTML. -->
<Page x:Class="AFMediaBar.Views.Pages.ReleaseHighlightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:components="clr-namespace:AFMediaBar.Components"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="{DynamicResource AppTextFontFamily}" TextElement.FontWeight="{DynamicResource AppTextFontWeight}"
    Loaded="OnPageLoaded" Unloaded="OnPageUnloaded" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <DataTemplate x:Key="ReleaseBody">
            <StackPanel Margin="20,12,20,20">
                <TextBlock Text="{Binding OriginalNotice}" Style="{StaticResource AfSettingsRowDescriptionStyle}" />
                <TextBlock Text="{DynamicResource Loc.ReleaseHighlights.NoHighlights}" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AfSettingsRowDescriptionStyle}">
                        <Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Highlights.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Highlights}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Ellipse Width="4" Height="4" Fill="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,8,0,0" />
                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="14" LineHeight="22" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Content="{DynamicResource Loc.ReleaseHighlights.FullNotes}" Click="OnOpenReleaseNotes" Margin="0,12,0,0"
                           HorizontalAlignment="Left" Visibility="{Binding HasReleaseNotes, Converter={StaticResource AfBooleanToVisibilityConverter}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ReleaseHeader">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding VersionLabel}" Foreground="{DynamicResource AfAccentBrush}" FontWeight="{DynamicResource AppTextStrongFontWeight}" FontSize="14" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Badge}" Foreground="{DynamicResource AfAccentBrush}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="{DynamicResource AppTextMediumFontWeight}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <components:SettingsGroupStrip Margin="{StaticResource AfSettingsHeaderMargin}" MaxWidth="{StaticResource AfSettingsContentMaxWidth}" Target="{Binding ElementName=PageScroll}" Title="{DynamicResource Loc.Common.Page.ReleaseHighlights}" />
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" Margin="{StaticResource AfSettingsScrollMargin}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="{StaticResource AfSettingsContentMaxWidth}">

                <TextBlock Text="{Binding ViewModel.StatusText}" Style="{StaticResource AfSettingsRowDescriptionStyle}" Margin="0,8,0,8" />
                <ProgressBar IsIndeterminate="True" Height="2" Margin="0,0,0,12"
                             Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource AfBooleanToVisibilityConverter}}" />
                <components:SettingsGroup Header="{DynamicResource Loc.ReleaseHighlights.Latest}" Icon="{ui:SymbolIcon Sparkle24}">
                    <Border Background="{DynamicResource AfSettingsInfoSurfaceBrush}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel DataContext="{Binding ViewModel.Latest}">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ReleaseHeader}" Margin="20,20,20,0" />
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ReleaseBody}" />
                        </StackPanel>
                    </Border>
                </components:SettingsGroup>
                <components:SettingsGroup Header="{DynamicResource Loc.ReleaseHighlights.History}" Icon="{ui:SymbolIcon History24}">
                    <ItemsControl ItemsSource="{Binding ViewModel.History}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <ui:CardExpander Content="{Binding}" Margin="0,0,0,8">
                                <ui:CardExpander.Header><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ReleaseHeader}" /></ui:CardExpander.Header>
                                <ui:CardExpander.Style><Style TargetType="{x:Type ui:CardExpander}" BasedOn="{StaticResource AfSettingsExpanderStyle}">
                                    <Style.Triggers><Trigger Property="IsExpanded" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ReleaseBody}" /></Trigger></Style.Triggers>
                                </Style></ui:CardExpander.Style>
                            </ui:CardExpander>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </components:SettingsGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
