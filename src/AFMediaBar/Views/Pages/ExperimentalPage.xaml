<Page x:Class="AFMediaBar.Views.Pages.ExperimentalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="clr-namespace:AFMediaBar.Components"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <components:SettingsGroupStrip Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}" PageIcon="{ui:SymbolIcon Beaker24}"
            Title="{DynamicResource Loc.Common.Page.Experimental}"
            Target="{Binding ElementName=PageScroll}" />
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" Margin="{StaticResource AfSettingsScrollMargin}" Background="Transparent"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="{StaticResource AfSettingsContentMaxWidth}">
                <ui:InfoBar x:Name="ExperimentalWarning" Message="{DynamicResource Loc.Experimental.Warning}" Severity="Warning"
                    Style="{StaticResource AfSettingsInfoBarStyle}" Margin="0,0,0,16" />
                <components:SettingsGroup GroupId="Battery.Title" Header="{DynamicResource Loc.Battery.Title}" Description="{DynamicResource Loc.Battery.SelectHint}" Icon="{ui:SymbolIcon Bluetooth24}">
                    <StackPanel>
                        <components:SettingsRow Icon="{ui:SymbolIcon Bluetooth24}" Title="{DynamicResource Loc.Experimental.Enable}"><ui:ToggleSwitch IsChecked="{Binding ViewModel.BluetoothBattery, Mode=TwoWay}"/></components:SettingsRow>

                        <WrapPanel Style="{StaticResource AfSettingsRelatedLinksStyle}">
                            <components:SettingsNavigationButton Content="{DynamicResource Loc.Battery.Open}" Destination="Widgets" GroupId="Battery.Title"/>
                        </WrapPanel>
                    </StackPanel>
                </components:SettingsGroup>
                <components:SettingsGroup GroupId="Memory.Title" Header="{DynamicResource Loc.Memory.Title}" Description="{DynamicResource Loc.Memory.Explanation}" Icon="{ui:SymbolIcon ArrowMinimize24}">
                    <StackPanel>
                        <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" Title="{DynamicResource Loc.Experimental.Enable}"><ui:ToggleSwitch IsChecked="{Binding ViewModel.MemoryTools, Mode=TwoWay}" /></components:SettingsRow>
                        <components:SettingsRow Icon="{ui:SymbolIcon ArrowMinimize24}" Title="{DynamicResource Loc.Memory.System.Title}" Description="{DynamicResource Loc.Memory.System.Description}" Visibility="{Binding ViewModel.MemoryTools, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.SystemMemoryCleanup, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <WrapPanel Style="{StaticResource AfSettingsRelatedLinksStyle}" Visibility="{Binding ViewModel.MemoryTools, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                            <components:SettingsNavigationButton Content="{DynamicResource Loc.Memory.Open}" Destination="Application" GroupId="Memory.Title" />
                        </WrapPanel>
                    </StackPanel>
                </components:SettingsGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
