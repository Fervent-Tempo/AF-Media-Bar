<Page x:Class="AFMediaBar.Views.Pages.ExperimentalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="clr-namespace:AFMediaBar.Components"
      xmlns:services="clr-namespace:AFMediaBar.Classes.Services"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <components:SettingsGroupStrip Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}" PageIcon="{ui:SymbolIcon Beaker24}"
            Title="{DynamicResource Loc.Common.Page.Experimental}"
            Target="{Binding ElementName=PageScroll}" />
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" Margin="{StaticResource AfSettingsScrollMargin}" Background="Transparent"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="{StaticResource AfSettingsContentMaxWidth}">
                <components:SettingsCallout Text="{DynamicResource Loc.Experimental.Warning}" Symbol="Warning24"
                    IsAccent="True" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16" />
                <components:SettingsGroup GroupId="Experimental.Audio.Title" Header="{DynamicResource Loc.Experimental.Audio.Title}"
                    Description="{DynamicResource Loc.Experimental.Audio.Description}" Icon="{ui:SymbolIcon Speaker224}">
                    <StackPanel>
                        <components:SettingsRow Title="{DynamicResource Loc.Experimental.Enable}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.NewAudioControl, Mode=TwoWay}" />
                        </components:SettingsRow>
                        <TextBlock Text="{DynamicResource Loc.Experimental.Audio.RoutingPreserved}" TextWrapping="Wrap" Style="{StaticResource AfSettingsHintTextStyle}" Margin="0,8,0,0" />
                        <StackPanel Visibility="{Binding ViewModel.NewAudioControl, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource Loc.Experimental.Audio.RoutesNotice}" TextWrapping="Wrap" Style="{StaticResource AfSettingsHintTextStyle}" Margin="0,8,0,12" />
                            <components:SettingsRow Title="{DynamicResource Loc.Audio.Settings.Title}"
                                Description="{DynamicResource Loc.Audio.Settings.Description}" Icon="{ui:SymbolIcon Speaker224}">
                                <ui:Button Content="{DynamicResource Loc.Experimental.OpenInteraction}"
                                    Style="{StaticResource AfSettingsButtonStyle}" Tag="{x:Static services:SettingsPageKey.Interaction}"
                                    CommandParameter="Audio.Settings.Title" Click="OpenSettings_Click" />
                            </components:SettingsRow>
                        </StackPanel>
                    </StackPanel>
                </components:SettingsGroup>
                <components:SettingsGroup GroupId="Experimental.Vertical.Title" Header="{DynamicResource Loc.Experimental.Vertical.Title}"
                    Description="{DynamicResource Loc.Experimental.Vertical.Description}" Icon="{ui:SymbolIcon ArrowSort24}">
                    <StackPanel>
                        <components:SettingsRow Title="{DynamicResource Loc.Experimental.Enable}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.VerticalTaskbar, Mode=TwoWay}" />
                        </components:SettingsRow>
                        <StackPanel Visibility="{Binding ViewModel.VerticalTaskbar, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource Loc.Experimental.Vertical.Shared}" TextWrapping="Wrap" Style="{StaticResource AfSettingsHintTextStyle}" Margin="0,8,0,12" />
                            <components:SettingsRow Title="{DynamicResource Loc.Common.Page.ContentLayout}"
                                Description="{DynamicResource Loc.ContentLayout.Header.Subtitle}" Icon="{ui:SymbolIcon Grid24}">
                                <ui:Button Content="{DynamicResource Loc.Experimental.OpenContentLayout}" Style="{StaticResource AfSettingsButtonStyle}"
                                    Uid="Taskbar" Tag="{x:Static services:SettingsPageKey.Components}" Click="OpenSettings_Click" />
                            </components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Common.Page.Appearance}"
                                Description="{DynamicResource Loc.Appearance.Unified.Header.Subtitle}" Icon="{ui:SymbolIcon PaintBrush24}">
                                <ui:Button Content="{DynamicResource Loc.Experimental.OpenAppearance}" Style="{StaticResource AfSettingsButtonStyle}"
                                    Uid="Taskbar" Tag="{x:Static services:SettingsPageKey.Appearance}" Click="OpenSettings_Click" />
                            </components:SettingsRow>
                        </StackPanel>
                    </StackPanel>
                </components:SettingsGroup>
                <components:SettingsGroup GroupId="Experimental.Floating.Title" Header="{DynamicResource Loc.Experimental.Floating.Title}"
                    Description="{DynamicResource Loc.Experimental.Floating.Description}" Icon="{ui:SymbolIcon Desktop24}">
                    <StackPanel>
                        <components:SettingsRow Title="{DynamicResource Loc.Experimental.Enable}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.FloatingBar, Mode=TwoWay}" />
                        </components:SettingsRow>
                        <StackPanel Visibility="{Binding ViewModel.FloatingBar, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                            <components:SettingsRow Title="{DynamicResource Loc.Experimental.Floating.Mode}">
                                <ComboBox SelectedIndex="{Binding ViewModel.RunningModeSelection, Mode=TwoWay}" MinWidth="180">
                                    <ComboBoxItem Content="{DynamicResource Loc.Experimental.Floating.Taskbar}" />
                                    <ComboBoxItem Content="{DynamicResource Loc.Experimental.Floating.Title}" />
                                </ComboBox>
                            </components:SettingsRow>
                            <TextBlock Text="{Binding ViewModel.RuntimeStatus}" TextWrapping="Wrap" Style="{StaticResource AfSettingsHintTextStyle}" Margin="0,6,0,12" />
                            <components:SettingsRow Title="{DynamicResource Loc.Experimental.Floating.Orientation}">
                                <ComboBox SelectedIndex="{Binding ViewModel.FloatingOrientation, Mode=TwoWay}" MinWidth="180">
                                    <ComboBoxItem Content="{DynamicResource Loc.Experimental.Floating.Horizontal}" />
                                    <ComboBoxItem Content="{DynamicResource Loc.Experimental.Floating.Vertical}" />
                                </ComboBox>
                            </components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Experimental.Floating.Layer}">
                                <ComboBox SelectedIndex="{Binding ViewModel.FloatingLayer, Mode=TwoWay}" MinWidth="180">
                                    <ComboBoxItem Content="{DynamicResource Loc.Experimental.Floating.Desktop}" />
                                    <ComboBoxItem Content="{DynamicResource Loc.Experimental.Floating.Topmost}" />
                                </ComboBox>
                            </components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Experimental.Floating.Lock}">
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.FloatingLocked, Mode=TwoWay}" />
                            </components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Common.Page.ScreenAndPlacement}" Icon="{ui:SymbolIcon Desktop24}">
                                <ui:Button Content="{DynamicResource Loc.Experimental.Floating.OpenDisplay}" Style="{StaticResource AfSettingsButtonStyle}"
                                    Uid="FloatingBar" Tag="{x:Static services:SettingsPageKey.ScreenAndPlacement}" Click="OpenSettings_Click" />
                            </components:SettingsRow>
                            <TextBlock Text="{DynamicResource Loc.Experimental.Floating.Independent}" TextWrapping="Wrap" Style="{StaticResource AfSettingsHintTextStyle}" Margin="0,8,0,12" />
                            <components:SettingsRow Title="{DynamicResource Loc.Common.Page.ContentLayout}"
                                Description="{DynamicResource Loc.ContentLayout.Header.Subtitle}" Icon="{ui:SymbolIcon Grid24}">
                                <ui:Button Content="{DynamicResource Loc.Experimental.OpenContentLayout}" Style="{StaticResource AfSettingsButtonStyle}"
                                    Uid="FloatingBar" Tag="{x:Static services:SettingsPageKey.Components}" Click="OpenSettings_Click" />
                            </components:SettingsRow>
                            <components:SettingsRow Title="{DynamicResource Loc.Common.Page.Appearance}"
                                Description="{DynamicResource Loc.Appearance.Unified.Header.Subtitle}" Icon="{ui:SymbolIcon PaintBrush24}">
                                <ui:Button Content="{DynamicResource Loc.Experimental.OpenAppearance}" Style="{StaticResource AfSettingsButtonStyle}"
                                    Uid="FloatingBar" Tag="{x:Static services:SettingsPageKey.Appearance}" Click="OpenSettings_Click" />
                            </components:SettingsRow>
                        </StackPanel>
                    </StackPanel>
                </components:SettingsGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
