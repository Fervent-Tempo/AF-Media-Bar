<?xml version="1.0" ?><Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:AFMediaBar.Components" xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="AFMediaBar.Views.Pages.ExtraFeaturesPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}"/>
        <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}"/>
    </Page.Resources>
    <components:SettingsPageLayout x:Name="PageLayout">
        <components:SettingsPageLayout.Header>
            <components:SettingsGroupStrip Title="{DynamicResource Loc.Settings.Page.MediaSource}" Subtitle="{DynamicResource Loc.Settings.Page.ExtraFeatures.Description}" PageIcon="{ui:SymbolIcon MusicNote220}" Target="{Binding ScrollViewer, ElementName=PageLayout}"><components:SettingsGroupStrip.HeaderActions><ui:Button Content="{DynamicResource Loc.Common.ResetPageDefaults}" Style="{StaticResource AfSettingsButtonStyle}" Click="ResetButton_Click" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top"/></components:SettingsGroupStrip.HeaderActions></components:SettingsGroupStrip>
        </components:SettingsPageLayout.Header>
        <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded">
            <components:SettingsGroup GroupId="Common.MediaSource" Header="{DynamicResource Loc.Common.MediaSource}" Icon="{ui:SymbolIcon Filter24}">
                <StackPanel>
                    <components:SettingsRow Description="{Binding ViewModel.SelectionDescription}" Icon="{ui:SymbolIcon ArrowSwap24}" Title="{DynamicResource Loc.Media.Selection.Title}">
                        <ComboBox MinWidth="{StaticResource AfSettingsSelectMinWidth}" SelectedValue="{Binding ViewModel.SelectionMode, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{DynamicResource Loc.Media.Selection.Mode.Automatic}" Tag="{x:Static settings:MediaSelectionMode.Automatic}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.Media.Selection.Mode.LatestSession}" Tag="{x:Static settings:MediaSelectionMode.LatestSession}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.Media.Selection.Mode.PreferredApplication}" Tag="{x:Static settings:MediaSelectionMode.PreferredApplication}"/>
                        </ComboBox>
                    </components:SettingsRow>
                    <StackPanel Visibility="{Binding ViewModel.IsPreferredApplication, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                        <components:SettingsRow Description="{DynamicResource Loc.Media.Selection.Preferred.Description}" IsNested="True" Title="{DynamicResource Loc.Media.Selection.Preferred.Title}" Icon="{ui:SymbolIcon Filter24}">
                            <ComboBox DisplayMemberPath="DisplayName" ItemsSource="{Binding ViewModel.PreferredSourceOptions}" MinWidth="{StaticResource AfSettingsSelectMinWidth}" SelectedValue="{Binding ViewModel.PreferredSourceId, Mode=TwoWay}" SelectedValuePath="SourceId"/>
                        </components:SettingsRow>
                        <TextBlock Margin="0,4,0,8" Style="{StaticResource AfSettingsHintTextStyle}" Text="{DynamicResource Loc.Media.Selection.Filtered}" Visibility="{Binding ViewModel.IsPreferredSourceBlocked, Converter={StaticResource AfBooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,8" Style="{StaticResource AfSettingsHintTextStyle}" Text="{DynamicResource Loc.Media.Selection.ManualHint}"/>
                    <components:SettingsRow Description="{DynamicResource Loc.Media.SourceFilter.Description}" Icon="{ui:SymbolIcon Filter24}" Title="{DynamicResource Loc.Media.SourceFilter.Title}" KeepControlInline="True">
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.SmtcFilterEnabled, Mode=TwoWay}"/>
                    </components:SettingsRow>
                    <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon AppsList24}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Media.SourceList.Title}"/>
                                <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Media.SourceList.Description}"/>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <ItemsControl ItemsSource="{Binding ViewModel.Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <components:SettingsRow Description="{Binding Descriptor.SourceId}" IsNested="True" Title="{Binding Descriptor.DisplayName}" Icon="{ui:SymbolIcon Filter24}">
                                        <WrapPanel Style="{StaticResource AfSettingsActionsStyle}">
                                            <ui:ToggleSwitch Margin="{StaticResource AfSettingsActionGap}" Content="{DynamicResource Loc.Media.SourceList.Allow}" IsChecked="{Binding IsAllowed, Mode=TwoWay}"/>
                                            <ui:Button Margin="{StaticResource AfSettingsActionGap}" Click="AddDetectedSource_Click" Content="{DynamicResource Loc.Media.SourceList.AddToQuickLaunch}" Style="{StaticResource AfSettingsButtonStyle}" ToolTip="{DynamicResource Loc.Media.SourceList.AddToQuickLaunch.ToolTip}" ToolTipService.ShowOnDisabled="True"/>
                                        </WrapPanel>
                                    </components:SettingsRow>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ui:CardExpander>
                    <TextBlock Text="{Binding ViewModel.StatusText}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AfSettingsResultTextStyle}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <WrapPanel Style="{StaticResource AfSettingsRelatedLinksStyle}">
                        <components:SettingsNavigationButton Content="{DynamicResource Loc.Widgets.Note.Manage}" Destination="Widgets" GroupId="Widgets.Note"/>
                    </WrapPanel>
                </StackPanel>
            </components:SettingsGroup>

        </StackPanel>
    </components:SettingsPageLayout>
</Page>
