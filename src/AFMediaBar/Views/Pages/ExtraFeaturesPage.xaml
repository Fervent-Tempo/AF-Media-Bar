<Page
    x:Class="AFMediaBar.Views.Pages.ExtraFeaturesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <!--
        媒体与通知页 / Media and notifications page

        媒体来源、快速启动和曲目通知保留在这里；静置层组件移至独立的组件设置页。
        Media sources, quick launch, and track notifications stay here; rest-layer components have their own page.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:SettingsGroupStrip Margin="{StaticResource AfSettingsHeaderMargin}" MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            Grid.Row="0"
            PageIcon="{ui:SymbolIcon PuzzlePiece24}"
            Subtitle="{DynamicResource Loc.Media.Header.Subtitle}"
            Target="{Binding ElementName=PageScroll}"
            Title="{DynamicResource Loc.Common.Page.MediaAndNotifications}" />

        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageRoot"
                MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
                Loaded="OnPageLoaded">

                <components:SettingsGroup GroupId="Common.MediaSource" Header="{DynamicResource Loc.Common.MediaSource}" Icon="{ui:SymbolIcon Filter24}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{Binding ViewModel.SelectionDescription}"
                            Icon="{ui:SymbolIcon ArrowSwap24}"
                            Title="{DynamicResource Loc.Media.Selection.Title}">
                            <ComboBox
                                MinWidth="{StaticResource AfSettingsSelectMinWidth}"
                                SelectedValue="{Binding ViewModel.SelectionMode, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Media.Selection.Mode.Automatic}" Tag="{x:Static settings:MediaSelectionMode.Automatic}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Media.Selection.Mode.LatestSession}" Tag="{x:Static settings:MediaSelectionMode.LatestSession}" />
                                <ComboBoxItem Content="{DynamicResource Loc.Media.Selection.Mode.PreferredApplication}" Tag="{x:Static settings:MediaSelectionMode.PreferredApplication}" />
                            </ComboBox>
                        </components:SettingsRow>
                        <StackPanel Visibility="{Binding ViewModel.IsPreferredApplication, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                            <components:SettingsRow
                                Description="{DynamicResource Loc.Media.Selection.Preferred.Description}"
                                IsNested="True"
                                Title="{DynamicResource Loc.Media.Selection.Preferred.Title}">
                                <ComboBox
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding ViewModel.PreferredSourceOptions}"
                                    MinWidth="{StaticResource AfSettingsSelectMinWidth}"
                                    SelectedValue="{Binding ViewModel.PreferredSourceId, Mode=TwoWay}"
                                    SelectedValuePath="SourceId" />
                            </components:SettingsRow>
                            <TextBlock
                                Margin="0,4,0,8"
                                Style="{StaticResource AfSettingsHintTextStyle}"
                                Text="{DynamicResource Loc.Media.Selection.Filtered}"
                                Visibility="{Binding ViewModel.IsPreferredSourceBlocked, Converter={StaticResource AfBooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,8" Style="{StaticResource AfSettingsHintTextStyle}" Text="{DynamicResource Loc.Media.Selection.ManualHint}" />
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Media.SourceFilter.Description}"
                            Icon="{ui:SymbolIcon Filter24}"
                            Title="{DynamicResource Loc.Media.SourceFilter.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.SmtcFilterEnabled, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon AppsList24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Media.SourceList.Title}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Media.SourceList.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <ItemsControl ItemsSource="{Binding ViewModel.Sources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <components:SettingsRow
                                            Description="{Binding Descriptor.SourceId}"
                                            IsNested="True"
                                            Title="{Binding Descriptor.DisplayName}">
                                            <WrapPanel Style="{StaticResource AfSettingsActionsStyle}">
                                                <ui:ToggleSwitch Margin="{StaticResource AfSettingsActionGap}"
                                                    Content="{DynamicResource Loc.Media.SourceList.Allow}"
                                                    IsChecked="{Binding IsAllowed, Mode=TwoWay}" />
                                                <ui:Button Margin="{StaticResource AfSettingsActionGap}"
                                                    Click="AddDetectedSource_Click"
                                                    Content="{DynamicResource Loc.Media.SourceList.AddToQuickLaunch}"
                                                    Style="{StaticResource AfSettingsButtonStyle}"
                                                    ToolTip="{DynamicResource Loc.Media.SourceList.AddToQuickLaunch.ToolTip}"
                                                    ToolTipService.ShowOnDisabled="True" />
                                            </WrapPanel>
                                        </components:SettingsRow>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:CardExpander>
                        <TextBlock Text="{Binding ViewModel.StatusText}" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AfSettingsResultTextStyle}">
                                <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>

                        <WrapPanel Style="{StaticResource AfSettingsRelatedLinksStyle}">
                            <components:SettingsNavigationButton Content="{DynamicResource Loc.Widgets.Note.Manage}"
                                Destination="Widgets" GroupId="Widgets.Note"/>
                        </WrapPanel>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup GroupId="Common.Group.TrackChangeNotification" Header="{DynamicResource Loc.Common.Group.TrackChangeNotification}" Icon="{ui:SymbolIcon MusicNote220}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Media.Notification.Enabled.Description}"
                            Icon="{ui:SymbolIcon MusicNote220}"
                            Title="{DynamicResource Loc.Media.Notification.Enabled.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.TrackChangeNotificationEnabled, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon Settings24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Media.Notification.Details.Title}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Media.Notification.Details.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsDiagram Margin="0,0,0,12" Kind="NotificationPlacement" />

                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Notification.Fullscreen.Description}"
                                    Icon="{ui:SymbolIcon FullScreenMaximize24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Media.Notification.Fullscreen.Title}">
                                    <ui:ToggleSwitch IsChecked="{Binding ViewModel.ShowTrackChangeNotificationWhenFullscreen, Mode=TwoWay}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon Pin24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Media.Notification.Position.Title}">
                                    <ComboBox
                                        MinWidth="{StaticResource AfSettingsSelectShortWidth}"
                                        SelectedValue="{Binding ViewModel.TrackChangeNotificationPosition, Mode=TwoWay}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.Position.TopLeft}" Tag="{x:Static settings:TrackChangeNotificationPosition.TopLeft}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.Position.TopCenter}" Tag="{x:Static settings:TrackChangeNotificationPosition.TopCenter}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.Position.TopRight}" Tag="{x:Static settings:TrackChangeNotificationPosition.TopRight}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.Position.BottomLeft}" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomLeft}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.Position.BottomCenter}" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomCenter}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.Position.BottomRight}" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomRight}" />
                                    </ComboBox>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon Timer24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Media.Notification.Duration.Title}">
                                    <components:SettingsNumericEditor
                                    Value="{Binding ViewModel.TrackChangeNotificationDurationSeconds, Mode=TwoWay}"
                                    Minimum="{Binding ViewModel.MinimumTrackChangeNotificationDurationSeconds}"
                                    Maximum="{Binding ViewModel.MaximumTrackChangeNotificationDurationSeconds}"
                                    Step="1"
                                    Unit="{DynamicResource Loc.Settings.Numeric.Seconds}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Notification.TargetMode.Description}"
                                    Icon="{ui:SymbolIcon ProjectionScreen24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Common.TargetMonitor}">
                                    <ComboBox
                                        MinWidth="{StaticResource AfSettingsSelectMinWidth}"
                                        SelectedValue="{Binding ViewModel.TrackChangeNotificationTargetMode, Mode=TwoWay}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.TargetMode.Fixed}" Tag="{x:Static settings:NotificationTargetMode.Fixed}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.TargetMode.ForegroundWindow}" Tag="{x:Static settings:NotificationTargetMode.ForegroundWindow}" />
                                    </ComboBox>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon Desktop24}"
                                    IsEnabled="{Binding ViewModel.CanSelectTrackChangeNotificationMonitor}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Media.Notification.FixedMonitor.Title}">
                                    <ComboBox
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding ViewModel.MonitorOptions}"
                                        MinWidth="{StaticResource AfSettingsSelectMinWidth}"
                                        SelectedValue="{Binding ViewModel.TrackChangeNotificationFixedMonitorDeviceId, Mode=TwoWay}"
                                        SelectedValuePath="DeviceId" />
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>

                <ui:Button
                    Margin="0,16,0,40"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="{DynamicResource Loc.Common.ResetPageDefaults}"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
