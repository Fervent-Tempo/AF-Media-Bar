<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:AFMediaBar.Components" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="AFMediaBar.Views.Pages.AboutPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style TargetType="{x:Type components:SettingsRow}" BasedOn="{StaticResource AfSettingsPilotRowStyle}"/>
        <Style TargetType="{x:Type components:SettingsGroup}" BasedOn="{StaticResource AfSettingsPilotGroupStyle}"/>
    </Page.Resources>
    <components:SettingsPageLayout x:Name="PageLayout">
        <components:SettingsPageLayout.Header>
            <components:SettingsGroupStrip Title="{DynamicResource Loc.Common.Page.About}" Subtitle="{DynamicResource Loc.Settings.Page.About.Description}" PageIcon="{ui:SymbolIcon QuestionCircle24}" Target="{Binding ScrollViewer, ElementName=PageLayout}"/>
        </components:SettingsPageLayout.Header>
        <StackPanel x:Name="PageRoot" Loaded="OnPageLoaded">
            <components:SettingsGroup GroupId="Common.Group.ProjectInfo" Header="{DynamicResource Loc.Common.Group.ProjectInfo}" Icon="{ui:SymbolIcon Info24}">
                <components:SettingsRow Description="{DynamicResource Loc.About.Row.Project.Description}" Icon="{ui:SymbolIcon Info24}" Title="AF Media Bar">
                    <WrapPanel>
                        <ui:Anchor Margin="0,0,10,0" Content="{DynamicResource Loc.About.Row.Project.Star}" Icon="{ui:SymbolIcon Star24}" NavigateUri="{Binding ViewModel.RepositoryUrl}"/>
                        <ui:Anchor Content="{DynamicResource Loc.About.Row.Project.Issues}" Icon="{ui:SymbolIcon Bug24}" NavigateUri="{Binding ViewModel.IssuesUrl}"/>
                    </WrapPanel>
                </components:SettingsRow>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Common.Group.Developers" Header="{DynamicResource Loc.Common.Group.Developers}" Icon="{ui:SymbolIcon Code24}" Visibility="{Binding ViewModel.HasDevelopersSection, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                <StackPanel>
                    <components:SettingsRow x:Name="CreditsStatusRow" MinHeight="84" Description="{Binding ViewModel.CreditsStatusText}" Icon="{ui:SymbolIcon Info24}" Title="{DynamicResource Loc.Credits.Status.Title}" Visibility="{Binding ViewModel.HasCreditsStatus, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                        <ui:Button Width="148" Command="{Binding ViewModel.RefreshCreditsCommand}" Content="{Binding ViewModel.CreditsRefreshButtonText}" Icon="{ui:SymbolIcon ArrowSync24}" Style="{StaticResource AfSettingsButtonStyle}"/>
                    </components:SettingsRow>
                    <ItemsControl ItemsSource="{Binding ViewModel.Contributors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,10,10" Padding="7" Background="{DynamicResource AfSettingsCardBrush}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="1" CornerRadius="8" ToolTip="{Binding Login}" AutomationProperties.Name="{Binding Login}">
                                    <Grid Width="40" Height="40" VerticalAlignment="Center">
                                        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Person24"/>
                                        <Image Width="40" Height="40" Source="{Binding Avatar}" Stretch="UniformToFill" Visibility="{Binding HasAvatar, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                                            <Image.Clip>
                                                <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Common.Group.Sponsors" Header="{DynamicResource Loc.Common.Group.Sponsors}" Icon="{ui:SymbolIcon Heart24}" Visibility="{Binding ViewModel.HasSponsors, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                <StackPanel>
                    <components:SettingsCallout Margin="0,0,0,4" FontSize="14" IsAccent="True" Symbol="Heart24" Text="{Binding ViewModel.SponsorNamesText}" Visibility="{Binding ViewModel.HasSponsors, Converter={StaticResource AfBooleanToVisibilityConverter}}"/>
                    <components:SettingsCallout Margin="0,0,0,4" IsAccent="False" Symbol="Heart24" Text="{DynamicResource Loc.Credits.Sponsors.None}" Visibility="{Binding ViewModel.HasNoSponsorsYet, Converter={StaticResource AfBooleanToVisibilityConverter}}"/>
                    <Border Style="{StaticResource AfSettingsInfoSurfaceStyle}" Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource AfSettingsHintTextStyle}" Text="{Binding ViewModel.SponsorCountText}"/>
                    </Border>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Common.Group.Support" Header="{DynamicResource Loc.Common.Group.Support}" Icon="{ui:SymbolIcon Heart24}">
                <StackPanel>
                    <components:SettingsCallout Margin="0,0,0,12" IsAccent="True" Symbol="Info24" Text="{DynamicResource Loc.About.Support.SponsorNote}"/>
                    <ItemsControl ItemsSource="{Binding ViewModel.SupportEntries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,12,12" Padding="24" Background="{DynamicResource AfSettingsCardBrush}" BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel Width="300">
                                        <TextBlock HorizontalAlignment="Center" FontWeight="{DynamicResource AppTextMediumFontWeight}" Text="{Binding Title}"/>
                                        <Image Width="280" Height="280" Margin="0,10,0,0" Source="{Binding Image}" Stretch="Uniform" Visibility="{Binding HasImage, Converter={StaticResource AfBooleanToVisibilityConverter}}"/>
                                        <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ExpectedAssetPath}" TextWrapping="Wrap" Visibility="{Binding IsPending, Converter={StaticResource AfBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <components:SettingsCallout Margin="0,0,0,4" IsAccent="False" Symbol="Info24" Text="{DynamicResource Loc.About.Support.Pending}" Visibility="{Binding ViewModel.HasPendingSupportEntries, Converter={StaticResource AfBooleanToVisibilityConverter}}"/>
                </StackPanel>
            </components:SettingsGroup>
            <components:SettingsGroup GroupId="Common.Group.Licenses" Header="{DynamicResource Loc.Common.Group.Licenses}" Icon="{ui:SymbolIcon DocumentText24}">
                <ItemsControl ItemsSource="{Binding ViewModel.Licenses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <components:SettingsRow Badge="{Binding Version}" Description="{Binding Note}" Icon="{ui:SymbolIcon DocumentText24}" Title="{Binding Name}">
                                <WrapPanel Style="{StaticResource AfSettingsActionsStyle}">
                                    <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding License}"/>
                                    <ui:Button Margin="{StaticResource AfSettingsActionGap}" Command="{Binding DataContext.ViewModel.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding Url}" Content="{DynamicResource Loc.About.Licenses.Open}" Icon="{ui:SymbolIcon Open24}" Style="{StaticResource AfSettingsButtonStyle}"/>
                                </WrapPanel>
                            </components:SettingsRow>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </components:SettingsGroup>
        </StackPanel>
    </components:SettingsPageLayout>
</Page>
