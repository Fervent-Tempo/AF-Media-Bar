<!-- 播放器支持弹窗只呈现接入方式与筛选；不读写设置，关闭与导航由宿主和设置窗口处理。 -->
<UserControl
    x:Class="AFMediaBar.Views.Pages.PlayerSupportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinWidth="440">
    <StackPanel>
        <TextBlock
            Margin="0,0,0,12"
            FontSize="12"
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{DynamicResource Loc.Home.Player.Scope}" />
        <ui:TextBox
            x:Name="FilterBox"
            Margin="0,0,0,12"
            AutomationProperties.Name="{DynamicResource Loc.Home.Player.Filter}"
            PlaceholderText="{DynamicResource Loc.Home.Player.Filter}"
            Text="{Binding PlayerFilter, UpdateSourceTrigger=PropertyChanged}" />
        <ScrollViewer
            MaxHeight="360"
            Focusable="True"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SupportedPlayers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="0,10"
                            BorderBrush="{DynamicResource AfSettingsBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        FontWeight="{DynamicResource AppTextStrongFontWeight}"
                                        Text="{Binding Name}"
                                        TextWrapping="Wrap" />
                                    <ContentControl
                                        Content="{DynamicResource Loc.Home.Player.PluginUnverified}"
                                        Style="{StaticResource AfSettingsBadgeAttentionStyle}"
                                        Visibility="{Binding IsPluginUnverified, Converter={StaticResource AfBooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    LineHeight="18"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Notes}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    LineHeight="17"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding PluginCondition}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel
            Margin="0,12,0,0"
            Visibility="{Binding HasNoSupportedPlayers, Converter={StaticResource AfBooleanToVisibilityConverter}}">
            <TextBlock
                HorizontalAlignment="Center"
                Text="{DynamicResource Loc.Home.Player.NoMatch}" />
            <ui:Button
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Appearance="Transparent"
                Command="{Binding ClearPlayerFilterCommand}"
                Content="{DynamicResource Loc.Home.Player.ClearFilter}" />
        </StackPanel>
        <components:SettingsNavigationButton
            Margin="0,16,0,0"
            HorizontalAlignment="Left"
            Content="{DynamicResource Loc.Settings.Page.MediaSource}"
            Destination="MediaAndNotifications"
            GroupId="Common.MediaSource" />
    </StackPanel>
</UserControl>
