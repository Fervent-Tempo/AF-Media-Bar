<Window x:Class="AFMediaBar.Views.Windows.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:AFMediaBar.Components"
        mc:Ignorable="d"
        Title="TaskbarWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Visibility="Collapsed">
    <Window.ContextMenu>
        <ContextMenu x:Name="PlayerMenu" Width="280"
                     Padding="4"
                     StaysOpen="False"
                     FontFamily="{DynamicResource AppTextFontFamily}"
                     FontWeight="{DynamicResource AppTextFontWeight}"
                     Background="{DynamicResource AppMenuBackgroundBrush}"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                     BorderThickness="1"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <ui:MenuItem x:Name="SessionsMenuItem"
                         Header="切换媒体源"
                         Icon="{ui:SymbolIcon MusicNote216}" />
            <Separator />
            <ui:MenuItem Header="重新连接 SMTC"
                         Icon="{ui:SymbolIcon ArrowSync24}"
                         Command="{Binding ReconnectMediaSessionCommand}" />
            <ui:MenuItem Header="重新加载任务栏媒体栏"
                         Icon="{ui:SymbolIcon ArrowSync24}"
                         Click="ReloadTaskbarHostMenuItem_Click" />
            <ui:MenuItem Header="设置"
                         Icon="{ui:SymbolIcon Settings24}"
                         Command="{Binding OpenSettingsCommand}" />
            <Separator />
            <ui:MenuItem Header="退出"
                         Icon="{ui:SymbolIcon ArrowExit20}"
                         Command="{Binding ExitApplicationCommand}" />
        </ContextMenu>
    </Window.ContextMenu>
    <Canvas Name="WidgetCanvas" Background="Transparent">
        <controls:TaskBarMediaControl x:Name="MediaControl"
                                      PreviewMouseLeftButtonDown="MediaControl_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="MediaControl_PreviewMouseMove"
                                      PreviewMouseLeftButtonUp="MediaControl_PreviewMouseLeftButtonUp"
                                      LostMouseCapture="MediaControl_LostMouseCapture" />
    </Canvas>
</Window>
