<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.TrayFeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowBackdropType="Acrylic"
        WindowCornerPreference="Round"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        IsHitTestVisible="False">
    <Border Margin="8" Padding="14,9" CornerRadius="6"
            MinWidth="150" MaxWidth="320"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25" />
        </Border.Effect>
        <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" TextAlignment="Center" />
    </Border>
</ui:FluentWindow>
