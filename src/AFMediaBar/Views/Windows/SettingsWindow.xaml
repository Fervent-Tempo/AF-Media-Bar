<!-- Settings shell owns navigation and window chrome; business actions stay in their pages. -->
<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:pages="clr-namespace:AFMediaBar.Views.Pages"
    Title="{Binding ViewModel.ApplicationTitle}" Width="1100" Height="650" MinWidth="640" MinHeight="460"
    FontFamily="{DynamicResource AppTextFontFamily}" FontWeight="{DynamicResource AppTextFontWeight}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}" Background="Transparent"
    ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" WindowStartupLocation="CenterScreen"
    Loaded="SettingsWindow_OnLoaded" SizeChanged="OnShellSizeChanged">
    <Window.Resources>
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource AfSettingsInputBrush}" />
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource AfSettingsInputBrush}" />
        </Style>
        <!-- Equal side columns keep CenterContent on the window center while preserving native title-bar parts. -->
        <Style x:Key="SettingsTitleBarStyle" TargetType="{x:Type ui:TitleBar}" BasedOn="{StaticResource {x:Type ui:TitleBar}}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ui:TitleBar}">
                <Grid x:Name="PART_MainGrid" Background="{TemplateBinding Background}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}" Width="16" Height="16"
                                          VerticalAlignment="Center" Focusable="False" AutomationProperties.AutomationId="TitleBarIcon" />
                        <ContentPresenter Content="{TemplateBinding Header}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding CenterContent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ui:TitleBarButton x:Name="PART_HelpButton" ButtonType="Help" AutomationProperties.AutomationId="TitleBarHelpButton" />
                        <ui:TitleBarButton x:Name="PART_MinimizeButton" ButtonType="Minimize" AutomationProperties.AutomationId="TitleBarMinimizeButton" />
                        <ui:TitleBarButton x:Name="PART_MaximizeButton" ButtonType="Maximize" AutomationProperties.AutomationId="TitleBarMaximizeButton" />
                        <ui:TitleBarButton x:Name="PART_CloseButton" ButtonType="Close" AutomationProperties.AutomationId="TitleBarCloseButton"
                                           MouseOverBackground="{DynamicResource PaletteRedBrush}" MouseOverButtonsForeground="White" />
                    </StackPanel>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="ShowHelp" Value="False"><Setter TargetName="PART_HelpButton" Property="Visibility" Value="Collapsed" /></Trigger>
                    <Trigger Property="ShowMinimize" Value="False"><Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" /></Trigger>
                    <Trigger Property="ShowMaximize" Value="False"><Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" /></Trigger>
                    <Trigger Property="ShowClose" Value="False"><Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" /></Trigger>
                    <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" /></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="ShowMaximize" Value="True" /><Condition Property="IsMaximized" Value="True" /></MultiTrigger.Conditions>
                        <Setter TargetName="PART_MaximizeButton" Property="ButtonType" Value="Restore" />
                    </MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Window.InputBindings><KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}" /></Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBar" Title="{Binding ViewModel.ApplicationTitle}" Style="{StaticResource SettingsTitleBarStyle}"
                     Background="{DynamicResource AfSettingsNavigationBrush}" CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon><ui:ImageIcon Source="{Binding TitleBarIconSource}" /></ui:TitleBar.Icon>
            <ui:TitleBar.CenterContent>
                <Grid x:Name="SearchHost" Width="260" VerticalAlignment="Center">
                        <ui:AutoSuggestBox x:Name="AutoSuggestBox" PlaceholderText="{DynamicResource Loc.Settings.Search.Placeholder}"
                                           SuggestionChosen="OnSearchSuggestionChosen" TextChanged="OnSearchTextChanged">
                            <ui:AutoSuggestBox.Icon><ui:IconSourceElement><ui:SymbolIconSource Symbol="Search24" /></ui:IconSourceElement></ui:AutoSuggestBox.Icon>
                            <ui:AutoSuggestBox.ItemTemplate><DataTemplate><StackPanel Margin="0,-2">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                            </StackPanel></DataTemplate></ui:AutoSuggestBox.ItemTemplate>
                        </ui:AutoSuggestBox>

                </Grid>
            </ui:TitleBar.CenterContent>
        </ui:TitleBar>
        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1" PaneDisplayMode="Left" IsPaneVisible="True" IsPaneOpen="True" OpenPaneLength="240" IsFooterSeparatorVisible="False"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True" FrameMargin="0" Background="Transparent"
                           TitleBar="{Binding ElementName=TitleBar}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{DynamicResource Loc.Common.Page.DisplayModes}" Icon="{ui:SymbolIcon Desktop24}" TargetPageType="{x:Type pages:DisplayModesPage}" />
                <ui:NavigationViewItem Content="{DynamicResource Loc.Common.Page.Appearance}" Icon="{ui:SymbolIcon PaintBrush24}" TargetPageType="{x:Type pages:AppearancePage}" />
                <ui:NavigationViewItem Content="{DynamicResource Loc.Common.Page.Lyrics}" Icon="{ui:SymbolIcon TextQuote24}" TargetPageType="{x:Type pages:LyricsPage}" />
                <ui:NavigationViewItem Content="{DynamicResource Loc.Common.Page.Interaction}" Icon="{ui:SymbolIcon HandDraw24}" TargetPageType="{x:Type pages:InteractionPage}" />
                <ui:NavigationViewItem Content="{DynamicResource Loc.Common.Page.Components}" Icon="{ui:SymbolIcon DataHistogram24}" TargetPageType="{x:Type pages:ComponentsSettingsPage}" />
                <ui:NavigationViewItem Content="{DynamicResource Loc.Common.Page.MediaAndNotifications}" Icon="{ui:SymbolIcon PuzzlePiece24}" TargetPageType="{x:Type pages:ExtraFeaturesPage}" />
                <ui:NavigationViewItem Content="{DynamicResource Loc.Common.Page.Application}" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:ApplicationPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="UpdateNoticeNavItem" Click="UpdateNoticeNavItem_Click" TargetPageType="{x:Type pages:ReleaseHighlightsPage}">
                    <ui:NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Loc.Common.Page.ReleaseHighlights}" />
                            <Ellipse x:Name="UpdateNoticeDot" Width="6" Height="6" Margin="6,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource AfAccentBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </ui:NavigationViewItem.Content>
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Sparkle24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Loc.Common.Page.About}" Icon="{ui:SymbolIcon QuestionCircle24}" TargetPageType="{x:Type pages:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay><ui:SnackbarPresenter x:Name="SnackbarPresenter" /></ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
