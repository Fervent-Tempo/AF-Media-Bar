<!-- Settings shell owns navigation and window chrome; business actions stay in their pages. -->
<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:pages="clr-namespace:AFMediaBar.Views.Pages"
    Title="{Binding ViewModel.ApplicationTitle}" Width="1100" Height="650" MinWidth="640" MinHeight="460"
    FontFamily="{DynamicResource AppTextFontFamily}" FontWeight="{DynamicResource AppTextFontWeight}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}" Background="Transparent"
    ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" WindowStartupLocation="CenterScreen"
    Loaded="SettingsWindow_OnLoaded" SizeChanged="OnShellSizeChanged">
    <Window.Resources>
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource AfSettingsInputBrush}" />
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource AfSettingsInputBrush}" />
        </Style>
        <!-- Equal side columns keep CenterContent on the window center while preserving native title-bar parts. -->
        <Style x:Key="SettingsTitleBarStyle" TargetType="{x:Type ui:TitleBar}" BasedOn="{StaticResource {x:Type ui:TitleBar}}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ui:TitleBar}">
                <Grid x:Name="PART_MainGrid" Background="{TemplateBinding Background}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}" Width="16" Height="16"
                                          VerticalAlignment="Center" Focusable="False" AutomationProperties.AutomationId="TitleBarIcon" />
                        <ContentPresenter Content="{TemplateBinding Header}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding CenterContent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ui:TitleBarButton x:Name="PART_HelpButton" ButtonType="Help" AutomationProperties.AutomationId="TitleBarHelpButton" />
                        <ui:TitleBarButton x:Name="PART_MinimizeButton" ButtonType="Minimize" AutomationProperties.AutomationId="TitleBarMinimizeButton" />
                        <ui:TitleBarButton x:Name="PART_MaximizeButton" ButtonType="Maximize" AutomationProperties.AutomationId="TitleBarMaximizeButton" />
                        <ui:TitleBarButton x:Name="PART_CloseButton" ButtonType="Close" AutomationProperties.AutomationId="TitleBarCloseButton"
                                           MouseOverBackground="{DynamicResource PaletteRedBrush}" MouseOverButtonsForeground="White" />
                    </StackPanel>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="ShowHelp" Value="False"><Setter TargetName="PART_HelpButton" Property="Visibility" Value="Collapsed" /></Trigger>
                    <Trigger Property="ShowMinimize" Value="False"><Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" /></Trigger>
                    <Trigger Property="ShowMaximize" Value="False"><Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" /></Trigger>
                    <Trigger Property="ShowClose" Value="False"><Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" /></Trigger>
                    <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" /></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="ShowMaximize" Value="True" /><Condition Property="IsMaximized" Value="True" /></MultiTrigger.Conditions>
                        <Setter TargetName="PART_MaximizeButton" Property="ButtonType" Value="Restore" />
                    </MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Window.InputBindings><KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}" /></Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBar" Title="{Binding ViewModel.ApplicationTitle}" Style="{StaticResource SettingsTitleBarStyle}"
                     Background="{DynamicResource AfSettingsNavigationBrush}" CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon><ui:ImageIcon Source="{Binding TitleBarIconSource}" /></ui:TitleBar.Icon>
            <ui:TitleBar.CenterContent>
                <Grid x:Name="SearchHost" Width="260" VerticalAlignment="Center">
                        <ui:AutoSuggestBox x:Name="AutoSuggestBox" PlaceholderText="{DynamicResource Loc.Settings.Search.Placeholder}"
                                           SuggestionChosen="OnSearchSuggestionChosen" TextChanged="OnSearchTextChanged">
                            <ui:AutoSuggestBox.Icon><ui:IconSourceElement><ui:SymbolIconSource Symbol="Search24" /></ui:IconSourceElement></ui:AutoSuggestBox.Icon>
                            <ui:AutoSuggestBox.ItemTemplate><DataTemplate><StackPanel Margin="0,-2">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                            </StackPanel></DataTemplate></ui:AutoSuggestBox.ItemTemplate>
                        </ui:AutoSuggestBox>

                </Grid>
            </ui:TitleBar.CenterContent>
        </ui:TitleBar>
        <Border Grid.Row="1" Background="{DynamicResource AfSettingsNavigationBrush}">
            <ScrollViewer Margin="28,0" MaxWidth="900" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                <Grid x:Name="PrimaryTabsHost" HorizontalAlignment="Left">
                <!-- One movable surface connects the selected page tabs across navigation. -->
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="PrimaryTabIndicator" Canvas.Top="4" Height="40" Visibility="Collapsed"
                            Background="{DynamicResource AfSettingsSectionBrush}"
                            BorderBrush="{DynamicResource AfSettingsBorderBrush}"
                            BorderThickness="1,1,1,0" CornerRadius="10,10,0,0">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="PrimaryTabIndicatorScale" ScaleX="1" />
                                <TranslateTransform x:Name="PrimaryTabIndicatorOffset" />
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>
                </Canvas>
                <StackPanel x:Name="PrimaryTabs" Orientation="Horizontal">
                    <ToggleButton Tag="{x:Type pages:DisplayModesPage}" Click="OnPrimaryNavigationClick" Style="{StaticResource AfSettingsPrimaryTabStyle}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Desktop24" FontSize="16" Foreground="{DynamicResource AfAccentBrush}" Margin="0,0,7,0" /><TextBlock Text="{DynamicResource Loc.Common.Page.DisplayModes}" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton Tag="{x:Type pages:AppearancePage}" Click="OnPrimaryNavigationClick" Style="{StaticResource AfSettingsPrimaryTabStyle}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PaintBrush24" FontSize="16" Foreground="{DynamicResource AfAccentBrush}" Margin="0,0,7,0" /><TextBlock Text="{DynamicResource Loc.Common.Page.Appearance}" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton Tag="{x:Type pages:InteractionPage}" Click="OnPrimaryNavigationClick" Style="{StaticResource AfSettingsPrimaryTabStyle}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="HandDraw24" FontSize="16" Foreground="{DynamicResource AfAccentBrush}" Margin="0,0,7,0" /><TextBlock Text="{DynamicResource Loc.Common.Page.Interaction}" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton Tag="{x:Type pages:LyricsPage}" Click="OnPrimaryNavigationClick" Style="{StaticResource AfSettingsPrimaryTabStyle}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="TextQuote24" FontSize="16" Foreground="{DynamicResource AfAccentBrush}" Margin="0,0,7,0" /><TextBlock Text="{DynamicResource Loc.Common.Page.Lyrics}" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton Tag="{x:Type pages:ComponentsSettingsPage}" Click="OnPrimaryNavigationClick" Style="{StaticResource AfSettingsPrimaryTabStyle}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DataHistogram24" FontSize="16" Foreground="{DynamicResource AfAccentBrush}" Margin="0,0,7,0" /><TextBlock Text="{DynamicResource Loc.Common.Page.Components}" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton Tag="{x:Type pages:ExtraFeaturesPage}" Click="OnPrimaryNavigationClick" Style="{StaticResource AfSettingsPrimaryTabStyle}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="16" Foreground="{DynamicResource AfAccentBrush}" Margin="0,0,7,0" /><TextBlock Text="{DynamicResource Loc.Common.Page.MediaAndNotifications}" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton Tag="{x:Type pages:ApplicationPage}" Click="OnPrimaryNavigationClick" Style="{StaticResource AfSettingsPrimaryTabStyle}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" FontSize="16" Foreground="{DynamicResource AfAccentBrush}" Margin="0,0,7,0" /><TextBlock Text="{DynamicResource Loc.Common.Page.Application}" /></StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="UpdateNoticeNavItem" Click="UpdateNoticeNavItem_Click" Tag="{x:Type pages:ReleaseHighlightsPage}"
                                  Style="{StaticResource AfSettingsPrimaryTabStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Foreground="{DynamicResource AfAccentBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="{DynamicResource Loc.Common.Page.ReleaseHighlights}" />
                            <Ellipse x:Name="UpdateNoticeDot" Width="6" Height="6" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource AfAccentBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="AboutTab" Click="OnPrimaryNavigationClick" Tag="{x:Type pages:AboutPage}"
                                  Style="{StaticResource AfSettingsPrimaryTabStyle}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="QuestionCircle24" FontSize="16" Foreground="{DynamicResource AfAccentBrush}" Margin="0,0,7,0" /><TextBlock Text="{DynamicResource Loc.Common.Page.About}" /></StackPanel>
                    </ToggleButton>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
        <!-- The fixed group strip is 45 DIP tall; blend the material just below it into the scroll area. -->
        <Border Grid.Row="2" Height="96" Margin="0,45,0,0" VerticalAlignment="Top"
                Background="{DynamicResource AfSettingsHeaderBridgeBrush}" IsHitTestVisible="False" />
        <!-- The existing page provider and journal still own navigation; these menu items are not presented. -->
        <ui:NavigationView x:Name="RootNavigation" Grid.Row="2" PaneDisplayMode="Top" IsPaneVisible="False" IsFooterSeparatorVisible="False"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False" FrameMargin="0" Background="Transparent">
            <ui:NavigationView.Template>
                <!-- Keep the library page presenter and journal without its built-in pane or content surface. -->
                <ControlTemplate TargetType="{x:Type ui:NavigationView}">
                    <Grid Background="Transparent">
                        <ItemsControl x:Name="PART_MenuItemsItemsControl" Visibility="Collapsed" />
                        <ItemsControl x:Name="PART_FooterMenuItemsItemsControl" Visibility="Collapsed" />
                        <ui:NavigationViewContentPresenter x:Name="PART_NavigationViewContentPresenter"
                            Padding="{TemplateBinding Padding}" Transition="{TemplateBinding Transition}" TransitionDuration="{TemplateBinding TransitionDuration}" />
                        <ContentPresenter Content="{TemplateBinding ContentOverlay}" />
                    </Grid>
                </ControlTemplate>
            </ui:NavigationView.Template>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem TargetPageType="{x:Type pages:DisplayModesPage}" />
                <ui:NavigationViewItem TargetPageType="{x:Type pages:AppearancePage}" />
                <ui:NavigationViewItem TargetPageType="{x:Type pages:InteractionPage}" />
                <ui:NavigationViewItem TargetPageType="{x:Type pages:LyricsPage}" />
                <ui:NavigationViewItem TargetPageType="{x:Type pages:ComponentsSettingsPage}" />
                <ui:NavigationViewItem TargetPageType="{x:Type pages:ExtraFeaturesPage}" />
                <ui:NavigationViewItem TargetPageType="{x:Type pages:ApplicationPage}" />
                <ui:NavigationViewItem TargetPageType="{x:Type pages:AboutPage}" />
                <ui:NavigationViewItem TargetPageType="{x:Type pages:ReleaseHighlightsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.ContentOverlay><ui:SnackbarPresenter x:Name="SnackbarPresenter" /></ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
        <!-- Retain only the departing page's visible content during a directional handoff. -->
        <Canvas x:Name="NavigationTransitionOverlay" Grid.Row="2" ClipToBounds="True" IsHitTestVisible="False" />
        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
