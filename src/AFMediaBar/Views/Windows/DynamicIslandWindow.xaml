<Window x:Class="AFMediaBar.Views.Windows.DynamicIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Dynamic Island"
        Width="420" Height="196"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="{x:Null}"
        ShowActivated="False"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Ideal"
        AutomationProperties.AutomationId="DynamicIsland"
        AutomationProperties.Name="{DynamicResource Loc.Island.Accessibility.Name}">
    <Window.Resources>
        <SolidColorBrush x:Key="IslandPrimaryBrush" Color="White" />
        <SolidColorBrush x:Key="IslandSecondaryBrush" Color="#9D9DA3" />
        <SolidColorBrush x:Key="IslandTrackBrush" Color="#45FFFFFF" />
        <SolidColorBrush x:Key="IslandActivityBrush" Color="#FF536E" />
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource IslandPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandSeekButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandSeekSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="IsMoveToPointEnabled" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource IslandPrimaryBrush}" Style="{StaticResource IslandSeekButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="22">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource IslandPrimaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="{DynamicResource IslandTrackBrush}" Style="{StaticResource IslandSeekButton}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.ContextMenu>
        <ContextMenu x:Name="PlayerMenu" Width="260" Padding="4" StaysOpen="False"
                     FontFamily="{DynamicResource AppTextFontFamily}"
                     Background="{DynamicResource AppMenuBackgroundBrush}"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <ui:MenuItem x:Name="SessionsMenuItem" Header="{DynamicResource Loc.Common.SwitchMediaSource}"
                         Icon="{ui:SymbolIcon MusicNote216}" />
            <Separator />
            <ui:MenuItem Header="{DynamicResource Loc.Common.ReconnectSmtc}" Icon="{ui:SymbolIcon ArrowSync24}"
                         Command="{Binding ReconnectMediaSessionCommand}" />
            <ui:MenuItem Header="{DynamicResource Loc.Common.Settings}" Icon="{ui:SymbolIcon Settings24}"
                         Command="{Binding OpenSettingsCommand}" />
            <Separator />
            <ui:MenuItem Header="{DynamicResource Loc.Common.Exit}" Icon="{ui:SymbolIcon ArrowExit20}"
                         Command="{Binding ExitApplicationCommand}" />
        </ContextMenu>
    </Window.ContextMenu>
    <Viewbox x:Name="IslandViewport" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Canvas x:Name="HostCanvas" Width="420" Height="196" Background="{x:Null}">
            <!-- Only the rounded clip paints the island; the rest of the layered host stays alpha-zero. -->
            <Border x:Name="IslandBody" Canvas.Left="0" Canvas.Top="4" Width="420" Height="192"
                    Background="Black"
                    PreviewMouseLeftButtonDown="Island_MouseDown" PreviewMouseLeftButtonUp="Island_MouseUp"
                    PreviewMouseMove="Island_MouseMove" LostMouseCapture="Island_LostMouseCapture"
                    PreviewTouchDown="Island_TouchDown" PreviewTouchMove="Island_TouchMove" PreviewTouchUp="Island_TouchUp"
                    LostTouchCapture="Island_LostTouchCapture">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PressTransform" CenterX="210" CenterY="18.5" />
                </Border.RenderTransform>
                <Border.Clip>
                    <RectangleGeometry x:Name="IslandClip" Rect="147,0,126,37" RadiusX="18.5" RadiusY="18.5" />
                </Border.Clip>
                <Canvas x:Name="IslandContent" Width="420" Height="192" Background="{x:Null}">
                    <Border x:Name="ArtworkFrame" Width="54" Height="54"
                            Background="#161616" CornerRadius="5" IsHitTestVisible="False" Opacity="0">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ArtworkScale" ScaleX="0.4444444444444444" ScaleY="0.4444444444444444" />
                                <TranslateTransform x:Name="ArtworkTranslation" X="157.5" Y="6.5" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Clip>
                            <RectangleGeometry x:Name="ArtworkClip" Rect="0,0,54,54" RadiusX="11.25" RadiusY="11.25" />
                        </Border.Clip>
                        <Grid>
                            <Path x:Name="ArtworkPlaceholder" Data="M8,4 L18,2 L18,16 C18,21 10,21 10,17 C10,14 14,13 16,14 L16,6 L10,7 L10,19 C10,24 2,24 2,20 C2,17 6,16 8,17 Z"
                                  Fill="#D0D0D0" Stretch="Uniform" Margin="5">
                                <Path.RenderTransform>
                                    <MatrixTransform x:Name="ArtworkPlaceholderTransform" />
                                </Path.RenderTransform>
                            </Path>
                            <Image x:Name="ArtworkImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <Canvas x:Name="ActivityIndicator" Width="28" Height="24" Opacity="0" IsHitTestVisible="False"
                            ToolTip="{DynamicResource Loc.Island.Activity.OutputSpectrum}">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="ActivityTranslation" X="235" Y="6.5" />
                        </Canvas.RenderTransform>
                        <Rectangle x:Name="ActivityBar0" Canvas.Left="1" Width="3" Height="24" Fill="{DynamicResource IslandActivityBrush}">
                            <Rectangle.Clip>
                                <RectangleGeometry Rect="0,10.5,3,3" RadiusX="1.5" RadiusY="1.5" />
                            </Rectangle.Clip>
                        </Rectangle>
                        <Rectangle x:Name="ActivityBar1" Canvas.Left="6" Width="3" Height="24" Fill="{DynamicResource IslandActivityBrush}">
                            <Rectangle.Clip>
                                <RectangleGeometry Rect="0,10.5,3,3" RadiusX="1.5" RadiusY="1.5" />
                            </Rectangle.Clip>
                        </Rectangle>
                        <Rectangle x:Name="ActivityBar2" Canvas.Left="11" Width="3" Height="24" Fill="{DynamicResource IslandActivityBrush}">
                            <Rectangle.Clip>
                                <RectangleGeometry Rect="0,10.5,3,3" RadiusX="1.5" RadiusY="1.5" />
                            </Rectangle.Clip>
                        </Rectangle>
                        <Rectangle x:Name="ActivityBar3" Canvas.Left="16" Width="3" Height="24" Fill="{DynamicResource IslandActivityBrush}">
                            <Rectangle.Clip>
                                <RectangleGeometry Rect="0,10.5,3,3" RadiusX="1.5" RadiusY="1.5" />
                            </Rectangle.Clip>
                        </Rectangle>
                        <Rectangle x:Name="ActivityBar4" Canvas.Left="21" Width="3" Height="24" Fill="{DynamicResource IslandActivityBrush}">
                            <Rectangle.Clip>
                                <RectangleGeometry Rect="0,10.5,3,3" RadiusX="1.5" RadiusY="1.5" />
                            </Rectangle.Clip>
                        </Rectangle>
                    </Canvas>
                    <Canvas x:Name="DetailLayer" Canvas.Left="24.5" Width="371" Height="160" Opacity="0" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="DetailTranslation" Y="8" />
                        </Canvas.RenderTransform>
                        <!-- Reveal fixed-size text instead of reformatting or stretching glyphs during the morph. -->
                        <Canvas Canvas.Left="87" Width="219" Height="74">
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="TrackTextTranslation" />
                            </Canvas.RenderTransform>
                            <Canvas.Clip>
                                <RectangleGeometry x:Name="TrackTextClip" Rect="0,0,219,74" />
                            </Canvas.Clip>
                            <TextBlock x:Name="TitleText" Canvas.Left="0" Canvas.Top="27" Width="219" FontSize="14.5"
                                       FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ArtistText" Canvas.Left="0" Canvas.Top="49" Width="219" FontSize="12.5"
                                       Foreground="#9D9DA3" TextTrimming="CharacterEllipsis" />
                        </Canvas>
                        <Canvas x:Name="ProgressRow" Width="371" Height="160" Opacity="0" IsHitTestVisible="False">
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="ProgressRevealTranslation" Y="4" />
                            </Canvas.RenderTransform>
                            <TextBlock x:Name="ElapsedText" Canvas.Left="21" Canvas.Top="83" Width="43" FontSize="10"
                                       Foreground="{DynamicResource IslandSecondaryBrush}" Text="0:00" />
                            <Slider x:Name="SeekSlider" Canvas.Left="63" Canvas.Top="78" Width="242" Minimum="0" Maximum="1"
                                    Style="{StaticResource IslandSeekSlider}" ValueChanged="SeekSlider_ValueChanged"
                                    PreviewMouseLeftButtonDown="SeekSlider_MouseDown" PreviewMouseLeftButtonUp="SeekSlider_MouseUp"
                                    PreviewMouseMove="SeekSlider_MouseMove" LostMouseCapture="SeekSlider_LostMouseCapture"
                                    PreviewTouchDown="SeekSlider_TouchDown" PreviewTouchMove="SeekSlider_TouchMove" PreviewTouchUp="SeekSlider_TouchUp"
                                    LostTouchCapture="SeekSlider_LostTouchCapture"
                                    AutomationProperties.AutomationId="IslandSeek" AutomationProperties.Name="{DynamicResource Loc.Island.Accessibility.Seek}" />
                            <TextBlock x:Name="RemainingText" Canvas.Left="307" Canvas.Top="83" Width="43" TextAlignment="Right"
                                       FontSize="10" Foreground="{DynamicResource IslandSecondaryBrush}" Text="−0:00" />
                        </Canvas>
                        <Canvas x:Name="ControlsRow" Width="371" Height="160" Opacity="0" IsHitTestVisible="False">
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="ControlsRevealTranslation" Y="6" />
                            </Canvas.RenderTransform>
                            <Button x:Name="PreviousButton" Canvas.Left="94" Canvas.Top="106" Style="{StaticResource IslandButton}"
                                    Command="{Binding SkipPreviousCommand}" AutomationProperties.AutomationId="IslandPrevious"
                                    AutomationProperties.Name="{DynamicResource Loc.Island.Accessibility.Previous}"
                                    ToolTip="{DynamicResource Loc.Island.Accessibility.Previous}">
                                <Path Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource IslandPrimaryBrush}"
                                      Data="M1,2 L4,2 L4,22 L1,22 Z M21,2 L7,12 L21,22 Z" />
                            </Button>
                            <Button x:Name="PlayPauseButton" Canvas.Left="158" Canvas.Top="106" Style="{StaticResource IslandButton}"
                                    Command="{Binding TogglePlayPauseCommand}" AutomationProperties.AutomationId="IslandPlayPause">
                                <Grid Width="26" Height="26">
                                    <Path x:Name="PlayGlyph" Fill="{DynamicResource IslandPrimaryBrush}" Data="M6,2 L24,13 L6,24 Z" />
                                    <Path x:Name="PauseGlyph" Fill="{DynamicResource IslandPrimaryBrush}" Data="M5,2 L11,2 L11,24 L5,24 Z M16,2 L22,2 L22,24 L16,24 Z" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                            <Button x:Name="NextButton" Canvas.Left="222" Canvas.Top="106" Style="{StaticResource IslandButton}"
                                    Command="{Binding SkipNextCommand}" AutomationProperties.AutomationId="IslandNext"
                                    AutomationProperties.Name="{DynamicResource Loc.Island.Accessibility.Next}"
                                    ToolTip="{DynamicResource Loc.Island.Accessibility.Next}">
                                <Path Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource IslandPrimaryBrush}"
                                      Data="M18,2 L21,2 L21,22 L18,22 Z M1,2 L15,12 L1,22 Z" />
                            </Button>
                        </Canvas>
                    </Canvas>
                </Canvas>
            </Border>
        </Canvas>
    </Viewbox>
</Window>
