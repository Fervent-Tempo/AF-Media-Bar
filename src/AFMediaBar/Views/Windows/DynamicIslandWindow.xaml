<Window x:Class="AFMediaBar.Views.Windows.DynamicIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AFMediaBar.Components"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="DynamicIslandWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowActivated="False"
        Visibility="Collapsed"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Window.ContextMenu>
        <ContextMenu x:Name="PlayerMenu" Width="280"
                     Padding="4"
                     StaysOpen="False"
                     FontFamily="{DynamicResource AppTextFontFamily}"
                     FontWeight="{DynamicResource AppTextFontWeight}"
                     Background="{DynamicResource AppMenuBackgroundBrush}"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                     BorderThickness="1"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <ui:MenuItem x:Name="SessionsMenuItem"
                         Header="{DynamicResource Loc.Common.SwitchMediaSource}"
                         Icon="{ui:SymbolIcon MusicNote216}" />
            <Separator />
            <ui:MenuItem Header="{DynamicResource Loc.Common.ReconnectSmtc}"
                         Icon="{ui:SymbolIcon ArrowSync24}"
                         Command="{Binding ViewModel.ReconnectMediaSessionCommand}" />
            <ui:MenuItem Header="{DynamicResource Loc.Common.Settings}"
                         Icon="{ui:SymbolIcon Settings24}"
                         Command="{Binding ViewModel.OpenSettingsCommand}" />
            <Separator />
            <ui:MenuItem Header="{DynamicResource Loc.Common.Exit}"
                         Icon="{ui:SymbolIcon ArrowExit20}"
                         Command="{Binding ViewModel.ExitApplicationCommand}" />
        </ContextMenu>
    </Window.ContextMenu>
    <Canvas Background="Transparent"
            MouseLeftButtonDown="Canvas_MouseLeftButtonDown">
        <controls:TaskBarMediaControl x:Name="MediaControl" />
    </Canvas>
</Window>
