<Window x:Class="AFMediaBar.Views.Windows.MediaCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Mini controller"
        Width="500" Height="148"
        MinWidth="0" MinHeight="0"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <!-- 卡片配色资源：全部通过 DynamicResource 引用，代码按深色 / 浅色 / 封面取色三种主题替换。 -->
        <SolidColorBrush x:Key="CardBackground" Color="#E6141418" />
        <SolidColorBrush x:Key="CardBorder" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="CardTextPrimary" Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="CardTextSecondary" Color="#9EFFFFFF" />
        <SolidColorBrush x:Key="CardTextDim" Color="#52FFFFFF" />
        <SolidColorBrush x:Key="CardTextRomanization" Color="#8CFFFFFF" />
        <SolidColorBrush x:Key="CardTextTranslation" Color="#59FFFFFF" />
        <SolidColorBrush x:Key="CardAccent" Color="#378ADD" />
        <SolidColorBrush x:Key="CardChromeBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="CardChromeHover" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="CardChromePressed" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="CardProgressTrack" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="CardArtFrame" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="CardChipForeground" Color="#B3FFFFFF" />

        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource CardTextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="{DynamicResource CardChromeBorder}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardChromeHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardChromePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="Card"
            Margin="6"
            CornerRadius="16"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            MouseEnter="Card_OnMouseEnter"
            MouseLeave="Card_OnMouseLeave"
            MouseLeftButtonDown="Card_OnMouseLeftButtonDown">
        <Grid x:Name="CardContent">
            <Border x:Name="CoverBackdropLayer"
                    CornerRadius="16"
                    ClipToBounds="True"
                    Opacity="0">
                <Grid>
                    <Image x:Name="CoverBackdrop" Stretch="UniformToFill">
                        <Image.Effect>
                            <BlurEffect x:Name="CoverBackdropBlur" Radius="32" KernelType="Gaussian" />
                        </Image.Effect>
                    </Image>
                    <Border Background="#B3000000" />
                </Grid>
            </Border>
            <!-- 沉浸式频谱：静息态贴在底边进度条上方、横跨整张卡片；置于内容之下，文字与封面不被遮挡。 -->
            <Canvas x:Name="ImmersiveSpectrumCanvas"
                    Height="20"
                    Margin="0,0,0,3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    ClipToBounds="True"
                    IsHitTestVisible="False"
                    Opacity="0">
                <!-- 柱群向上渐隐，避免一条实心亮线把卡片下半部压得太重。 -->
                <Canvas.OpacityMask>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Canvas.OpacityMask>
            </Canvas>
            <Grid Margin="14,12,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="82" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="96" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <Border x:Name="ArtFrame"
                        Grid.Row="0" Grid.Column="0"
                        Width="96" Height="96"
                        CornerRadius="9"
                        Background="{DynamicResource CardArtFrame}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ArtScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                </Border>

                <StackPanel x:Name="TextColumn"
                            Grid.Row="0" Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <!-- 曲目信息超宽时无缝循环：第一份后面留一段空白再接一份同样的文字，
                         滚满一份周期就归零，因为两份开头相同，视觉上不会回程。 -->
                    <ScrollViewer x:Name="MetaViewport"
                                  Width="{Binding ActualWidth, ElementName=TextColumn}"
                                  HorizontalAlignment="Left"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  Focusable="False"
                                  IsHitTestVisible="False"
                                  Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="MetaText"
                                       FontSize="12"
                                       Foreground="{DynamicResource CardTextSecondary}"
                                       TextTrimming="None" />
                            <Border x:Name="MetaGap" Width="48" Visibility="Collapsed" />
                            <TextBlock x:Name="MetaRepeat"
                                       FontSize="12"
                                       Foreground="{DynamicResource CardTextSecondary}"
                                       TextTrimming="None"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                    <!-- 超宽歌词走滚动视口：逐字歌词按擦亮进度定位，行级歌词按本行时长匀速平移，
                         都不再用省略号砍掉尾巴。 -->
                    <ScrollViewer x:Name="LyricViewport"
                                  Width="{Binding ActualWidth, ElementName=TextColumn}"
                                  HorizontalAlignment="Left"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  Focusable="False"
                                  IsHitTestVisible="False"
                                  Margin="0,0,0,7">
                        <Grid x:Name="LyricContent">
                            <TextBlock x:Name="LyricBaseText"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Left"
                                       Foreground="{DynamicResource CardTextDim}"
                                       TextTrimming="None" />
                            <TextBlock x:Name="LyricHighlightText"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Left"
                                       Foreground="{DynamicResource CardTextPrimary}"
                                       TextTrimming="None" />
                        </Grid>
                    </ScrollViewer>
                    <Grid Height="30">
                        <StackPanel x:Name="SecondaryLines"
                                    VerticalAlignment="Center">
                            <!-- 两行副行也各自有滚动视口，超宽时与主行按同一进度平移。 -->
                            <ScrollViewer x:Name="RomanizationViewport"
                                          Width="{Binding ActualWidth, ElementName=TextColumn}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          Focusable="False"
                                          IsHitTestVisible="False"
                                          Visibility="Collapsed">
                                <TextBlock x:Name="RomanizationText"
                                           FontSize="11"
                                           LineHeight="13"
                                           LineStackingStrategy="BlockLineHeight"
                                           HorizontalAlignment="Left"
                                           Foreground="{DynamicResource CardTextRomanization}"
                                           TextTrimming="None" />
                            </ScrollViewer>
                            <ScrollViewer x:Name="TranslationViewport"
                                          Width="{Binding ActualWidth, ElementName=TextColumn}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          Focusable="False"
                                          IsHitTestVisible="False"
                                          Visibility="Collapsed">
                                <TextBlock x:Name="TranslationText"
                                           FontSize="11"
                                           LineHeight="13"
                                           LineStackingStrategy="BlockLineHeight"
                                           HorizontalAlignment="Left"
                                           Foreground="{DynamicResource CardTextTranslation}"
                                           TextTrimming="None" />
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel x:Name="ControlsPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                            <Button x:Name="PreviousButton" Style="{StaticResource KeyButton}"
                                    Click="PreviousButton_OnClick" ToolTip="上一首">
                                <Canvas Width="9" Height="11">
                                    <Rectangle x:Name="PreviousBar" Canvas.Left="0" Canvas.Top="1" Width="1.5" Height="9"
                                               Fill="{DynamicResource CardTextPrimary}" />
                                    <Path x:Name="PreviousChevron" Data="M8,1 L2,5.5 L8,10 Z"
                                          Fill="{DynamicResource CardTextPrimary}" />
                                </Canvas>
                            </Button>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource KeyButton}"
                                    Margin="6,0,0,0" Click="PlayPauseButton_OnClick" ToolTip="播放/暂停">
                                <Grid Width="9" Height="11">
                                    <Path x:Name="PauseIcon" Data="M0.5,1 L3,1 L3,10 L0.5,10 Z M5.5,1 L8,1 L8,10 L5.5,10 Z"
                                          Fill="{DynamicResource CardAccent}" />
                                    <Path x:Name="PlayIcon" Data="M1,0.5 L8.5,5.5 L1,10.5 Z"
                                          Fill="{DynamicResource CardAccent}" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                            <Button x:Name="NextButton" Style="{StaticResource KeyButton}"
                                    Margin="6,0,0,0" Click="NextButton_OnClick" ToolTip="下一首">
                                <Canvas Width="9" Height="11">
                                    <Path x:Name="NextChevron" Data="M1,1 L7,5.5 L1,10 Z"
                                          Fill="{DynamicResource CardTextPrimary}" />
                                    <Rectangle x:Name="NextBar" Canvas.Left="7.5" Canvas.Top="1" Width="1.5" Height="9"
                                               Fill="{DynamicResource CardTextPrimary}" />
                                </Canvas>
                            </Button>
                            <Border x:Name="ControlsDivider" Width="1" Height="16"
                                    Background="{DynamicResource CardProgressTrack}" Margin="8,0,8,0" />
                            <Button x:Name="PinButton" Style="{StaticResource KeyButton}"
                                    Click="PinButton_OnClick" ToolTip="置顶">
                                <ui:SymbolIcon x:Name="PinIcon" Symbol="Pin24" FontSize="14"
                                               Foreground="{DynamicResource CardChipForeground}" />
                            </Button>
                            <Button x:Name="ThemeButton" Style="{StaticResource KeyButton}"
                                    Margin="6,0,0,0" Click="ThemeButton_OnClick" ToolTip="切换配色">
                                <ui:SymbolIcon x:Name="ThemeIcon" Symbol="Color24" FontSize="14"
                                               Foreground="{DynamicResource CardChipForeground}" />
                            </Button>
                            <Button x:Name="CloseButton" Style="{StaticResource KeyButton}"
                                    Margin="6,0,0,0" Click="CloseButton_OnClick" ToolTip="关闭">
                                <ui:SymbolIcon x:Name="CloseIcon" Symbol="Dismiss24" FontSize="14"
                                               Foreground="{DynamicResource CardChipForeground}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="0" Grid.Column="2" Margin="12,0,0,0">
                    <Canvas x:Name="SpectrumCanvas"
                            Width="82" Height="48"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ClipToBounds="True"
                            Opacity="0.55">
                        <Canvas x:Name="SpectrumContent" RenderTransformOrigin="1,1">
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="SpectrumScale" ScaleX="1" ScaleY="1" />
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Canvas>
                    <StackPanel x:Name="VitalsPanel"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Opacity="0.55" />
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                      Margin="0,6,0,8" Height="18">
                    <Grid x:Name="LitProgress" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LitTime"
                                   Grid.Column="0"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11"
                                   Foreground="{DynamicResource CardTextSecondary}"
                                   VerticalAlignment="Center" />
                        <!-- 点亮态进度条：直线层与波浪层共用同一格，开关只切显隐，进度列宽照常更新。 -->
                        <Grid x:Name="LitProgressTrack" Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                            <Grid x:Name="LitLinearProgress" Height="3" VerticalAlignment="Center">
                                <Border x:Name="LitTrack" Background="{DynamicResource CardProgressTrack}" CornerRadius="1.5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="LitPlayedColumn" Width="0*" />
                                        <ColumnDefinition x:Name="LitRestColumn" Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="LitPlayed" Grid.Column="0"
                                            Background="{DynamicResource CardAccent}" CornerRadius="1.5">
                                        <Ellipse x:Name="HeadDot"
                                                 Width="8" Height="8"
                                                 Fill="{DynamicResource CardAccent}"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,-4,0"
                                                 Opacity="0" />
                                    </Border>
                                </Grid>
                            </Grid>
                            <Canvas x:Name="LitWaveCanvas"
                                    Height="16"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Opacity="0">
                                <Line x:Name="WaveTrack"
                                      Stroke="{DynamicResource CardProgressTrack}"
                                      StrokeThickness="1.5" />
                                <Polyline x:Name="WavePlayed"
                                          Stroke="{DynamicResource CardAccent}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                <Rectangle x:Name="WaveHead"
                                           Canvas.Left="0" Canvas.Top="1.5"
                                           Width="3" Height="13"
                                           RadiusX="1.5" RadiusY="1.5"
                                           Fill="{DynamicResource CardTextPrimary}" />
                            </Canvas>
                        </Grid>
                        <TextBlock x:Name="LitDuration"
                                   Grid.Column="2"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11"
                                   Foreground="{DynamicResource CardTextSecondary}"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right" />
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="EdgeProgress" Height="3" VerticalAlignment="Bottom">
                <Border x:Name="EdgeTrack" Background="{DynamicResource CardProgressTrack}" CornerRadius="0,0,15,15" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="EdgePlayedColumn" Width="0*" />
                        <ColumnDefinition x:Name="EdgeRestColumn" Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="EdgePlayed" Grid.Column="0"
                            Background="{DynamicResource CardAccent}" CornerRadius="0,0,0,15" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
