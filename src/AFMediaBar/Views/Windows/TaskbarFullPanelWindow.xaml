<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.TaskbarFullPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="媒体完整面板" Width="520" Height="302"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStyle="None" WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True" Background="Transparent"
        FontFamily="{DynamicResource AppTextFontFamily}"
        FontWeight="{DynamicResource AppTextFontWeight}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Border Margin="8" Padding="16" CornerRadius="14"
            Background="Transparent"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.28" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="ArtworkBorder" Width="76" Height="76" CornerRadius="9" ClipToBounds="True" Background="#18FFFFFF" Cursor="Hand" Tag="MediaAction" MouseLeftButtonUp="ArtworkBorder_MouseLeftButtonUp">
                    <Grid><ui:SymbolIcon x:Name="ArtworkPlaceholder" Symbol="MusicNote220" FontSize="30"/>
                        <Image x:Name="ArtworkImage" Stretch="UniformToFill"/></Grid>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="暂无媒体" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistText" Margin="0,3,0,0" Opacity="0.72" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SourceText" Margin="0,2,0,0" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,13,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Slider x:Name="ProgressSlider" Minimum="0" Maximum="1" Tag="MediaAction"
                        PreviewMouseLeftButtonDown="ProgressSlider_MouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ProgressSlider_MouseLeftButtonUp"/>
                <Grid Grid.Row="1" Margin="3,0">
                    <TextBlock x:Name="PositionText" FontSize="10" Opacity="0.62"/>
                    <TextBlock x:Name="DurationText" FontSize="10" Opacity="0.62" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button x:Name="PreviousButton" Width="36" Height="34" Padding="0" ToolTip="上一首" Click="PreviousButton_Click"><ui:SymbolIcon Symbol="Previous24"/></ui:Button>
                    <ui:Button x:Name="PlayButton" Width="44" Height="38" Margin="6,0" Padding="0" ToolTip="播放 / 暂停" Click="PlayButton_Click"><ui:SymbolIcon x:Name="PlayIcon" Symbol="Play24"/></ui:Button>
                    <ui:Button x:Name="NextButton" Width="36" Height="34" Padding="0" ToolTip="下一首" Click="NextButton_Click"><ui:SymbolIcon Symbol="Next24"/></ui:Button>
                    <ui:Button x:Name="RepeatButton" Width="36" Height="34" Margin="12,0,0,0" Padding="0" ToolTip="循环模式" Click="RepeatButton_Click"><ui:SymbolIcon Symbol="ArrowRepeatAll24"/></ui:Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="输出设备" FontSize="11" Opacity="0.62"/>
                    <ComboBox x:Name="DeviceCombo" Height="30" Margin="0,3,0,0" DisplayMemberPath="DisplayName"
                              DropDownOpened="DeviceCombo_DropDownOpened" SelectionChanged="DeviceCombo_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Grid><TextBlock Text="当前应用音量" FontSize="11" Opacity="0.62"/>
                        <TextBlock x:Name="VolumeText" FontSize="11" HorizontalAlignment="Right" Opacity="0.62"/></Grid>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Margin="0,3,0,0"
                            PreviewMouseLeftButtonUp="VolumeSlider_MouseLeftButtonUp"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="4" Margin="0,12,0,0" Padding="10,7" CornerRadius="7" Background="#10FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="内存" FontSize="10" Opacity="0.55"/><TextBlock x:Name="RamMetric" Text="—" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="CPU" FontSize="10" Opacity="0.55"/><TextBlock x:Name="CpuMetric" Text="—" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="GPU" FontSize="10" Opacity="0.55"/><TextBlock x:Name="GpuMetric" Text="—" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="本程序内存" FontSize="10" Opacity="0.55"/><TextBlock x:Name="ProcessMetric" Text="—" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
