<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.TaskbarFullPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Loc.Panel.FullPanel.WindowTitle}" Width="520" MinHeight="0" SizeToContent="Height"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStyle="None" WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True" Background="Transparent"
        FontFamily="{DynamicResource AppTextFontFamily}"
        FontWeight="{DynamicResource AppTextFontWeight}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <ui:FluentWindow.Resources>
        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <Border x:Name="PanelRoot" Margin="8" Padding="16" CornerRadius="14"
            Background="Transparent"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
            Effect="{DynamicResource AfPanelShadowEffect}">
        <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
        <Border.RenderTransform>
            <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <StackPanel>
            <Grid x:Name="MediaInfoSection" Margin="0,0,0,13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="ArtworkBorder" Width="76" Height="76" CornerRadius="9" ClipToBounds="True" Background="#18FFFFFF" Cursor="Hand" Tag="MediaAction" MouseLeftButtonUp="ArtworkBorder_MouseLeftButtonUp">
                    <Grid><ui:SymbolIcon x:Name="ArtworkPlaceholder" Symbol="MusicNote220" FontSize="30"/>
                        <Image x:Name="ArtworkImage" Stretch="UniformToFill"/></Grid>
                </Border>
                <!--
                    完整层是"把整首歌的信息看全"的地方，因此这一块的四行 MUST NOT 裁剪：标题、歌手与来源都按可用宽度换行，
                    面板高度随内容增长（SizeToContent=Height）。省略号留给媒体栏的静置层/悬停层——那里的宽度被任务栏长度限制，
                    而这里没有这个限制。
                    The full panel is where the whole track is read, so these four lines MUST NOT be trimmed: the title, the artist, and the
                    source wrap within the available width and the panel grows with its content (SizeToContent=Height). Ellipses belong to
                    the rest and hover layers of the bar, whose width is bounded by the taskbar length; this panel has no such bound.
                -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="{DynamicResource Loc.Panel.FullPanel.NoMedia}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ArtistText" Margin="0,3,0,0" Opacity="0.72" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SourceText" Margin="0,2,0,0" FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                    <!-- 歌词来源：只在当前曲目真的取到歌词时出现，没有歌词时整行收起、不占位置。 -->
                    <!-- The lyric source, shown only while the current track really has lyrics; without them the line collapses and takes no room. -->
                    <TextBlock x:Name="LyricsSourceText" Margin="0,2,0,0" FontSize="11" Opacity="0.5" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="MediaControlsSection" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Slider x:Name="ProgressSlider" Minimum="0" Maximum="1" Tag="MediaAction"
                            Style="{StaticResource AfAccentSliderStyle}"
                            FocusVisualStyle="{DynamicResource AfFocusVisualStyle}"
                            IsMoveToPointEnabled="True"
                            PreviewMouseLeftButtonDown="ProgressSlider_MouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="ProgressSlider_MouseLeftButtonUp"
                            LostMouseCapture="ProgressSlider_LostMouseCapture"/>
                    <Grid Grid.Row="1" Margin="3,0">
                        <TextBlock x:Name="PositionText" FontSize="10" Opacity="0.62"/>
                        <TextBlock x:Name="DurationText" FontSize="10" Opacity="0.62" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <ui:Button x:Name="PreviousButton" Width="36" Height="34" Padding="0" ToolTip="{DynamicResource Loc.Common.PreviousTrack}" Click="PreviousButton_Click"><ui:SymbolIcon Symbol="Previous24"/></ui:Button>
                    <ui:Button x:Name="PlayButton" Width="44" Height="38" Margin="6,0" Padding="0" ToolTip="{DynamicResource Loc.Common.PlayPause}" Click="PlayButton_Click"><ui:SymbolIcon x:Name="PlayIcon" Symbol="Play24"/></ui:Button>
                    <ui:Button x:Name="NextButton" Width="36" Height="34" Padding="0" ToolTip="{DynamicResource Loc.Common.NextTrack}" Click="NextButton_Click"><ui:SymbolIcon Symbol="Next24"/></ui:Button>
                    <ui:Button x:Name="RepeatButton" Width="36" Height="34" Margin="12,0,0,0" Padding="0" ToolTip="{DynamicResource Loc.Panel.FullPanel.RepeatMode}" Click="RepeatButton_Click"><ui:SymbolIcon Symbol="ArrowRepeatAll24"/></ui:Button>
                </StackPanel>
            </StackPanel>

            <Grid x:Name="AudioControlsSection" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Common.OutputDevice}" FontSize="11" Opacity="0.62"/>
                    <ComboBox x:Name="DeviceCombo" MinHeight="32" Margin="0,3,0,0"
                              MaxDropDownHeight="240" DisplayMemberPath="DisplayName"
                              ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.DisplayName}"
                              DropDownOpened="DeviceCombo_DropDownOpened"
                              SelectionChanged="DeviceCombo_SelectionChanged"
                              PreviewMouseWheel="DeviceCombo_PreviewMouseWheel"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Grid><TextBlock Text="{DynamicResource Loc.Panel.Volume.CurrentAppVolume}" FontSize="11" Opacity="0.62"/>
                        <TextBlock x:Name="VolumeText" FontSize="11" HorizontalAlignment="Right" Opacity="0.62"/></Grid>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Margin="0,3,0,0"
                            Style="{StaticResource AfAccentSliderStyle}"
                            FocusVisualStyle="{DynamicResource AfFocusVisualStyle}"
                            IsMoveToPointEnabled="True"
                            SmallChange="2" LargeChange="10"
                            PreviewMouseLeftButtonUp="VolumeSlider_MouseLeftButtonUp"
                            PreviewMouseWheel="VolumeSlider_PreviewMouseWheel"/>
                </StackPanel>
            </Grid>

            <Border x:Name="PerformanceSection" Padding="10,7" CornerRadius="7" Background="#10FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{DynamicResource Loc.Panel.Performance.Memory}" FontSize="10" Opacity="0.55"/><TextBlock x:Name="RamMetric" Text="—" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="CPU" FontSize="10" Opacity="0.55"/><TextBlock x:Name="CpuMetric" Text="—" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="GPU" FontSize="10" Opacity="0.55"/><TextBlock x:Name="GpuMetric" Text="—" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="{DynamicResource Loc.Panel.Performance.ProcessMemory}" FontSize="10" Opacity="0.55"/><TextBlock x:Name="ProcessMetric" Text="—" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</ui:FluentWindow>
