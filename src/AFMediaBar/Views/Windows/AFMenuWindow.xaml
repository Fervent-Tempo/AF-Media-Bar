<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.AFMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AF Media Bar"
        MinWidth="0"
        MinHeight="0"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        Background="Transparent"
        ShowActivated="True"
        Deactivated="Window_OnDeactivated"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Border x:Name="MenuRoot"
            Margin="4"
            Padding="4"
            CornerRadius="8"
            BorderThickness="1"
            Background="Transparent"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Effect="{DynamicResource AfFlyoutShadowEffect}">
        <Border.RenderTransformOrigin>0.5,0</Border.RenderTransformOrigin>
        <Border.RenderTransform>
            <ScaleTransform x:Name="MenuScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <ContentPresenter x:Name="MenuContentPresenter"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
    </Border>
</ui:FluentWindow>
