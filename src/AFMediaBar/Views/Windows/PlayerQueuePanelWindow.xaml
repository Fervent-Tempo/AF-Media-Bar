<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.PlayerQueuePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Loc.Panel.Queue.WindowTitle}"
        Width="380" MinWidth="0" MinHeight="0" SizeToContent="Height"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStyle="None" WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True" Background="Transparent"
        ShowActivated="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource AppTextFontFamily}"
        FontWeight="{DynamicResource AppTextFontWeight}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AFMediaBar;component/Resources/MediaVisualResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="QueueVisibility" />

            <!-- 与任务栏设备弹窗使用同一套行按钮反馈：透明底、圆角、ControlFill 系列 hover/pressed。 -->
            <Style x:Key="QueueItemButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="8,6,14,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource AfFocusVisualStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="Background"
                                            Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="Background"
                                            Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 选中态与设备弹窗一致：AfAccentTintBrush 背景 + 左侧 3px AfAccentBrush 标记。 -->
            <Style x:Key="QueueItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Height" Value="46" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Border x:Name="CandidateMark" Width="3" CornerRadius="1" Margin="1,8,0,8"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource AfAccentBrush}"
                                            Visibility="Collapsed" />
                                    <ContentPresenter Margin="5,0,0,0" HorizontalAlignment="Stretch" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemSurface" Property="Background"
                                            Value="{DynamicResource AfAccentTintBrush}" />
                                    <Setter TargetName="CandidateMark" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid x:Name="PanelRoot" RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border x:Name="PanelChrome" CornerRadius="16" Background="Transparent"
                    IsHitTestVisible="False"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" />
            <Border Padding="12" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding TitleText}" FontSize="16"
                                       FontWeight="{DynamicResource AppTextStrongFontWeight}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource PanelLabelStyle}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasStatusText, Converter={StaticResource QueueVisibility}}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" MinWidth="52" Height="32" Margin="4,0,0,0"
                                   Padding="10,0" Content="{DynamicResource Loc.Panel.Queue.Retry}"
                                   Command="{Binding RetryCommand}"
                                   Visibility="{Binding CanRetry, Converter={StaticResource QueueVisibility}}"
                                   ToolTip="{DynamicResource Loc.Panel.Queue.Retry}" />
                        <ui:Button Grid.Column="2" Width="32" Height="32" Margin="4,0,0,0" Padding="0"
                                   Command="{Binding RefreshCommand}"
                                   ToolTip="{DynamicResource Loc.Panel.Queue.Refresh}"
                                   AutomationProperties.Name="{DynamicResource Loc.Panel.Queue.Refresh}">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                        </ui:Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="QueueList" ItemsSource="{Binding Items}"
                                 ItemContainerStyle="{StaticResource QueueItemStyle}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 Height="240"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 SelectionMode="Single"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 AutomationProperties.Name="{DynamicResource Loc.Panel.Queue.ListName}"
                                 PreviewMouseDown="QueueList_PreviewMouseDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource QueueItemButtonStyle}"
                                            Click="QueueItem_Click"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid Loaded="QueueItem_Loaded"
                                              Unloaded="QueueItem_Unloaded"
                                              DataContextChanged="QueueItem_DataContextChanged">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" Style="{StaticResource PanelLabelStyle}"
                                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <Border Grid.Column="1" Width="32" Height="32" CornerRadius="5"
                                                    Margin="0,0,8,0" ClipToBounds="True"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <Grid>
                                                    <ui:SymbolIcon Symbol="MusicNote220" FontSize="14"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding Artwork}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PanelLabelStyle}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <ui:SymbolIcon Symbol="Play24" FontSize="12"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource AfAccentBrush}">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <TextBlock Text="{Binding DurationText}" Style="{StaticResource PanelLabelStyle}"
                                                           HorizontalAlignment="Right" Margin="0,2,0,0"
                                                           Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource QueueVisibility}}">
                            <ui:SymbolIcon Symbol="DocumentQueue24" FontSize="28"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc.Panel.Queue.Empty}"
                                       Style="{StaticResource PanelLabelStyle}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
