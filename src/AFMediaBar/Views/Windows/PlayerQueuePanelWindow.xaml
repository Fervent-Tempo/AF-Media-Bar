<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.PlayerQueuePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Loc.Panel.Queue.WindowTitle}"
        Width="380" Height="520" MinWidth="0" MinHeight="0"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStyle="None" WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True" Background="Transparent"
        ShowActivated="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource AppTextFontFamily}"
        FontWeight="{DynamicResource AppTextFontWeight}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AFMediaBar;component/Resources/MediaVisualResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="QueueVisibility" />
            <Style x:Key="QueueItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource AfFocusVisualStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="RowSurface" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowSurface" Property="Background"
                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowSurface" Property="Background"
                                            Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid x:Name="PanelRoot" RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border x:Name="PanelChrome" CornerRadius="16" Background="Transparent"
                    IsHitTestVisible="False"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" />
            <Border Padding="12" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding TitleText}" FontSize="16"
                                       FontWeight="{DynamicResource AppTextStrongFontWeight}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource PanelLabelStyle}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" MinWidth="52" Height="32" Margin="4,0,0,0"
                                   Padding="10,0" Content="{DynamicResource Loc.Panel.Queue.Retry}"
                                   Command="{Binding RetryCommand}"
                                   Visibility="{Binding CanRetry, Converter={StaticResource QueueVisibility}}"
                                   ToolTip="{DynamicResource Loc.Panel.Queue.Retry}" />
                        <ui:Button Grid.Column="2" Width="32" Height="32" Margin="4,0,0,0" Padding="0"
                                   Command="{Binding RefreshCommand}"
                                   ToolTip="{DynamicResource Loc.Panel.Queue.Refresh}"
                                   AutomationProperties.Name="{DynamicResource Loc.Panel.Queue.Refresh}">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                        </ui:Button>
                        <ui:Button Grid.Column="3" Width="32" Height="32" Margin="4,0,0,0" Padding="0"
                                   Command="{Binding CloseCommand}"
                                   ToolTip="{DynamicResource Loc.Common.Close}"
                                   AutomationProperties.Name="{DynamicResource Loc.Common.Close}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                        </ui:Button>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0,0,0,10"
                            Visibility="{Binding HasCurrent, Converter={StaticResource QueueVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="10"
                                    Background="{DynamicResource AfMaterialCardBrush}">
                                <ui:SymbolIcon Symbol="MusicNote220" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentTitle}" FontSize="14"
                                           FontWeight="{DynamicResource AppTextMediumFontWeight}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CurrentSubtitle}" Style="{StaticResource PanelLabelStyle}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                                        Margin="8,0,0,0">
                                <TextBlock Text="{Binding CurrentStatusText}" Style="{StaticResource PanelLabelStyle}"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding ShuffleText}" Style="{StaticResource PanelLabelStyle}"
                                           Margin="0,3,0,0" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource AfAccentBrush}"
                                           Visibility="{Binding IsShuffleOn, Converter={StaticResource QueueVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="QueueList" ItemsSource="{Binding Items}"
                                 ItemContainerStyle="{StaticResource QueueItemStyle}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 SelectionMode="Single"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 AutomationProperties.Name="{DynamicResource Loc.Panel.Queue.ListName}"
                                 MouseDoubleClick="QueueList_MouseDoubleClick"
                                 PreviewKeyDown="QueueList_PreviewKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" Style="{StaticResource PanelLabelStyle}"
                                                   VerticalAlignment="Top" Margin="0,2,4,0"
                                                   Typography.NumeralAlignment="Tabular" />
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PanelLabelStyle}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <ui:SymbolIcon Symbol="Play24" FontSize="12"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource AfAccentBrush}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource PanelLabelStyle}"
                                                       HorizontalAlignment="Right" Margin="0,2,0,0"
                                                       Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource QueueVisibility}}">
                            <ui:SymbolIcon Symbol="DocumentQueue24" FontSize="28"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc.Panel.Queue.Empty}"
                                       Style="{StaticResource PanelLabelStyle}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="{Binding ActionStatus}" Style="{StaticResource PanelLabelStyle}"
                                   Foreground="{DynamicResource AfAccentBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding HasActionStatus, Converter={StaticResource QueueVisibility}}" />
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="{DynamicResource Loc.Panel.Queue.DoubleClickHint}"
                                       Style="{StaticResource PanelLabelStyle}" />
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource PanelLabelStyle}"
                                       HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
