<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.AudioControlFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:AFMediaBar.Classes.Converters"
        xmlns:components="clr-namespace:AFMediaBar.Components"
        Title="{DynamicResource Loc.Common.AudioControl}"
        Width="320"
        MinWidth="0"
        MinHeight="0"
        SizeToContent="Height"
        MaxHeight="620"
        ShowInTaskbar="False"
        Topmost="True"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        FontFamily="{DynamicResource AppTextFontFamily}"
        FontWeight="{DynamicResource AppTextFontWeight}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="Transparent"
        Deactivated="Window_OnDeactivated"
        mc:Ignorable="d"
        d:DesignHeight="500">
    <ui:FluentWindow.Resources>
        <converters:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter" />
        <BooleanToVisibilityConverter x:Key="AfBooleanToVisibilityConverter" />
        <Style x:Key="AudioDeviceLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="AudioStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AudioCardActionStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="Transparent" CornerRadius="4">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="ApplicationRouteDeviceTemplate">
            <TextBlock Text="{Binding MenuLabel}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceHint}" />
        </DataTemplate>
        <DataTemplate x:Key="AudioApplicationCardTemplate">
            <Border Height="40" Margin="0,0,0,4" CornerRadius="6" BorderThickness="1" Padding="8,0"
                    MouseLeftButtonUp="ApplicationCard_OnMouseLeftButtonUp"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Border.Style><Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" /></Trigger></Style.Triggers>
                </Style></Border.Style>
                <Grid Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" /><ColumnDefinition Width="8" />
                        <ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource AudioCardActionStyle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Grid.ColumnSpan="5" Background="Transparent" BorderThickness="0" Padding="0"
                            FocusVisualStyle="{DynamicResource AfFocusVisualStyle}"
                            IsEnabled="{Binding CanRoute}" AutomationProperties.Name="{Binding DisplayName}"
                            Command="{Binding DataContext.ToggleAudioApplicationCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                            CommandParameter="{Binding}" />
                    <Button Style="{StaticResource AudioCardActionStyle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="28" Height="28" Padding="0" BorderThickness="0" Background="Transparent"
                            Command="{Binding Volume.ToggleMuteCommand}" IsEnabled="{Binding CanAdjustVolume}"
                            ToolTip="{Binding IconToolTip}" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="{Binding IconToolTip}">
                        <Grid>
                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="{DynamicResource AppTextStrongFontWeight}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                    <DataTrigger Binding="{Binding IconData}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Image Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding IconData, Converter={StaticResource ByteArrayToImageSourceConverter}}" Stretch="Uniform" />
                            <Border Background="{DynamicResource ControlSolidFillColorDefaultBrush}" CornerRadius="4"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="1">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                    <DataTrigger Binding="{Binding Volume.IsMuted}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers></Style></Border.Style>
                                <ui:SymbolIcon Symbol="SpeakerMute24" FontSize="10" />
                            </Border>
                        </Grid>
                    </Button>
                <Slider Grid.Column="2" Minimum="0" Maximum="100"
                        MinWidth="0" MaxWidth="160"
                        Style="{StaticResource AfAccentSliderStyle}"
                        FocusVisualStyle="{DynamicResource AfFocusVisualStyle}"
                        Margin="0,0,10,0"
                        Visibility="{Binding CanAdjustVolume, Converter={StaticResource AfBooleanToVisibilityConverter}}" IsEnabled="{Binding CanAdjustVolume}" Value="{Binding Volume.VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PreviewMouseLeftButtonDown="ApplicationVolumeSlider_OnPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ApplicationVolumeSlider_OnPreviewMouseLeftButtonUp"
                        LostMouseCapture="ApplicationVolumeSlider_OnLostMouseCapture"
                        PreviewKeyDown="ApplicationVolumeSlider_OnPreviewKeyDown"
                        IsMoveToPointEnabled="True"
                        LargeChange="10"
                        SmallChange="2"
                        PreviewMouseWheel="ApplicationVolumeSlider_OnPreviewMouseWheel"
                        VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" IsHitTestVisible="False" Text="{Binding Volume.VolumePercent, StringFormat={}{0}%}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <DataTrigger Binding="{Binding CanAdjustVolume}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Grid.ColumnSpan="2" IsHitTestVisible="False" Text="{DynamicResource Loc.Audio.Route.NoPlayback}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                            <DataTrigger Binding="{Binding CanAdjustVolume}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>

                    <Button Foreground="{DynamicResource TextFillColorPrimaryBrush}" Grid.Column="4" Width="24" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                            ToolTip="{DynamicResource Loc.Audio.Route.Expand}" AutomationProperties.Name="{DynamicResource Loc.Audio.Route.Expand}"
                            FocusVisualStyle="{DynamicResource AfFocusVisualStyle}"
                            Command="{Binding DataContext.ToggleAudioApplicationCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                            CommandParameter="{Binding}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AudioCardActionStyle}"><Style.Triggers>
                            <DataTrigger Binding="{Binding CanRoute}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                        <ui:SymbolIcon FontSize="12">
                            <ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Symbol" Value="ChevronDown24" /><Style.Triggers>
                                <DataTrigger Binding="{Binding IsDetailSelected}" Value="True"><Setter Property="Symbol" Value="ChevronUp24" /></DataTrigger>
                            </Style.Triggers></Style></ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>
    <Border x:Name="FlyoutRoot" Margin="4"
            Padding="12"
            CornerRadius="8"
            Background="Transparent"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Effect="{DynamicResource AfFlyoutShadowEffect}">
        <Border.RenderTransformOrigin>0.85,1</Border.RenderTransformOrigin>
        <Border.RenderTransform>
            <ScaleTransform x:Name="FlyoutScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Grid>

        <Grid x:Name="AudioContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Loc.Common.AudioControl}" ToolTip="{Binding StatusText}" FontSize="16" FontWeight="{DynamicResource AppTextStrongFontWeight}" VerticalAlignment="Center" />
                <ui:Button Grid.Column="1"
                           Width="26" Height="26"
                           Padding="0"
                           Command="{Binding RefreshCommand}"
                           ToolTip="{DynamicResource Loc.Panel.AudioFlyout.Refresh}">
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                </ui:Button>
            </Grid>

            <StackPanel Grid.Row="1" HorizontalAlignment="Stretch" Orientation="Horizontal" Margin="0,4,0,0">
                <ui:SymbolIcon Symbol="Speaker224" FontSize="14" Margin="0,0,6,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{DynamicResource Loc.Common.OutputDevice}" Style="{StaticResource AudioDeviceLabelStyle}" />
            </StackPanel>
            <components:ReleaseOpenComboBox x:Name="OutputDeviceComboBox"
                      Style="{StaticResource {x:Type ComboBox}}"
                      Grid.Row="2" HorizontalAlignment="Stretch"
                      MinHeight="32"
                      MaxDropDownHeight="240"
                      ItemsSource="{Binding OutputDevices}"
                      DisplayMemberPath="MenuLabel"
                      ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.DeviceHint}"
                      SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                      DropDownOpened="OutputDevice_OnDropDownOpened"
                      DropDownClosed="OutputDevice_OnDropDownClosed"
                      PreviewMouseWheel="OutputDevice_OnPreviewMouseWheel" />

            <TextBlock Grid.Row="3" Text="{Binding OutputDeviceStatus}">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AudioStatusStyle}"><Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedOutputDevice}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Row="4" HorizontalAlignment="Stretch" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Mic24" FontSize="14" Margin="0,0,6,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{DynamicResource Loc.Common.InputDevice}" Style="{StaticResource AudioDeviceLabelStyle}" />
                </StackPanel>
                <components:ReleaseOpenComboBox x:Name="InputDeviceComboBox" MinHeight="32" MaxDropDownHeight="240"
                    Style="{StaticResource {x:Type ComboBox}}" ItemsSource="{Binding InputDevices}" DisplayMemberPath="MenuLabel"
                    ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.DeviceHint}"
                    SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}" PreviewMouseWheel="InputDevice_OnPreviewMouseWheel"
                    DropDownOpened="OutputDevice_OnDropDownOpened" DropDownClosed="OutputDevice_OnDropDownClosed" />
                <TextBlock Text="{Binding InputDeviceStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource AudioStatusStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedInputDevice}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Button Grid.Row="5"
                    MinHeight="38"
                    Margin="0,12,0,14"
                    Padding="8,4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding OpenSpatialAudioSettingsCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.Panel.AudioFlyout.SpatialAudio}" FontWeight="{DynamicResource AppTextStrongFontWeight}" FontSize="13" />
                        <TextBlock Text="{Binding SpatialAudioText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="Open24" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Loc.Panel.AudioFlyout.AppVolume}" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                <Grid x:Name="ApplicationsViewport" Grid.Row="1" Height="132">
                    <ScrollViewer x:Name="ApplicationsScrollViewer" Padding="12,0,12,0"
                                  PanningMode="VerticalOnly" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsApplicationDetailVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style></ScrollViewer.Style>
                        <ItemsControl x:Name="ApplicationCards" ItemsSource="{Binding AudioApplications}" ItemTemplate="{StaticResource AudioApplicationCardTemplate}" />
                    </ScrollViewer>
                    <ScrollViewer x:Name="ApplicationDetailScrollViewer" PreviewMouseWheel="ApplicationDetail_OnPreviewMouseWheel"
                                  Padding="12,0,12,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                            <DataTrigger Binding="{Binding IsApplicationDetailVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers></Style></ScrollViewer.Style>
                        <Grid DataContext="{Binding SelectedAudioApplication}" Height="132">
                            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="88" /></Grid.RowDefinitions>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AudioApplicationCardTemplate}" HorizontalContentAlignment="Stretch" />
                            <Border Grid.Row="1" CornerRadius="6" Padding="8" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="6" /><RowDefinition Height="32" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Loc.Common.OutputDevice}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <components:ReleaseOpenComboBox x:Name="ApplicationOutputDeviceComboBox" Grid.Column="2" Tag="Output" Height="32" MinHeight="32" MinWidth="0" MaxWidth="220" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Padding="8,2"
                                        PreviewMouseWheel="ApplicationDevice_OnPreviewMouseWheel" DropDownOpened="OutputDevice_OnDropDownOpened" DropDownClosed="OutputDevice_OnDropDownClosed"
                                        ItemsSource="{Binding OutputDevices}" ItemTemplate="{StaticResource ApplicationRouteDeviceTemplate}" IsEnabled="{Binding IsRouteSupported}"
                                        SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}" Style="{StaticResource {x:Type ComboBox}}" MaxDropDownHeight="220"
                                        ToolTip="{Binding OutputDeviceToolTip}" ToolTipService.ShowOnDisabled="True" />
                                    <TextBlock Grid.Row="2" Text="{DynamicResource Loc.Common.InputDevice}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <components:ReleaseOpenComboBox x:Name="ApplicationInputDeviceComboBox" Grid.Row="2" Grid.Column="2" Tag="Input" Height="32" MinHeight="32" MinWidth="0" MaxWidth="220" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Padding="8,2"
                                        PreviewMouseWheel="ApplicationDevice_OnPreviewMouseWheel" DropDownOpened="OutputDevice_OnDropDownOpened" DropDownClosed="OutputDevice_OnDropDownClosed"
                                        ItemsSource="{Binding InputDevices}" ItemTemplate="{StaticResource ApplicationRouteDeviceTemplate}" IsEnabled="{Binding IsRouteSupported}"
                                        SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}" Style="{StaticResource {x:Type ComboBox}}" MaxDropDownHeight="220"
                                        ToolTip="{Binding InputDeviceToolTip}" ToolTipService.ShowOnDisabled="True" />
                                    <TextBlock Grid.RowSpan="3" Grid.ColumnSpan="3" Text="{Binding StatusText}" TextWrapping="Wrap"
                                               Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRouteSupported}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>


        </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
