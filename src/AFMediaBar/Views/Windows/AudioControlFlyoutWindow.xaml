<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.AudioControlFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:AFMediaBar.Classes.Converters"
        xmlns:components="clr-namespace:AFMediaBar.Components"
        Title="{DynamicResource Loc.Common.AudioControl}"
        Width="320"
        MinWidth="0"
        MinHeight="0"
        SizeToContent="Height"
        MaxHeight="620"
        ShowInTaskbar="False"
        Topmost="True"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        FontFamily="{DynamicResource AppTextFontFamily}"
        FontWeight="{DynamicResource AppTextFontWeight}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="Transparent"
        Deactivated="Window_OnDeactivated"
        mc:Ignorable="d"
        d:DesignHeight="500">
    <ui:FluentWindow.Resources>
        <converters:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter" />
        <BooleanToVisibilityConverter x:Key="AfBooleanToVisibilityConverter" />
        <Style x:Key="AudioDeviceLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="AudioStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AudioApplicationExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border CornerRadius="6" BorderThickness="1" Padding="8,0"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <StackPanel>
                                <Grid MinHeight="44">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                    <ToggleButton Grid.Column="1" Width="24" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                                                  ToolTip="{DynamicResource Loc.Audio.Route.Expand}" AutomationProperties.Name="{DynamicResource Loc.Audio.Route.Expand}"
                                                  FocusVisualStyle="{DynamicResource AfFocusVisualStyle}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Style.Triggers>
                                            <DataTrigger Binding="{Binding CanRoute}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers></Style></ToggleButton.Style>
                                        <ui:SymbolIcon x:Name="RouteChevron" Symbol="ChevronDown24" FontSize="12" />
                                    </ToggleButton>
                                </Grid>
                                <ContentPresenter x:Name="RoutingContent" Visibility="Collapsed" ContentSource="Content" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="RoutingContent" Property="Visibility" Value="Visible" />
                                <Setter TargetName="RouteChevron" Property="Symbol" Value="ChevronUp24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Border x:Name="FlyoutRoot" Margin="4"
            Padding="12"
            CornerRadius="8"
            Background="Transparent"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Effect="{DynamicResource AfFlyoutShadowEffect}">
        <Border.RenderTransformOrigin>0.85,1</Border.RenderTransformOrigin>
        <Border.RenderTransform>
            <ScaleTransform x:Name="FlyoutScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Loc.Common.AudioControl}" FontSize="16" FontWeight="{DynamicResource AppTextStrongFontWeight}" VerticalAlignment="Center" />
                <ui:Button Grid.Column="1"
                           Width="26" Height="26"
                           Padding="0"
                           Command="{Binding RefreshCommand}"
                           ToolTip="{DynamicResource Loc.Panel.AudioFlyout.Refresh}">
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                </ui:Button>
            </Grid>

            <StackPanel Grid.Row="1" Width="220" HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,4,0,0">
                <ui:SymbolIcon Symbol="Speaker224" FontSize="14" Margin="0,0,6,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{DynamicResource Loc.Common.OutputDevice}" Style="{StaticResource AudioDeviceLabelStyle}" />
            </StackPanel>
            <components:ReleaseOpenComboBox x:Name="OutputDeviceComboBox"
                      Style="{StaticResource {x:Type ComboBox}}"
                      Grid.Row="2" Width="220" HorizontalAlignment="Center"
                      MinHeight="32"
                      MaxDropDownHeight="240"
                      ItemsSource="{Binding OutputDevices}"
                      DisplayMemberPath="DisplayName"
                      ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.DisplayName}"
                      SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                      DropDownOpened="OutputDevice_OnDropDownOpened"
                      DropDownClosed="OutputDevice_OnDropDownClosed"
                      PreviewMouseWheel="OutputDevice_OnPreviewMouseWheel" />

            <TextBlock Grid.Row="3" Text="{Binding OutputDeviceStatus}">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AudioStatusStyle}"><Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedOutputDevice}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Row="4" Width="220" HorizontalAlignment="Center" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Mic24" FontSize="14" Margin="0,0,6,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{DynamicResource Loc.Common.InputDevice}" Style="{StaticResource AudioDeviceLabelStyle}" />
                </StackPanel>
                <components:ReleaseOpenComboBox x:Name="InputDeviceComboBox" MinHeight="32" MaxDropDownHeight="240"
                    Style="{StaticResource {x:Type ComboBox}}" ItemsSource="{Binding InputDevices}" DisplayMemberPath="DisplayName"
                    ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.DisplayName}"
                    SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}" PreviewMouseWheel="InputDevice_OnPreviewMouseWheel"
                    DropDownOpened="OutputDevice_OnDropDownOpened" DropDownClosed="OutputDevice_OnDropDownClosed" />
                <TextBlock Text="{Binding InputDeviceStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource AudioStatusStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedInputDevice}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Button Grid.Row="5"
                    MinHeight="38"
                    Margin="0,12,0,14"
                    Padding="8,4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding OpenSpatialAudioSettingsCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.Panel.AudioFlyout.SpatialAudio}" FontWeight="{DynamicResource AppTextStrongFontWeight}" FontSize="13" />
                        <TextBlock Text="{Binding SpatialAudioText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="Open24" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Loc.Panel.AudioFlyout.AppVolume}" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                <ScrollViewer x:Name="ApplicationsScrollViewer" Grid.Row="1"
                              MaxHeight="300"
                              Padding="12,0,12,0"
                              PanningMode="VerticalOnly"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding AudioApplications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Style="{StaticResource AudioApplicationExpanderStyle}">
                                    <Expander.Header>
                                        <Grid MinHeight="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" /><ColumnDefinition Width="8" />
                                                <ColumnDefinition /><ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <Button Width="28" Height="28" Padding="0" BorderThickness="0" Background="Transparent"
                                                    Command="{Binding Volume.ToggleMuteCommand}" IsEnabled="{Binding CanAdjustVolume}"
                                                    ToolTip="{Binding IconToolTip}" ToolTipService.ShowOnDisabled="True"
                                                    AutomationProperties.Name="{Binding IconToolTip}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontWeight="{DynamicResource AppTextStrongFontWeight}">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                                            <DataTrigger Binding="{Binding IconData}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                        </Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"
                                                           Source="{Binding IconData, Converter={StaticResource ByteArrayToImageSourceConverter}}" Stretch="Uniform" />
                                                    <Border Background="{DynamicResource ControlSolidFillColorDefaultBrush}" CornerRadius="4"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="1">
                                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                                            <DataTrigger Binding="{Binding Volume.IsMuted}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                        </Style.Triggers></Style></Border.Style>
                                                        <ui:SymbolIcon Symbol="SpeakerMute24" FontSize="10" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        <Slider Grid.Column="2" Minimum="0" Maximum="100"
                                                MinWidth="0" MaxWidth="160"
                                                Style="{StaticResource AfAccentSliderStyle}"
                                                FocusVisualStyle="{DynamicResource AfFocusVisualStyle}"
                                                Margin="0,0,10,0"
                                                Visibility="{Binding CanAdjustVolume, Converter={StaticResource AfBooleanToVisibilityConverter}}" IsEnabled="{Binding CanAdjustVolume}" Value="{Binding Volume.VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PreviewMouseLeftButtonDown="ApplicationVolumeSlider_OnPreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="ApplicationVolumeSlider_OnPreviewMouseLeftButtonUp"
                                                LostMouseCapture="ApplicationVolumeSlider_OnLostMouseCapture"
                                                PreviewKeyDown="ApplicationVolumeSlider_OnPreviewKeyDown"
                                                IsMoveToPointEnabled="True"
                                                LargeChange="10"
                                                SmallChange="2"
                                                PreviewMouseWheel="ApplicationVolumeSlider_OnPreviewMouseWheel"
                                                VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Volume.VolumePercent, StringFormat={}{0}%}"
                                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanAdjustVolume}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="{DynamicResource Loc.Audio.Route.NoPlayback}"
                                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanAdjustVolume}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel MaxWidth="220" HorizontalAlignment="Center" Margin="0,4,0,12">
                                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                                            <DataTrigger Binding="{Binding CanRoute}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers></Style></StackPanel.Style>
                                        <TextBlock Text="{DynamicResource Loc.Common.OutputDevice}" Style="{StaticResource AudioDeviceLabelStyle}" />
                                        <components:ReleaseOpenComboBox Tag="Output" MinHeight="32" Width="220" MaxWidth="220"
                                            PreviewMouseWheel="ApplicationDevice_OnPreviewMouseWheel"
                                            DropDownOpened="OutputDevice_OnDropDownOpened" DropDownClosed="OutputDevice_OnDropDownClosed"
                                            ItemsSource="{Binding OutputDevices}" DisplayMemberPath="DisplayName"
                                            IsEnabled="{Binding IsRouteSupported}" SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                                            Style="{StaticResource {x:Type ComboBox}}" MaxDropDownHeight="220"
                                            ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.DisplayName}" />
                                        <TextBlock Text="{DynamicResource Loc.Common.InputDevice}" Style="{StaticResource AudioDeviceLabelStyle}" Margin="0,12,0,6" />
                                        <components:ReleaseOpenComboBox Tag="Input" MinHeight="32" Width="220" MaxWidth="220"
                                            PreviewMouseWheel="ApplicationDevice_OnPreviewMouseWheel"
                                            DropDownOpened="OutputDevice_OnDropDownOpened" DropDownClosed="OutputDevice_OnDropDownClosed"
                                            ItemsSource="{Binding InputDevices}" DisplayMemberPath="DisplayName"
                                            IsEnabled="{Binding IsRouteSupported}" SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}"
                                            Style="{StaticResource {x:Type ComboBox}}" MaxDropDownHeight="220"
                                            ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.DisplayName}" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource AudioStatusStyle}" />
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <TextBlock Grid.Row="7" Text="{Binding StatusText}" Style="{StaticResource AudioStatusStyle}" />
        </Grid>
    </Border>
</ui:FluentWindow>
