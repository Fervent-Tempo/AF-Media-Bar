<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.AudioControlFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:AFMediaBar.Classes.Converters"
        Title="音频控制"
        Width="320"
        MinWidth="0"
        SizeToContent="Height"
        MaxHeight="440"
        ShowInTaskbar="False"
        Topmost="True"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        FontFamily="{DynamicResource AppTextFontFamily}"
        FontWeight="{DynamicResource AppTextFontWeight}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="Transparent"
        Deactivated="Window_OnDeactivated"
        mc:Ignorable="d"
        d:DesignHeight="500">
    <ui:FluentWindow.Resources>
        <converters:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter" />
    </ui:FluentWindow.Resources>
    <Border Margin="4"
            Padding="10"
            CornerRadius="8"
            Background="Transparent"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.24" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="音频控制" FontSize="16" FontWeight="{DynamicResource AppTextStrongFontWeight}" VerticalAlignment="Center" />
                <ui:Button Grid.Column="1"
                           Width="26" Height="26"
                           Padding="0"
                           Command="{Binding RefreshCommand}"
                           ToolTip="刷新音频状态">
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                </ui:Button>
            </Grid>

            <TextBlock Grid.Row="1" Text="输出设备" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
            <ComboBox x:Name="OutputDeviceComboBox"
                      Grid.Row="2"
                      MinHeight="32"
                      MaxDropDownHeight="240"
                      ItemsSource="{Binding OutputDevices}"
                      DisplayMemberPath="DisplayName"
                      SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                      DropDownOpened="OutputDevice_OnDropDownOpened"
                      DropDownClosed="OutputDevice_OnDropDownClosed"
                      PreviewMouseWheel="OutputDevice_OnPreviewMouseWheel" />

            <Button Grid.Row="3"
                    MinHeight="38"
                    Margin="0,7,0,10"
                    Padding="8,4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding OpenSpatialAudioSettingsCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="空间音效" FontWeight="{DynamicResource AppTextStrongFontWeight}" FontSize="13" />
                        <TextBlock Text="{Binding SpatialAudioText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="Open24" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="应用音量" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                <ScrollViewer Grid.Row="1"
                              MaxHeight="114"
                              PanningMode="VerticalOnly"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Applications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="22" Height="22" CornerRadius="4"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" FontWeight="{DynamicResource AppTextStrongFontWeight}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IconData}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Width="18" Height="18"
                                                   Source="{Binding IconData, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                                   Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Margin="5,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="{DynamicResource AppTextFontWeight}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentMedia}" Value="True">
                                                        <Setter Property="FontWeight" Value="{DynamicResource AppTextStrongFontWeight}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Slider Grid.Column="2" Minimum="0" Maximum="100"
                                            MinWidth="0"
                                            Margin="0,0,6,0"
                                            Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PreviewMouseLeftButtonDown="ApplicationVolumeSlider_OnPreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="ApplicationVolumeSlider_OnPreviewMouseLeftButtonUp"
                                            LostMouseCapture="ApplicationVolumeSlider_OnLostMouseCapture"
                                            PreviewKeyDown="ApplicationVolumeSlider_OnPreviewKeyDown"
                                            IsMoveToPointEnabled="True"
                                            LargeChange="10"
                                            SmallChange="2"
                                            PreviewMouseWheel="ApplicationVolumeSlider_OnPreviewMouseWheel"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding VolumePercent, StringFormat={}{0}%}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <TextBlock Grid.Row="5" Text="{Binding StatusText}" Margin="0,6,0,0"
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Border>
</ui:FluentWindow>
