<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.TrackChangeNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Loc.Panel.Notification.WindowTitle}"
        MinWidth="0" MinHeight="0" MaxWidth="400" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="Manual"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True" Background="Transparent"
        FontFamily="{DynamicResource AppTextFontFamily}"
        FontWeight="{DynamicResource AppTextFontWeight}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        MouseEnter="Window_MouseEnter">
    <Border x:Name="AnimatedRoot" Margin="6" Padding="10" CornerRadius="10"
            Background="Transparent"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
            Effect="{DynamicResource AfNotificationShadowEffect}"
            Opacity="0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="EntryScaleTransform" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="EntryTransform" />
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArtworkColumn" Width="44" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ArtworkBorder" Width="44" Height="44" CornerRadius="7" ClipToBounds="True" Background="#18FFFFFF">
                <Grid>
                    <ui:SymbolIcon x:Name="ArtworkPlaceholder" Symbol="MusicNote220" FontSize="24" />
                    <Image x:Name="ArtworkImage" Stretch="Uniform" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="96" MaxWidth="240">
                <TextBlock Text="{DynamicResource Loc.Panel.Notification.NowPlaying}" FontSize="11" Opacity="0.58" />
                <TextBlock x:Name="TitleText" Margin="0,2,0,0" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText" Margin="0,2,0,0" FontSize="12" Opacity="0.7"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</ui:FluentWindow>
