<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.TrackChangeNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:components="clr-namespace:AFMediaBar.Components"
        Title="{DynamicResource Loc.Panel.Notification.WindowTitle}"
        MinWidth="0" MinHeight="0" MaxWidth="400" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="Manual"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True" Background="Transparent"
        FontFamily="{DynamicResource AppTextFontFamily}"
        FontWeight="{DynamicResource AppTextFontWeight}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        MouseEnter="Window_MouseEnter">
    <Border x:Name="AnimatedRoot" Margin="6" Padding="10" CornerRadius="10"
            Background="Transparent"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
            Effect="{DynamicResource AfNotificationShadowEffect}"
            Opacity="0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="EntryScaleTransform" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="EntryTransform" />
            </TransformGroup>
        </Border.RenderTransform>
        <components:TrackNotificationContent x:Name="NotificationContent"/>
    </Border>
</ui:FluentWindow>
