<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.TaskbarCompactFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:components="clr-namespace:AFMediaBar.Components"
        Title="{DynamicResource Loc.Panel.CompactMenu.WindowTitle}"
        MinWidth="0"
        MinHeight="0"
        SizeToContent="Height"
        MaxHeight="440"
        ShowInTaskbar="False"
        Topmost="True"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        FontFamily="{DynamicResource AppTextFontFamily}"
        FontWeight="{DynamicResource AppTextFontWeight}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="Transparent"
        Deactivated="Window_OnDeactivated"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Border x:Name="FlyoutRoot" Margin="4" Padding="10" CornerRadius="8"
            Background="Transparent"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Effect="{DynamicResource AfFlyoutShadowEffect}">
        <Border.RenderTransformOrigin>0.5,1</Border.RenderTransformOrigin>
        <Border.RenderTransform>
            <ScaleTransform x:Name="FlyoutScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Grid>
            <StackPanel x:Name="QuickLaunchPanel" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource Loc.Panel.QuickLaunch.Title}" FontSize="16" FontWeight="{DynamicResource AppTextStrongFontWeight}" Margin="0,0,0,8"/>
                <TextBlock x:Name="QuickLaunchStatusText" FontSize="12" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock x:Name="QuickLaunchEmptyText" Text="{DynamicResource Loc.Panel.QuickLaunch.Empty}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ScrollViewer x:Name="QuickLaunchScrollViewer" MaxHeight="280"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="QuickLaunchList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="34" Padding="8,4" Margin="0,1" HorizontalContentAlignment="Left"
                                        BorderThickness="0" Background="Transparent" Click="QuickLaunchItem_Click">
                                    <TextBlock Text="{Binding DisplayName}" MaxWidth="270" TextTrimming="CharacterEllipsis"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="OutputDevicePanel" Visibility="Collapsed" PreviewMouseWheel="OutputDevicePanel_PreviewMouseWheel">
                <TextBlock Text="{DynamicResource Loc.Common.OutputDevice}" FontSize="16" FontWeight="{DynamicResource AppTextStrongFontWeight}" Margin="0,0,0,8"/>
                <components:ReleaseOpenComboBox x:Name="OutputDeviceComboBox" MinHeight="32" MaxDropDownHeight="240"
                          Style="{StaticResource {x:Type ComboBox}}"
                          DisplayMemberPath="DisplayName" SelectionChanged="OutputDeviceComboBox_SelectionChanged"
                          DropDownOpened="OutputDeviceComboBox_DropDownOpened"
                          DropDownClosed="OutputDeviceComboBox_DropDownClosed"
                          PreviewMouseWheel="OutputDeviceComboBox_PreviewMouseWheel"/>
            </StackPanel>

            <StackPanel x:Name="VolumePanel" Visibility="Collapsed" HorizontalAlignment="Center"
                        PreviewMouseWheel="VolumePanel_PreviewMouseWheel">
                <!-- 竖向音量面板：来源名称在上、百分比在滑块上方、滑块占满剩余高度。 -->
                <!-- Vertical volume panel: source name on top, percentage above the slider, slider fills the rest. -->
                <TextBlock x:Name="VolumeSourceText" FontSize="14" MaxWidth="72"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="VolumePercentText" FontSize="12" Margin="0,6,0,0" Opacity="0.68"
                           HorizontalAlignment="Center"/>
                <Slider x:Name="VolumeSlider" Orientation="Vertical" Height="150" Margin="0,8,0,0"
                        HorizontalAlignment="Center" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10"
                        IsMoveToPointEnabled="True"
                        Style="{StaticResource AfAccentSliderStyle}"
                        ValueChanged="VolumeSlider_ValueChanged" PreviewMouseWheel="VolumeSlider_PreviewMouseWheel"/>
            </StackPanel>
        </Grid>
    </Border>
</ui:FluentWindow>
