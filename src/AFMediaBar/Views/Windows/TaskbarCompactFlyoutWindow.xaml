<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.TaskbarCompactFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:components="clr-namespace:AFMediaBar.Components"
        Title="{DynamicResource Loc.Panel.CompactMenu.WindowTitle}"
        MinWidth="0"
        MinHeight="0"
        SizeToContent="Height"
        MaxHeight="440"
        ShowInTaskbar="False"
        Topmost="True"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        FontFamily="{DynamicResource AppTextFontFamily}"
        FontWeight="{DynamicResource AppTextFontWeight}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="Transparent"
        Deactivated="Window_OnDeactivated"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <ui:FluentWindow.Resources>
        <Style x:Key="DeviceOptionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="FocusVisualStyle" Value="{DynamicResource AfFocusVisualStyle}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DeviceOptionContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6">
                    <Grid>
                        <Border x:Name="CandidateMark" Width="3" CornerRadius="1" Margin="1,8,0,8" HorizontalAlignment="Left"
                                Background="{DynamicResource AfAccentBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="5,0,0,0" HorizontalAlignment="Stretch" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource AfAccentTintBrush}" />
                        <Setter TargetName="CandidateMark" Property="Visibility" Value="Visible" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Border x:Name="FlyoutRoot" Margin="4" Padding="10" CornerRadius="8" PreviewMouseWheel="FlyoutRoot_PreviewMouseWheel"
            Background="Transparent"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Effect="{DynamicResource AfFlyoutShadowEffect}">
        <Border.RenderTransformOrigin>0.5,1</Border.RenderTransformOrigin>
        <Border.RenderTransform>
            <ScaleTransform x:Name="FlyoutScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Grid>
            <StackPanel x:Name="QuickLaunchPanel" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource Loc.Panel.QuickLaunch.Title}" FontSize="16" FontWeight="{DynamicResource AppTextStrongFontWeight}" Margin="0,0,0,8"/>
                <TextBlock x:Name="QuickLaunchStatusText" FontSize="12" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock x:Name="QuickLaunchEmptyText" Text="{DynamicResource Loc.Panel.QuickLaunch.Empty}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ScrollViewer x:Name="QuickLaunchScrollViewer" MaxHeight="280"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="QuickLaunchList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="34" Padding="8,4" Margin="0,1" HorizontalContentAlignment="Left"
                                        BorderThickness="0" Background="Transparent" Click="QuickLaunchItem_Click">
                                    <TextBlock Text="{Binding DisplayName}" MaxWidth="270" TextTrimming="CharacterEllipsis"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="OutputDevicePanel" Visibility="Collapsed">
                <StackPanel x:Name="DeviceHeaderPanel" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="DeviceTitleText" FontSize="16" FontWeight="{DynamicResource AppTextStrongFontWeight}" VerticalAlignment="Top" />
                        <TextBlock x:Name="CurrentDeviceText" Grid.Column="2" TextWrapping="Wrap" FontSize="12" TextAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="DeviceApplicationText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                </StackPanel>
                <ListBox x:Name="OutputDeviceList" MinHeight="0" MaxHeight="280" BorderThickness="0" Padding="0"
                         Background="Transparent" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource DeviceOptionContainerStyle}">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Button Style="{StaticResource DeviceOptionButtonStyle}" Click="DeviceItem_Click"
                                AutomationProperties.Name="{Binding DisplayName}">
                            <TextBlock Text="{Binding MenuLabel}" TextWrapping="Wrap" ToolTip="{Binding DeviceHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="DeviceUnavailableText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel x:Name="VolumePanel" Visibility="Collapsed" HorizontalAlignment="Center"
                        PreviewMouseWheel="VolumePanel_PreviewMouseWheel">
                <!-- 竖向音量面板：来源名称在上、百分比在滑块上方、滑块占满剩余高度。 -->
                <!-- Vertical volume panel: source name on top, percentage above the slider, slider fills the rest. -->
                <TextBlock x:Name="VolumeSourceText" FontSize="14" MaxWidth="100"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="VolumePercentText" FontSize="12" Margin="0,6,0,0" Opacity="0.68"
                           HorizontalAlignment="Center"/>
                <Slider x:Name="VolumeSlider" Orientation="Vertical" Height="150" Margin="0,8,0,0"
                        HorizontalAlignment="Center" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10"
                        IsMoveToPointEnabled="True"
                        Style="{StaticResource AfAccentSliderStyle}"
                        ValueChanged="VolumeSlider_ValueChanged" PreviewMouseWheel="VolumeSlider_PreviewMouseWheel"/>
            </StackPanel>
        </Grid>
    </Border>
</ui:FluentWindow>
