<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        设置页结构组件 / Settings structure components

        分组容器、分组标签条、子区域和说明图宿主。它们把“分组”和“父子依赖”从每页各自重复的
        ContentControl + 卡片堆叠，变成可以一次改动、六页一致的控件。

        Group container, group strip, sub-region, and diagram host. They turn "a group" and "a parent-child
        dependency" from markup repeated per page into controls that change once and stay consistent across all
        six pages.

        这里显式合并两个字典，是为了让本文件里的 StaticResource 能够解析：
        ResourceDictionary 在解析时看不到 Application 的合并列表，只能看到自己合并进来的字典。
        The two dictionaries are merged here explicitly so this file's StaticResource lookups can resolve:
        a ResourceDictionary cannot see the application's merge list while it is being parsed, only the
        dictionaries it merges itself.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AFMediaBar;component/Resources/SettingsAppearanceResources.xaml" />
        <ResourceDictionary Source="/AFMediaBar;component/Resources/SettingsDiagrams.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        状态芯片 / Status chips

        芯片承担“当前 / 未实现 / 需先启用”这类状态。以前这些状态写在卡片描述的句子里，
        读起来像解释而不是状态，用户得读完一整句才知道这个选项现在能不能用。
        Chips carry states such as "current / not implemented / needs enabling". These used to live inside
        description sentences, where they read as explanation rather than state and forced the user to finish a
        sentence before learning whether an option could be used at all.
    -->

    <Style x:Key="AfSettingsChipBaseStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border
                        Padding="8,2"
                        Background="{TemplateBinding Background}"
                        CornerRadius="9">
                        <ContentPresenter
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="AfSettingsChipAccentStyle"
        BasedOn="{StaticResource AfSettingsChipBaseStyle}"
        TargetType="{x:Type ContentControl}">
        <Setter Property="Background" Value="{DynamicResource AfAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AfOnAccentBrush}" />
    </Style>

    <Style
        x:Key="AfSettingsChipNeutralStyle"
        BasedOn="{StaticResource AfSettingsChipBaseStyle}"
        TargetType="{x:Type ContentControl}">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="AfSettingsChipAttentionStyle"
        BasedOn="{StaticResource AfSettingsChipBaseStyle}"
        TargetType="{x:Type ContentControl}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>

    <!--
        内联状态徽章 / Inline status badge

        「当前模式 / 未实现 / 预留」这类短状态贴在行标题右侧，而不是另占一行、也不是塞进说明句里。
        它比芯片更小更紧，因为它与标题同处一个文字块。
        Short states such as "current / not implemented / reserved" sit beside the row title instead of taking a
        row of their own or hiding inside the description sentence. It is smaller and tighter than a chip because
        it shares one text block with the title.
    -->

    <Style x:Key="AfSettingsBadgeBaseStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border
                        Padding="6,1"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <ContentPresenter
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="AfSettingsBadgeAccentStyle"
        BasedOn="{StaticResource AfSettingsBadgeBaseStyle}"
        TargetType="{x:Type ContentControl}">
        <Setter Property="Background" Value="{DynamicResource AfAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AfOnAccentBrush}" />
    </Style>

    <Style
        x:Key="AfSettingsBadgeNeutralStyle"
        BasedOn="{StaticResource AfSettingsBadgeBaseStyle}"
        TargetType="{x:Type ContentControl}">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style
        x:Key="AfSettingsBadgeAttentionStyle"
        BasedOn="{StaticResource AfSettingsBadgeBaseStyle}"
        TargetType="{x:Type ContentControl}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>

    <!--
        设置行 / Settings row

        一行一个选项、一行恰好一个控件，控件永远贴右。左侧是主色图标底片、标题与说明，
        右侧是唯一的控件槽。行间距 4 DIP：同一分组的行贴成一条连续列表，而不是一堆独立盒子。
        One option per row, exactly one control per row, always pinned right. The left side carries the accent
        icon chip, title, and description; the right side is the single control slot. The 4 DIP row gap welds a
        group's rows into one continuous list instead of a pile of separate boxes.
    -->
    <Style TargetType="{x:Type components:SettingsRow}">
        <Setter Property="Margin" Value="{StaticResource AfSettingsRowGap}" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource AfSettingsCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource CardForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AfSettingsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AfFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:SettingsRow}">
                    <Grid>
<Border
                        x:Name="RowSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        SnapsToDevicePixels="True" IsHitTestVisible="False" components:SettingsHoverShadow.IsEnabled="True" />
                    <Border Padding="{TemplateBinding Padding}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="Transparent">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                x:Name="IconChip"
                                Grid.Column="0"
                                Width="32"
                                Height="32"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{DynamicResource AfOnAccentBrush}">
                                <Border
                                    Background="{DynamicResource AfAccentBrush}"
                                    CornerRadius="8" />
                                <ContentControl
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Icon}"
                                    FontSize="18"
                                    Foreground="{DynamicResource AfOnAccentBrush}"
                                    Focusable="False"
                                    KeyboardNavigation.IsTabStop="False" />
                            </Grid>

                            <StackPanel x:Name="TitleHost"
                                Grid.Column="1"
                                VerticalAlignment="Center">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock TextWrapping="Wrap"
                                        Style="{StaticResource AfSettingsRowTitleStyle}"
                                        Text="{TemplateBinding Title}" />
                                    <ContentControl
                                        x:Name="RowBadge" Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Badge}"
                                        Style="{StaticResource AfSettingsBadgeNeutralStyle}" />
                                </Grid>
                                <TextBlock
                                    x:Name="RowDescription"
                                    Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                    Text="{TemplateBinding Description}" />
                            </StackPanel>

                            <ContentPresenter
                                x:Name="ControlHost"
                                Grid.Column="2"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCompact" Value="True">
                            <Setter TargetName="TitleHost" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="ControlHost" Property="Grid.Row" Value="1" />
                            <Setter TargetName="ControlHost" Property="Grid.Column" Value="1" />
                            <Setter TargetName="ControlHost" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="ControlHost" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="ControlHost" Property="Margin" Value="0,8,0,0" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconChip" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconChip" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="RowDescription" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Badge" Value="">
                            <Setter TargetName="RowBadge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="BadgeTone" Value="Accent">
                            <Setter TargetName="RowBadge" Property="Style" Value="{StaticResource AfSettingsBadgeAccentStyle}" />
                        </Trigger>
                        <Trigger Property="BadgeTone" Value="Attention">
                            <Setter TargetName="RowBadge" Property="Style" Value="{StaticResource AfSettingsBadgeAttentionStyle}" />
                        </Trigger>
                        <!--
                            嵌套行：更小的图标、左侧缩进到父行标题下方、去掉自己的表面与圆角，只留一条发丝线。
                            因此它读起来属于上方那一行，而不是又一张卡片。
                            A nested row uses a smaller icon, indents under its parent's title, and drops its own
                            surface and radius for a hairline separator, so it reads as belonging to the row above
                            instead of being another card.
                        -->
                        <Trigger Property="IsNested" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <Setter Property="CornerRadius" Value="0" />
                            <Setter Property="Padding" Value="52,12,16,12" />
                            <Setter TargetName="IconChip" Property="Width" Value="26" />
                            <Setter TargetName="IconChip" Property="Height" Value="26" />
                            <Setter TargetName="IconChip" Property="Margin" Value="0,0,12,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ControlHost" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsNested" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                        </MultiTrigger>
                        <!--
                            选中态用 IsKeyboardFocusWithin 而不是 IsKeyboardFocused：点击或拖动行内滑杆时焦点落在滑杆上，
                            行本身并没有获得焦点，用 IsKeyboardFocused 时行的强调色边框不会亮，"点一下滑块"因此看起来没有选中；
                            改成 FocusWithin 后，Tab 与鼠标两条入口亮起的是同一圈边框。
                            The active state keys off IsKeyboardFocusWithin rather than IsKeyboardFocused: clicking or dragging the row's
                            slider puts focus on the slider, not on the row, so with IsKeyboardFocused the row's accent border stayed dark
                            and clicking a slider looked like nothing had been selected; with FocusWithin both the Tab and mouse entries
                            light the same frame.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsNested" Value="False" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource AfAccentBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        可展开分组 / Expander group

        需要多个控件才能表达的设置放进展开器：头部还是「标题 + 说明 + 可选开关」这一行形态，
        展开体是缩进的同构行。缩进的 52 DIP 与嵌套行的左内边距一致，因此展开体里的图标
        正好落在父行标题的左边缘下方。
        Settings that need several controls go into an expander: the header keeps the same title, description, and
        optional switch shape, and the body is indented identical rows. The 52 DIP indent matches the nested
        row's left padding, so the body icons line up under the parent title's left edge.
    -->
    <ControlTemplate x:Key="AfSettingsExpanderIconTemplate" TargetType="{x:Type ContentControl}">
        <Border Width="32" Height="32" Background="{DynamicResource AfAccentBrush}" CornerRadius="8"
                TextElement.Foreground="{DynamicResource AfOnAccentBrush}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="AfSettingsExpanderToggleTemplate" TargetType="{x:Type ToggleButton}">
        <Border x:Name="HeaderSurface" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                <Border Grid.Column="1" Margin="12,0,0,0" Padding="10,6" VerticalAlignment="Center"
                        Background="{DynamicResource AfAccentTintBrush}" BorderBrush="{DynamicResource AfAccentBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ExpandHint" Margin="0,0,8,0" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="{DynamicResource AppTextMediumFontWeight}"
                                   Foreground="{DynamicResource AfAccentBrush}" Text="{DynamicResource Loc.Settings.Expand}" />
                        <ui:SymbolIcon x:Name="ExpandChevron" FontSize="16" Foreground="{DynamicResource AfAccentBrush}"
                                       Symbol="ChevronDown24" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ExpandHint" Property="Text" Value="{DynamicResource Loc.Settings.Collapse}" />
                <Setter TargetName="ExpandChevron" Property="Symbol" Value="ChevronUp24" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="AfSettingsExpanderStyle" TargetType="{x:Type ui:CardExpander}">
        <Setter Property="IsExpanded" Value="False" />
        <Setter Property="Margin" Value="{StaticResource AfSettingsRowGap}" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="Background" Value="{DynamicResource AfSettingsCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource CardForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AfSettingsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ContentPadding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:CardExpander}">
                    <Grid>
<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" components:SettingsHoverShadow.IsEnabled="True" />
                        <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="Transparent">
                        <StackPanel>
                            <ToggleButton x:Name="ExpanderToggleButton" Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Foreground="{TemplateBinding Foreground}" FocusVisualStyle="{DynamicResource AfFocusVisualStyle}"
                                          Cursor="Hand"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource AfSettingsExpanderToggleTemplate}">
                                <ToggleButton.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl x:Name="ControlIcon" Margin="0,0,14,0" VerticalAlignment="Center"
                                                        Content="{TemplateBinding Icon}" FontSize="18" Focusable="False"
                                                        Foreground="{DynamicResource AfOnAccentBrush}"
                                                        Template="{StaticResource AfSettingsExpanderIconTemplate}" />
                                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                          Content="{TemplateBinding Header}" />
                                    </Grid>
                                </ToggleButton.Content>
                            </ToggleButton>
                            <Border x:Name="ExpandedContent" Padding="{TemplateBinding ContentPadding}" Visibility="Collapsed">
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" />
                            </Border>
                        </StackPanel>
                    </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="ControlIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ControlIcon" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!--
            Header 默认按内容宽度排布，于是头部里的开关会紧贴在说明文字后面，而不是贴到卡片右缘。
            拉成 Stretch 后，头部那行才与普通设置行的右列落在同一条竖线上。
            The header lays out at content width by default, which leaves a switch in it hugging the description
            text instead of the card's right edge. Stretching it puts the header row's control on the same vertical
            line as every ordinary settings row.
        -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!--
        分组容器 / Group container

        分组标题带一个主色底片图标，让分组在滚动时也能被一眼认出；分组标题仍然是分组标签条的唯一来源，
        因为标签条读的就是这个 Header。
        The group header carries an accent-tinted icon chip so the group stays recognisable while scrolling.
        The header remains the single source for the group strip, which reads this very Header.
    -->

    <Style TargetType="{x:Type components:SettingsGroup}">
        <Setter Property="Margin" Value="{StaticResource AfSettingsSectionGap}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:SettingsGroup}">
                    <StackPanel>
                        <Border Background="{DynamicResource AfSettingsGroupSurfaceBrush}"
                                BorderBrush="{DynamicResource AfSettingsBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        x:Name="GroupIcon"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        TextElement.Foreground="{DynamicResource AfOnAccentBrush}">
                                        <Border
                                            Background="{DynamicResource AfAccentBrush}"
                                            CornerRadius="10" />
                                        <ContentControl
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Icon}"
                                            FontSize="22"
                                            Foreground="{DynamicResource AfOnAccentBrush}"
                                            Focusable="False"
                                            KeyboardNavigation.IsTabStop="False" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource AfSettingsSectionTitleStyle}"
                                        Text="{TemplateBinding Header}" />

                                    <ContentControl
                                        x:Name="GroupStatus"
                                        Grid.Column="2"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource AfSettingsChipNeutralStyle}"
                                        Content="{TemplateBinding StatusText}" />
                                </Grid>

                                <!--
                                    分组说明：一行白话，用来解释「常驻状态 / 快捷控制 / 完整面板」等名称什么时候生效。
                                    缩进 50 DIP 与分组图标底片及右侧间距同宽，因此说明与标题左对齐起点一致。
                                    The group description: one plain line explaining when a view such as "Always-on view / Quick controls /
                                    Full panel" applies. The 50 DIP indent matches the header icon plate and gap so the description starts
                                    on the same left edge as the title.
                                -->
                                <TextBlock
                                    x:Name="GroupDescription"
                                    Margin="50,6,0,0"
                                    Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                    Text="{TemplateBinding Description}" />

                            </StackPanel>
                        </Border>

                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="GroupIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="GroupDescription" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="StatusText" Value="">
                            <Setter TargetName="GroupStatus" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="StatusTone" Value="Accent">
                            <Setter TargetName="GroupStatus" Property="Style" Value="{StaticResource AfSettingsChipAccentStyle}" />
                        </Trigger>
                        <Trigger Property="StatusTone" Value="Attention">
                            <Setter TargetName="GroupStatus" Property="Style" Value="{StaticResource AfSettingsChipAttentionStyle}" />
                        </Trigger>
                        <!--
                            未实现的分组弱化图标底片而不是整块降低透明度：整块变暗会让其中的文字跌破对比度，
                            而底片的强弱变化已经足够说明“这块还不是正式功能”。
                            A muted group dims its icon plate rather than the whole block, because dimming the block
                            would push its text below the contrast floor, and a weaker plate already reads as
                            "not a shipped feature yet".
                        -->
                        <Trigger Property="Tint" Value="Muted">
                            <Setter TargetName="GroupIcon" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Setter TargetName="GroupStatus" Property="Style" Value="{StaticResource AfSettingsChipNeutralStyle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        分组标签 / Group tab

        悬停只改底色，不位移：标签条会被高频划过，位移在那里只会变成噪声。
        Hover changes only the fill and never moves the tab: the strip is crossed constantly, and movement there
        reads as noise.
    -->

    <Style x:Key="AfSettingsGroupTabStyle" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AfFocusVisualStyle}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="TabBorder"
                        Margin="0,0,2,0"
                        Padding="10,6"
                        Background="Transparent"
                        CornerRadius="6">
                        <TextBlock
                            x:Name="TabText"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter TargetName="TabText" Property="FontWeight" Value="{DynamicResource AppTextStrongFontWeight}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="TabText" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Progress sits between primary and group navigation; the selected group marker stays beneath its label. -->
    <Style TargetType="{x:Type components:SettingsGroupStrip}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type components:SettingsGroupStrip}">
            <Border Background="{DynamicResource AfSettingsSectionBrush}">
                <StackPanel Margin="28,0" MaxWidth="900">
                    <Grid Height="2" Margin="0,2,0,0" Background="{DynamicResource AfSettingsBorderBrush}">
                        <Border x:Name="PART_Progress" Background="{DynamicResource AfAccentBrush}" Opacity="0.65" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="1" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <Grid x:Name="PART_TabContent" MinHeight="40">
                            <ItemsControl x:Name="PART_Tabs" Focusable="False" ItemsSource="{Binding Groups, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Command="{Binding JumpCommand}" CommandParameter="{Binding}" Content="{Binding Name}" Style="{StaticResource AfSettingsGroupTabStyle}" />
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="PART_Indicator" Width="0" Height="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                    Background="{DynamicResource AfAccentBrush}" CornerRadius="1">
                                <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                    <Border x:Name="PART_Divider" Height="1" Background="{DynamicResource AfSettingsBorderBrush}" Opacity="0" />
                </StackPanel>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!--
        说明图宿主 / Diagram host

        页面只声明 Kind，模板由这里按种类选择；页面因此不再引用任何具体的图键，
        改一张图也不会牵动六个页面。
        A page declares only a Kind and the template is selected here, so pages no longer reference diagram
        keys and changing one diagram touches no page.
    -->

    <Style TargetType="{x:Type components:SettingsDiagram}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="LayerRest">
                <Setter Property="Template" Value="{StaticResource AfDiagramLayerRest}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="LayerHover">
                <Setter Property="Template" Value="{StaticResource AfDiagramLayerHover}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="LayerFull">
                <Setter Property="Template" Value="{StaticResource AfDiagramLayerFull}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="TaskbarPlacement">
                <Setter Property="Template" Value="{StaticResource AfDiagramTaskbarPlacement}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="TaskbarLength">
                <Setter Property="Template" Value="{StaticResource AfDiagramTaskbarLength}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="InputGestures">
                <Setter Property="Template" Value="{StaticResource AfDiagramInputGestures}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="WheelGestures">
                <Setter Property="Template" Value="{StaticResource AfDiagramWheelGestures}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="TrayOverflow">
                <Setter Property="Template" Value="{StaticResource AfDiagramTrayOverflow}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="LyricsTwoLine">
                <Setter Property="Template" Value="{StaticResource AfDiagramLyricsTwoLine}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="LyricsAlignment">
                <Setter Property="Template" Value="{StaticResource AfDiagramLyricsAlignment}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="NotificationPlacement">
                <Setter Property="Template" Value="{StaticResource AfDiagramNotificationPlacement}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="Spectrum">
                <Setter Property="Template" Value="{StaticResource AfDiagramSpectrum}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="DynamicIslandSurface">
                <Setter Property="Template" Value="{StaticResource AfDiagramDynamicIslandSurface}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <!-- Slider values are synchronized by the editor so template/range coercion cannot write settings during construction. -->
    <Style TargetType="{x:Type components:SettingsNumericEditor}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="RangeFormat" Value="{DynamicResource Loc.Settings.Numeric.Range}" />
        <Setter Property="InvalidMessage" Value="{DynamicResource Loc.Settings.Numeric.Invalid}" />
        <Setter Property="AdjustedFormat" Value="{DynamicResource Loc.Settings.Numeric.Adjusted}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type components:SettingsRow}}}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type components:SettingsNumericEditor}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Slider x:Name="PART_Slider" Width="120" Style="{StaticResource AfSettingsRowSliderStyle}"
                        AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" />
                <TextBox x:Name="PART_Input" Grid.Column="1" Width="72" Margin="8,0,0,0" Padding="6,4"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                         Background="{DynamicResource AfSettingsInputBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         ToolTip="{TemplateBinding HelpText}" AutomationProperties.HelpText="{TemplateBinding HelpText}"
                         AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" />
                <TextBlock Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{TemplateBinding Unit}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasInputError" Value="True"><Setter TargetName="PART_Input" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

</ResourceDictionary>
