<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        设置页矢量说明图 / Settings vector diagrams

        每张图都紧挨着它所解释的控件，并且自带唯一一句说明；页面不再需要另写一条说明来解释同一件事。
        所有颜色都取自主题画刷，因此浅色、深色、高对比度和系统主色变化都不需要额外处理。

        Every diagram sits next to the control it explains and carries exactly one caption, so a page never has
        to repeat the same explanation elsewhere. Every colour comes from a theme brush, so light, dark, high
        contrast, and accent changes need no extra handling.

        带 Tag="demo-pulse" 或 Tag="demo-nudge-y" 的元素由 SettingsDiagram 驱动循环演示，
        且只在图可见、窗口处于前台时运行。
        Elements tagged demo-pulse or demo-nudge-y are animated by SettingsDiagram, and only while the diagram
        is visible and its window is in the foreground.
    -->

    <Style x:Key="AfDiagramLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  图的唯一一句说明，统一放在分隔线下方。  -->
    <!--  The diagram's single caption, always below the divider.  -->
    <Style x:Key="AfDiagramCaptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="AfDiagramSurfaceStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!--  1. 静置层 / Rest layer  -->
    <ControlTemplate x:Key="AfDiagramLayerRest">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="22"
                        Height="22"
                        Background="{DynamicResource AfAccentBrush}"
                        CornerRadius="5"
                        Opacity="0.8" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                        <Border
                            Width="88"
                            Height="6"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource TextFillColorSecondaryBrush}"
                            CornerRadius="3"
                            Opacity="0.8" />
                        <Border
                            Width="58"
                            Height="4"
                            Margin="0,5,0,0"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="2" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            Width="3"
                            Height="10"
                            Tag="demo-pulse"
                            Background="{DynamicResource AfAccentBrush}"
                            CornerRadius="1" />
                        <Border
                            Width="3"
                            Height="18"
                            Margin="3,0,0,0"
                            Tag="demo-pulse"
                            Background="{DynamicResource AfAccentBrush}"
                            CornerRadius="1" />
                        <Border
                            Width="3"
                            Height="13"
                            Margin="3,0,0,0"
                            Tag="demo-pulse"
                            Background="{DynamicResource AfAccentBrush}"
                            CornerRadius="1" />
                        <Border
                            Width="3"
                            Height="7"
                            Margin="3,0,0,0"
                            Tag="demo-pulse"
                            Background="{DynamicResource AfAccentBrush}"
                            CornerRadius="1" />
                        <Border
                            Width="26"
                            Height="12"
                            Margin="10,0,0,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="3" />
                    </StackPanel>
                </Grid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="{DynamicResource Loc.Diagram.LayerRest.Caption}" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  2. 悬停层 / Hover layer  -->
    <ControlTemplate x:Key="AfDiagramLayerHover">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Border
                        Width="22"
                        Height="22"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="11" />
                    <Border
                        Width="22"
                        Height="22"
                        Margin="6,0,0,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="11" />
                    <Border
                        Width="22"
                        Height="22"
                        Margin="6,0,0,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="11" />
                    <Border
                        Width="22"
                        Height="22"
                        Margin="6,0,0,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="11" />
                    <Border
                        Width="22"
                        Height="22"
                        Margin="6,0,0,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="11" />
                    <Border
                        Width="74"
                        Height="22"
                        Margin="12,0,0,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="11" />
                    <Border
                        Width="12"
                        Height="12"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AfAccentBrush}"
                        CornerRadius="6" />
                </StackPanel>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="{DynamicResource Loc.Diagram.LayerHover.Caption}" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  3. 完整层 / Full layer  -->
    <ControlTemplate x:Key="AfDiagramLayerFull">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <UniformGrid Columns="4">
                    <Border
                        Margin="0,0,6,0"
                        Padding="0,9"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="{DynamicResource Loc.Diagram.LayerFull.Label.MediaInfo}" />
                    </Border>
                    <Border
                        Margin="0,0,6,0"
                        Padding="0,9"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="{DynamicResource Loc.Diagram.LayerFull.Label.Playback}" />
                    </Border>
                    <Border
                        Margin="0,0,6,0"
                        Padding="0,9"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="{DynamicResource Loc.Common.AudioControl}" />
                    </Border>
                    <Border
                        Padding="0,9"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="{DynamicResource Loc.Diagram.LayerFull.Label.Performance}" />
                    </Border>
                </UniformGrid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="{DynamicResource Loc.Diagram.LayerFull.Caption}" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  4. 任务栏位置与避让 / Taskbar placement and avoidance  -->
    <ControlTemplate x:Key="AfDiagramTaskbarPlacement">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <Border
                            Width="11"
                            Height="11"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="2" />
                        <Border
                            Width="11"
                            Height="11"
                            Margin="6,0,0,0"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="2" />
                        <Border
                            Width="11"
                            Height="11"
                            Margin="6,0,0,0"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="2" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Symbol="ArrowLeft24" />
                        <Border
                            Width="150"
                            Height="22"
                            Background="{DynamicResource AfAccentBrush}"
                            CornerRadius="4"
                            Opacity="0.8" />
                        <ui:SymbolIcon
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Symbol="ArrowRight24" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Grid Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="{DynamicResource Loc.Diagram.TaskbarPlacement.Label.TaskbarIcons}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="{DynamicResource Loc.Diagram.TaskbarPlacement.Label.EdgeOffset}" />
                </Grid>

                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="{DynamicResource Loc.Diagram.TaskbarPlacement.Caption}" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  5. 媒体栏长度 / Media bar length  -->
    <ControlTemplate x:Key="AfDiagramTaskbarLength">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid Height="26">
                    <Border
                        Height="10"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="5" />
                    <Border
                        Height="10"
                        Margin="72,0,64,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AfAccentBrush}"
                        CornerRadius="5"
                        Opacity="0.85" />
                    <Border
                        Width="2"
                        Height="26"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource TextFillColorTertiaryBrush}"
                        CornerRadius="1" />
                    <Border
                        Width="2"
                        Height="26"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource TextFillColorTertiaryBrush}"
                        CornerRadius="1" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="{DynamicResource Loc.Diagram.TaskbarLength.Label.MinimumWidth}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="{DynamicResource Loc.Diagram.TaskbarLength.Label.TaskbarLimit}" />
                </Grid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="{DynamicResource Loc.Diagram.TaskbarLength.Caption}" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  6. 静置层点击区域 / Click zones on the rest layer  -->
    <ControlTemplate x:Key="AfDiagramInputGestures">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="22"
                        Height="22"
                        Background="{DynamicResource AfAccentBrush}"
                        CornerRadius="5"
                        Opacity="0.8" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="{DynamicResource Loc.Diagram.InputGestures.Label.ArtworkClick}" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <Border
                            Width="88"
                            Height="6"
                            Background="{DynamicResource TextFillColorSecondaryBrush}"
                            CornerRadius="3"
                            Opacity="0.8" />
                        <Border
                            Width="56"
                            Height="4"
                            Margin="0,5,0,0"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="2" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="{DynamicResource Loc.Diagram.InputGestures.Label.TextClick}" />
                </Grid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="{DynamicResource Loc.Diagram.InputGestures.Caption}" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  7. 滚轮方向 / Wheel direction per surface  -->
    <ControlTemplate x:Key="AfDiagramWheelGestures">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="{DynamicResource Loc.Diagram.WheelGestures.Label.MediaBar}" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Tag="demo-nudge-y"
                            FontSize="13"
                            Symbol="ArrowUp24" />
                        <ui:SymbolIcon
                            Margin="6,0,0,0"
                            FontSize="13"
                            Symbol="ArrowDown24" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="{DynamicResource Loc.Diagram.WheelGestures.Label.MediaBarResults}" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="{DynamicResource Loc.Common.TrayIcon}" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Tag="demo-nudge-y"
                            FontSize="13"
                            Symbol="ArrowUp24" />
                        <ui:SymbolIcon
                            Margin="6,0,0,0"
                            FontSize="13"
                            Symbol="ArrowDown24" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="{DynamicResource Loc.Diagram.WheelGestures.Label.TrayResults}" />
                </Grid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="{DynamicResource Loc.Diagram.WheelGestures.Caption}" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  8. 托盘溢出区 / Tray overflow  -->
    <ControlTemplate x:Key="AfDiagramTrayOverflow">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="{DynamicResource Loc.Diagram.TrayOverflow.Label.TrayArea}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="{DynamicResource Loc.Diagram.TrayOverflow.Label.OverflowArrow}" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Border
                        Height="28"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4" />
                    <StackPanel
                        Margin="10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="12" Symbol="ChevronUp24" />
                        <Border
                            Width="13"
                            Height="13"
                            Margin="12,0,0,0"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="3" />
                        <Border
                            Width="13"
                            Height="13"
                            Margin="6,0,0,0"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="3" />
                        <Border
                            Width="13"
                            Height="13"
                            Margin="6,0,0,0"
                            Background="{DynamicResource AfAccentBrush}"
                            CornerRadius="3" />
                    </StackPanel>
                </Grid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="{DynamicResource Loc.Diagram.TrayOverflow.Caption}" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  9. 双行歌词 / Two lyric lines  -->
    <ControlTemplate x:Key="AfDiagramLyricsTwoLine">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        MinWidth="42"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="{DynamicResource Loc.Diagram.LyricsTwoLine.Label.FirstLine}" />
                    <Border
                        Grid.Column="1"
                        Width="150"
                        Height="7"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource TextFillColorSecondaryBrush}"
                        CornerRadius="3" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        MinWidth="42"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="{DynamicResource Loc.Diagram.LyricsTwoLine.Label.SecondLine}" />
                    <Border
                        Grid.Column="1"
                        Width="104"
                        Height="5"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{DynamicResource TextFillColorTertiaryBrush}"
                        CornerRadius="3" />
                </Grid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="{DynamicResource Loc.Diagram.LyricsTwoLine.Caption}" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  10. 歌词对齐 / Lyric alignment  -->
    <ControlTemplate x:Key="AfDiagramLyricsAlignment">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Left">
                        <Border
                            Width="3"
                            Height="14"
                            Background="{DynamicResource AfAccentBrush}"
                            CornerRadius="1" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="{DynamicResource Loc.Common.AlignLeft}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center">
                        <Border
                            Width="3"
                            Height="14"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="1" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="{DynamicResource Loc.Common.AlignCenter}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right">
                        <Border
                            Width="3"
                            Height="14"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="1" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="{DynamicResource Loc.Common.AlignRight}" />
                    </StackPanel>
                </Grid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="{DynamicResource Loc.Diagram.LyricsAlignment.Caption}" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  11. 通知锚点 / Notification anchors  -->
    <ControlTemplate x:Key="AfDiagramNotificationPlacement">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="150" Height="72">
                        <Border
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4" />
                        <Border
                            Width="34"
                            Height="18"
                            Margin="0,7,7,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AfAccentBrush}"
                            CornerRadius="3"
                            Opacity="0.9" />
                        <Ellipse
                            Width="5"
                            Height="5"
                            Margin="9,10,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Ellipse
                            Width="5"
                            Height="5"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Ellipse
                            Width="5"
                            Height="5"
                            Margin="9,0,0,10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Ellipse
                            Width="5"
                            Height="5"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Border
                            Height="10"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="0,0,4,4"
                            Opacity="0.35" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="{DynamicResource Loc.Diagram.NotificationPlacement.Label.InsideMonitor}" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="{DynamicResource Loc.Diagram.NotificationPlacement.Label.AvoidTaskbar}" />
                    </StackPanel>
                </Grid>
                <Border
