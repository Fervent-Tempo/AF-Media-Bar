<Application
  x:Class="AFMediaBar.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  DispatcherUnhandledException="OnDispatcherUnhandledException"
  Exit="OnExit"
  Startup="OnStartup"
>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="AppTextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
      <FontWeight x:Key="AppTextFontWeight">Normal</FontWeight>
      <FontWeight x:Key="AppTextMediumFontWeight">Medium</FontWeight>
      <FontWeight x:Key="AppTextStrongFontWeight">SemiBold</FontWeight>
      <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
      <SolidColorBrush x:Key="AppMenuBackgroundBrush" Color="#FFF9F9F9" />
      <Style TargetType="{x:Type Page}">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppTextFontFamily}" />
        <Setter Property="TextElement.FontWeight" Value="{DynamicResource AppTextFontWeight}" />
      </Style>
      <Style BasedOn="{StaticResource UiContextMenu}" TargetType="{x:Type ContextMenu}">
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Popup.PopupAnimation" Value="None" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ContextMenu}">
              <Border
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8"
                SnapsToDevicePixels="True">
                <StackPanel
                  ClipToBounds="True"
                  IsItemsHost="True"
                  KeyboardNavigation.DirectionalNavigation="Cycle" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- Keep WPF-UI menu visuals while making the complete item row hit-testable. -->
      <Style x:Key="AfMenuItemStyle"
             BasedOn="{StaticResource WpfUiMenuItem}"
             TargetType="{x:Type ui:MenuItem}">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style BasedOn="{StaticResource AfMenuItemStyle}"
             TargetType="{x:Type ui:MenuItem}" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
