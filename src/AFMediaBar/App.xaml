<Application
  x:Class="AFMediaBar.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  DispatcherUnhandledException="OnDispatcherUnhandledException"
  Exit="OnExit"
  Startup="OnStartup"
>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="/AFMediaBar;component/Resources/MotionResources.xaml" />
        <ResourceDictionary Source="/AFMediaBar;component/Resources/SettingsAppearanceResources.xaml" />
        <ResourceDictionary Source="/AFMediaBar;component/Resources/SettingsDiagrams.xaml" />
        <!--
          结构组件字典自己也会合并上面两个字典，因为 ResourceDictionary 解析时看不到这里：
          它只能看到自己声明的合并项。同一个 Source 由 WPF 缓存复用，因此重复合并不会重复解析。
          The component dictionary also merges the two above, because a ResourceDictionary cannot see this
          list while it is parsed and can only resolve what it merges itself. WPF caches by Source, so the
          repeated merge reuses one instance rather than parsing twice.
        -->
        <ResourceDictionary Source="/AFMediaBar;component/Resources/SettingsComponentResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="AppTextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
      <!--
        布尔到可见性的应用级转换器：更新区、便携版提示等"只在某些状态下出现"的行都用它，
        因此这些行不需要各自写代码切换 Visibility。
        Application-level boolean-to-visibility converter used by rows that only appear in certain states, such as
        the update section and the portable-build notice, so none of them needs code to toggle Visibility.
      -->
      <BooleanToVisibilityConverter x:Key="AfBooleanToVisibilityConverter" />
      <FontFamily x:Key="AppIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
      <FontWeight x:Key="AppTextFontWeight">Normal</FontWeight>
      <FontWeight x:Key="AppTextMediumFontWeight">Medium</FontWeight>
      <FontWeight x:Key="AppTextStrongFontWeight">SemiBold</FontWeight>
      <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
      <SolidColorBrush x:Key="AppMenuBackgroundBrush" Color="#FFF9F9F9" />
      <Style TargetType="{x:Type Page}">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppTextFontFamily}" />
        <Setter Property="TextElement.FontWeight" Value="{DynamicResource AppTextFontWeight}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      </Style>
      <Style BasedOn="{StaticResource UiContextMenu}" TargetType="{x:Type ContextMenu}">
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Popup.PopupAnimation" Value="None" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ContextMenu}">
              <Border
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8"
                SnapsToDevicePixels="True">
                <StackPanel
                  ClipToBounds="True"
                  IsItemsHost="True"
                  KeyboardNavigation.DirectionalNavigation="Cycle" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Keep WPF-UI menu visuals while making the complete item row hit-testable. -->
      <Style x:Key="AfMenuItemStyle"
             BasedOn="{StaticResource WpfUiMenuItem}"
             TargetType="{x:Type ui:MenuItem}">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style BasedOn="{StaticResource AfMenuItemStyle}"
             TargetType="{x:Type ui:MenuItem}" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
