<UserControl x:Class="AFMediaBar.Components.Wpf.BuiltIn.PlaybackCommand.PlaybackCommandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AFMediaBar.Components.Wpf.Controls">
  <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Command="{Binding InvokeCommand}"
          CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
          IsEnabled="{Binding IsEnabled}"
          ToolTip="{Binding ToolTip}"
          Style="{DynamicResource TransportButtonStyle}">
    <controls:CenteredIconGlyph Width="16" Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource AppIconFontFamily}"
                                FontSize="14"
                                Glyph="{Binding Glyph}" />
  </Button>
</UserControl>
