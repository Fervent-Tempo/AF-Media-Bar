<UserControl x:Class="AFMediaBar.Components.Wpf.BuiltIn.Metrics.MetricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button Width="74" Height="24" Padding="8,0" BorderThickness="0"
          Background="{DynamicResource TaskbarHoverBrush}"
          Command="{Binding OpenTaskManagerCommand}"
          IsEnabled="{Binding IsEnabled}"
          IsHitTestVisible="{Binding Settings.OpenTaskManagerOnClick}">
    <TextBlock Text="{Binding Text}" FontSize="11"
               FontFamily="{DynamicResource AppTextFontFamily}"
               Foreground="{DynamicResource TaskbarSecondaryTextBrush}"
               TextTrimming="CharacterEllipsis" />
  </Button>
</UserControl>
