<UserControl x:Class="AFMediaBar.Components.Wpf.BuiltIn.Spectrum.SpectrumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AFMediaBar.Components.Wpf.BuiltIn.Spectrum">
  <local:SpectrumBars Values="{Binding Values}"
                      BandCount="{Binding Settings.BandCount}"
                      RefreshRateHz="{Binding Settings.RefreshRateHz}"
                      SensitivityPercent="{Binding Settings.SensitivityPercent}"
                      BarBrush="{DynamicResource TaskbarSecondaryTextBrush}" />
</UserControl>
