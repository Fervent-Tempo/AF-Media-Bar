<UserControl x:Class="AFMediaBar.Components.Wpf.BuiltIn.Separator.SeparatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True" Margin="8,0">
  <Border Background="{DynamicResource MenuSeparatorBrush}"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Width" Value="{Binding LengthDip}" />
        <Setter Property="Height" Value="{Binding ThicknessDip}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsVertical}" Value="True">
            <Setter Property="Width" Value="{Binding ThicknessDip}" />
            <Setter Property="Height" Value="{Binding LengthDip}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
  </Border>
</UserControl>
