<UserControl x:Class="AFMediaBar.Components.Wpf.BuiltIn.MediaSource.MediaSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button Width="{Binding WidthDip}" Padding="0" Background="Transparent" BorderThickness="0"
          IsEnabled="{Binding IsEnabled}"
          Command="{Binding SelectSourceCommand}"
          CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
    <TextBlock Text="{Binding SourceName}" FontSize="{Binding FontSizeDip}"
               FontFamily="{DynamicResource AppTextFontFamily}"
               Foreground="{DynamicResource TaskbarSecondaryTextBrush}"
               TextAlignment="Center" TextTrimming="CharacterEllipsis" />
  </Button>
</UserControl>
