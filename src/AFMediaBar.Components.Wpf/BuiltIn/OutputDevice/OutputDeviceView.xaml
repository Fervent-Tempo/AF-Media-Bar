<UserControl x:Class="AFMediaBar.Components.Wpf.BuiltIn.OutputDevice.OutputDeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AFMediaBar.Components.Wpf.Controls">
  <Button x:Name="DeviceButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Command="{Binding SelectCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
          IsEnabled="{Binding IsEnabled}"
          PreviewMouseWheel="DeviceButton_OnPreviewMouseWheel"
          Style="{DynamicResource TransportButtonStyle}"
          ToolTip="{Binding DeviceName}">
    <controls:CenteredIconGlyph Width="16" Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource AppIconFontFamily}"
                                FontSize="14"
                                Glyph="&#xE7F5;" />
  </Button>
</UserControl>
