<UserControl x:Class="AFMediaBar.Components.Wpf.BuiltIn.Artwork.ArtworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button Width="40" Height="40" Padding="0"
          Command="{Binding OpenSourceCommand}"
          CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
          IsHitTestVisible="{Binding Settings.OpenSourceOnClick}">
    <Button.Template>
      <ControlTemplate TargetType="Button">
        <Border Background="{Binding Background}"
                CornerRadius="{Binding CornerRadiusDip}">
          <Grid ClipToBounds="True">
            <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource AppIconFontFamily}" FontSize="18"
                       Foreground="{DynamicResource TaskbarSecondaryTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Button.Template>
  </Button>
</UserControl>
