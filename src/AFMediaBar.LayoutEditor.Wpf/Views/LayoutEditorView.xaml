<UserControl x:Class="AFMediaBar.LayoutEditor.Wpf.Views.LayoutEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AFMediaBar.LayoutEditor.Wpf.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="8" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="280" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Padding="8" BorderThickness="1">
      <views:LayoutTreeView />
    </Border>
    <ContentControl Grid.Column="2" Content="{Binding PreviewContent}" />
    <Border Grid.Column="4" Padding="8" BorderThickness="1">
      <views:LayoutInspectorView />
    </Border>
    <Border Grid.Row="2" Grid.ColumnSpan="5" Padding="8" BorderThickness="1">
      <views:ComponentPaletteView />
    </Border>
  </Grid>
</UserControl>
