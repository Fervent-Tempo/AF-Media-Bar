<UserControl x:Class="AFMediaBar.LayoutEditor.Wpf.Views.LayoutTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AFMediaBar.LayoutEditor.Wpf.ViewModels">
  <TreeView ItemsSource="{Binding Roots}"
            SelectedItemChanged="Tree_OnSelectedItemChanged"
            Background="Transparent"
            BorderThickness="0">
    <TreeView.Resources>
      <HierarchicalDataTemplate DataType="{x:Type vm:LayoutTreeItemViewModel}"
                                ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding InstanceId}">
          <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
          <TextBlock Margin="6,0,0,0" Opacity="0.55" FontSize="10"
                     Text="{Binding InstanceId}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </HierarchicalDataTemplate>
    </TreeView.Resources>
    <TreeView.ItemContainerStyle>
      <Style TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
      </Style>
    </TreeView.ItemContainerStyle>
  </TreeView>
</UserControl>
