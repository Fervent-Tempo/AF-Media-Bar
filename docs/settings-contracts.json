  "rules": [
    {
      "id": "spectrum-device-target",
      "paths": ["settings.spectrumComponent.captureSource", "settings.spectrumComponent.captureDeviceId", "settings.spectrumComponent.captureDeviceMode", "settings.spectrumComponent.captureDeviceName"],
      "text": "设备策略缺失、null 或无效时按 ID 回退：为空跟随媒体来源，否则固定所存端点。显式策略分别跟随媒体实际输出、系统默认输出（Console）或指定端点；跟随媒体无法匹配时沿用 Multimedia 默认端点回退，指定端点离线保留配置并暂停采集。非指定策略保留设备标识但不用于选择；程序采集范围忽略设备策略与标识。"
    },
    {
      "id": "full-panel-entry-only",
      "paths": ["settings.taskbarExperience.fullLayerEnabled", "settings.taskbarExperience.fullPanelEntryVisible"],
      "text": "完整面板始终允许交互打开；FullLayerEnabled 仅保留已发布字段兼容，归一化时与 FullPanelEntryVisible 合并为入口可见性并恢复为 true。入口关闭只隐藏外侧横杆，不关闭完整面板。"
    },
    {
      "id": "input-shapes",
      "always": true,
      "text": "默认值、缺字段和显式 null 可能不同；修改时核对实际反序列化、Normalize 和相关测试，不从发布标记推定读取行为。"
    },
    {
      "id": "reset-defaults",
      "always": true,
      "text": "重置优先使用有效用户默认快照，否则取内置值；ResetAll 保留当前 TranslucentTB 已提示标记。重置范围按实际调用方核对。"
    },
    {
      "id": "enum-input",
      "whenEnum": true,
      "text": "JSON 无效枚举先按对应类型的读取规则回退再归一化，可能不同于代码直接传入未定义值。成员发布状态独立于父字段。"
    },
    {
      "id": "taskbar-reset",
      "prefixes": ["settings.taskbarExperience"],
      "text": "ResetContentLayout 恢复任务栏体验但保留媒体字号及频谱、性能显隐；字号由 ResetTaskbarAppearance 恢复，小组件显隐由 ResetComponents 恢复。旧 ResetDisplayModes 仍会恢复组件显隐等，不等于当前页面重置；两者均保留交互中的封面悬停模式。"
    },
    {
      "id": "artwork-progress",
      "paths": ["settings.taskbarExperience.artworkProgressVisible", "settings.taskbarExperience.hoverControls.progressVisible"],
      "text": "封面边缘进度默认开启，缺字段回开启；显式关闭保持。旧悬停进度字段仅保留读写，不再呈现或预留宽度，不映射到新开关。静置文字进度独立；内容布局重置优先用户快照，schema 不变。",
      "relatedPaths": ["settings.taskbarExperience.restProgressVisible"]
    },
    {
      "id": "artwork-hover",
      "paths": ["settings.interaction.artworkHoverMode"],
      "text": "Off 仍有栏内1.1×，Zoom 为2×，Preview 为独立预览。模式存储在 interaction，由交互页提供选项并重置；封面显隐仍归任务栏内容。未发布的开发旧路径不迁移，缺字段回 Off。",
      "relatedPaths": ["settings.taskbarExperience.artworkVisible"]
    },
    {
      "id": "arrangement",
      "paths": ["settings.taskbarExperience.arrangement", "settings.floatingBar.profile.arrangement"],
      "text": "null 时 position=End 解析为 Right，其余为 Left；显式值优先。",
      "relatedPaths": ["settings.position"]
    },
    {
      "id": "full-panel",
      "prefixes": ["settings.taskbarExperience.fullPanel"],
      "text": "四项全关时回 Compact：媒体信息和控制开启，音频与性能关闭；不可只孤立判断一个开关。",
      "relatedPaths": ["settings.taskbarExperience.fullPanel.mediaInfoVisible", "settings.taskbarExperience.fullPanel.mediaControlsVisible", "settings.taskbarExperience.fullPanel.audioControlsVisible", "settings.taskbarExperience.fullPanel.performanceVisible"]
    },
    {
      "id": "rest-order",
      "paths": ["settings.taskbarExperience.restComponentOrder"],
      "text": "null 用默认顺序；封面和媒体文字固定在前，只排序尾部。遗漏的已知尾部会补全，因此空数组不表示隐藏组件。"
    },
    {
      "id": "idle-components",
      "paths": ["settings.taskbarExperience.idleComponents"],
      "text": "null 默认只留 Artwork（无媒体时指快速启动音符）；空数组全部隐藏；显式列表控制无媒体保留项。封面显隐不能替代它。",
      "relatedPaths": ["settings.taskbarExperience.artworkVisible"]
    },
    {
      "id": "font-family",
      "prefixes": ["settings.appearance.latinFont", "settings.appearance.cjkFont"],
      "text": "family=null 保留旧字体预设，空串跟随系统；派生的 SelectedFontFamily 不序列化。具体校验和范围查源码。",
      "relatedPaths": ["settings.appearance.latinFont", "settings.appearance.latinFontFamily", "settings.appearance.cjkFont", "settings.appearance.cjkFontFamily"]
    },
    {
      "id": "appearance-reset",
      "prefixes": ["settings.appearance", "settings.taskbarSurface", "settings.dynamicIslandSurface"],
      "text": "应用外观重置保留媒体文字色和任务栏背景；任务栏外观重置保留全局主题字体。旧 ResetAppearance 还覆盖布局，须核对实际调用方。"
    },
    {
      "id": "lyrics-reset",
      "prefixes": ["settings.lyrics"],
      "paths": ["settings.allowBrowserAndVideoLyrics", "settings.twoLineLyricsEnabled"],
      "text": "ResetLyrics 保留歌词对齐与固定宽度，它们归内容布局重置；简繁、来源、分隔符等仍归歌词重置。"
    },
    {
      "id": "lyrics-sources",
      "prefixes": ["settings.lyricsSource"],
      "text": "null 全启用，空数组全关；保存未知ID，使用时忽略。按Ordinal去重；enabledSourceIds仅控制启用集合，手动规则使用独立prioritySourceIds排序，默认规则不使用手动调度选项。ID为Netease、NeteaseSearch、LRCLIB、QQMusic、Kugou、SodaMusic。"
    },
    {
      "id": "secondary-line",
      "prefixes": ["settings.lyricsSecondaryLine"],
      "text": "order=null 使用下一句→翻译→音译；空数组关闭；显式列表保留优先级。JSON非法项先受枚举回退影响。"
    },
    {
      "id": "artist-separators",
      "paths": ["settings.lyricsArtistSeparators"],
      "text": "存储保留空白和换行；null由setter变为空串，空串关闭分割。"
    },
    {
      "id": "interaction",
      "prefixes": ["settings.interaction"],
      "text": "ResetInteraction 恢复整段。托盘点击仅接受模型白名单，其他已定义旧值也可回默认；两个滚轮字段不要用根级旧字段代替。"
    },
    {
      "id": "source-filter",
      "prefixes": ["settings.smtcSourceFilter"],
      "text": "enabled=false 不过滤；true且空列表不允许任何来源。列表Trim、忽略大小写去重并排序，使用时归一化媒体别名。",
      "relatedPaths": ["settings.smtcSourceFilter.enabled", "settings.smtcSourceFilter.allowedSourceIds"]
    },
    {
      "id": "quick-launch",
      "prefixes": ["settings.quickLaunch"],
      "text": "小组件页 ResetComponents 恢复快速启动配置，ResetExtraFeatures 保留；快速启动缺少新字段时保持列表启动；悬停应用图标默认开启但仅选择后启动模式使用。选中 ID 无效时回退第一项，空列表没有目标。条目是列表模板，不能当作默认配置；无效目标/Kind 被过滤，空 Id 会生成标识。JSON 非法枚举输入和代码直接传值的回退可能不同，修改时核对真实读取链。"
    },
    {
      "id": "media-source-id",
      "paths": ["settings.smtcSourceFilter.allowedSourceIds", "settings.quickLaunch.entries[].sourceId", "settings.mediaSelection.preferredSourceId"],
      "text": "媒体ID是开放的SMTC集合。网易云SourceId=cloudmusic、选择键source:cloudmusic；cloudmusic/netease/163music别名不区分大小写，与歌词来源ID不是同一契约。"
    },
    {
      "id": "components",
      "prefixes": ["settings.spectrumComponent", "settings.performanceComponent"],
      "text": "小组件页 ResetComponents 恢复频谱、性能、蓝牙电量参数及显隐；ResetContentLayout 和 ResetDeviceManagement 保留这些设置。性能 metrics 空或全无效回 SystemMemory；metricOrder 只决定已选指标顺序，缺失或 null 沿用原顺序。枚举新增成员的发布状态独立核对。"
    },
    {
      "id": "startup",
      "paths": ["settings.launchAtStartup"],
      "text": "启动先读实际注册/Windows禁用状态同步；未知时保留意图。只有用户主动开启才允许解除禁用，失败回实际状态或上次值。"
    },
    {
      "id": "translucent-tb",
      "paths": ["settings.translucentTbCompatibilityPromptShown", "settings.appearance.taskbarBackgroundMaterial"],
      "text": "检测到TranslucentTB且未提示时可开启磨砂、先标记落盘再提示；ResetAll保留当前提示标记，用户默认快照不能重新触发。",
      "relatedPaths": ["settings.translucentTbCompatibilityPromptShown", "settings.appearance.taskbarBackgroundMaterial"]
    },
    {
      "id": "monitor-targets",
      "prefixes": ["settings.taskbarTargetMonitorDeviceId"],
      "text": "列表为空且旧普通单目标非空时迁入列表并清旧字段；旧单目标AllTaskbars保留全部当前目标语义。离线ID保留，全部离线时临时回主屏。",
      "relatedPaths": ["settings.taskbarTargetMonitorDeviceIds", "settings.taskbarTargetMonitorDeviceId"]
    },
    {
      "id": "placement-reset",
      "prefixes": ["settings.taskbarBar", "settings.taskbarTargetMonitorDeviceId", "settings.dynamicIsland"],
      "paths": ["settings.position", "settings.windowMode", "settings.layoutOrientationMode", "settings.layoutLengthScalePercent", "settings.layoutThicknessScalePercent"],
      "text": "新ResetScreenAndPlacement仅恢复目标、位置、padding、跨轴偏移、避让、锁定；比例、模式、barEnabled等旧字段须核对旧ResetLayout/DisplayModes，不能按页名推定。"
    },
    {
      "id": "legacy-geometry-null",
      "paths": ["settings.layoutLengthScalePercent", "settings.layoutThicknessScalePercent", "settings.taskbarBarCrossAxisOffsetDip", "settings.dynamicIslandLeft", "settings.dynamicIslandTop"],
      "text": "五项旧null预处理只识别标准camelCase envelope；大写SETTINGS下非可空几何null仍可导致读取失败。"
    },
    {
      "id": "retained-mode",
      "prefixes": ["settings.dynamicIsland"],
      "paths": ["settings.windowMode"],
      "text": "桌面悬浮标识仅在对应实验开启时生效；实验关闭和旧灵动岛标识归一化为Taskbar。横竖任务栏共享原配置，悬浮配置首次复制后独立保存。"
    },
    {
      "id": "retained-fields",
      "paths": ["settings.trayWheelBehavior", "settings.appearance.enhancedReadability", "settings.taskbarBarBackgroundBlur"],
      "text": "这些旧字段仍写入文件。EnhancedReadability无呈现效果；托盘使用interaction映射，未通用转接根滚轮字段；删除前仍按发布证据判断。"
    },
    {
      "id": "removed-strictness",
      "paths": ["settings.lyricsMatchStrictness"],
      "text": "这是发布过后移除的字段，不是未发布项；当前按未知键忽略，保存时不写回，也没有旧值转接。"
    }
  ]
}
