{
  "formatVersion": 1,
  "groups": [
    { "id": "appearance", "title": "外观与基础表面", "prefixes": ["settings.appearance", "settings.taskbarSurface", "settings.dynamicIslandSurface"] },
    { "id": "taskbar", "title": "任务栏内容与布局", "prefixes": ["settings.taskbarExperience"] },
    { "id": "lyrics", "title": "歌词", "prefixes": ["settings.lyrics"], "paths": ["settings.allowBrowserAndVideoLyrics", "settings.twoLineLyricsEnabled"] },
    { "id": "interaction", "title": "交互与托盘", "prefixes": ["settings.interaction"], "paths": ["settings.trayWheelBehavior"] },
    { "id": "media", "title": "媒体、通知与快速启动", "prefixes": ["settings.smtcSourceFilter", "settings.trackChangeNotification", "settings.quickLaunch"] },
    { "id": "components", "title": "频谱与性能", "prefixes": ["settings.spectrumComponent", "settings.performanceComponent"] },
    { "id": "application", "title": "应用、更新与启动状态", "prefixes": ["settings.update"], "paths": ["settings.launchAtStartup", "settings.interfaceLanguage", "settings.translucentTbCompatibilityPromptShown"] },
    { "id": "placement", "title": "显示目标与旧定位字段", "prefixes": ["settings.taskbarTargetMonitorDeviceId", "settings.taskbarBar", "settings.dynamicIsland"], "excludePrefixes": ["settings.dynamicIslandSurface"], "paths": ["settings.position", "settings.windowMode", "settings.layoutOrientationMode", "settings.layoutLengthScalePercent", "settings.layoutThicknessScalePercent"] }
  ],
  "rules": [
    { "id": "input-shapes", "always": true, "text": "内置默认、缺字段、显式 null 不同；缺字段结果以父对象仍存在的实际读取为准。列表条目使用固定示例，不是默认配置。" },
    { "id": "reset-defaults", "always": true, "text": "重置优先使用有效用户默认快照，否则取内置值；查询default列是内置默认。ResetAll保留当前TranslucentTB已提示标记。" },
    { "id": "enum-input", "whenEnum": true, "text": "JSON 无效枚举先变成类型回退值再归一化，可能不同于代码直接传入未定义值。成员发布状态独立于父字段。" },
    { "id": "taskbar-reset", "prefixes": ["settings.taskbarExperience"], "text": "ResetContentLayout 恢复任务栏体验但保留媒体字号；字号由 ResetTaskbarAppearance 恢复。旧 ResetDisplayModes 仍会恢复组件显隐等，不等于当前页面重置；两者均保留交互中的封面悬停模式。" },
    { "id": "artwork-hover", "paths": ["settings.interaction.artworkHoverMode"], "text": "Off 仍有栏内1.1×，Zoom 为2×，Preview 为独立预览。模式存储在 interaction，由交互页提供选项并重置；封面显隐仍归任务栏内容。未发布的开发旧路径不迁移，缺字段回 Off。", "relatedPaths": ["settings.taskbarExperience.artworkVisible"] },
    { "id": "arrangement", "paths": ["settings.taskbarExperience.arrangement"], "text": "null 时 position=End 解析为 Right，其余为 Left；显式值优先。", "relatedPaths": ["settings.position"] },
    { "id": "full-panel", "prefixes": ["settings.taskbarExperience.fullPanel"], "text": "四项全关时回 Compact：媒体信息和控制开启，音频与性能关闭；不可只孤立判断一个开关。", "relatedPaths": ["settings.taskbarExperience.fullPanel.mediaInfoVisible", "settings.taskbarExperience.fullPanel.mediaControlsVisible", "settings.taskbarExperience.fullPanel.audioControlsVisible", "settings.taskbarExperience.fullPanel.performanceVisible"] },
    { "id": "rest-order", "paths": ["settings.taskbarExperience.restComponentOrder"], "text": "null 用默认顺序；封面和媒体文字固定在前，只排序尾部。遗漏的已知尾部会补全，因此空数组不表示隐藏组件。" },
    { "id": "idle-components", "paths": ["settings.taskbarExperience.idleComponents"], "text": "null 默认只留 Artwork（无媒体时指快速启动音符）；空数组全部隐藏；显式列表控制无媒体保留项。封面显隐不能替代它。", "relatedPaths": ["settings.taskbarExperience.artworkVisible"] },
    { "id": "font-family", "prefixes": ["settings.appearance.latinFont", "settings.appearance.cjkFont"], "text": "family=null 保留旧预设，空串跟随系统；Trim 后含逗号或超过200字符回空串。派生的 SelectedFontFamily 不序列化。", "relatedPaths": ["settings.appearance.latinFont", "settings.appearance.latinFontFamily", "settings.appearance.cjkFont", "settings.appearance.cjkFontFamily"] },
    { "id": "accent-color", "paths": ["settings.appearance.accentColor"], "text": "接受带/不带#的6位RGB和8位ARGB；规范化成大写#RRGGBB并丢弃alpha，非法值回#0078D4。" },
    { "id": "appearance-reset", "prefixes": ["settings.appearance", "settings.taskbarSurface", "settings.dynamicIslandSurface"], "text": "应用外观重置保留媒体文字色和任务栏背景；任务栏外观重置保留全局主题字体。旧 ResetAppearance 还覆盖布局，须核对实际调用方。" },
    { "id": "lyrics-reset", "prefixes": ["settings.lyrics"], "paths": ["settings.allowBrowserAndVideoLyrics", "settings.twoLineLyricsEnabled"], "text": "ResetLyrics 保留歌词对齐与固定宽度，它们归内容布局重置；简繁、来源、分隔符等仍归歌词重置。" },
    { "id": "lyrics-sources", "prefixes": ["settings.lyricsSource"], "text": "null 全启用，空数组全关；保存未知ID，使用时忽略。按Ordinal去重，顺序不决定取词阶段。ID为Netease、NeteaseSearch、LRCLIB、QQMusic、Kugou、SodaMusic。" },
    { "id": "secondary-line", "prefixes": ["settings.lyricsSecondaryLine"], "text": "order=null 使用下一句→翻译→音译；空数组关闭；显式列表保留优先级。JSON非法项先受枚举回退影响。" },
    { "id": "artist-separators", "paths": ["settings.lyricsArtistSeparators"], "text": "存储保留空白和换行；null由setter变为空串，空串关闭分割。" },
    { "id": "interaction", "prefixes": ["settings.interaction"], "text": "ResetInteraction 恢复整段。托盘点击仅接受模型白名单，其他已定义旧值也可回默认；两个滚轮字段不要用根级旧字段代替。" },
    { "id": "source-filter", "prefixes": ["settings.smtcSourceFilter"], "text": "enabled=false 不过滤；true且空列表不允许任何来源。列表Trim、忽略大小写去重并排序，使用时归一化媒体别名。", "relatedPaths": ["settings.smtcSourceFilter.enabled", "settings.smtcSourceFilter.allowedSourceIds"] },
    { "id": "quick-launch", "prefixes": ["settings.quickLaunch"], "text": "entries=null→空；空目标或代码非法Kind过滤；按Kind+Target忽略大小写去重。空Id生成GUID，空名称取文件名，SourceId空白回null。JSON非法Kind可能先回Executable。" },
    { "id": "media-source-id", "paths": ["settings.smtcSourceFilter.allowedSourceIds", "settings.quickLaunch.entries[].sourceId"], "text": "媒体ID是开放的SMTC集合。网易云SourceId=cloudmusic、选择键source:cloudmusic；cloudmusic/netease/163music别名不区分大小写，与歌词来源ID不是同一契约。" },
    { "id": "components", "prefixes": ["settings.spectrumComponent", "settings.performanceComponent"], "text": "频谱及性能由 ResetComponents/ResetContentLayout 恢复。性能metrics空或全无效回SystemMemory；模型范围和吸附规则按所属类型核对，UI步长不保证都在Normalize吸附。 性能displayMode默认Cycle；metricOrder只决定已选指标显示顺序，轮换和并排共用；缺失或null使用原指标顺序。" },
    { "id": "notifications", "prefixes": ["settings.trackChangeNotification"], "text": "通知由媒体与通知重置；时长夹1000–10000ms。固定显示器丢失时运行回退，不清除用户选择。" },
    { "id": "update", "prefixes": ["settings.update"], "text": "跳过版本Trim、空回null、最长32字符；未来检查时间由调度按到期处理。检查记录是状态字段，没有自动下载开关。" },
    { "id": "startup", "paths": ["settings.launchAtStartup"], "text": "启动先读实际注册/Windows禁用状态同步；未知时保留意图。只有用户主动开启才允许解除禁用，失败回实际状态或上次值。" },
    { "id": "translucent-tb", "paths": ["settings.translucentTbCompatibilityPromptShown", "settings.appearance.taskbarBackgroundMaterial"], "text": "检测到TranslucentTB且未提示时可开启磨砂、先标记落盘再提示；ResetAll保留当前提示标记，用户默认快照不能重新触发。", "relatedPaths": ["settings.translucentTbCompatibilityPromptShown", "settings.appearance.taskbarBackgroundMaterial"] },
    { "id": "language", "paths": ["settings.interfaceLanguage"], "text": "System保存选择而非生效语言：zh的Hant/TW/HK/MO/CHT为繁体，其他中文为简体；vi为越南语，其他或未知为英文。越南语成员尚未发布。" },
    { "id": "monitor-targets", "prefixes": ["settings.taskbarTargetMonitorDeviceId"], "text": "列表为空且旧普通单目标非空时迁入列表并清旧字段；旧单目标AllTaskbars保留全部当前目标语义。离线ID保留，全部离线时临时回主屏。", "relatedPaths": ["settings.taskbarTargetMonitorDeviceIds", "settings.taskbarTargetMonitorDeviceId"] },
    { "id": "placement-reset", "prefixes": ["settings.taskbarBar", "settings.taskbarTargetMonitorDeviceId", "settings.dynamicIsland"], "paths": ["settings.position", "settings.windowMode", "settings.layoutOrientationMode", "settings.layoutLengthScalePercent", "settings.layoutThicknessScalePercent"], "text": "新ResetScreenAndPlacement仅恢复目标、位置、padding、跨轴偏移、避让、锁定；比例、模式、barEnabled等旧字段须核对旧ResetLayout/DisplayModes，不能按页名推定。" },
    { "id": "legacy-geometry-null", "paths": ["settings.layoutLengthScalePercent", "settings.layoutThicknessScalePercent", "settings.taskbarBarCrossAxisOffsetDip", "settings.dynamicIslandLeft", "settings.dynamicIslandTop"], "text": "五项旧null预处理只识别标准camelCase envelope；大写SETTINGS下非可空几何null仍可导致读取失败。" },
    { "id": "retained-mode", "prefixes": ["settings.dynamicIsland"], "paths": ["settings.windowMode"], "text": "当前只运行任务栏，WindowMode归一化为Taskbar；保留灵动岛字段和表面不等于该模式已实现。" },
    { "id": "retained-fields", "paths": ["settings.trayWheelBehavior", "settings.appearance.enhancedReadability", "settings.taskbarBarBackgroundBlur"], "text": "这些旧字段仍写入文件。EnhancedReadability无呈现效果；托盘使用interaction映射，未通用转接根滚轮字段；删除前仍按发布证据判断。" },
    { "id": "removed-strictness", "paths": ["settings.lyricsMatchStrictness"], "text": "这是发布过后移除的字段，不是未发布项；当前按未知键忽略，保存时不写回，也没有旧值转接。" }
  ]
}
