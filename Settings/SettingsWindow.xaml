<Window x:Class="AFMediaBar.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.WindowTitle}"
        Icon="/AFMediaBar;component/icon.ico"
        Width="820"
        Height="560"
        MinWidth="820"
        MinHeight="560"
        Background="{DynamicResource MenuBackgroundBrush}"
        Foreground="{DynamicResource MenuPrimaryTextBrush}"
        FontFamily="{DynamicResource AppTextFontFamily}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="SettingsNavigationItemStyle" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="NavigationBorder"
                    Background="Transparent"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource MenuSelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource MenuHighlightTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsSearchResultItemStyle" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
      <Setter Property="Padding" Value="12,12" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="SearchResultBorder"
                    Background="Transparent"
                    BorderBrush="{DynamicResource MenuSeparatorBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SearchResultBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SearchResultBorder" Property="Background" Value="{DynamicResource MenuSelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource MenuHighlightTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid MinHeight="48">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="SwitchTrack"
                      Width="38"
                      Height="22"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Background="{DynamicResource SliderTrackBrush}"
                      BorderBrush="{DynamicResource MenuBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="11">
                <Ellipse x:Name="SwitchThumb"
                         Width="16"
                         Height="16"
                         Margin="2"
                         HorizontalAlignment="Left"
                         Fill="{DynamicResource SliderThumbBrush}" />
              </Border>
              <ContentPresenter Grid.Column="1"
                                VerticalAlignment="Center"
                                ContentSource="Content"
                                RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource SliderFillBrush}" />
                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsSegmentStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="SegmentBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource MenuSelectionBrush}" />
                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{DynamicResource SliderFillBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource MenuHighlightTextBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ActionBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource MenuPressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}" />
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
    </Style>

    <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
    </Style>

    <Style x:Key="SettingsRowDescriptionStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource MenuSecondaryTextBrush}" />
    </Style>

    <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource MenuHighlightTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinWidth" Value="200" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton"
                            Focusable="False"
                            ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Box"
                            Background="{DynamicResource MenuHoverBrush}"
                            BorderBrush="{DynamicResource MenuBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,7">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource MenuPrimaryTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="&#xE70D;"
                                   FontFamily="{StaticResource AppIconFontFamily}"
                                   FontSize="10"
                                   Foreground="{DynamicResource MenuSecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ContentSite"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                TextElement.Foreground="{DynamicResource MenuPrimaryTextBrush}" />
              <Popup x:Name="PART_Popup"
                     AllowsTransparency="True"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     PopupAnimation="Fade"
                     StaysOpen="False">
                <Border MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="300"
                        Padding="4"
                        Background="{DynamicResource MenuBackgroundBrush}"
                        BorderBrush="{DynamicResource MenuBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="68" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="4,0,4,10">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource Settings.WindowTitle}"
                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                   FontSize="22"
                   FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Settings.LiveApplyHint}"
                   Margin="0,4,0,0"
                   Style="{StaticResource SettingsRowDescriptionStyle}" />
      </StackPanel>
      <Grid Width="300"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
        <TextBox x:Name="SearchBox"
                 Height="34"
                 Padding="12,7"
                 Background="{DynamicResource MenuHoverBrush}"
                 BorderBrush="{DynamicResource MenuBorderBrush}"
                 BorderThickness="1"
                 Foreground="{DynamicResource MenuPrimaryTextBrush}"
                 ToolTip="{DynamicResource Settings.Search.Placeholder}"
                 TextChanged="SearchBox_OnTextChanged" />
        <TextBlock x:Name="SearchPlaceholder"
                   Margin="12,0"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Foreground="{DynamicResource MenuSecondaryTextBrush}"
                   Text="{DynamicResource Settings.Search.Placeholder}" />
      </Grid>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0"
              MinWidth="160"
              Padding="8"
              Background="{DynamicResource MenuHoverBrush}"
              CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0"
                     Margin="8,4,8,8"
                     FontSize="12"
                     Foreground="{DynamicResource MenuSecondaryTextBrush}"
                     Text="{DynamicResource Settings.Categories}" />
          <ListBox x:Name="NavigationList"
                   Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemContainerStyle="{StaticResource SettingsNavigationItemStyle}"
                   SelectedIndex="0"
                   SelectionChanged="NavigationList_OnSelectionChanged">
            <ListBoxItem Tag="General">
              <StackPanel Orientation="Horizontal">
                <TextBlock Width="24" Text="&#xE713;" FontFamily="{StaticResource AppIconFontFamily}" />
                <TextBlock Text="{DynamicResource Settings.Nav.General}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Components">
              <StackPanel Orientation="Horizontal">
                <TextBlock Width="24" Text="&#xE90F;" FontFamily="{StaticResource AppIconFontFamily}" />
                <TextBlock Text="{DynamicResource Settings.Nav.Components}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Layout">
              <StackPanel Orientation="Horizontal">
                <TextBlock Width="24" Text="&#xE8A1;" FontFamily="{StaticResource AppIconFontFamily}" />
                <TextBlock Text="{DynamicResource Settings.Nav.Layout}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Appearance">
              <StackPanel Orientation="Horizontal">
                <TextBlock Width="24" Text="&#xE790;" FontFamily="{StaticResource AppIconFontFamily}" />
                <TextBlock Text="{DynamicResource Settings.Nav.Appearance}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Interaction">
              <StackPanel Orientation="Horizontal">
                <TextBlock Width="24" Text="&#xE7C9;" FontFamily="{StaticResource AppIconFontFamily}" />
                <TextBlock Text="{DynamicResource Settings.Nav.Interaction}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Performance">
              <StackPanel Orientation="Horizontal">
                <TextBlock Width="24" Text="&#xE950;" FontFamily="{StaticResource AppIconFontFamily}" />
                <TextBlock Text="{DynamicResource Settings.Nav.Performance}" />
              </StackPanel>
            </ListBoxItem>
          </ListBox>
        </Grid>
      </Border>

      <ScrollViewer x:Name="SettingsPageScrollViewer"
                    Grid.Column="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Grid Margin="10,0,22,20">
          <StackPanel x:Name="SearchResultsPage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Settings.Search.Results}" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock x:Name="SearchResultsSummaryText"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <ListBox x:Name="SearchResultsList"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource SettingsSearchResultItemStyle}"
                     SelectionChanged="SearchResults_OnSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               Foreground="{DynamicResource MenuPrimaryTextBrush}" />
                    <TextBlock Grid.Column="1"
                               Margin="18,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource MenuSecondaryTextBrush}"
                               Text="{Binding PageTitle}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="SearchEmptyText"
                       Text="{DynamicResource Settings.Search.NoResults}"
                       Visibility="Collapsed"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
          </StackPanel>

          <StackPanel x:Name="GeneralPage">
            <TextBlock Text="{DynamicResource Settings.Nav.General}" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="{DynamicResource Settings.General.Description}"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
              <CheckBox x:Name="StartupCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="GeneralCheckBox_OnChanged" Unchecked="GeneralCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.General.AutoStartTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.General.AutoStartDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <CheckBox x:Name="HideWhenNoMediaCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="WindowCheckBox_OnChanged" Unchecked="WindowCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.General.HideWhenNoMediaTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.General.HideWhenNoMediaDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource Settings.Language.SectionTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                <TextBlock Text="{DynamicResource Settings.Language.Description}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <RadioButton x:Name="LanguageFollowSystemRadioButton" Content="{DynamicResource Settings.Language.FollowSystem}" GroupName="LanguageMode" Style="{StaticResource SettingsSegmentStyle}" Checked="LanguageRadio_OnChanged" />
                  <RadioButton x:Name="LanguageZhCnRadioButton" Content="{DynamicResource Settings.Language.ZhCn}" GroupName="LanguageMode" Style="{StaticResource SettingsSegmentStyle}" Checked="LanguageRadio_OnChanged" />
                  <RadioButton x:Name="LanguageZhTwRadioButton" Content="{DynamicResource Settings.Language.ZhTw}" GroupName="LanguageMode" Style="{StaticResource SettingsSegmentStyle}" Checked="LanguageRadio_OnChanged" />
                  <RadioButton x:Name="LanguageEnUsRadioButton" Content="{DynamicResource Settings.Language.EnUs}" GroupName="LanguageMode" Style="{StaticResource SettingsSegmentStyle}" Checked="LanguageRadio_OnChanged" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Margin="0,24,0,8" Text="{DynamicResource Settings.General.About}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Style="{StaticResource SettingsRowDescriptionStyle}" />
            <WrapPanel Margin="0,14,0,0">
              <Button Content="{DynamicResource Settings.General.OpenGitHub}" Tag="https://github.com/Fervent-Tempo/AF-Media-Bar" Style="{StaticResource SettingsActionButtonStyle}" Click="OpenLink_OnClick" />
              <Button Content="{DynamicResource Settings.General.ReportIssue}" Tag="https://github.com/Fervent-Tempo/AF-Media-Bar/issues" Style="{StaticResource SettingsActionButtonStyle}" Click="OpenLink_OnClick" />
              <Button Content="{DynamicResource Settings.General.License}" Tag="https://github.com/Fervent-Tempo/AF-Media-Bar/blob/main/LICENSE" Style="{StaticResource SettingsActionButtonStyle}" Click="OpenLink_OnClick" />
              <Button Content="{DynamicResource Settings.General.OpenLogFile}" Style="{StaticResource SettingsActionButtonStyle}" Click="OpenLogFile_OnClick" />
            </WrapPanel>
            <TextBlock Margin="0,28,0,8" Text="{DynamicResource Settings.General.Update}" FontSize="15" FontWeight="SemiBold" />
            <CheckBox x:Name="AutomaticUpdateChecksCheckBox"
                      Style="{StaticResource SettingsCheckBoxStyle}"
                      Checked="UpdateCheckSetting_OnChanged"
                      Unchecked="UpdateCheckSetting_OnChanged">
              <StackPanel>
                <TextBlock Text="{DynamicResource Settings.General.AutoCheckUpdateTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                <TextBlock Text="{DynamicResource Settings.General.AutoCheckUpdateDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
              </StackPanel>
            </CheckBox>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="CheckForUpdatesButton"
                      Content="{DynamicResource Settings.General.CheckUpdate}"
                      Style="{StaticResource SettingsActionButtonStyle}"
                      Click="CheckForUpdates_OnClick" />
              <Button x:Name="SkipUpdateButton"
                      Content="{DynamicResource Settings.General.IgnoreVersion}"
                      Visibility="Collapsed"
                      Style="{StaticResource SettingsActionButtonStyle}"
                      Click="SkipUpdate_OnClick" />
            </StackPanel>
            <TextBlock x:Name="UpdateStatusText"
                       Margin="0,8,0,0"
                       Text="{DynamicResource Settings.General.CheckUpdateHint}"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Border x:Name="UpdateDetailsPanel"
                    Margin="0,14,0,0"
                    Padding="12"
                    Background="{DynamicResource MenuHoverBrush}"
                    BorderBrush="{DynamicResource MenuBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="UpdateTitleText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MenuPrimaryTextBrush}" />
                <TextBlock x:Name="UpdateVersionText"
                           Style="{StaticResource SettingsRowDescriptionStyle}" />
                <TextBlock x:Name="UpdateChangelogText"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MenuPrimaryTextBrush}" />
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="GitHubDownloadButton"
                          Content="{DynamicResource Settings.General.DownloadGithub}"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                  <Button x:Name="QuarkDownloadButton"
                          Content="{DynamicResource Settings.General.DownloadQuark}"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                  <Button x:Name="BaiduDownloadButton"
                          Content="{DynamicResource Settings.General.DownloadBaidu}"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                  <Button x:Name="LanzouDownloadButton"
                          Content="{DynamicResource Settings.General.DownloadLanzou}"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                  <Button x:Name="ReleaseNotesButton"
                          Content="{DynamicResource Settings.General.ViewReleaseNotes}"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock Margin="0,28,0,8" Text="{DynamicResource Settings.General.Reset}" FontSize="15" FontWeight="SemiBold" />
            <Button x:Name="ResetDefaultsButton" Content="{DynamicResource Settings.General.ResetAll}" HorizontalAlignment="Left" Style="{StaticResource SettingsActionButtonStyle}" Click="ResetDefaults_OnClick" />
          </StackPanel>

          <StackPanel x:Name="ComponentsPage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Settings.Nav.Components}" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="{DynamicResource Settings.Components.Description}"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
              <CheckBox x:Name="ShowArtworkCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="WindowCheckBox_OnChanged" Unchecked="WindowCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Components.ShowArtworkTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Components.ShowArtworkDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource Settings.Components.ArtworkCornerRadiusTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                <TextBlock Text="{DynamicResource Settings.Components.ArtworkCornerRadiusDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                <Grid Width="320" HorizontalAlignment="Left" Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                  </Grid.ColumnDefinitions>
                  <Slider x:Name="ArtworkCornerRadiusSlider"
                          Grid.Column="0"
                          Width="240"
                          Minimum="0"
                          Maximum="20"
                          TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          ValueChanged="ArtworkCornerRadiusSlider_OnValueChanged" />
                  <TextBlock x:Name="ArtworkCornerRadiusValueText"
                             Grid.Column="1"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             FontSize="14" />
                </Grid>
              </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <CheckBox x:Name="ShowMediaInfoCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="WindowCheckBox_OnChanged" Unchecked="WindowCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Components.ShowMediaInfoTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Components.ShowMediaInfoDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
              <CheckBox x:Name="MetricsEnabledCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Components.MetricsTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Components.MetricsDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <StackPanel Margin="44,0,0,0">
              <CheckBox x:Name="SystemMemoryCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <TextBlock Text="{DynamicResource Settings.Components.MetricMem}" Style="{StaticResource SettingsRowTitleStyle}" />
              </CheckBox>
              <CheckBox x:Name="SystemCpuCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <TextBlock Text="{DynamicResource Settings.Components.MetricCpu}" Style="{StaticResource SettingsRowTitleStyle}" />
              </CheckBox>
              <CheckBox x:Name="SystemGpuCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <TextBlock Text="{DynamicResource Settings.Components.MetricGpu}" Style="{StaticResource SettingsRowTitleStyle}" />
              </CheckBox>
              <CheckBox x:Name="ProcessMemoryCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <TextBlock Text="{DynamicResource Settings.Components.MetricApp}" Style="{StaticResource SettingsRowTitleStyle}" />
              </CheckBox>
              <CheckBox x:Name="OpenTaskManagerOnMetricsClickCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Components.OpenTaskManagerTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Components.OpenTaskManagerDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </StackPanel>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,1,0,1" Padding="0,10">
              <CheckBox x:Name="AudioMonitorCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Components.SpectrumTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Components.SpectrumDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <CheckBox x:Name="OutputDeviceCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Components.OutputSwitchTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Components.OutputSwitchDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <CheckBox x:Name="VolumeControlCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Components.MediaVolumeTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Components.MediaVolumeDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
          </StackPanel>

          <StackPanel x:Name="LayoutPage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Settings.Nav.Layout}" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="{DynamicResource Settings.Layout.Description}"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <TextBlock Text="{DynamicResource Settings.Layout.WindowMode}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Settings.Layout.WindowModeHint}" Margin="0,4,0,8" Style="{StaticResource SettingsRowDescriptionStyle}" />
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="TaskbarModeRadioButton" Content="{DynamicResource Settings.Layout.DockToTaskbar}" GroupName="HostMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
              <RadioButton x:Name="FloatingModeRadioButton" Content="{DynamicResource Settings.Layout.Floating}" GroupName="HostMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
            </StackPanel>
            <TextBlock Text="{DynamicResource Settings.Layout.Arrangement}" Margin="0,18,0,4" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Settings.Layout.ArrangementHint}" Margin="0,0,0,8" Style="{StaticResource SettingsRowDescriptionStyle}" />
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="AutomaticLayoutRadioButton" Content="{DynamicResource Settings.Common.Auto}" GroupName="LayoutMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
              <RadioButton x:Name="HorizontalLayoutRadioButton" Content="{DynamicResource Settings.Common.Horizontal}" GroupName="LayoutMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
              <RadioButton x:Name="VerticalLayoutRadioButton" Content="{DynamicResource Settings.Common.Vertical}" GroupName="LayoutMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
            </StackPanel>
            <TextBlock Text="{DynamicResource Settings.Layout.Size}" Margin="0,18,0,4" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Settings.Layout.LengthScale}" Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Grid Width="320" HorizontalAlignment="Left" Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="LengthScaleSlider"
                      Grid.Column="0"
                      Width="240"
                      Minimum="70"
                      Maximum="125"
                      TickFrequency="5"
                      IsSnapToTickEnabled="True"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      ValueChanged="ScaleSlider_OnValueChanged" />
              <TextBlock x:Name="LengthScaleValueText"
                         Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="14" />
            </Grid>
            <TextBlock Text="{DynamicResource Settings.Layout.ThicknessScale}" Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Grid Width="320" HorizontalAlignment="Left" Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="ThicknessScaleSlider"
                      Grid.Column="0"
                      Width="240"
                      Minimum="70"
                      Maximum="125"
                      TickFrequency="5"
                      IsSnapToTickEnabled="True"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      ValueChanged="ScaleSlider_OnValueChanged" />
              <TextBlock x:Name="ThicknessScaleValueText"
                         Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="14" />
            </Grid>
            <TextBlock Text="{DynamicResource Settings.Layout.TopOffset}" Margin="0,8,0,0" Style="{StaticResource SettingsRowTitleStyle}" />
            <TextBlock Text="{DynamicResource Settings.Layout.TopOffsetDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Grid Width="320" HorizontalAlignment="Left" Margin="0,6,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="TaskbarTopOffsetSlider"
                      Grid.Column="0"
                      Width="240"
                      Minimum="-20"
                      Maximum="20"
                      TickFrequency="1"
                      IsSnapToTickEnabled="True"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      ValueChanged="ScaleSlider_OnValueChanged" />
              <TextBlock x:Name="TaskbarTopOffsetValueText"
                         Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="14" />
            </Grid>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,1,0,1" Padding="0,10">
              <CheckBox x:Name="AutomaticPlacementCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="PlacementCheckBox_OnChanged" Unchecked="PlacementCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Layout.AvoidTaskbarTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock x:Name="AutomaticPlacementDescription" Text="{DynamicResource Settings.Layout.AvoidTaskbarDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <CheckBox x:Name="LockPositionCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="PlacementCheckBox_OnChanged" Unchecked="PlacementCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Layout.LockPositionTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Layout.LockPositionDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Button Content="{DynamicResource Settings.Layout.ResetPosition}" HorizontalAlignment="Left" Margin="0,16,0,0" Style="{StaticResource SettingsActionButtonStyle}" Click="ResetPosition_OnClick" />
            <TextBlock Text="{DynamicResource Settings.Layout.EditorTitle}" Margin="0,30,0,0" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Settings.Layout.EditorDescription}"
                       Margin="0,4,0,10"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <TextBlock Text="{DynamicResource Settings.Layout.EditorProfile}" Style="{StaticResource SettingsRowDescriptionStyle}" />
            <ComboBox x:Name="LayoutProfileComboBox"
                      Width="320"
                      HorizontalAlignment="Left"
                      Margin="0,4,0,10"
                      Style="{StaticResource SettingsComboBoxStyle}"
                      SelectionChanged="LayoutProfileComboBox_OnSelectionChanged" />
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Settings.Layout.EditorStructure}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                <TreeView x:Name="LayoutTree"
                          Height="220"
                          Margin="0,4,0,0"
                          Background="{DynamicResource MenuHoverBrush}"
                          BorderBrush="{DynamicResource MenuBorderBrush}"
                          BorderThickness="1"
                          Foreground="{DynamicResource MenuPrimaryTextBrush}"
                          SelectedItemChanged="LayoutTree_OnSelectedItemChanged" />
                <TextBlock x:Name="LayoutEditorSelectionText"
                           Margin="0,6,0,0"
                           Text="{DynamicResource Settings.Layout.EditorNoSelection}"
                           Style="{StaticResource SettingsRowDescriptionStyle}" />
              </StackPanel>
              <Border Grid.Column="2"
                      MinHeight="220"
                      Padding="10"
                      Background="{DynamicResource MenuHoverBrush}"
                      BorderBrush="{DynamicResource MenuBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="6">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Layout.EditorPreview}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                  <Border x:Name="LayoutEditorPreviewHost"
                          Height="120"
                          Margin="0,8,0,0"
                          Background="{DynamicResource TaskbarReadabilityBrush}"
                          CornerRadius="6"
                          ClipToBounds="True" />
                </StackPanel>
              </Border>
            </Grid>
            <WrapPanel Margin="0,0,0,8">
              <Button x:Name="LayoutMoveUpButton"
                      Content="{DynamicResource Settings.Layout.EditorMoveUp}"
                      Style="{StaticResource SettingsActionButtonStyle}"
                      Click="LayoutMoveUpButton_OnClick" />
              <Button x:Name="LayoutMoveDownButton"
                      Content="{DynamicResource Settings.Layout.EditorMoveDown}"
                      Style="{StaticResource SettingsActionButtonStyle}"
                      Click="LayoutMoveDownButton_OnClick" />
              <Button x:Name="LayoutToggleButton"
                      Content="{DynamicResource Settings.Layout.EditorToggle}"
                      Style="{StaticResource SettingsActionButtonStyle}"
                      Click="LayoutToggleButton_OnClick" />
              <Button x:Name="LayoutRemoveButton"
                      Content="{DynamicResource Settings.Layout.EditorRemove}"
                      Style="{StaticResource SettingsActionButtonStyle}"
                      Click="LayoutRemoveButton_OnClick" />
            </WrapPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="LayoutSlotComboBox"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Style="{StaticResource SettingsComboBoxStyle}" />
              <ComboBox x:Name="LayoutWidgetTypeComboBox"
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        Style="{StaticResource SettingsComboBoxStyle}" />
              <Button x:Name="LayoutAddWidgetButton"
                      Grid.Column="2"
                      Content="{DynamicResource Settings.Layout.EditorAddWidget}"
                      Style="{StaticResource SettingsActionButtonStyle}"
                      Click="LayoutAddWidgetButton_OnClick" />
            </Grid>
            <Button x:Name="LayoutAddContainerButton"
                    Content="{DynamicResource Settings.Layout.EditorAddContainer}"
                    HorizontalAlignment="Left"
                    Style="{StaticResource SettingsActionButtonStyle}"
                    Click="LayoutAddContainerButton_OnClick" />
            <TextBlock x:Name="LayoutEditorMessageText"
                       Margin="0,6,0,0"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Border x:Name="LayoutPropertyHost"
                    Margin="0,14,0,0"
                    Padding="10"
                    Background="{DynamicResource MenuHoverBrush}"
                    BorderBrush="{DynamicResource MenuBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6" />
          </StackPanel>

          <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Settings.Nav.Appearance}" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="{DynamicResource Settings.Appearance.Description}"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <TextBlock Text="{DynamicResource Settings.Appearance.Fonts}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Settings.Appearance.FontsHint}"
                       Margin="0,4,0,8"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="210" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Settings.Appearance.LatinFont}" Margin="0,0,0,4" Style="{StaticResource SettingsRowDescriptionStyle}" />
                <ComboBox x:Name="FontLatinComboBox"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          SelectionChanged="FontComboBox_OnSelectionChanged">
                  <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontSegoeUi}" />
                  <ComboBoxItem Content="Arial" />
                  <ComboBoxItem Content="Calibri" />
                  <ComboBoxItem Content="Verdana" />
                  <ComboBoxItem Content="Consolas" />
                  <ComboBoxItem Content="Times New Roman" />
                  <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontFollowCjk}" />
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource Settings.Appearance.CjkFont}" Margin="0,0,0,4" Style="{StaticResource SettingsRowDescriptionStyle}" />
                <ComboBox x:Name="FontCjkComboBox"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          SelectionChanged="FontComboBox_OnSelectionChanged">
                  <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontSystemDefault}" />
                  <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontMsYaHei}" />
                  <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontDengXian}" />
                  <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontSimSun}" />
                  <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontSimHei}" />
                  <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontKaiTi}" />
                  <ComboBoxItem Content="{DynamicResource Settings.Appearance.FontFangSong}" />
                </ComboBox>
              </StackPanel>
            </Grid>
            <StackPanel Margin="0,0,0,10" HorizontalAlignment="Left">
              <TextBlock Text="{DynamicResource Settings.Appearance.FontWeight}" Margin="0,0,0,4" Style="{StaticResource SettingsRowDescriptionStyle}" />
              <Grid Width="320">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240" />
                  <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="FontWeightSlider"
                        Grid.Column="0"
                        Width="240"
                        Minimum="300"
                        Maximum="900"
                        TickFrequency="50"
                        IsSnapToTickEnabled="False"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ValueChanged="FontWeightSlider_OnValueChanged" />
                <TextBlock x:Name="FontWeightValueText"
                           Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="14" />
              </Grid>
            </StackPanel>
            <Border Margin="0,0,0,16"
                    Padding="12,8"
                    Background="{DynamicResource MenuHoverBrush}"
                    BorderBrush="{DynamicResource MenuBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
              <TextBlock x:Name="FontPreviewText"
                         Text="{DynamicResource Settings.Appearance.FontPreview}"
                         FontSize="14"
                         Foreground="{DynamicResource MenuPrimaryTextBrush}" />
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" />
            <TextBlock Text="{DynamicResource Settings.Appearance.PlayerText}" Margin="0,16,0,0" FontSize="15" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
              <RadioButton x:Name="AutomaticForegroundRadioButton" Content="{DynamicResource Settings.Common.Auto}" GroupName="ForegroundMode" Style="{StaticResource SettingsSegmentStyle}" Checked="ThemeRadio_OnChanged" />
              <RadioButton x:Name="LightForegroundRadioButton" Content="{DynamicResource Settings.Appearance.LightText}" GroupName="ForegroundMode" Style="{StaticResource SettingsSegmentStyle}" Checked="ThemeRadio_OnChanged" />
              <RadioButton x:Name="DarkForegroundRadioButton" Content="{DynamicResource Settings.Appearance.DarkText}" GroupName="ForegroundMode" Style="{StaticResource SettingsSegmentStyle}" Checked="ThemeRadio_OnChanged" />
            </StackPanel>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,1,0,1" Padding="0,10">
              <CheckBox x:Name="EnhancedReadabilityCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="ThemeCheckBox_OnChanged" Unchecked="ThemeCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Appearance.ReadabilityTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Appearance.ReadabilityDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <TextBlock Margin="0,24,0,0" Text="{DynamicResource Settings.Appearance.MenuTheme}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Settings.Appearance.MenuThemeHint}"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <RadioButton x:Name="AutomaticMenuThemeRadioButton" Content="{DynamicResource Settings.Common.Auto}" GroupName="MenuThemeMode" Style="{StaticResource SettingsSegmentStyle}" Checked="MenuThemeRadio_OnChanged" />
              <RadioButton x:Name="LightMenuThemeRadioButton" Content="{DynamicResource Settings.Common.Light}" GroupName="MenuThemeMode" Style="{StaticResource SettingsSegmentStyle}" Checked="MenuThemeRadio_OnChanged" />
              <RadioButton x:Name="DarkMenuThemeRadioButton" Content="{DynamicResource Settings.Common.Dark}" GroupName="MenuThemeMode" Style="{StaticResource SettingsSegmentStyle}" Checked="MenuThemeRadio_OnChanged" />
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="InteractionPage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Settings.Nav.Interaction}" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="{DynamicResource Settings.Interaction.Description}"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
              <CheckBox x:Name="AutoCollapseCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="WindowCheckBox_OnChanged" Unchecked="WindowCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Interaction.AutoCollapseTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Interaction.AutoCollapseDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <CheckBox x:Name="EdgeAutoCollapseCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="WindowCheckBox_OnChanged" Unchecked="WindowCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Interaction.EdgeCollapseTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock x:Name="EdgeAutoCollapseDescription" Text="{DynamicResource Settings.Interaction.EdgeCollapseDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <CheckBox x:Name="AlwaysOnTopCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="WindowCheckBox_OnChanged" Unchecked="WindowCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Interaction.TopMostTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Interaction.TopMostDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PerformancePage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Settings.Nav.Performance}" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="{DynamicResource Settings.Performance.Description}"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
              <CheckBox x:Name="LowGpuModeCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Settings.Performance.LowPerfTitle}" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="{DynamicResource Settings.Performance.LowPerfDescription}" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <TextBlock Margin="0,24,0,8" Text="{DynamicResource Settings.Performance.Diagnostics}" FontSize="15" FontWeight="SemiBold" />
            <Button Content="{DynamicResource Settings.Performance.Reconnect}" HorizontalAlignment="Left" Style="{StaticResource SettingsActionButtonStyle}" Click="Reconnect_OnClick" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
