<Window x:Class="AFMediaBar.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AF Media Bar 设置"
        Icon="/AFMediaBar;component/icon.ico"
        Width="980"
        Height="700"
        MinWidth="820"
        MinHeight="560"
        Background="{DynamicResource MenuBackgroundBrush}"
        Foreground="{DynamicResource MenuPrimaryTextBrush}"
        FontFamily="{DynamicResource AppTextFontFamily}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="SettingsNavigationItemStyle" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="NavigationBorder"
                    Background="Transparent"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource MenuSelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource MenuHighlightTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsSearchResultItemStyle" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
      <Setter Property="Padding" Value="12,12" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="SearchResultBorder"
                    Background="Transparent"
                    BorderBrush="{DynamicResource MenuSeparatorBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SearchResultBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SearchResultBorder" Property="Background" Value="{DynamicResource MenuSelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource MenuHighlightTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid MinHeight="48">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="SwitchTrack"
                      Width="38"
                      Height="22"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Background="{DynamicResource SliderTrackBrush}"
                      BorderBrush="{DynamicResource MenuBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="11">
                <Ellipse x:Name="SwitchThumb"
                         Width="16"
                         Height="16"
                         Margin="2"
                         HorizontalAlignment="Left"
                         Fill="{DynamicResource SliderThumbBrush}" />
              </Border>
              <ContentPresenter Grid.Column="1"
                                VerticalAlignment="Center"
                                ContentSource="Content"
                                RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource SliderFillBrush}" />
                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsSegmentStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="SegmentBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource MenuSelectionBrush}" />
                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{DynamicResource SliderFillBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource MenuHighlightTextBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ActionBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource MenuPressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}" />
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
    </Style>

    <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
    </Style>

    <Style x:Key="SettingsRowDescriptionStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource MenuSecondaryTextBrush}" />
    </Style>

    <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource MenuHighlightTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource MenuPrimaryTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinWidth" Value="200" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton"
                            Focusable="False"
                            ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Box"
                            Background="{DynamicResource MenuHoverBrush}"
                            BorderBrush="{DynamicResource MenuBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,7">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource MenuPrimaryTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="&#xE70D;"
                                   FontFamily="{StaticResource AppIconFontFamily}"
                                   FontSize="10"
                                   Foreground="{DynamicResource MenuSecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ContentSite"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                TextElement.Foreground="{DynamicResource MenuPrimaryTextBrush}" />
              <Popup x:Name="PART_Popup"
                     AllowsTransparency="True"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     PopupAnimation="Fade"
                     StaysOpen="False">
                <Border MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="300"
                        Padding="4"
                        Background="{DynamicResource MenuBackgroundBrush}"
                        BorderBrush="{DynamicResource MenuBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="68" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="4,0,4,10">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="AF Media Bar 设置"
                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                   FontSize="22"
                   FontWeight="SemiBold" />
        <TextBlock Text="修改后立即生效"
                   Margin="0,4,0,0"
                   Style="{StaticResource SettingsRowDescriptionStyle}" />
      </StackPanel>
      <Grid Width="300"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
        <TextBox x:Name="SearchBox"
                 Height="34"
                 Padding="12,7"
                 Background="{DynamicResource MenuHoverBrush}"
                 BorderBrush="{DynamicResource MenuBorderBrush}"
                 BorderThickness="1"
                 Foreground="{DynamicResource MenuPrimaryTextBrush}"
                 ToolTip="搜索设置"
                 TextChanged="SearchBox_OnTextChanged" />
        <TextBlock x:Name="SearchPlaceholder"
                   Margin="12,0"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Foreground="{DynamicResource MenuSecondaryTextBrush}"
                   Text="搜索设置" />
      </Grid>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0"
              Padding="8"
              Background="{DynamicResource MenuHoverBrush}"
              CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0"
                     Margin="8,4,8,8"
                     FontSize="12"
                     Foreground="{DynamicResource MenuSecondaryTextBrush}"
                     Text="设置类别" />
          <ListBox x:Name="NavigationList"
                   Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemContainerStyle="{StaticResource SettingsNavigationItemStyle}"
                   SelectedIndex="0"
                   SelectionChanged="NavigationList_OnSelectionChanged">
            <ListBoxItem Tag="General">
              <StackPanel Orientation="Horizontal">
                <TextBlock Width="24" Text="&#xE713;" FontFamily="{StaticResource AppIconFontFamily}" />
                <TextBlock Text="常规" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Components">
              <StackPanel Orientation="Horizontal">
                <TextBlock Width="24" Text="&#xE90F;" FontFamily="{StaticResource AppIconFontFamily}" />
                <TextBlock Text="播放器组件" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Layout">
              <StackPanel Orientation="Horizontal">
                <TextBlock Width="24" Text="&#xE8A1;" FontFamily="{StaticResource AppIconFontFamily}" />
                <TextBlock Text="布局与位置" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Appearance">
              <StackPanel Orientation="Horizontal">
                <TextBlock Width="24" Text="&#xE790;" FontFamily="{StaticResource AppIconFontFamily}" />
                <TextBlock Text="外观" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Interaction">
              <StackPanel Orientation="Horizontal">
                <TextBlock Width="24" Text="&#xE7C9;" FontFamily="{StaticResource AppIconFontFamily}" />
                <TextBlock Text="交互与动画" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Performance">
              <StackPanel Orientation="Horizontal">
                <TextBlock Width="24" Text="&#xE950;" FontFamily="{StaticResource AppIconFontFamily}" />
                <TextBlock Text="性能与高级" />
              </StackPanel>
            </ListBoxItem>
          </ListBox>
        </Grid>
      </Border>

      <ScrollViewer x:Name="SettingsPageScrollViewer"
                    Grid.Column="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Grid Margin="10,0,22,20">
          <StackPanel x:Name="SearchResultsPage" Visibility="Collapsed">
            <TextBlock Text="搜索结果" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock x:Name="SearchResultsSummaryText"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <ListBox x:Name="SearchResultsList"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource SettingsSearchResultItemStyle}"
                     SelectionChanged="SearchResults_OnSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               Foreground="{DynamicResource MenuPrimaryTextBrush}" />
                    <TextBlock Grid.Column="1"
                               Margin="18,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource MenuSecondaryTextBrush}"
                               Text="{Binding PageTitle}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="SearchEmptyText"
                       Text="没有匹配的设置"
                       Visibility="Collapsed"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
          </StackPanel>

          <StackPanel x:Name="GeneralPage">
            <TextBlock Text="常规" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="管理启动、媒体可见性和应用级操作。"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
              <CheckBox x:Name="StartupCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="GeneralCheckBox_OnChanged" Unchecked="GeneralCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="开机启动" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="登录 Windows 后自动启动 AF Media Bar。" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <CheckBox x:Name="HideWhenNoMediaCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="WindowCheckBox_OnChanged" Unchecked="WindowCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="无媒体时隐藏播放器" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="所有媒体会话都停止播放后隐藏媒体栏。" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <TextBlock Margin="0,24,0,8" Text="关于" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Style="{StaticResource SettingsRowDescriptionStyle}" />
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button Content="打开 GitHub" Tag="https://github.com/Fervent-Tempo/AF-Media-Bar" Style="{StaticResource SettingsActionButtonStyle}" Click="OpenLink_OnClick" />
              <Button Content="反馈问题" Tag="https://github.com/Fervent-Tempo/AF-Media-Bar/issues" Style="{StaticResource SettingsActionButtonStyle}" Click="OpenLink_OnClick" />
              <Button Content="许可证" Tag="https://github.com/Fervent-Tempo/AF-Media-Bar/blob/main/LICENSE" Style="{StaticResource SettingsActionButtonStyle}" Click="OpenLink_OnClick" />
            </StackPanel>
            <TextBlock Margin="0,28,0,8" Text="获取更新" FontSize="15" FontWeight="SemiBold" />
            <CheckBox x:Name="AutomaticUpdateChecksCheckBox"
                      Style="{StaticResource SettingsCheckBoxStyle}"
                      Checked="UpdateCheckSetting_OnChanged"
                      Unchecked="UpdateCheckSetting_OnChanged">
              <StackPanel>
                <TextBlock Text="自动检查更新" Style="{StaticResource SettingsRowTitleStyle}" />
                <TextBlock Text="启动后延迟检查，每天最多访问一次公开版本清单。" Style="{StaticResource SettingsRowDescriptionStyle}" />
              </StackPanel>
            </CheckBox>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="CheckForUpdatesButton"
                      Content="检查更新"
                      Style="{StaticResource SettingsActionButtonStyle}"
                      Click="CheckForUpdates_OnClick" />
              <Button x:Name="SkipUpdateButton"
                      Content="忽略此版本"
                      Visibility="Collapsed"
                      Style="{StaticResource SettingsActionButtonStyle}"
                      Click="SkipUpdate_OnClick" />
            </StackPanel>
            <TextBlock x:Name="UpdateStatusText"
                       Margin="0,8,0,0"
                       Text="也可以在这里立即检查。"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Border x:Name="UpdateDetailsPanel"
                    Margin="0,14,0,0"
                    Padding="12"
                    Background="{DynamicResource MenuHoverBrush}"
                    BorderBrush="{DynamicResource MenuBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="UpdateTitleText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MenuPrimaryTextBrush}" />
                <TextBlock x:Name="UpdateVersionText"
                           Style="{StaticResource SettingsRowDescriptionStyle}" />
                <TextBlock x:Name="UpdateChangelogText"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MenuPrimaryTextBrush}" />
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="GitHubDownloadButton"
                          Content="GitHub 下载"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                  <Button x:Name="QuarkDownloadButton"
                          Content="夸克网盘"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                  <Button x:Name="BaiduDownloadButton"
                          Content="百度网盘"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                  <Button x:Name="LanzouDownloadButton"
                          Content="蓝奏云"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                  <Button x:Name="ReleaseNotesButton"
                          Content="查看更新说明"
                          Visibility="Collapsed"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          Click="OpenLink_OnClick" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock Margin="0,28,0,8" Text="恢复" FontSize="15" FontWeight="SemiBold" />
            <Button x:Name="ResetDefaultsButton" Content="恢复全部默认设置" HorizontalAlignment="Left" Style="{StaticResource SettingsActionButtonStyle}" Click="ResetDefaults_OnClick" />
          </StackPanel>

          <StackPanel x:Name="ComponentsPage" Visibility="Collapsed">
            <TextBlock Text="播放器组件" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="选择媒体栏中显示的附加组件。封面、标题和播放控制始终保留。"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
              <CheckBox x:Name="MetricsEnabledCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="显示性能指标" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="在播放器中显示可选的系统和进程指标。" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <StackPanel Margin="44,0,0,0">
              <CheckBox x:Name="SystemMemoryCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <TextBlock Text="系统内存（MEM）" Style="{StaticResource SettingsRowTitleStyle}" />
              </CheckBox>
              <CheckBox x:Name="SystemCpuCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <TextBlock Text="系统处理器（CPU）" Style="{StaticResource SettingsRowTitleStyle}" />
              </CheckBox>
              <CheckBox x:Name="SystemGpuCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <TextBlock Text="系统图形处理器（GPU）" Style="{StaticResource SettingsRowTitleStyle}" />
              </CheckBox>
              <CheckBox x:Name="ProcessMemoryCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <TextBlock Text="播放器内存（APP）" Style="{StaticResource SettingsRowTitleStyle}" />
              </CheckBox>
            </StackPanel>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,1,0,1" Padding="0,10">
              <CheckBox x:Name="AudioMonitorCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="音频频谱" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="在收起状态显示当前系统声音的频谱。" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <CheckBox x:Name="OutputDeviceCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="输出设备切换" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="显示快速切换默认输出设备的按钮。" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <CheckBox x:Name="VolumeControlCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="当前媒体音量" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="显示当前媒体应用的独立音量调节按钮。" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
          </StackPanel>

          <StackPanel x:Name="LayoutPage" Visibility="Collapsed">
            <TextBlock Text="布局与位置" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="设置窗口宿主、排列方向、比例和任务栏位置。"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <TextBlock Text="窗口模式" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="悬浮窗口可以脱离任务栏自由移动。" Margin="0,4,0,8" Style="{StaticResource SettingsRowDescriptionStyle}" />
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="TaskbarModeRadioButton" Content="依附任务栏" GroupName="HostMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
              <RadioButton x:Name="FloatingModeRadioButton" Content="独立悬浮" GroupName="HostMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
            </StackPanel>
            <TextBlock Text="布局" Margin="0,18,0,4" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="自动布局在任务栏模式下跟随任务栏方向，悬浮模式默认横向。" Margin="0,0,0,8" Style="{StaticResource SettingsRowDescriptionStyle}" />
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="AutomaticLayoutRadioButton" Content="自动" GroupName="LayoutMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
              <RadioButton x:Name="HorizontalLayoutRadioButton" Content="横向" GroupName="LayoutMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
              <RadioButton x:Name="VerticalLayoutRadioButton" Content="竖向" GroupName="LayoutMode" Style="{StaticResource SettingsSegmentStyle}" Checked="WindowRadio_OnChanged" />
            </StackPanel>
            <TextBlock Text="显示比例" Margin="0,18,0,4" FontSize="15" FontWeight="SemiBold" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="ScaleSlider"
                      Grid.Column="0"
                      Minimum="70"
                      Maximum="125"
                      TickFrequency="5"
                      IsSnapToTickEnabled="True"
                      VerticalAlignment="Center"
                      ValueChanged="ScaleSlider_OnValueChanged" />
              <TextBlock x:Name="ScaleValueText"
                         Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="14" />
            </Grid>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,1,0,1" Padding="0,10">
              <CheckBox x:Name="AutomaticPlacementCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="PlacementCheckBox_OnChanged" Unchecked="PlacementCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="自动避让任务栏图标" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock x:Name="AutomaticPlacementDescription" Text="仅依附任务栏模式的横向布局可用。" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <CheckBox x:Name="LockPositionCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="PlacementCheckBox_OnChanged" Unchecked="PlacementCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="锁定手动位置" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="锁定后不能通过拖动改变任务栏位置。" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Button Content="重置位置" HorizontalAlignment="Left" Margin="0,16,0,0" Style="{StaticResource SettingsActionButtonStyle}" Click="ResetPosition_OnClick" />
          </StackPanel>

          <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
            <TextBlock Text="外观" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="分别调整媒体控制窗口和菜单界面的配色。自动模式会跟随 Windows 主题。"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <TextBlock Text="字体" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="分别选择西文和中文字体。西文负责英文曲名与数字，中文负责汉字；日文、韩文自动使用系统自带字体。"
                       Margin="0,4,0,8"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="210" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="西文字体" Margin="0,0,0,4" Style="{StaticResource SettingsRowDescriptionStyle}" />
                <ComboBox x:Name="FontLatinComboBox"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          SelectionChanged="FontComboBox_OnSelectionChanged">
                  <ComboBoxItem Content="Segoe UI（系统默认）" />
                  <ComboBoxItem Content="Arial" />
                  <ComboBoxItem Content="Calibri" />
                  <ComboBoxItem Content="Verdana" />
                  <ComboBoxItem Content="Consolas" />
                  <ComboBoxItem Content="Times New Roman" />
                  <ComboBoxItem Content="跟随中文字体" />
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="中文字体" Margin="0,0,0,4" Style="{StaticResource SettingsRowDescriptionStyle}" />
                <ComboBox x:Name="FontCjkComboBox"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          SelectionChanged="FontComboBox_OnSelectionChanged">
                  <ComboBoxItem Content="系统默认" />
                  <ComboBoxItem Content="微软雅黑（推荐）" />
                  <ComboBoxItem Content="等线" />
                  <ComboBoxItem Content="宋体" />
                  <ComboBoxItem Content="黑体" />
                  <ComboBoxItem Content="楷体" />
                  <ComboBoxItem Content="仿宋" />
                </ComboBox>
              </StackPanel>
            </Grid>
            <Border Margin="0,0,0,16"
                    Padding="12,8"
                    Background="{DynamicResource MenuHoverBrush}"
                    BorderBrush="{DynamicResource MenuBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
              <TextBlock x:Name="FontPreviewText"
                         Text="预览：中文 日本語 한국어 AaBbCc 123"
                         FontSize="14"
                         Foreground="{DynamicResource MenuPrimaryTextBrush}" />
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" />
            <TextBlock Text="媒体控制窗口文字" Margin="0,16,0,0" FontSize="15" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
              <RadioButton x:Name="AutomaticForegroundRadioButton" Content="自动" GroupName="ForegroundMode" Style="{StaticResource SettingsSegmentStyle}" Checked="ThemeRadio_OnChanged" />
              <RadioButton x:Name="LightForegroundRadioButton" Content="浅色文字" GroupName="ForegroundMode" Style="{StaticResource SettingsSegmentStyle}" Checked="ThemeRadio_OnChanged" />
              <RadioButton x:Name="DarkForegroundRadioButton" Content="深色文字" GroupName="ForegroundMode" Style="{StaticResource SettingsSegmentStyle}" Checked="ThemeRadio_OnChanged" />
            </StackPanel>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,1,0,1" Padding="0,10">
              <CheckBox x:Name="EnhancedReadabilityCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="ThemeCheckBox_OnChanged" Unchecked="ThemeCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="增强文字可读性" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="在文字后增加反差底色，适合透明任务栏或复杂壁纸。" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <TextBlock Margin="0,24,0,0" Text="菜单与设置主题" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="应用于右键菜单、详细设置以及播放器的音量和设备弹窗。"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <RadioButton x:Name="AutomaticMenuThemeRadioButton" Content="自动" GroupName="MenuThemeMode" Style="{StaticResource SettingsSegmentStyle}" Checked="MenuThemeRadio_OnChanged" />
              <RadioButton x:Name="LightMenuThemeRadioButton" Content="浅色" GroupName="MenuThemeMode" Style="{StaticResource SettingsSegmentStyle}" Checked="MenuThemeRadio_OnChanged" />
              <RadioButton x:Name="DarkMenuThemeRadioButton" Content="深色" GroupName="MenuThemeMode" Style="{StaticResource SettingsSegmentStyle}" Checked="MenuThemeRadio_OnChanged" />
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="InteractionPage" Visibility="Collapsed">
            <TextBlock Text="交互与动画" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="控制鼠标交互和悬浮窗口的折叠行为。"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
              <CheckBox x:Name="AutoCollapseCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="WindowCheckBox_OnChanged" Unchecked="WindowCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="自动折叠" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="鼠标离开后在媒体信息和播放控制之间切换。" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <CheckBox x:Name="EdgeAutoCollapseCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="WindowCheckBox_OnChanged" Unchecked="WindowCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="桌面边缘自动折叠" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock x:Name="EdgeAutoCollapseDescription" Text="仅独立悬浮模式可用。" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,10">
              <CheckBox x:Name="AlwaysOnTopCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="WindowCheckBox_OnChanged" Unchecked="WindowCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="始终置顶并显示" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="保持窗口可见并显示在其他窗口上方。" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PerformancePage" Visibility="Collapsed">
            <TextBlock Text="性能与高级" Style="{StaticResource SettingsPageTitleStyle}" />
            <TextBlock Text="降低资源占用或执行媒体会话诊断操作。"
                       Margin="0,6,0,20"
                       Style="{StaticResource SettingsRowDescriptionStyle}" />
            <Border BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
              <CheckBox x:Name="LowGpuModeCheckBox" Style="{StaticResource SettingsCheckBoxStyle}" Checked="MetricCheckBox_OnChanged" Unchecked="MetricCheckBox_OnChanged">
                <StackPanel>
                  <TextBlock Text="低配置模式" Style="{StaticResource SettingsRowTitleStyle}" />
                  <TextBlock Text="使用软件渲染并关闭过渡、滚动文字和指标淡入淡出。" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
              </CheckBox>
            </Border>
            <TextBlock Margin="0,24,0,8" Text="诊断" FontSize="15" FontWeight="SemiBold" />
            <Button Content="重新连接媒体会话" HorizontalAlignment="Left" Style="{StaticResource SettingsActionButtonStyle}" Click="Reconnect_OnClick" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
