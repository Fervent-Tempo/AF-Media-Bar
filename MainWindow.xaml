<Window x:Class="TaskbarPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网易云任务栏播放器"
        Height="52"
        SizeToContent="Width"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False">
  <Window.ContextMenu>
    <ContextMenu x:Name="PlayerMenu"
                 Opened="PlayerMenu_OnOpened"
                 Closed="PlayerMenu_OnClosed">
      <MenuItem x:Name="ConnectionMenuItem"
                Header="等待网易云音乐"
                IsEnabled="False" />
      <Separator />
      <MenuItem Header="显示网易云音乐"
                Click="ShowCloudMusic_OnClick" />
      <MenuItem Header="重新连接媒体会话"
                Click="Reconnect_OnClick" />
      <MenuItem Header="性能指标">
        <MenuItem x:Name="SystemMemoryMenuItem"
                  Header="系统内存（MEM）"
                  IsCheckable="True"
                  Click="MetricSetting_OnClick" />
        <MenuItem x:Name="SystemCpuMenuItem"
                  Header="系统处理器（CPU）"
                  IsCheckable="True"
                  Click="MetricSetting_OnClick" />
        <MenuItem x:Name="ProcessMemoryMenuItem"
                  Header="播放器内存（APP）"
                  IsCheckable="True"
                  Click="MetricSetting_OnClick" />
      </MenuItem>
      <MenuItem Header="位置">
        <MenuItem x:Name="AutomaticPlacementMenuItem"
                  Header="自动避让任务栏图标"
                  IsCheckable="True"
                  Click="AutomaticPlacement_OnClick" />
        <MenuItem x:Name="LockPositionMenuItem"
                  Header="锁定手动位置"
                  IsCheckable="True"
                  Click="LockPosition_OnClick" />
      </MenuItem>
      <MenuItem x:Name="StartupMenuItem"
                Header="开机启动"
                IsCheckable="True"
                Click="Startup_OnClick" />
      <Separator />
      <MenuItem Header="退出"
                Click="Exit_OnClick" />
    </ContextMenu>
  </Window.ContextMenu>

  <Grid x:Name="PlayerRoot"
        Width="349"
        Height="44"
        Background="#01000000"
        ClipToBounds="True"
        SnapsToDevicePixels="True"
        MouseEnter="PlayerRoot_OnMouseEnter"
        MouseLeave="PlayerRoot_OnMouseLeave"
        PreviewMouseLeftButtonDown="PlayerRoot_OnPreviewMouseLeftButtonDown"
        PreviewMouseMove="PlayerRoot_OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="PlayerRoot_OnPreviewMouseLeftButtonUp">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="44" />
      <ColumnDefinition Width="210" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Border x:Name="ArtworkHost"
            Grid.Column="0"
            Width="40"
            Height="40"
            CornerRadius="5"
            Background="#2AFFFFFF"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Cursor="Hand"
            MouseLeftButtonUp="ShowCloudMusic_OnMouseLeftButtonUp">
      <Grid ClipToBounds="True">
        <TextBlock x:Name="ArtworkPlaceholder"
                   Text="&#xE8D6;"
                   FontFamily="Segoe Fluent Icons"
                   FontSize="18"
                   Foreground="#B9D1E3"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <Image x:Name="ArtworkImage"
               Stretch="UniformToFill" />
      </Grid>
    </Border>

    <Grid x:Name="CentralHost"
          Grid.Column="1"
          Width="210"
          ClipToBounds="True">
      <Grid x:Name="InfoHost"
            Width="210"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Cursor="Hand"
            MouseLeftButtonUp="ShowCloudMusic_OnMouseLeftButtonUp">
        <Grid Margin="9,0,8,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="18" />
          </Grid.RowDefinitions>

          <Canvas x:Name="TitleViewport"
                  Grid.Row="0"
                  Height="22"
                  ClipToBounds="True">
            <TextBlock x:Name="TitleText"
                       Text="等待网易云音乐"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       TextWrapping="NoWrap">
              <TextBlock.RenderTransform>
                <TranslateTransform x:Name="TitleTransform" Y="8" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Canvas>

          <Canvas x:Name="ArtistViewport"
                  Grid.Row="1"
                  Height="18"
                  ClipToBounds="True">
            <TextBlock x:Name="ArtistText"
                       Text="请先播放一首歌曲"
                       FontFamily="Segoe UI Variable Text"
                       FontSize="11.5"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Opacity="0"
                       IsHitTestVisible="False"
                       TextWrapping="NoWrap">
              <TextBlock.RenderTransform>
                <TranslateTransform x:Name="ArtistTransform" Y="-3" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Canvas>
        </Grid>
      </Grid>

      <Border x:Name="ControlsHost"
              Width="114"
              HorizontalAlignment="Right"
              Opacity="0"
              ClipToBounds="True"
              IsHitTestVisible="False">
        <Border.RenderTransform>
          <TranslateTransform x:Name="ControlsTransform" X="8" />
        </Border.RenderTransform>
        <StackPanel Width="114"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Button x:Name="PreviousButton"
                  Style="{StaticResource TransportButtonStyle}"
                  ToolTip="上一首"
                  Click="Previous_OnClick">
            <TextBlock Text="&#xE892;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="13" />
          </Button>
          <Button x:Name="PlayPauseButton"
                  Style="{StaticResource TransportButtonStyle}"
                  ToolTip="播放"
                  Click="PlayPause_OnClick">
            <TextBlock x:Name="PlayPauseGlyph"
                       Text="&#xE768;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="15" />
          </Button>
          <Button x:Name="NextButton"
                  Style="{StaticResource TransportButtonStyle}"
                  ToolTip="下一首"
                  Click="Next_OnClick">
            <TextBlock Text="&#xE893;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="13" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <Border x:Name="MetricsDivider"
            Grid.Column="2"
            Width="1"
            Height="22"
            Margin="8,0"
            Background="#28FFFFFF"
            VerticalAlignment="Center" />

    <Border x:Name="MetricsHost"
            Grid.Column="3"
            Width="74"
            Height="24"
            Margin="0,0,4,0"
            Padding="8,0"
            CornerRadius="12"
            Background="#24FFFFFF"
            VerticalAlignment="Center">
      <TextBlock x:Name="MetricsText"
                 Text="MEM --%"
                 FontFamily="Segoe UI Variable Text"
                 FontSize="11"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource SecondaryTextBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
