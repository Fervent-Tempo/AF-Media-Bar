<Window x:Class="TaskbarPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网易云任务栏播放器"
        Width="420"
        Height="52"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False">
  <Window.ContextMenu>
    <ContextMenu x:Name="PlayerMenu" Opened="PlayerMenu_OnOpened">
      <MenuItem x:Name="ConnectionMenuItem" Header="等待网易云音乐" IsEnabled="False" />
      <Separator />
      <MenuItem Header="显示网易云音乐" Click="ShowCloudMusic_OnClick" />
      <MenuItem Header="重新连接媒体会话" Click="Reconnect_OnClick" />
      <MenuItem x:Name="StartupMenuItem" Header="开机启动" IsCheckable="True" Click="Startup_OnClick" />
      <Separator />
      <MenuItem Header="退出" Click="Exit_OnClick" />
    </ContextMenu>
  </Window.ContextMenu>

  <Grid x:Name="PlayerRoot" Margin="0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="44" />
      <ColumnDefinition Width="188" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Width="40"
            Height="40"
            CornerRadius="5"
            Background="#2AFFFFFF"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Cursor="Hand"
            MouseLeftButtonUp="ShowCloudMusic_OnMouseLeftButtonUp">
      <Grid>
        <TextBlock x:Name="ArtworkPlaceholder"
                   Text="&#xE8D6;"
                   FontFamily="Segoe Fluent Icons"
                   FontSize="18"
                   Foreground="#B9D1E3"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
      </Grid>
    </Border>

    <Grid Grid.Column="1"
          Margin="9,0,8,0"
          VerticalAlignment="Center"
          Cursor="Hand"
          MouseLeftButtonUp="ShowCloudMusic_OnMouseLeftButtonUp">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="TitleText"
                 Grid.Row="0"
                 Text="等待网易云音乐"
                 FontFamily="Segoe UI Variable Display"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource PrimaryTextBrush}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="等待网易云音乐" />
      <TextBlock x:Name="ArtistText"
                 Grid.Row="1"
                 Margin="0,1,0,0"
                 Text="请先播放一首歌曲"
                 FontFamily="Segoe UI Variable Text"
                 FontSize="11.5"
                 Foreground="{StaticResource SecondaryTextBrush}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="请先播放一首歌曲" />
    </Grid>

    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="PreviousButton"
              Style="{StaticResource TransportButtonStyle}"
              ToolTip="上一首"
              Click="Previous_OnClick">
        <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="13" />
      </Button>
      <Button x:Name="PlayPauseButton"
              Style="{StaticResource TransportButtonStyle}"
              ToolTip="播放"
              Click="PlayPause_OnClick">
        <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="15" />
      </Button>
      <Button x:Name="NextButton"
              Style="{StaticResource TransportButtonStyle}"
              ToolTip="下一首"
              Click="Next_OnClick">
        <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="13" />
      </Button>
    </StackPanel>
  </Grid>
</Window>
