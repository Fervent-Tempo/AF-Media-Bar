<Window x:Class="TaskbarPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AF Shell · Media Bar"
        Height="52"
        SizeToContent="Width"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False">
  <Window.ContextMenu>
    <ContextMenu x:Name="PlayerMenu"
                 MaxWidth="360"
                 Opened="PlayerMenu_OnOpened"
                 Closed="PlayerMenu_OnClosed">
      <MenuItem x:Name="ConnectionMenuItem"
                IsEnabled="False">
        <MenuItem.Header>
          <TextBlock x:Name="ConnectionMenuText"
                     MaxWidth="300"
                     Text="等待媒体播放"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </MenuItem.Header>
      </MenuItem>
      <Separator />
      <MenuItem x:Name="ShowSourceMenuItem"
                Header="显示媒体应用"
                Click="ShowMediaSource_OnClick" />
      <MenuItem x:Name="MediaSourcesMenuItem"
                Header="媒体来源" />
      <MenuItem Header="重新连接媒体会话"
                Click="Reconnect_OnClick" />
      <MenuItem Header="性能指标">
        <MenuItem x:Name="MetricsEnabledMenuItem"
                  Header="显示性能指标"
                  IsCheckable="True"
                  Click="MetricSetting_OnClick" />
        <Separator />
        <MenuItem x:Name="SystemMemoryMenuItem"
                  Header="系统内存（MEM）"
                  IsCheckable="True"
                  Click="MetricSetting_OnClick" />
        <MenuItem x:Name="SystemCpuMenuItem"
                  Header="系统处理器（CPU）"
                  IsCheckable="True"
                  Click="MetricSetting_OnClick" />
        <MenuItem x:Name="SystemGpuMenuItem"
                  Header="系统图形处理器（GPU）"
                  IsCheckable="True"
                  Click="MetricSetting_OnClick" />
        <MenuItem x:Name="ProcessMemoryMenuItem"
                  Header="播放器内存（APP）"
                  IsCheckable="True"
                  Click="MetricSetting_OnClick" />
      </MenuItem>
      <MenuItem x:Name="LowGpuModeMenuItem"
                Header="低配置模式"
                ToolTip="降低硬件渲染和动画活动，适合低配置设备"
                IsCheckable="True"
                Click="MetricSetting_OnClick" />
      <MenuItem x:Name="AudioMonitorMenuItem"
                Header="音频监听"
                ToolTip="在收起状态显示当前系统声音"
                IsCheckable="True"
                Click="MetricSetting_OnClick" />
      <MenuItem Header="位置">
        <MenuItem x:Name="AutomaticPlacementMenuItem"
                  Header="自动避让任务栏图标"
                  IsCheckable="True"
                  Click="AutomaticPlacement_OnClick" />
        <MenuItem x:Name="LockPositionMenuItem"
                  Header="锁定手动位置"
                  IsCheckable="True"
                  Click="LockPosition_OnClick" />
      </MenuItem>
      <MenuItem x:Name="StartupMenuItem"
                Header="开机启动"
                IsCheckable="True"
                Click="Startup_OnClick" />
      <Separator />
      <MenuItem Header="退出"
                Click="Exit_OnClick" />
    </ContextMenu>
  </Window.ContextMenu>

  <Grid x:Name="PlayerRoot"
        Width="349"
        Height="44"
        Background="#01000000"
        ClipToBounds="True"
        SnapsToDevicePixels="True"
        MouseEnter="PlayerRoot_OnMouseEnter"
        MouseLeave="PlayerRoot_OnMouseLeave"
        PreviewMouseWheel="PlayerRoot_OnPreviewMouseWheel"
        PreviewMouseLeftButtonDown="PlayerRoot_OnPreviewMouseLeftButtonDown"
        PreviewMouseMove="PlayerRoot_OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="PlayerRoot_OnPreviewMouseLeftButtonUp">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="44" />
      <ColumnDefinition Width="210" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Border x:Name="ArtworkHost"
            Grid.Column="0"
            Width="40"
            Height="40"
            CornerRadius="5"
            Background="#2AFFFFFF"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Cursor="Hand"
            MouseLeftButtonUp="ShowMediaSource_OnMouseLeftButtonUp">
      <Grid ClipToBounds="True">
        <TextBlock x:Name="ArtworkPlaceholder"
                   Text="&#xE8D6;"
                   FontFamily="Segoe Fluent Icons"
                   FontSize="18"
                   Foreground="#B9D1E3"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <Image x:Name="ArtworkImage"
               Stretch="UniformToFill" />
      </Grid>
    </Border>

    <Grid x:Name="CentralHost"
          Grid.Column="1"
          Width="210"
          ClipToBounds="True">
      <Grid x:Name="InfoHost"
            Width="210"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Cursor="Hand"
            MouseLeftButtonUp="ShowMediaSource_OnMouseLeftButtonUp">
        <Grid Height="40"
              Margin="9,0,8,0">

          <Canvas x:Name="TitleViewport"
                  Height="40"
                  VerticalAlignment="Center"
                  ClipToBounds="True">
            <TextBlock x:Name="TitleText"
                       Canvas.Top="10"
                       Text="等待媒体播放"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       TextWrapping="NoWrap">
              <TextBlock.RenderTransform>
                <TranslateTransform x:Name="TitleTransform" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Canvas>

          <Canvas x:Name="ArtistViewport"
                  Height="18"
                  VerticalAlignment="Bottom"
                  ClipToBounds="True">
            <TextBlock x:Name="ArtistText"
                       Text="请在任意应用中播放音频或视频"
                       FontFamily="Segoe UI Variable Text"
                       FontSize="11.5"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Opacity="0"
                       IsHitTestVisible="False"
                       TextWrapping="NoWrap">
              <TextBlock.RenderTransform>
                <TranslateTransform x:Name="ArtistTransform" Y="3" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Canvas>
        </Grid>
      </Grid>

      <Border x:Name="ControlsHost"
              Width="114"
              HorizontalAlignment="Right"
              Opacity="0"
              ClipToBounds="True"
              IsHitTestVisible="False">
        <Border.RenderTransform>
          <TranslateTransform x:Name="ControlsTransform" X="8" />
        </Border.RenderTransform>
        <StackPanel Width="114"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Button x:Name="PreviousButton"
                  Style="{StaticResource TransportButtonStyle}"
                  ToolTip="上一首"
                  Click="Previous_OnClick">
            <TextBlock Text="&#xE892;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="13" />
          </Button>
          <Button x:Name="PlayPauseButton"
                  Style="{StaticResource TransportButtonStyle}"
                  ToolTip="播放"
                  Click="PlayPause_OnClick">
            <TextBlock x:Name="PlayPauseGlyph"
                       Text="&#xE768;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="15" />
          </Button>
          <Button x:Name="NextButton"
                  Style="{StaticResource TransportButtonStyle}"
                  ToolTip="下一首"
                  Click="Next_OnClick">
            <TextBlock Text="&#xE893;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="13" />
          </Button>
        </StackPanel>
      </Border>
      <StackPanel x:Name="AudioVisualizerHost"
                  Width="114"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Orientation="Horizontal"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
        <Border x:Name="AudioBar0" Width="4" Height="4" Margin="14,0,5,0" CornerRadius="2" Background="#B9D1E3" VerticalAlignment="Center" />
        <Border x:Name="AudioBar1" Width="4" Height="4" Margin="0,0,5,0" CornerRadius="2" Background="#B9D1E3" VerticalAlignment="Center" />
        <Border x:Name="AudioBar2" Width="4" Height="4" Margin="0,0,5,0" CornerRadius="2" Background="#B9D1E3" VerticalAlignment="Center" />
        <Border x:Name="AudioBar3" Width="4" Height="4" Margin="0,0,5,0" CornerRadius="2" Background="#B9D1E3" VerticalAlignment="Center" />
        <Border x:Name="AudioBar4" Width="4" Height="4" Margin="0" CornerRadius="2" Background="#B9D1E3" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Border x:Name="MetricsDivider"
            Grid.Column="2"
            Width="1"
            Height="22"
            Margin="8,0"
            Background="#28FFFFFF"
            VerticalAlignment="Center" />

    <Border x:Name="MetricsHost"
            Grid.Column="3"
            Width="74"
            Height="24"
            Margin="0,0,4,0"
            Padding="8,0"
            CornerRadius="12"
            Background="#24FFFFFF"
            VerticalAlignment="Center">
      <TextBlock x:Name="MetricsText"
                 Text="MEM --%"
                 FontFamily="Segoe UI Variable Text"
                 FontSize="11"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource SecondaryTextBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
