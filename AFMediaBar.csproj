<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>AFMediaBar</AssemblyName>
    <AssemblyTitle>AF Media Bar</AssemblyTitle>
    <RootNamespace>AFMediaBar</RootNamespace>
    <Version>1.1.1</Version>
    <Authors>AmorFate</Authors>
    <Copyright>Copyright (c) 2026 AmorFate</Copyright>
    <RepositoryUrl>https://github.com/Fervent-Tempo/AF-Media-Bar</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Product>AF Media Bar</Product>
    <Description>Media control and minor beautification software for Windows 10/11 desktops.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="src\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Page Remove="src\AFMediaBar.WinUI\**\*.xaml" />
    <ApplicationDefinition Remove="src\AFMediaBar.WinUI\App.xaml" />
    <Compile Remove="prototypes\**\*.cs" />
    <Page Remove="prototypes\**\*.xaml" />
    <ApplicationDefinition Remove="prototypes\**\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\AFMediaBar.Core\AFMediaBar.Core.csproj" />
    <ProjectReference Include="src\AFMediaBar.Platform.Windows\AFMediaBar.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
